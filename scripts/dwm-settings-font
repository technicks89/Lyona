#!/usr/bin/env bash

set -euo pipefail

# A checkout keeps the shared shell code beside the scripts; an install keeps it
# in PREFIX/lib/lyona, beside PREFIX/bin (Sync Sprint 12 S12-13).
lyona_lib=${BASH_SOURCE[0]%/*}
[[ -f $lyona_lib/dwm-paths.sh ]] || lyona_lib=${lyona_lib%bin}lib/lyona
# shellcheck source=scripts/dwm-paths.sh
. "$lyona_lib/dwm-paths.sh"

default_family='MesloLGS Nerd Font Mono'
default_scale='1.00'
protocol_header=$'appearance-font-protocol\t1\t0'
action_header=$'appearance-font-action-protocol\t1\t0'
home_dir=${HOME:-}
# Lenient: a missing HOME is reported by require_paths, through the protocol.
# shellcheck source=scripts/dwm-proc.sh
. "$lyona_lib/dwm-proc.sh"
# shellcheck source=scripts/dwm-xdg.sh
. "$lyona_lib/dwm-xdg.sh"
lyona_xdg_dirs lenient
config_dir=$config_home/lyona
config_file=$config_dir/font.conf
state_base=$state_home/lyona
appearance_state_dir=$state_base/appearance
state_dir=$state_home/lyona/appearance/font
lock_file=$state_dir/mutation.lock
preview_file=$state_dir/preview.current
preview_meta=$state_dir/preview.meta
preview_baseline=$state_dir/preview.baseline
preview_failed=$state_dir/preview.failed

# The preview, keep, revert and rollback machinery, shared with dwm-settings-toolkit
# (Sync Sprint 12 S12-14).
preview_program=dwm-settings-font
preview_label=font
preview_config_name=font.conf
preview_env=DWM_SETTINGS_FONT
# shellcheck source=scripts/dwm-preview.sh
. "$lyona_lib/dwm-preview.sh"
preview_setup_active=false
preview_setup_pid=''
preview_setup_hash=''
preview_setup_present=no
preview_setup_mode=600
published_config_retained=false
exchange_failure_detail=''

usage() {
	printf '%s\n' \
		'usage: dwm-settings-font status' \
		'       dwm-settings-font mutation-ready' \
		'       dwm-settings-font preview TOKEN SECONDS FAMILY SCALE' \
		'       dwm-settings-font keep TOKEN' \
		'       dwm-settings-font revert TOKEN' \
		'       dwm-settings-font abandon TOKEN' \
		'       dwm-settings-font apply FAMILY SCALE' \
		'       dwm-settings-font reset' >&2
}

die() {
	printf '%s\n' "$*" >&2
	exit 1
}

valid_family() {
	local family=$1
	[[ -n $family && ${#family} -le 200 && $family != *$'\t'* &&
		$family != *$'\n'* && $family != *$'\r'* && $family != *:* ]]
}

valid_scale() {
	case $1 in
	0.80 | 0.90 | 1.00 | 1.10 | 1.25 | 1.50) return 0 ;;
	*) return 1 ;;
	esac
}

meslo_alias() {
	case $1 in
	'MesloLGS Nerd Font Mono' | 'MesloLGS Nerd Font' | 'MesloLGS NF') return 0 ;;
	*) return 1 ;;
	esac
}

font_installed() {
	local requested=$1 resolved
	command -v fc-match >/dev/null 2>&1 || return 1
	command -v timeout >/dev/null 2>&1 || return 1
	resolved=$(timeout 3 fc-match --format '%{family[0]}\n' \
		"$requested:charset=20-7e" 2>/dev/null) || return 1
	[[ $resolved == "$requested" ]] && return 0
	meslo_alias "$requested" && meslo_alias "$resolved"
}

default_font_available() {
	local resolved
	command -v fc-match >/dev/null 2>&1 || return 1
	command -v timeout >/dev/null 2>&1 || return 1
	resolved=$(timeout 3 fc-match --format '%{family[0]}\n' \
		"$default_family:charset=20-7e" 2>/dev/null) || return 1
	meslo_alias "$resolved"
}

read_config() {
	configured_family=$default_family
	configured_scale=$default_scale
	configured_state=default
	configured_detail='Managed shell font defaults are active'
	[[ -e $config_file ]] || return 0
	validate_file "$config_file" 'font configuration'
	if [[ $(stat -c %s -- "$config_file") -gt 4096 ]]; then
		configured_state=invalid
		configured_detail='Font configuration is too large; safe shell defaults remain active'
		return 1
	fi
	local header='' family='' scale='' record value extra records=0
	while IFS=$'\t' read -r record value extra || [[ -n $record$value$extra ]]; do
		((records += 1))
		case $records:$record in
		1:appearance-font-protocol) header=$record$'\t'$value$'\t'$extra ;;
		2:family)
			family=$value
			[[ -z $extra ]] || family=''
			;;
		3:scale)
			scale=$value
			[[ -z $extra ]] || scale=''
			;;
		*)
			configured_state=invalid
			configured_detail='Font configuration has unexpected records'
			return 1
			;;
		esac
	done <"$config_file"
	if [[ $header != "$protocol_header" ]] || ! valid_family "$family" || ! valid_scale "$scale"; then
		configured_state=invalid
		configured_detail='Font configuration is malformed; safe shell defaults remain active'
		return 1
	fi
	configured_family=$family
	configured_scale=$scale
	configured_state=configured
	configured_detail='Managed shell font selection is persisted'
}

write_config() {
	local family=$1 scale=$2 expected_hash=$3 expected_mode=${4:-} requested_temp=${5:-} temp mode=600
	prepare_config
	if [[ -e $config_file ]]; then
		if [[ -n $expected_mode ]]; then
			mode=$expected_mode
		else
			mode=$(stat -c %a -- "$config_file")
		fi
	fi
	if [[ -n $requested_temp ]]; then
		[[ $requested_temp == "$config_dir"/.font.conf.preview-exchange.* &&
			! -e $requested_temp && ! -L $requested_temp ]] || return 1
		(umask 077 && set -o noclobber && : >"$requested_temp") 2>/dev/null || return 1
		temp=$requested_temp
	else
		temp=$(mktemp --tmpdir="$config_dir" .font.conf.XXXXXX) || return 1
	fi
	trap 'unlink -- "${temp:-}" 2>/dev/null || true' RETURN
	printf '%s\nfamily\t%s\nscale\t%s\n' "$protocol_header" "$family" "$scale" >"$temp" ||
		return 1
	chmod "$mode" -- "$temp" || return 1
	if ! publish_config_if_hash "$temp" "$expected_hash" "$expected_mode"; then
		[[ $published_config_retained == false ]] || temp=
		return 1
	fi
	temp=
	trap - RETURN
}

selection_hash() {
	local family=$1 scale=$2
	printf '%s\nfamily\t%s\nscale\t%s\n' "$protocol_header" "$family" "$scale" |
		sha256sum | awk '{ print $1 }'
}

write_meta() {
	local token=$1 deadline=$2 boot_id=$3 family=$4 scale=$5 hash=$6 present=$7 mode=$8 pid=$9
	local start=${10} published=${11:-no} temp
	temp=$(mktemp --tmpdir="$state_dir" .preview.meta.XXXXXX)
	trap 'unlink -- "${temp:-}" 2>/dev/null || true' RETURN
	chmod 600 -- "$temp"
	printf '%s\t%s\n' \
		token "$token" deadline "$deadline" boot-id "$boot_id" family "$family" scale "$scale" \
		hash "$hash" baseline-present "$present" baseline-mode "$mode" \
		watchdog-pid "$pid" watchdog-start "$start" published "$published" >"$temp"
	mv -fT -- "$temp" "$preview_meta"
	trap - RETURN
}

validate_selection() {
	local family=$1 scale=$2
	valid_family "$family" || die 'font family is invalid'
	valid_scale "$scale" || die 'text scale must be one of 0.80, 0.90, 1.00, 1.10, 1.25, or 1.50'
	font_installed "$family" || die "font family is not installed or lacks basic interface glyphs: $family"
}

emit_status() {
	local selection_state detail token='' family scale deadline boot_id remaining=0 failed_detail=''
	local active_token active_hash
	prepare_state
	prepare_config yes
	acquire_lock
	expire_preview_locked || true
	if preview_token >/dev/null 2>&1 && [[ ! -e $preview_failed ]] &&
		[[ ${DWM_SETTINGS_FONT_NO_WATCHDOG:-0} != 1 ]] && ! watchdog_alive; then
		active_token=$(preview_token)
		active_hash=$(meta_value hash 2>/dev/null || true)
		if restore_baseline "$active_hash"; then
			clear_preview
		else
			mark_failed "$active_token" \
				'Automatic font rollback watchdog stopped and the previous configuration could not be restored'
		fi
	fi
	read_config || true
	selection_state=available
	detail=$configured_detail
	if [[ $configured_family == "$default_family" ]]; then
		default_font_available || selection_state=unavailable
	elif ! font_installed "$configured_family"; then
		selection_state=unavailable
	fi
	if [[ $selection_state == unavailable ]]; then
		detail="Configured font family is not installed: $configured_family"
	elif [[ $configured_state == invalid ]]; then
		selection_state=partial
	fi
	printf '%s\n' "$action_header"
	printf 'provider\tfont\tavailable\tuser-session\tManaged shell font and text scale\n'
	printf 'selection\t%s\t%s\t%s\t%s\n' "$selection_state" \
		"$(clean_field "$configured_family")" "$configured_scale" "$(clean_field "$detail")"
	if [[ -f $preview_failed ]]; then
		IFS=$'\t' read -r token failed_detail <"$preview_failed" || true
		printf 'preview\tfailed\t%s\t%s\t%s\t0\t%s\n' "$(clean_field "$token")" \
			"$(clean_field "$configured_family")" "$configured_scale" "$(clean_field "$failed_detail")"
	elif token=$(preview_token 2>/dev/null); then
		family=$(meta_value family 2>/dev/null || true)
		scale=$(meta_value scale 2>/dev/null || true)
		deadline=$(meta_value deadline 2>/dev/null || true)
		boot_id=$(meta_value boot-id 2>/dev/null || true)
		if [[ $boot_id == "$(read_boot_id)" && $deadline =~ ^[0-9]+$ && $deadline -gt $(read_now) ]]; then
			remaining=$((deadline - $(read_now)))
		fi
		printf 'preview\tactive\t%s\t%s\t%s\t%s\tAutomatic rollback is armed\n' \
			"$(clean_field "$token")" "$(clean_field "$family")" "$scale" "$remaining"
	else
		printf 'preview\tnone\t\t\t\t0\tNo font preview is active\n'
	fi
}

mutation_ready() {
	prepare_state
	prepare_config
	command -v flock >/dev/null 2>&1 || return 1
	command -v timeout >/dev/null 2>&1 || return 1
	command -v fc-match >/dev/null 2>&1 || return 1
	command -v setsid >/dev/null 2>&1 || return 1
	command -v sleep >/dev/null 2>&1 || return 1
	exchange_supported || die "$exchange_failure_detail"
	read_now >/dev/null
	read_boot_id >/dev/null
}

start_preview() {
	local token=$1 seconds=$2 family=$3 scale=$4 present=no mode=600 baseline_hash=absent
	local deadline boot_id hash pid='' start=''
	valid_token "$token" || die 'preview token is invalid'
	valid_seconds "$seconds" || die 'preview duration must be between 5 and 120 seconds'
	validate_selection "$family" "$scale"
	acquire_lock
	expire_preview_locked || true
	[[ ! -e $preview_file && ! -e $preview_failed ]] || die 'another font preview needs to be completed first'
	prepare_config
	if [[ -e $config_file ]]; then
		present=yes
		capture_baseline
		baseline_hash=$(config_path_hash "$preview_baseline")
		mode=$(stat -c %a -- "$config_file")
	fi
	preview_setup_active=true
	preview_setup_present=$present
	preview_setup_mode=$mode
	preview_setup_pid=''
	preview_setup_hash=''
	trap 'preview_setup_cleanup $?' EXIT
	trap 'exit 130' HUP INT TERM
	hash=$(selection_hash "$family" "$scale")
	preview_setup_hash=$hash
	boot_id=$(read_boot_id)
	deadline=$(($(read_now) + 10#$seconds))
	write_meta "$token" "$deadline" "$boot_id" "$family" "$scale" "$hash" "$present" "$mode" '' ''
	write_preview_token "$token"
	if [[ ${DWM_SETTINGS_FONT_NO_WATCHDOG:-0} != 1 ]]; then
		setsid "$0" _watchdog "$token" "$deadline" </dev/null >/dev/null 2>&1 9>&- &
		pid=$!
		preview_setup_pid=$pid
		for _ in {1..20}; do
			start=$(proc_starttime "$pid" || true)
			[[ -n $start ]] && break
			sleep 0.01
		done
		[[ -n $start ]] || die 'font preview rollback watchdog could not start'
		write_meta "$token" "$deadline" "$boot_id" "$family" "$scale" "$hash" "$present" "$mode" "$pid" "$start"
	fi
	write_config "$family" "$scale" "$baseline_hash" "$mode" \
		"$(preview_exchange_path "$token")" ||
		die 'font configuration changed outside Settings; preview was not applied'
	write_meta "$token" "$deadline" "$boot_id" "$family" "$scale" "$hash" "$present" "$mode" \
		"$pid" "$start" yes
	preview_setup_active=false
	trap - EXIT HUP INT TERM
	printf '%s\nresult\tpreview-started\n' "$action_header"
}

finish_preview() {
	local action=$1 requested=$2 token expected_hash expected_mode current_hash current_mode
	valid_token "$requested" || die 'preview token is invalid'
	acquire_lock
	token=$(preview_token 2>/dev/null || true)
	[[ $token == "$requested" ]] || die 'font preview token does not match the active preview'
	expected_hash=$(meta_value hash 2>/dev/null || true)
	expected_mode=$(meta_value baseline-mode 2>/dev/null || true)
	current_hash=$(file_hash)
	current_mode=$(file_mode)
	case $action in
	keep)
		expire_preview_locked "$token" || true
		[[ $(preview_token 2>/dev/null || true) == "$token" ]] || die 'font preview has expired'
		[[ ! -e $preview_failed ]] || die 'failed font preview cannot be kept'
		[[ $current_hash == "$expected_hash" && $current_mode == "$expected_mode" ]] ||
			die 'font configuration changed outside Settings; keep was refused'
		clear_preview
		;;
	revert)
		restore_baseline "$expected_hash" || {
			mark_failed "$token" 'Previous font configuration could not be restored'
			die 'previous font configuration could not be restored; the active file was preserved or retained for recovery'
		}
		clear_preview
		;;
	abandon)
		[[ -e $preview_failed ]] || die 'font preview is not stale; use keep or revert'
		clear_preview
		;;
	*) die 'unsupported font preview action' ;;
	esac
	printf '%s\nresult\t%s\n' "$action_header" "$action"
}

apply_selection() {
	local family=$1 scale=$2 expected_hash expected_mode
	validate_selection "$family" "$scale"
	acquire_lock
	expire_preview_locked || true
	[[ ! -e $preview_file && ! -e $preview_failed ]] || die 'complete the active font preview before applying another selection'
	expected_hash=$(file_hash)
	expected_mode=$(file_mode)
	write_config "$family" "$scale" "$expected_hash" "$expected_mode" ||
		die 'font configuration changed outside Settings; selection was not applied'
	printf '%s\nresult\tapplied\n' "$action_header"
}

reset_selection() {
	local expected_hash expected_mode
	acquire_lock
	expire_preview_locked || true
	[[ ! -e $preview_file && ! -e $preview_failed ]] || die 'complete the active font preview before resetting'
	expected_hash=$(file_hash)
	expected_mode=$(file_mode)
	remove_config "$expected_hash" "$expected_mode" ||
		die 'font configuration changed outside Settings; reset was not applied'
	printf '%s\nresult\treset\n' "$action_header"
}

command=${1:-}
case $command in
status)
	[[ $# -eq 1 ]] || {
		usage
		exit 2
	}
	emit_status
	;;
mutation-ready)
	[[ $# -eq 1 ]] || {
		usage
		exit 2
	}
	mutation_ready
	;;
preview)
	[[ $# -eq 5 ]] || {
		usage
		exit 2
	}
	start_preview "$2" "$3" "$4" "$5"
	;;
keep | revert | abandon)
	[[ $# -eq 2 ]] || {
		usage
		exit 2
	}
	finish_preview "$command" "$2"
	;;
apply)
	[[ $# -eq 3 ]] || {
		usage
		exit 2
	}
	apply_selection "$2" "$3"
	;;
reset)
	[[ $# -eq 1 ]] || {
		usage
		exit 2
	}
	reset_selection
	;;
_watchdog)
	[[ $# -eq 3 ]] || exit 2
	watchdog "$2" "$3"
	;;
*)
	usage
	exit 2
	;;
esac
