#!/usr/bin/env bash
set -euo pipefail

# Topgrade, the one command that updates everything (Sync Sprint 15 S15-06,
# decision D-28), from the AUR (#245): topgrade-bin, which repackages
# upstream's release binary and installs in seconds. It used to be built from
# crates.io with cargo, which took a Rust toolchain, about 300 MB of crates and
# several minutes of compiling, and was the slowest step of the install.
#
# - The AUR base is pinned to a commit whose PKGBUILD was reviewed, in
#   dwm-aur.sh's one pin table (#281, docs/AUR-PACKAGES.md): topgrade-bin
#   downloads the release tarball from github.com/topgrade-rs over HTTPS with a
#   b2sum, and has no install script or dependencies. dwm-aur.sh refuses a
#   PKGBUILD whose sources are not all checksummed, and bounds the build.
# - makepkg runs as the user, never as root; only the built package is
#   installed with root (pacman -U).
# - No source fallback, and no Rust: the topgrade source package compiles for
#   several minutes, and when topgrade-bin cannot be built the AUR or GitHub is
#   almost certainly unreachable for it too (decided with the maintainer).
# - Topgrade updates itself afterwards: its system step runs yay, which updates
#   AUR packages. pacman -Syu alone does not.
# - A Topgrade package already installed is left alone, unless --force. A
#   Topgrade an older lyona built with cargo, in ~/.cargo/bin, would come first
#   on PATH: it is offered for removal, never removed silently.
#
# Needs the network, git and makepkg (base-devel). install.sh runs this for the
# recommended and full profiles (unless --skip-topgrade), after every
# privileged step. The live medium's postinstall runs --build-only as the new
# user and installs the package itself.

# A checkout keeps the shared shell code beside the scripts; an install keeps it
# in PREFIX/lib/lyona, beside PREFIX/bin (Sync Sprint 12 S12-13).
lyona_lib=${BASH_SOURCE[0]%/*}
[[ -f $lyona_lib/dwm-xdg.sh ]] || lyona_lib=${lyona_lib%bin}lib/lyona
# shellcheck source=scripts/dwm-xdg.sh
. "$lyona_lib/dwm-xdg.sh"

# Every AUR build goes through dwm-aur.sh, which holds the pins (#281).
aur=$lyona_lib/dwm-aur.sh
# The tests' local AUR, under the name this script has always read.
[[ -z ${INSTALL_TOPGRADE_AUR_URL:-} ]] || export DWM_AUR_URL=$INSTALL_TOPGRADE_AUR_URL
# topgrade-bin takes seconds; this bounds a stalled download.
export DWM_AUR_BUILD_SECONDS=${DWM_AUR_BUILD_SECONDS:-600}

usage() {
	cat <<EOF
Usage: install-topgrade [--dry-run] [--force] [--print-plan] [--build-only DIR]

Install Topgrade from the AUR: the topgrade-bin package, built with makepkg
from a pinned, reviewed PKGBUILD and installed with pacman.

Topgrade then updates itself through yay; pacman -Syu does not update it.

Options:
  --dry-run         Print what would be done, and change nothing.
  --force           Install even when a Topgrade package is already installed.
  --print-plan      Print one line describing the install, for install.sh.
  --build-only DIR  Build topgrade-bin into DIR and print the package's path;
                    install nothing, and never use sudo.
  -h, --help        Show this help.

An older lyona built Topgrade with cargo into ~/.cargo/bin. That copy comes
before the package on PATH; remove it with: cargo uninstall topgrade
EOF
}

say() { printf 'install-topgrade: %s\n' "$*" >&2; }
die() {
	say "$*"
	exit 1
}

dry_run=false
force=false
print_plan=false
build_only=
while (($# > 0)); do
	case $1 in
	--dry-run) dry_run=true ;;
	--force) force=true ;;
	--print-plan) print_plan=true ;;
	--build-only)
		(($# > 1)) || die '--build-only needs a directory'
		build_only=$2
		shift
		;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		say "unknown option: $1"
		usage >&2
		exit 2
		;;
	esac
	shift
done

pin_of() {
	bash "$aur" pin "$1"
}

if $print_plan; then
	printf 'topgrade-bin from the AUR (PKGBUILD pinned at %s), built with makepkg and installed with pacman\n' \
		"$(pin_of topgrade-bin | cut -c1-12)"
	exit 0
fi

(($(id -u) != 0)) || die 'run as the target user, not as root: makepkg refuses root'
[[ -n ${HOME:-} ]] || die 'HOME is not set'

# The installed Topgrade package, by name: pacman -Qq resolves provides, so
# this finds topgrade-bin and topgrade alike.
topgrade_package() {
	local name
	command -v pacman >/dev/null 2>&1 || return 1
	name=$(pacman -Qq topgrade 2>/dev/null) || return 1
	printf '%s\n' "${name%%$'\n'*}"
}

cargo_copy=${CARGO_HOME:-$HOME/.cargo}/bin/topgrade

# The copy an older lyona built with cargo: asked about at a terminal, only
# described otherwise.
offer_cargo_copy_removal() {
	local answer
	[[ -x $cargo_copy ]] || return 0
	say "an older Topgrade, built with cargo, is at $cargo_copy; it comes before the package on PATH."
	if [[ -t 0 && -t 2 ]]; then
		printf 'install-topgrade: remove it (cargo uninstall topgrade)? [y/N] ' >&2
		read -r answer || answer=
		case $answer in
		y | Y | yes | YES)
			if command -v cargo >/dev/null 2>&1 && cargo uninstall topgrade >&2; then
				say "removed $cargo_copy."
			elif rm -f -- "$cargo_copy"; then
				say "removed $cargo_copy."
			else
				say "could not remove $cargo_copy."
			fi
			return 0
			;;
		esac
	fi
	say "left in place; remove it with: cargo uninstall topgrade (or rm $cargo_copy)"
}

if [[ -z $build_only ]] && ! $force && installed=$(topgrade_package); then
	say "Topgrade is already installed ($installed); it updates itself through yay. Use --force to reinstall."
	offer_cargo_copy_removal
	exit 0
fi

if $dry_run; then
	if [[ -n $build_only ]]; then
		say "would build topgrade-bin (AUR commit $(pin_of topgrade-bin)) with makepkg into $build_only"
	else
		say "would build topgrade-bin (AUR commit $(pin_of topgrade-bin)) with makepkg and install it with sudo pacman -U"
	fi
	exit 0
fi

# build_pin BASE DEST: BASE built at its pinned commit by dwm-aur.sh, its
# package (not a -debug split) in DEST. Prints the package's path.
build_pin() {
	local base=$1 dest=$2 package
	while IFS= read -r package; do
		[[ ${package##*/} == "$base"-[0-9]* ]] || continue
		printf '%s\n' "$package"
		return 0
	done < <(bash "$aur" build-pinned "$base" "$dest")
	say "built no $base package"
	return 1
}

if [[ -n $build_only ]]; then
	[[ -d $build_only && -w $build_only ]] || die "$build_only is not a writable directory"
	build_pin topgrade-bin "$build_only" || die 'topgrade-bin could not be built'
	exit 0
fi

command -v sudo >/dev/null 2>&1 || die 'sudo is not installed'
lyona_xdg_dirs
mkdir -p -- "$cache_home/lyona"
build_root=$(mktemp -d "$cache_home/lyona/topgrade-build.XXXXXX") || die "cannot create a build directory in $cache_home/lyona"
trap 'rm -rf -- "$build_root"' EXIT

package=$(build_pin topgrade-bin "$build_root") ||
	die 'Topgrade could not be built from the AUR; check the network, then run install-topgrade again'

say "installing ${package##*/} with pacman..."
# --needed would make --force a no-op when this version is already installed.
pacman_args=(-U --noconfirm)
$force || pacman_args+=(--needed)
sudo pacman "${pacman_args[@]}" -- "$package" || die "pacman could not install ${package##*/}"
say 'Topgrade is installed; run topgrade. It updates itself through yay.'
offer_cargo_copy_removal
