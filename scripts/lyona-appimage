#!/usr/bin/env bash
set -euo pipefail

# lyona-appimage (#260): AppImages in the launcher, without Gear Lever's GNOME
# runtime. It is the default handler for AppImage files when nothing else is.
#
#   lyona-appimage open FILE    add FILE to the launcher and start it; the first
#                               time, it asks first
#   lyona-appimage remove NAME  take an AppImage out again: its file in
#                               ~/Applications (to the trash), its launcher entry
#                               and its icon
#   lyona-appimage list         the AppImages it has added, NAME<TAB>FILE
#
# Opening a new AppImage asks "Add and run", "Add only" or "Cancel": in the
# terminal when it runs in one, else as a notification with those buttons
# (closing it is Cancel). With no way to ask, it is only added, not run: a
# downloaded program never runs from one click without a question. Adding
# moves the file into ~/Applications, makes it executable, and writes a
# launcher entry with the name and icon read from inside it. They are read with
# unsquashfs at the offset where the AppImage's ELF runtime ends, so adding an
# AppImage never runs it. Nothing it reads from the file is trusted: entry
# values are cleaned, files are size-limited, and a symlink inside the image may
# not lead outside it.
#
# Exit status: 0 done (or cancelled), 1 failed (said on stderr, and as a
# notification for open), 2 bad usage.

# The XDG directories, from the shared helper: beside this script in a
# checkout, PREFIX/lib/lyona in an install.
script_dir=${0%/*}
[[ $script_dir != "$0" ]] || script_dir=.
lyona_lib=$script_dir
[[ -f $lyona_lib/dwm-xdg.sh ]] || lyona_lib=${lyona_lib%bin}lib/lyona
# shellcheck source=scripts/dwm-xdg.sh
. "$lyona_lib/dwm-xdg.sh"
# All four are set; config_home is not read.
# shellcheck disable=SC2034
lyona_xdg_dirs
readonly APPS_DIR=${LYONA_APPIMAGE_DIR:-$HOME/Applications}
readonly ENTRY_DIR=$data_home/applications
readonly ICON_DIR=$data_home/lyona/appimage-icons
readonly WORK_ROOT=$cache_home/lyona
readonly LOCK_FILE=$state_home/lyona/appimage.lock
readonly ENTRY_PREFIX=lyona-appimage-
readonly MAX_ENTRY_BYTES=65536
readonly MAX_ICON_BYTES=2097152
readonly MAX_VALUE_CHARS=256
# At most this many root .desktop files are tried, each extraction at most
# EXTRACT_SECONDS.
readonly MAX_CANDIDATES=8
readonly EXTRACT_SECONDS=20
# How long another open or remove may hold the lock (one may be asking).
readonly LOCK_SECONDS=300
# An AppImage that exits within this many tenths of a second, with a failure,
# is reported as not started.
readonly START_WATCH_TENTHS=20

action=${1:-}
work=
# A move integrate made and has not finished: on a failure before the entry is
# written, the file goes back where it was.
moved_from=
moved_to=

cleanup() {
	[[ -z $moved_from ]] || mv -n -- "$moved_to" "$moved_from" 2>/dev/null || :
	[[ -z $work ]] || rm -rf -- "$work"
}
trap cleanup EXIT

notify() { # TITLE BODY
	command -v notify-send >/dev/null 2>&1 || return 0
	notify-send -a lyona -- "$1" "$2" >/dev/null 2>&1 || :
}

fail() { # MESSAGE
	printf 'lyona-appimage: %s\n' "$1" >&2
	[[ $action != open ]] || notify "AppImage not added" "$1"
	exit 1
}

usage() {
	printf 'Usage: lyona-appimage open FILE | remove NAME | list\n' >&2
	exit 2
}

# One lock for every change to ~/Applications and the entries: a double click
# opens twice.
take_lock() {
	mkdir -p -- "${LOCK_FILE%/*}"
	exec 9>>"$LOCK_FILE"
	flock -w "$LOCK_SECONDS" 9 || fail "another AppImage is being added or removed; try again"
}

# The byte offset where the ELF runtime ends: the end of its section header
# table, which is the end of the ELF file (AppImage type 2). Little-endian x86
# only, which is what lyona runs on.
elf_end() { # FILE
	local file=$1 class shoff shentsize shnum
	[[ $(od -An -tx1 -N4 -- "$file" | tr -d ' \n') == 7f454c46 ]] || return 1
	[[ $(od -An -tu1 -j5 -N1 -- "$file" | tr -d ' ') == 1 ]] || return 1
	class=$(od -An -tu1 -j4 -N1 -- "$file" | tr -d ' ')
	case $class in
	2)
		shoff=$(od -An -tu8 -j40 -N8 -- "$file" | tr -d ' ')
		shentsize=$(od -An -tu2 -j58 -N2 -- "$file" | tr -d ' ')
		shnum=$(od -An -tu2 -j60 -N2 -- "$file" | tr -d ' ')
		;;
	1)
		shoff=$(od -An -tu4 -j32 -N4 -- "$file" | tr -d ' ')
		shentsize=$(od -An -tu2 -j46 -N2 -- "$file" | tr -d ' ')
		shnum=$(od -An -tu2 -j48 -N2 -- "$file" | tr -d ' ')
		;;
	*) return 1 ;;
	esac
	[[ $shoff =~ ^[0-9]+$ && $shentsize =~ ^[0-9]+$ && $shnum =~ ^[0-9]+$ ]] || return 1
	printf '%s\n' $((shoff + shentsize * shnum))
}

# The offset of the AppImage's squashfs image, or fail.
image_offset() { # FILE
	local file=$1 offset
	offset=$(elf_end "$file") || return 1
	((offset > 0 && offset < $(stat -c %s -- "$file"))) || return 1
	[[ $(od -An -c -j "$offset" -N4 -- "$file" | tr -d ' \n') == hsqs ]] || return 1
	printf '%s\n' "$offset"
}

# extract FILE OFFSET NAME MAX: NAME from the image's root into $work/root, its
# symlinks followed inside the image. Prints the extracted regular file's path,
# which must stay inside $work/root and be at most MAX bytes. No file written
# may be larger than MAX (ulimit), and the extraction is time-limited, so a
# huge or endless entry stops early.
extract() { # FILE OFFSET NAME MAX
	local file=$1 offset=$2 name=$3 max=$4 resolved root
	# unsquashfs takes no "--": FILE is always an absolute path (integrate).
	(
		ulimit -f $(((max + 1023) / 1024 + 1))
		timeout "$EXTRACT_SECONDS" unsquashfs -q -no-progress -no-xattrs -follow -f -o "$offset" \
			-d "$work/root" "$file" "$name"
	) >/dev/null 2>&1 || return 1
	root=$(realpath -e -- "$work/root") || return 1
	resolved=$(realpath -e -- "$work/root/$name" 2>/dev/null) || return 1
	[[ $resolved == "$root"/* && -f $resolved && ! -L $resolved ]] || return 1
	(($(stat -c %s -- "$resolved") <= max)) || return 1
	printf '%s\n' "$resolved"
}

# The files and symlinks at the image's root, one per line: never a directory,
# which extracting would bring along whole.
root_names() { # FILE OFFSET
	unsquashfs -no-progress -lls -o "$2" -d R "$1" 2>/dev/null |
		sed -n -e 's|^-[^ ]* .* R/\([^/]*\)$|\1|p' -e 's|^l[^ ]* .* R/\([^/]*\) -> .*$|\1|p'
}

# TEXT cleaned for a desktop entry or a message: no control characters, at most
# MAX_VALUE_CHARS characters (not bytes, so UTF-8 is never cut in half).
clean() { # TEXT
	printf '%s' "$1" | LC_ALL=C tr -d '\000-\037\177' |
		LC_ALL=C.UTF-8 awk -v n="$MAX_VALUE_CHARS" '{ printf "%s", substr($0, 1, n) }'
}

# raw_key FILE KEY: KEY's value in the [Desktop Entry] group, as written.
raw_key() { # FILE KEY
	awk -v want="$2" '
		/^\[/ { group = $0; next }
		group == "[Desktop Entry]" {
			eq = index($0, "=")
			if (eq > 0 && substr($0, 1, eq - 1) == want) { print substr($0, eq + 1); exit }
		}' "$1"
}

# key FILE KEY: raw_key, cleaned: for values read from inside an AppImage.
key() { # FILE KEY
	clean "$(raw_key "$1" "$2")"
}

# A value for an Exec line (desktop entry specification): quoted, with ", `, $
# and \ escaped inside the quotes and a literal % written %%, then every
# backslash doubled by the key file's own string escaping, as webapp-create's
# desktop_exec_arg does.
exec_quote() { # VALUE
	local value=${1//%/%%}
	value=${value//\\/\\\\}
	value=${value//\"/\\\"}
	value=${value//\`/\\\`}
	value=${value//\$/\\\$}
	value="\"$value\""
	printf '%s' "${value//\\/\\\\}"
}

# NAME as an entry id: lowercase ASCII letters, digits and dashes, at most 64
# characters, so the entry's file name stays well under the 255-byte limit.
slug() { # NAME
	local value
	value=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | LC_ALL=C tr -c 'a-z0-9' '-' | tr -s '-')
	value=${value#-}
	value=${value:0:64}
	value=${value%-}
	printf '%s\n' "${value:-appimage}"
}

refresh_entries() {
	! command -v update-desktop-database >/dev/null 2>&1 ||
		update-desktop-database -q -- "$ENTRY_DIR" >/dev/null 2>&1 || :
}

# The entry that points at FILE, if any.
entry_for() { # FILE
	local entry
	for entry in "$ENTRY_DIR/$ENTRY_PREFIX"*.desktop; do
		[[ -f $entry ]] || continue
		[[ $(raw_key "$entry" X-Lyona-AppImage) == "$1" ]] && {
			printf '%s\n' "$entry"
			return 0
		}
	done
	return 1
}

# A free entry id for DEST: its slug, with -2, -3 when another AppImage's
# entry has it (My_App and My-App have the same slug).
entry_id() { # DEST
	local base id n=2
	base=$ENTRY_PREFIX$(slug "$(basename -- "$1")")
	id=$base
	while [[ -e $ENTRY_DIR/$id.desktop && $(raw_key "$ENTRY_DIR/$id.desktop" X-Lyona-AppImage) != "$1" ]]; do
		id=$base-$n
		n=$((n + 1))
	done
	printf '%s\n' "$id"
}

# Where FILE goes in APPS_DIR: there already, an identical copy already there,
# or a free name (a different file of the same name keeps both).
destination() { # FILE
	local file=$1 base candidate n=2
	base=$(basename -- "$file")
	if [[ $(realpath -e -- "$(dirname -- "$file")") == "$(realpath -m -- "$APPS_DIR")" ]]; then
		printf '%s\n' "$APPS_DIR/$base"
		return 0
	fi
	candidate=$APPS_DIR/$base
	while [[ -e $candidate ]]; do
		if cmp -s -- "$file" "$candidate"; then
			printf '%s\n' "$candidate"
			return 0
		fi
		candidate=$APPS_DIR/${base%.*}-$n${base##"${base%.*}"}
		n=$((n + 1))
	done
	printf '%s\n' "$candidate"
}

# PATH for a message: under HOME shown with ~, so the text that matters fits.
shown() { # PATH
	if [[ $1 == "$HOME"/* ]]; then
		# shellcheck disable=SC2088 # a literal ~ to show, not to expand
		printf '~/%s' "${1#"$HOME"/}"
	else
		printf '%s' "$1"
	fi
}

# The host FILE was downloaded from, if the browser recorded it
# (user.xdg.origin.url): only the host, cleaned.
origin_host() { # FILE
	local url host
	command -v getfattr >/dev/null 2>&1 || return 0
	url=$(getfattr --only-values -n user.xdg.origin.url -- "$1" 2>/dev/null) || return 0
	[[ $url == *://* ]] || return 0
	host=${url#*://}
	host=${host%%/*}
	host=${host##*@}
	clean "$host"
}

# Whether the notification server shows buttons (the "actions" capability).
notify_can_ask() {
	local caps
	command -v notify-send >/dev/null 2>&1 && command -v gdbus >/dev/null 2>&1 || return 1
	caps=$(timeout 5 gdbus call --session --dest org.freedesktop.Notifications \
		--object-path /org/freedesktop/Notifications \
		--method org.freedesktop.Notifications.GetCapabilities 2>/dev/null) || return 1
	[[ $caps == *"'actions'"* ]]
}

# ask FILE: the user's choice for a new AppImage, run, add or cancel.
ask() { # FILE
	local file=$1 label host size question detail answer=
	label=$(clean "$(basename -- "$file")")
	host=$(origin_host "$file")
	size=$(numfmt --to=iec-i --suffix=B -- "$(stat -c %s -- "$file")" 2>/dev/null || :)
	question="Run $label?"
	# The warning first: a notification shows three lines.
	detail="Only run programs you trust.${host:+ Downloaded from $host.}${size:+ $size.} Either way it moves to $(shown "$APPS_DIR") and joins the launcher."
	if [[ -t 0 && -t 2 ]]; then
		printf '%s\n%s\n[r] Add and run  [a] Add only  [c] Cancel: ' "$question" "$detail" >&2
		read -r answer || answer=
		case ${answer,,} in
		r | run) printf 'run\n' ;;
		a | add) printf 'add\n' ;;
		*) printf 'cancel\n' ;;
		esac
	elif notify_can_ask; then
		# Critical, so Do Not Disturb does not hide a question the user just
		# caused; closing it without a choice is Cancel.
		answer=$(notify-send -a lyona -u critical -A run="Add and run" -A add="Add only" \
			-A cancel=Cancel -- "$question" "$detail" 2>/dev/null) || answer=
		case $answer in
		run | add) printf '%s\n' "$answer" ;;
		*) printf 'cancel\n' ;;
		esac
	else
		# Nothing can ask: add it, never run it unasked.
		printf 'add\n'
	fi
}

# integrate FILE: the entry for FILE in APPS_DIR, written once. Sets
# integrated_path, the AppImage in APPS_DIR, and choice: run, add or cancel
# (already added: run; added by another open while asking: the answer given). In this shell, not a subshell, so the scratch
# directory is cleaned up on exit.
integrated_path=
choice=
integrate() { # FILE
	local file=$1 offset dest name desktop icon_name icon icon_dest ext exec_args terminal
	local categories comment wmclass id candidate tried=0 base
	local -a names=()
	local -A in_root=()
	[[ -f $file && ! -L $file ]] || fail "not a file: $(clean "$file")"
	file=$(realpath -e -- "$file") || fail "not a file: $(clean "$1")"
	base=$(basename -- "$file")
	# A launcher entry cannot hold these in a path: rename the file first.
	[[ $base != *[[:cntrl:]\\]* ]] ||
		fail "$(clean "$base") has a control character or a backslash in its name; rename it and open it again"
	offset=$(image_offset "$file") || fail "$(clean "$base") is not an AppImage this can read (type 2, x86)"
	dest=$(destination "$file")
	if entry_for "$dest" >/dev/null && [[ -x $dest ]]; then
		integrated_path=$dest
		choice=run
		return 0
	fi

	mkdir -p -- "$WORK_ROOT"
	work=$(mktemp -d -p "$WORK_ROOT" appimage.XXXXXX)
	mapfile -t names < <(root_names "$file" "$offset")
	for candidate in "${names[@]}"; do
		[[ -z $candidate ]] || in_root[$candidate]=1
	done
	desktop=
	for candidate in "${names[@]}"; do
		[[ $candidate == *.desktop ]] || continue
		((tried++ < MAX_CANDIDATES)) || break
		desktop=$(extract "$file" "$offset" "$candidate" "$MAX_ENTRY_BYTES") && break
		desktop=
	done

	icon_name=
	[[ -z $desktop ]] || icon_name=$(key "$desktop" Icon)
	icon=
	for candidate in "$icon_name.png" "$icon_name.svg" .DirIcon; do
		[[ $candidate != .png && $candidate != .svg && $candidate != */* ]] || continue
		[[ -n ${in_root[$candidate]:-} ]] || continue
		icon=$(extract "$file" "$offset" "$candidate" "$MAX_ICON_BYTES") && break
		icon=
	done

	# Asked without the lock, so an open question holds up no other open or
	# remove.
	choice=$(ask "$file")
	if [[ $choice == cancel ]]; then
		printf 'lyona-appimage: %s was not added\n' "$(clean "$base")" >&2
		return 0
	fi

	# Under the lock, looked at again: while the question was open, another
	# open of the same file (a double click) may have added it.
	take_lock
	if [[ ! -e $file ]]; then
		if entry_for "$dest" >/dev/null && [[ -x $dest ]]; then
			integrated_path=$dest
			return 0
		fi
		fail "$(clean "$base") was moved while asking; open it again"
	fi
	dest=$(destination "$file")
	if entry_for "$dest" >/dev/null && [[ -x $dest ]]; then
		integrated_path=$dest
		return 0
	fi

	name=
	[[ -z $desktop ]] || name=$(key "$desktop" Name)
	[[ -n $name ]] || name=$(clean "$(basename -- "$dest" | sed -E 's/\.[Aa]pp[Ii]mage$//')")

	mkdir -p -- "$APPS_DIR" "$ENTRY_DIR" "$ICON_DIR"
	if [[ $file != "$dest" && ! -e $dest ]]; then
		mv -n -- "$file" "$dest" || fail "could not move $(clean "$base") to $APPS_DIR"
		moved_from=$file
		moved_to=$dest
	fi
	chmod u+x -- "$dest" || fail "could not make $(clean "$dest") executable"

	id=$(entry_id "$dest")
	icon_dest=application-x-executable
	if [[ -n $icon ]]; then
		case $(od -An -tx1 -N4 -- "$icon" | tr -d ' \n') in
		89504e47) ext=png ;;
		*) grep -q '<svg' -- "$icon" 2>/dev/null && ext=svg || ext= ;;
		esac
		if [[ -n $ext ]]; then
			icon_dest=$ICON_DIR/$id.$ext
			install -m 0644 -- "$icon" "$icon_dest"
		fi
	fi

	# The entry's own Exec arguments: only the file and URL field codes.
	exec_args=
	if [[ -n $desktop ]]; then
		exec_args=$(key "$desktop" Exec | grep -oE '%[fFuU]' | head -n 1 || :)
		terminal=$(key "$desktop" Terminal)
		categories=$(key "$desktop" Categories)
		comment=$(key "$desktop" Comment)
		wmclass=$(key "$desktop" StartupWMClass)
	fi
	# dest has no control character or backslash (checked above), so it needs
	# no string escaping in TryExec and X-Lyona-AppImage.
	{
		printf '[Desktop Entry]\nType=Application\n'
		printf 'Name=%s\n' "$name"
		[[ -z ${comment:-} ]] || printf 'Comment=%s\n' "$comment"
		[[ -z ${categories:-} ]] || printf 'Categories=%s\n' "$categories"
		printf 'Exec=%s%s\n' "$(exec_quote "$dest")" "${exec_args:+ $exec_args}"
		printf 'TryExec=%s\n' "$dest"
		printf 'Icon=%s\n' "$icon_dest"
		printf 'Terminal=%s\n' "$([[ ${terminal:-} == true ]] && printf true || printf false)"
		[[ -z ${wmclass:-} ]] || printf 'StartupWMClass=%s\n' "$wmclass"
		printf 'X-Lyona-AppImage=%s\n' "$dest"
	} >"$ENTRY_DIR/$id.desktop.tmp"
	mv -fT -- "$ENTRY_DIR/$id.desktop.tmp" "$ENTRY_DIR/$id.desktop"
	moved_from=
	moved_to=
	refresh_entries
	notify "Added $name to the launcher" "Moved to $(shown "$APPS_DIR"). Remove it with: lyona-appimage remove \"$name\""
	integrated_path=$dest
}

# start DEST ARGS: started detached; one that fails within two seconds is
# reported, with the usual cause when it is missing.
start() { # DEST [ARGS...]
	local dest=$1 pid status=0 i label hint=
	shift
	# 9>&-: the AppImage must not inherit the open/remove lock, or it would hold
	# it for as long as it runs.
	if command -v setsid >/dev/null 2>&1; then
		setsid -- "$dest" "$@" >/dev/null 2>&1 </dev/null 9>&- &
	else
		"$dest" "$@" >/dev/null 2>&1 </dev/null 9>&- &
	fi
	pid=$!
	for ((i = 0; i < START_WATCH_TENTHS; i++)); do
		kill -0 "$pid" 2>/dev/null || break
		sleep 0.1
	done
	kill -0 "$pid" 2>/dev/null && return 0
	wait "$pid" || status=$?
	((status == 0)) && return 0
	label=$(clean "$(basename -- "$dest")")
	[[ $(ldconfig -p 2>/dev/null || :) == *libfuse.so.2* ]] ||
		hint=" It may need fuse2: sudo pacman -S fuse2."
	printf 'lyona-appimage: %s did not start (exit %s).%s\n' "$label" "$status" "$hint" >&2
	notify "$label did not start" "Run it from a terminal to see why: lyona-appimage open \"$dest\".$hint"
	exit 1
}

open_appimage() { # FILE [ARGS...]
	local file=$1
	shift
	command -v unsquashfs >/dev/null 2>&1 || fail "unsquashfs is missing (install squashfs-tools)"
	integrate "$file"
	[[ $choice == run ]] || return 0
	start "$integrated_path" "$@"
}

list_appimages() {
	local entry
	for entry in "$ENTRY_DIR/$ENTRY_PREFIX"*.desktop; do
		[[ -f $entry ]] || continue
		printf '%s\t%s\n' "$(key "$entry" Name)" "$(raw_key "$entry" X-Lyona-AppImage)"
	done
}

# remove NAME: by its launcher name (any case), its file name, or its path. A
# name two AppImages share is refused, with their file names to choose from.
# The file goes to the trash when it can.
remove_appimage() { # NAME
	local wanted=$1 entry name file icon apps icons gone
	local -a matches=()
	take_lock
	apps=$(realpath -m -- "$APPS_DIR")
	icons=$(realpath -m -- "$ICON_DIR")
	for entry in "$ENTRY_DIR/$ENTRY_PREFIX"*.desktop; do
		[[ -f $entry ]] || continue
		file=$(raw_key "$entry" X-Lyona-AppImage)
		if [[ $(basename -- "$file") == "$wanted" || $file == "$wanted" ]]; then
			matches=("$entry")
			break
		fi
		name=$(key "$entry" Name)
		[[ ${name,,} != "${wanted,,}" ]] || matches+=("$entry")
	done
	((${#matches[@]} > 0)) || fail "no AppImage named $wanted (see lyona-appimage list)"
	if ((${#matches[@]} > 1)); then
		for entry in "${matches[@]}"; do
			printf '  %s\n' "$(basename -- "$(raw_key "$entry" X-Lyona-AppImage)")" >&2
		done
		fail "${#matches[@]} AppImages are named $wanted; remove one by its file name, from the list above"
	fi
	entry=${matches[0]}
	name=$(key "$entry" Name)
	file=$(raw_key "$entry" X-Lyona-AppImage)
	gone="left in place (not in $APPS_DIR)"
	# Only what this added: a file in APPS_DIR and an icon in ICON_DIR.
	if [[ $(realpath -m -- "$(dirname -- "$file")") == "$apps" && -e $file ]]; then
		if command -v gio >/dev/null 2>&1 && gio trash -- "$file" >/dev/null 2>&1; then
			gone="moved to the trash"
		else
			rm -f -- "$file"
			gone=deleted
		fi
	fi
	icon=$(raw_key "$entry" Icon)
	[[ $icon != /* || $(realpath -m -- "$(dirname -- "$icon")") != "$icons" ]] || rm -f -- "$icon"
	rm -f -- "$entry"
	printf 'Removed %s from the launcher; %s %s\n' "${name:-$file}" "$file" "$gone"
	refresh_entries
}

case $action in
open)
	(($# >= 2)) || usage
	shift
	open_appimage "$@"
	;;
remove)
	(($# == 2)) || usage
	remove_appimage "$2"
	;;
list)
	(($# == 1)) || usage
	list_appimages
	;;
*) usage ;;
esac
