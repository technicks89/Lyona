#!/usr/bin/env bash
#
# Generate the Linux console palette from a lyona palette.
#
# The installer runs on a bare virtual terminal, which has sixteen colours and
# no truecolor. Those sixteen are not fixed, though: OSC P redefines them, so
# the console can be made to match the boot splash and the desktop that follows
# rather than showing stock VGA colours in between.
#
#     lyona-console-theme generate THEME_ID THEMES_FILE OUTFILE
#
# The output is a sourceable snippet defining lyona_console_colors. Slot 0 is
# the console background, so it takes term_bg rather than term_color0 -- that
# is what makes the background match the splash.

set -euo pipefail
export LC_ALL=C

die() {
	printf 'lyona-console-theme: %s\n' "$*" >&2
	exit 1
}

usage() {
	printf 'usage: lyona-console-theme generate THEME_ID THEMES_FILE OUTFILE\n' >&2
	exit 2
}

# Copied from its siblings rather than shared: none of them has a sourceable
# form, and a shared file would need an install path and a runtime lookup.
toml_get() {
	local section="$1" key="$2" file="$3"
	awk -v sec="[$section]" -v key="$key" '
		/^[[:space:]]*\[/ {
			header = $0
			sub(/^[[:space:]]*/, "", header)
			sub(/[[:space:]]*#.*/, "", header)
			sub(/[[:space:]]+$/, "", header)
			in_sec = (header == sec)
		}
		in_sec && $0 ~ "^[[:space:]]*" key "[[:space:]]*=" {
			sub(/^[^=]*=[[:space:]]*/, "")
			gsub(/"/, "")
			gsub(/[[:space:]]+#.*$/, "")
			sub(/[[:space:]]+$/, "")
			print; exit
		}
	' "$file"
}

valid_theme_id() {
	case ${1:-} in
	"" | *[/\\]* | *..* | *[[:space:]]*) return 1 ;;
	esac
	[[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]
}

# Lowercase RRGGBB, which is the only form the OSC P escape accepts.
hex_body() {
	local colour=$1
	[[ $colour =~ ^#[0-9A-Fa-f]{6}$ ]] || return 1
	printf '%s' "${colour:1}" | tr '[:upper:]' '[:lower:]'
}

generate_one() {
	local id=$1 file=$2 outfile=$3
	local section="theme.$id" index slot colour body
	local -a bodies=()

	valid_theme_id "$id" || die "unsafe theme id: $id"
	[[ -f $file ]] || die "themes file not found: $file"

	# Slot 0 is the background the console paints everything on.
	colour=$(toml_get "$section" term_bg "$file")
	body=$(hex_body "$colour") || die "theme '$id' has no usable term_bg"
	bodies[0]=$body

	for index in {1..15}; do
		colour=$(toml_get "$section" "term_color$index" "$file")
		body=$(hex_body "$colour") ||
			die "theme '$id' has no usable term_color$index"
		bodies[index]=$body
	done

	{
		printf '# Generated by lyona-console-theme from the %s palette. Do not edit.\n' "$id"
		printf '#\n'
		printf '# Repaints the sixteen console colours so the installer matches the boot\n'
		printf '# splash instead of stock VGA. A no-op anywhere but a real virtual\n'
		printf '# terminal, where the escape would otherwise be printed as text.\n'
		printf 'lyona_console_colors() {\n'
		# shellcheck disable=SC2016 # emitting literal shell, not expanding it
		printf '\tcase $(tty 2>/dev/null) in\n'
		printf '\t/dev/tty[0-9]*) ;;\n'
		printf '\t*) return 0 ;;\n'
		printf '\tesac\n'
		for index in {0..15}; do
			slot=$(printf '%X' "$index")
			printf "\tprintf '\\\\033]P%s%s'\n" "$slot" "${bodies[index]}"
		done
		printf "\tprintf '\\\\033[0m'\n"
		printf '\t# The new slot 0 only reaches the whole screen once it is repainted.\n'
		printf '\tclear\n'
		printf '}\n'
	} >"$outfile"
}

case ${1:-} in
generate)
	[[ $# -eq 4 ]] || usage
	generate_one "$2" "$3" "$4"
	;;
-h | --help | help) usage ;;
*) usage ;;
esac
