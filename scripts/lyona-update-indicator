#!/usr/bin/env bash
set -euo pipefail
# Everything this writes (the settings) is private to the user.
umask 077

# The panel's updates-available indicator (Sync Sprint 15 S15-02, decision
# D-25). It counts pending updates and changes nothing. System packages are
# counted by checkupdates (pacman-contrib), which syncs a private copy of the
# package databases and never takes pacman's lock; the shell counts the lyona
# release itself, through `lyona-update check`. The shell runs `check` a while
# after login, at the interval set here, and when its NetworkModel sees the
# connection come up (Sync Sprint 16 R16-34); by hand, only from Settings.
#
#   lyona-update-indicator check                       one parsed result
#   lyona-update-indicator status                      the settings
#   lyona-update-indicator set-interval 1|3|6|12|24    hours between checks
#   lyona-update-indicator set-show-when-current yes|no
#   lyona-update-indicator set-float-terminal yes|no   float the update terminal
#
# check prints, after the header, one line per provider (system packages, then
# Flatpak apps, S15-03), then a completion line:
#   update-indicator-protocol  1  0
#   provider  system|flatpak  available|current|unavailable|error  COUNT  DETAIL
#   complete  check
# status prints the settings, and whether window-rules.toml has the rule that
# floats the update terminal (S15-04; never added to a user's file for them):
#   update-indicator-protocol  1  0
#   setting  interval-hours  HOURS
#   setting  show-when-current  yes|no
#   setting  float-terminal  yes|no
#   setting  float-rule  present|missing
#   complete  status

# A checkout keeps the shared shell code beside the scripts; an install keeps it
# in PREFIX/lib/lyona, beside PREFIX/bin (Sync Sprint 12 S12-13).
lyona_lib=${BASH_SOURCE[0]%/*}
[[ -f $lyona_lib/dwm-xdg.sh ]] || lyona_lib=${lyona_lib%bin}lib/lyona
# shellcheck source=scripts/dwm-xdg.sh
. "$lyona_lib/dwm-xdg.sh"
lyona_xdg_dirs
# shellcheck source=scripts/dwm-paths.sh
. "$lyona_lib/dwm-paths.sh"

config_file=$config_home/lyona/update-indicator.conf
rules_file=$config_home/lyona/window-rules.toml
# The window class the update terminal gets when it should float, and the rule
# in config/window-rules.toml that floats it (lyona-update-terminal).
readonly float_class=lyona-update-float
readonly protocol_header=$'update-indicator-protocol\t1\t0'
readonly intervals='1 3 6 12 24'
readonly default_interval=6
# checkupdates downloads the repository databases; a stalled mirror must not
# hold the check open.
readonly check_seconds=180

die() {
	printf 'lyona-update-indicator: %s\n' "$*" >&2
	exit 1
}

help_text() {
	cat <<'EOF'
Usage: lyona-update-indicator COMMAND

The panel's updates-available count: system packages, Flatpak apps and lyona.

  check                        Counts what can be updated now.
  status                       Prints the last count and the settings.
  set-interval 1|3|6|12|24     How often, in hours, the panel checks.
  set-show-when-current yes|no Keeps the panel icon when nothing is waiting.
  set-float-terminal yes|no    Opens update terminals as floating windows.
EOF
}

usage() {
	help_text >&2
	exit 2
}

valid_interval() {
	[[ " $intervals " == *" $1 "* ]]
}

read_setting() { # KEY DEFAULT
	local line value=$2
	[[ -f $config_file && ! -L $config_file ]] || {
		printf '%s' "$value"
		return
	}
	while IFS= read -r line || [[ -n $line ]]; do
		[[ $line == "$1="* ]] && value=${line#*=}
	done <"$config_file"
	printf '%s' "$value"
}

# The settings as they apply: a missing, hand-edited or unknown value is the
# default, never an error.
interval_setting() {
	local value
	value=$(read_setting interval-hours "$default_interval")
	valid_interval "$value" || value=$default_interval
	printf '%s' "$value"
}

show_setting() {
	local value
	value=$(read_setting show-when-current no)
	[[ $value == yes ]] || value=no
	printf '%s' "$value"
}

float_setting() {
	local value
	value=$(read_setting float-terminal no)
	[[ $value == yes ]] || value=no
	printf '%s' "$value"
}

# A rule for the float class that floats it, as dwm reads the file: through
# lyona-toml, the one TOML reader (D-20; Sync Sprint 16 R16-44), so a rule dwm
# would not see (a comment, a typo, a table it drops) does not count. The dump
# is "rules<TAB>INDEX<TAB>KEY<TAB>VALUE", one line per key.
float_rule() {
	local dump=
	# Status 4 (entries past dwm's limit dropped) still dumps what dwm reads.
	[[ -f $rules_file && ! -L $rules_file ]] && dump=$(lyona_toml dump "$rules_file" 2>/dev/null) || :
	if awk -F '\t' -v class="$float_class" '
		$1 == "rules" && $3 == "class" && $4 == class { named[$2] = 1 }
		$1 == "rules" && $3 == "isfloating" && $4 == "1" { floats[$2] = 1 }
		END { for (i in named) if (i in floats) found = 1; exit !found }' <<<"$dump"; then
		printf present
	else
		printf missing
	fi
}

write_settings() { # INTERVAL SHOW FLOAT
	local temporary
	[[ ! -L $config_file ]] || die 'refusing to replace a symlinked update-indicator.conf'
	mkdir -p -- "${config_file%/*}"
	temporary=$(mktemp "${config_file%/*}/.update-indicator.conf.XXXXXX") ||
		die 'cannot write the update indicator settings'
	if ! printf 'interval-hours=%s\nshow-when-current=%s\nfloat-terminal=%s\n' "$1" "$2" "$3" >"$temporary" ||
		! chmod 600 -- "$temporary" || ! mv -fT -- "$temporary" "$config_file"; then
		rm -f -- "$temporary"
		die 'cannot write the update indicator settings'
	fi
}

status() {
	printf '%s\n' "$protocol_header"
	printf 'setting\tinterval-hours\t%s\n' "$(interval_setting)"
	printf 'setting\tshow-when-current\t%s\n' "$(show_setting)"
	printf 'setting\tfloat-terminal\t%s\n' "$(float_setting)"
	printf 'setting\tfloat-rule\t%s\n' "$(float_rule)"
	printf 'complete\tstatus\n'
}

# checkupdates exits 0 with one line per pending update, 2 when there is none,
# and 1 when the check itself failed.
system_provider() {
	local output status=0 count
	if ! command -v checkupdates >/dev/null 2>&1; then
		printf 'provider\tsystem\tunavailable\t0\tInstall pacman-contrib to count package updates\n'
		return
	fi
	output=$(timeout --kill-after=10 "$check_seconds" checkupdates --nocolor 2>/dev/null) || status=$?
	case $status in
	0)
		count=$(printf '%s\n' "$output" | awk 'NF { n++ } END { print n + 0 }')
		if ((count > 0)); then
			printf 'provider\tsystem\tavailable\t%d\t%d package updates\n' "$count" "$count"
		else
			printf 'provider\tsystem\tcurrent\t0\tPackages are up to date\n'
		fi
		;;
	2) printf 'provider\tsystem\tcurrent\t0\tPackages are up to date\n' ;;
	124 | 137) printf 'provider\tsystem\terror\t0\tThe package check timed out; it will be tried again\n' ;;
	*) printf 'provider\tsystem\terror\t0\tThe package check failed; it will be tried again\n' ;;
	esac
}

# Flatpak apps (Sync Sprint 15 S15-03), each installation scope on its own: a
# scope that fails is named, and never read as up to date. Flatpak not being
# installed is not an error. Without a terminal, remote-ls prints one
# tab-separated row per pending update and no header.
flatpak_provider() {
	local scope output status count total=0 failed=()
	if ! command -v flatpak >/dev/null 2>&1; then
		printf 'provider\tflatpak\tunavailable\t0\tFlatpak is not installed\n'
		return
	fi
	for scope in system user; do
		status=0
		output=$(timeout --kill-after=10 "$check_seconds" \
			flatpak remote-ls --updates "--$scope" --columns=application,branch </dev/null 2>/dev/null) || status=$?
		if ((status != 0)); then
			failed+=("$scope")
			continue
		fi
		count=$(printf '%s\n' "$output" | awk 'NF { n++ } END { print n + 0 }')
		total=$((total + count))
	done
	if ((${#failed[@]} > 0)); then
		printf 'provider\tflatpak\terror\t0\tThe Flatpak check failed for the %s installation; it will be tried again\n' \
			"${failed[*]}"
	elif ((total > 0)); then
		printf 'provider\tflatpak\tavailable\t%d\t%d Flatpak updates\n' "$total" "$total"
	else
		printf 'provider\tflatpak\tcurrent\t0\tFlatpak apps are up to date\n'
	fi
}

check() {
	printf '%s\n' "$protocol_header"
	system_provider
	flatpak_provider
	printf 'complete\tcheck\n'
}

# NetworkManager's StateChanged signal, through GDBus: a machine interface, not
# nmcli's text. 70 is NM_STATE_CONNECTED_GLOBAL.
case ${1:-} in
-h | --help)
	help_text
	exit 0
	;;
check)
	(($# == 1)) || usage
	check
	;;
status)
	(($# == 1)) || usage
	status
	;;
set-interval)
	(($# == 2)) || usage
	valid_interval "$2" || die "the interval must be one of: $intervals (hours)"
	write_settings "$2" "$(show_setting)" "$(float_setting)"
	status
	;;
set-show-when-current)
	(($# == 2)) || usage
	[[ $2 == yes || $2 == no ]] || die 'show-when-current must be yes or no'
	write_settings "$(interval_setting)" "$2" "$(float_setting)"
	status
	;;
set-float-terminal)
	(($# == 2)) || usage
	[[ $2 == yes || $2 == no ]] || die 'float-terminal must be yes or no'
	write_settings "$(interval_setting)" "$(show_setting)" "$2"
	status
	;;
*) usage ;;
esac
