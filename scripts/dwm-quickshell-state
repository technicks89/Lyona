#!/bin/sh
set -eu

print_default_names() {
	count=${1:-9}
	i=1
	sep=
	while [ "$i" -le "$count" ]; do
		printf '%s%s' "$sep" "$i"
		sep='|'
		i=$((i + 1))
	done
}

clean_line() {
	tr '\r\n' '  ' | sed 's/[[:space:]][[:space:]]*/ /g; s/^ //; s/ $//'
}

root_property_value() {
	prop=$1
	xprop -root "$prop" 2>/dev/null |
		sed -n -e 's/^[^=]*= //p' -e 's/^[^:]*: window id # //p'
}

root_status() {
	xprop -root WM_NAME 2>/dev/null |
		awk -F'= ' '
			/^WM_NAME/ {
				status = $2
				gsub(/^"/, "", status)
				gsub(/"$/, "", status)
				print status
				found = 1
				exit
			}
			END {
				if (!found) {
					print ""
				}
			}
		' | clean_line
}

desktop_names() {
	names=$(root_property_value _NET_DESKTOP_NAMES | awk '
		BEGIN { RS = ","; sep = "" }
		{
			gsub(/^[[:space:]]*"/, "")
			gsub(/"[[:space:]]*$/, "")
			if ($0 != "") {
				printf "%s%s", sep, $0
				sep = "|"
			}
		}
	')
	if [ -n "$names" ]; then
		printf '%s' "$names"
	else
		print_default_names "$1"
	fi
}

active_window_id() {
	xdotool getactivewindow 2>/dev/null || {
		root_property_value _NET_ACTIVE_WINDOW |
			awk '$1 != "0x0" { print $1; exit }'
	}
}

client_snapshot() {
	client_list=$1
	[ -n "$client_list" ] || {
		printf 'occupied=\napps=\n'
		return 0
	}

	{
		snapshot_ifs=$IFS
		IFS=','
		for window_id in $client_list; do
			window_id=${window_id##* }
			[ -n "$window_id" ] || continue
			printf 'LYONA-WINDOW %s\n' "$window_id"
			xprop -id "$window_id" _NET_WM_DESKTOP _NET_WM_PID WM_CLASS 2>/dev/null || true
		done
		IFS=$snapshot_ifs
	} | awk '
		function owner_uid(process_id,   line, parts, uid, status_path) {
			uid = -1
			status_path = "/proc/" process_id "/status"
			while ((getline line < status_path) > 0) {
				if (line ~ /^Uid:/) {
					split(line, parts, /[[:space:]]+/)
					uid = parts[2]
					break
				}
			}
			close(status_path)
			return uid
		}
		function flush(   value) {
			if (window == "") {
				return
			}
			if (desktop != "" && desktop ~ /^[0-9]+$/ && desktop != 4294967295) {
				desktops[desktop] = 1
			}
			if (class != "" && !(pid != "" && owner_uid(pid) == 0)) {
				if (!((("|" class "|")) in seen)) {
					seen["|" class "|"] = 1
					value = window ":" class
					apps[++napps] = value
				}
			}
			window = ""; desktop = ""; pid = ""; class = ""
		}
		/^LYONA-WINDOW / { flush(); window = $2; next }
		/^_NET_WM_DESKTOP/ { sub(/^[^=]*= */, ""); desktop = $0; next }
		/^_NET_WM_PID/ { sub(/^[^=]*= */, ""); pid = $0; next }
		/^WM_CLASS/ {
			sub(/^[^=]*= */, "")
			gsub(/"/, "")
			split($0, classes, /, /)
			class = tolower(classes[2])
			next
		}
		END {
			flush()

			ndesktops = 0
			for (key in desktops) {
				sorted[++ndesktops] = key + 0
			}
			for (i = 2; i <= ndesktops; i++) {
				value = sorted[i]
				for (j = i - 1; j >= 1 && sorted[j] > value; j--) {
					sorted[j + 1] = sorted[j]
				}
				sorted[j + 1] = value
			}
			out = ""
			for (i = 1; i <= ndesktops; i++) {
				out = out (i > 1 ? "|" : "") sorted[i]
			}
			printf "occupied=%s\n", out

			out = ""
			for (i = 1; i <= napps; i++) {
				out = out (i > 1 ? "|" : "") apps[i]
			}
			printf "apps=%s\n", out
		}
	'
}

fullscreen_monitors() {
	root_property_value _DWM_FULLSCREEN_MONITORS |
		tr ',' '\n' |
		awk '$1 ~ /^[0-9]+$/ { print $1 }' |
		sort -nu |
		paste -sd '|' -
}

window_title() {
	window_id=$1
	[ -n "$window_id" ] || return 1
	xprop -id "$window_id" _NET_WM_NAME WM_NAME 2>/dev/null |
		awk -F'= ' '
			/^_NET_WM_NAME/ {
				title = $2
				gsub(/^"/, "", title)
				gsub(/"$/, "", title)
				print title
				found = 1
				exit
			}
			/^WM_NAME/ {
				title = $2
				gsub(/^"/, "", title)
				gsub(/"$/, "", title)
				fallback = title
			}
			END {
				if (!found && fallback != "") {
					print fallback
				}
			}
		' | clean_line
}

window_class() {
	window_id=$1
	[ -n "$window_id" ] || return 1
	xprop -id "$window_id" WM_CLASS 2>/dev/null |
		awk -F'= ' '/^WM_CLASS/ { gsub(/"/, "", $2); split($2, classes, /, /); print tolower(classes[2]); exit }'
}

root_snapshot() {
	xprop -root \
		_NET_CURRENT_DESKTOP \
		_NET_NUMBER_OF_DESKTOPS \
		_NET_DESKTOP_NAMES \
		_NET_CLIENT_LIST \
		_DWM_FULLSCREEN_MONITORS \
		_DWM_MONITOR_DESKTOPS \
		_DWM_SELECTED_MONITOR \
		WM_NAME 2>/dev/null |
		awk '
			function value(   text) {
				text = $0
				sub(/^[^=:]*(\([^)]*\))?[:=][[:space:]]*/, "", text)
				sub(/^window id # /, "", text)
				return text
			}
			function collapse(text) {
				gsub(/[\r\n\t]/, " ", text)
				gsub(/[[:space:]]+/, " ", text)
				sub(/^ /, "", text)
				sub(/ $/, "", text)
				return text
			}
			function unquote(text) {
				sub(/^"/, "", text)
				sub(/"$/, "", text)
				return text
			}
			/^_NET_CURRENT_DESKTOP/ { split(value(), f, /[[:space:]]+/); current = f[1]; next }
			/^_NET_NUMBER_OF_DESKTOPS/ { split(value(), f, /[[:space:]]+/); count = f[1]; next }
			/^_NET_DESKTOP_NAMES/ {
				n = split(value(), parts, /,[[:space:]]*/)
				names = ""
				for (i = 1; i <= n; i++) {
					entry = unquote(parts[i])
					if (entry != "") {
						names = names (names == "" ? "" : "|") entry
					}
				}
				next
			}
			/^_NET_CLIENT_LIST/ { clients = value(); next }
			/^_DWM_FULLSCREEN_MONITORS/ {
				n = split(value(), parts, /,[[:space:]]*/)
				delete seen
				nfull = 0
				for (i = 1; i <= n; i++) {
					entry = unquote(parts[i])
					if (entry !~ /^[[:space:]]*[0-9]+[[:space:]]*$/) {
						continue
					}
					entry = entry + 0
					if (!(entry in seen)) {
						seen[entry] = 1
						full[++nfull] = entry
					}
				}
				for (i = 2; i <= nfull; i++) {
					pivot = full[i]
					for (j = i - 1; j >= 1 && full[j] > pivot; j--) {
						full[j + 1] = full[j]
					}
					full[j + 1] = pivot
				}
				fullscreen = ""
				for (i = 1; i <= nfull; i++) {
					fullscreen = fullscreen (i > 1 ? "|" : "") full[i]
				}
				next
			}
			/^_DWM_MONITOR_DESKTOPS/ { desktops = value(); gsub(/[[:space:]"]/, "", desktops); next }
			/^_DWM_SELECTED_MONITOR/ { split(value(), f, /[[:space:]]+/); selected = f[1]; next }
			/^WM_NAME/ { status = collapse(unquote(value())); next }
			END {
				printf "%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n",
					current, count, names, clients, fullscreen, desktops, selected, status
			}
		'
}

show_state() {
	{
		IFS= read -r current
		IFS= read -r count
		IFS= read -r names
		IFS= read -r clients
		IFS= read -r fullscreen_monitors
		IFS= read -r monitor_desktops
		IFS= read -r focused_monitor
		IFS= read -r status
	} <<ROOT_SNAPSHOT
$(root_snapshot)
ROOT_SNAPSHOT

	current=${current:-0}
	count=${count:-9}
	[ -n "$names" ] || names=$(print_default_names "$count")
	window_id=$(active_window_id)
	title=$(window_title "$window_id" || true)
	title=${title:-Desktop}
	class=$(window_class "$window_id" || true)
	class=${class:-application-x-executable}
	occupied=
	apps=
	snapshot=$(client_snapshot "$clients")
	occupied=${snapshot%%
*}
	occupied=${occupied#occupied=}
	apps=${snapshot#*
}
	apps=${apps#apps=}
	monitor_desktops=${monitor_desktops:-$current}

	printf 'current=%s\n' "$current"
	printf 'monitor_desktops=%s\n' "$monitor_desktops"
	printf 'focused_monitor=%s\n' "$focused_monitor"
	printf 'count=%s\n' "$count"
	printf 'names=%s\n' "$names"
	printf 'occupied=%s\n' "$occupied"
	printf 'fullscreen_monitors=%s\n' "$fullscreen_monitors"
	printf 'apps=%s\n' "$apps"
	printf 'active_window=%s\n' "$window_id"
	printf 'title=%s\n' "$title"
	printf 'class=%s\n' "$class"
	printf 'status=%s\n' "$status"
}

watch_state() {
	show_state
	printf '\n'

	if xprop -root _DWM_MONITOR_DESKTOPS >/dev/null 2>&1; then
		xprop -root -spy \
			DWM_TAG_UPDATE \
			_DWM_MONITOR_DESKTOPS \
			_DWM_SELECTED_MONITOR \
			_NET_NUMBER_OF_DESKTOPS \
			_NET_DESKTOP_NAMES \
			_NET_ACTIVE_WINDOW \
			_NET_CLIENT_LIST \
			_DWM_FULLSCREEN_MONITORS \
			WM_NAME 2>/dev/null
	else
		xprop -root -spy \
			DWM_TAG_UPDATE \
			_NET_CURRENT_DESKTOP \
			_NET_NUMBER_OF_DESKTOPS \
			_NET_DESKTOP_NAMES \
			_NET_ACTIVE_WINDOW \
			_NET_CLIENT_LIST \
			_DWM_FULLSCREEN_MONITORS \
			WM_NAME 2>/dev/null
	fi |
		while IFS= read -r _event; do
			show_state
			printf '\n'
		done
}

switch_workspace() {
	target=${1:-}
	case $target in
	'' | *[!0-9]*)
		printf 'usage: %s switch <zero-based-workspace>\n' "$0" >&2
		return 2
		;;
	esac
	if command -v xdotool >/dev/null 2>&1; then
		xdotool set_desktop "$target"
	elif command -v wmctrl >/dev/null 2>&1; then
		wmctrl -s "$target"
	else
		printf 'xdotool or wmctrl is required for workspace switching\n' >&2
		return 127
	fi
}

focus_window() {
	target=${1:-}
	case $target in
	0x[0-9a-fA-F]* | [0-9]*) ;;
	*)
		printf 'usage: %s focus <window-id>\n' "$0" >&2
		return 2
		;;
	esac
	if command -v xdotool >/dev/null 2>&1; then
		xdotool windowactivate "$target"
	elif command -v wmctrl >/dev/null 2>&1; then
		wmctrl -ia "$target"
	else
		printf 'xdotool or wmctrl is required for window focus\n' >&2
		return 127
	fi
}

case ${1:-state} in
state)
	show_state
	;;
watch)
	watch_state
	;;
switch)
	switch_workspace "${2:-}"
	;;
focus)
	focus_window "${2:-}"
	;;
*)
	printf 'usage: %s [state|watch|switch <zero-based-workspace>|focus <window-id>]\n' "$0" >&2
	exit 2
	;;
esac
