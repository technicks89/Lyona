#!/bin/bash
# Bash for watch: read -t with a fractional timeout, EPOCHREALTIME and an
# associative array of per-window watchers.
set -euo pipefail

# A checkout keeps the shared shell code beside the scripts; an install keeps it
# in PREFIX/lib/lyona, beside PREFIX/bin (Sync Sprint 12 S12-13).
lyona_lib=${BASH_SOURCE[0]%/*}
[[ -f $lyona_lib/dwm-watchdog.sh ]] || lyona_lib=${lyona_lib%bin}lib/lyona
# shellcheck source=scripts/dwm-watchdog.sh
. "$lyona_lib/dwm-watchdog.sh"

print_default_names() {
	count=${1:-9}
	i=1
	sep=
	while [ "$i" -le "$count" ]; do
		printf '%s%s' "$sep" "$i"
		sep='|'
		i=$((i + 1))
	done
}

clean_line() {
	tr '\r\n' '  ' | sed 's/[[:space:]][[:space:]]*/ /g; s/^ //; s/ $//'
}

root_property_value() {
	prop=$1
	xprop -root "$prop" 2>/dev/null |
		sed -n -e 's/^[^=]*= //p' -e 's/^[^:]*: window id # //p'
}

root_status() {
	xprop -root WM_NAME 2>/dev/null |
		awk -F'= ' '
			/^WM_NAME/ {
				status = $2
				gsub(/^"/, "", status)
				gsub(/"$/, "", status)
				print status
				found = 1
				exit
			}
			END {
				if (!found) {
					print ""
				}
			}
		' | clean_line
}

desktop_names() {
	names=$(root_property_value _NET_DESKTOP_NAMES | awk '
		BEGIN { RS = ","; sep = "" }
		{
			gsub(/^[[:space:]]*"/, "")
			gsub(/"[[:space:]]*$/, "")
			if ($0 != "") {
				printf "%s%s", sep, $0
				sep = "|"
			}
		}
	')
	if [ -n "$names" ]; then
		printf '%s' "$names"
	else
		print_default_names "$1"
	fi
}

# The parser for client_snapshot and client_snapshot_one: xprop output for
# each window, after a "LYONA-WINDOW ID" line or, for one window, with the id
# given as first.
# shellcheck disable=SC2016 # an awk program: its $ fields are awk's
client_snapshot_awk='
	# One window, given as first, has no LYONA-WINDOW line before it.
	BEGIN { window = first }
	function sanitize_title(value) {
		gsub(/\|/, " ", value)
		gsub(/[\t\r\n]/, " ", value)
		gsub(/  +/, " ", value)
		sub(/^ /, "", value)
		sub(/ $/, "", value)
		return value
	}
	# A WM_CLASS is not free text like a title: unlike sanitize_title,
	# whose lossy space-replacement is fine for display, a class needs to
	# round-trip exactly (it feeds Icons.launcherIcon lookups and is
	# matched against elsewhere), so a "%"/":"/"|" collision with this
	# wire format own separators is escaped rather than destroyed --
	# percent-encoded the way encodeURIComponent would, and decoded back
	# on the QML side via DwmStateWindows.js decodeClass. "%" must be
	# escaped first so the "%" introduced by escaping ":"/"|" is never
	# itself re-escaped.
	function sanitize_class(value) {
		gsub(/%/, "%25", value)
		gsub(/:/, "%3A", value)
		gsub(/\|/, "%7C", value)
		return value
	}
	function reset() {
		window = ""; desktop = ""; class = ""; title = ""; raw_title = ""; have_net_wm_name = 0; dock = 0
	}
	function flush(   value) {
		if (window == "") {
			return
		}
		# A dock is the panel or the tray, which dwm lists in _NET_CLIENT_LIST
		# with its clients (EWMH allows it): not a window to switch to, so it
		# stays out of the overview and the task list. Its preferred (first)
		# type decides, as dwm isaltbar() reads it.
		if (dock) {
			skipped[++nskipped] = window
			reset()
			return
		}
		if (desktop != "" && desktop ~ /^[0-9]+$/ && desktop != 4294967295) {
			desktops[desktop] = 1
		}
		# Every managed window is listed. Windows whose _NET_WM_PID named a
		# root-owned process used to be left out, which a client could claim
		# to hide from the overview and the task list, and which hid real
		# root GUI tools (Sync Sprint 12 S12-12).
		value = window ":" desktop ":" class ":" sanitize_title(title)
		windows[++nwindows] = value
		full_titles[nwindows] = window " " full_title(raw_title)
		if (class != "") {
			if (!((("|" class "|")) in seen)) {
				seen["|" class "|"] = 1
				value = window ":" class
				apps[++napps] = value
			}
		}
		reset()
	}
	# The title as the panel shows it (#283): the "|" that windows= cannot
	# carry is kept, and only whitespace is collapsed, as window_title does.
	function full_title(value) {
		sub(/^"/, "", value)
		sub(/"$/, "", value)
		gsub(/[[:space:]]+/, " ", value)
		sub(/^ /, "", value)
		sub(/ $/, "", value)
		return value
	}
	/^LYONA-WINDOW / { flush(); window = $2; next }
	/^_NET_WM_DESKTOP/ { sub(/^[^=]*= */, ""); desktop = $0; next }
	/^_NET_WM_WINDOW_TYPE\(/ {
		sub(/^[^=]*= */, "")
		split($0, types, /, /)
		dock = types[1] == "_NET_WM_WINDOW_TYPE_DOCK"
		next
	}
	/^WM_CLASS/ {
		sub(/^[^=]*= */, "")
		gsub(/"/, "")
		split($0, classes, /, /)
		class = sanitize_class(tolower(classes[2]))
		next
	}
	# A property the window does not set prints "PROP:  not found." (no
	# "(" after the name), never a real value; only a line with "(" is a
	# genuine title, the same distinction window_title() makes with its
	# own -F"= " split (where a "not found" line leaves $2 empty).
	/^_NET_WM_NAME\(/ {
		sub(/^[^=]*= */, "")
		raw_title = $0
		gsub(/"/, "")
		title = $0
		have_net_wm_name = 1
		next
	}
	/^WM_NAME\(/ {
		if (!have_net_wm_name) {
			sub(/^[^=]*= */, "")
			raw_title = $0
			gsub(/"/, "")
			title = $0
		}
		next
	}
	END {
		flush()

		ndesktops = 0
		for (key in desktops) {
			sorted[++ndesktops] = key + 0
		}
		for (i = 2; i <= ndesktops; i++) {
			value = sorted[i]
			for (j = i - 1; j >= 1 && sorted[j] > value; j--) {
				sorted[j + 1] = sorted[j]
			}
			sorted[j + 1] = value
		}
		out = ""
		for (i = 1; i <= ndesktops; i++) {
			out = out (i > 1 ? "|" : "") sorted[i]
		}
		printf "occupied=%s\n", out

		out = ""
		for (i = 1; i <= napps; i++) {
			out = out (i > 1 ? "|" : "") apps[i]
		}
		printf "apps=%s\n", out

		out = ""
		for (i = 1; i <= nwindows; i++) {
			out = out (i > 1 ? "|" : "") windows[i]
		}
		printf "windows=%s\n", out
		# Then the full title of every window, "title ID TEXT", for the active
		# window title= line.
		for (i = 1; i <= nwindows; i++) {
			printf "title %s\n", full_titles[i]
		}
		# Last, so the occupied, apps and windows lines stay first: the docks
		# left out, for the per-window cache to remember.
		for (i = 1; i <= nskipped; i++) {
			printf "skip %s\n", skipped[i]
		}
	}
'

# The windows' properties, each after a "LYONA-WINDOW ID" line.
client_window_props() {
	local window_id IFS=,
	for window_id in $1; do
		window_id=${window_id##* }
		[ -n "$window_id" ] || continue
		printf 'LYONA-WINDOW %s\n' "$window_id"
		xprop -id "$window_id" _NET_WM_DESKTOP _NET_WM_WINDOW_TYPE WM_CLASS _NET_WM_NAME WM_NAME 2>/dev/null || true
	done
}

client_snapshot() {
	client_list=$1
	[ -n "$client_list" ] || {
		printf 'occupied=\napps=\nwindows=\n'
		return 0
	}
	awk -v first= "$client_snapshot_awk" < <(client_window_props "$client_list")
}

# One window: each side is a single command, which bash runs without a fork of
# its own, so a changed window costs two processes, xprop and awk (#283).
client_snapshot_one() {
	awk -v first="$1" "$client_snapshot_awk" < <(xprop -id "$1" _NET_WM_DESKTOP _NET_WM_WINDOW_TYPE WM_CLASS _NET_WM_NAME WM_NAME 2>/dev/null)
}

fullscreen_monitors() {
	root_property_value _DWM_FULLSCREEN_MONITORS |
		tr ',' '\n' |
		awk '$1 ~ /^[0-9]+$/ { print $1 }' |
		sort -nu |
		paste -sd '|' -
}

window_title() {
	window_id=$1
	[ -n "$window_id" ] || return 1
	xprop -id "$window_id" _NET_WM_NAME WM_NAME 2>/dev/null |
		awk -F'= ' '
			/^_NET_WM_NAME/ {
				title = $2
				gsub(/^"/, "", title)
				gsub(/"$/, "", title)
				print title
				found = 1
				exit
			}
			/^WM_NAME/ {
				title = $2
				gsub(/^"/, "", title)
				gsub(/"$/, "", title)
				fallback = title
			}
			END {
				if (!found && fallback != "") {
					print fallback
				}
			}
		' | clean_line
}

window_class() {
	window_id=$1
	[ -n "$window_id" ] || return 1
	xprop -id "$window_id" WM_CLASS 2>/dev/null |
		awk -F'= ' '
			# Same scheme as client_snapshot() own sanitize_class(): this
			# feeds the single active window class= line, which shares
			# DwmState.qml activeWindowClass parsing with DwmStateWindows.js
			# decodeClass(), so both must escape the same way for a WM_CLASS
			# containing "%"/":"/"|" to round-trip.
			function sanitize_class(value) {
				gsub(/%/, "%25", value)
				gsub(/:/, "%3A", value)
				gsub(/\|/, "%7C", value)
				return value
			}
			/^WM_CLASS/ { gsub(/"/, "", $2); split($2, classes, /, /); print sanitize_class(tolower(classes[2])); exit }
		'
}

# Each side is a single command, which bash runs without a fork of its own:
# with the caller's < <(...), the root costs two processes (#283).
root_snapshot() {
	awk '
		function value(   text) {
			text = $0
			sub(/^[^=:]*(\([^)]*\))?[:=][[:space:]]*/, "", text)
			sub(/^window id # /, "", text)
			return text
		}
		function collapse(text) {
			gsub(/[\r\n\t]/, " ", text)
			gsub(/[[:space:]]+/, " ", text)
			sub(/^ /, "", text)
			sub(/ $/, "", text)
			return text
		}
		function unquote(text) {
			sub(/^"/, "", text)
			sub(/"$/, "", text)
			return text
		}
		# An unset property prints "NAME:  not found." (or "no such atom on
		# any window." for an atom nobody has created): no value.
		/^[A-Za-z_]+:[[:space:]]+(not found|no such atom on any window)\.$/ { next }
		/^_NET_CURRENT_DESKTOP/ { split(value(), f, /[[:space:]]+/); current = f[1]; next }
		/^_NET_NUMBER_OF_DESKTOPS/ { split(value(), f, /[[:space:]]+/); count = f[1]; next }
		/^_NET_DESKTOP_NAMES/ {
			n = split(value(), parts, /,[[:space:]]*/)
			names = ""
			for (i = 1; i <= n; i++) {
				entry = unquote(parts[i])
				if (entry != "") {
					names = names (names == "" ? "" : "|") entry
				}
			}
			next
		}
		/^_NET_CLIENT_LIST/ { clients = value(); next }
		/^_DWM_FULLSCREEN_MONITORS/ {
			n = split(value(), parts, /,[[:space:]]*/)
			delete seen
			nfull = 0
			for (i = 1; i <= n; i++) {
				entry = unquote(parts[i])
				if (entry !~ /^[[:space:]]*[0-9]+[[:space:]]*$/) {
					continue
				}
				entry = entry + 0
				if (!(entry in seen)) {
					seen[entry] = 1
					full[++nfull] = entry
				}
			}
			for (i = 2; i <= nfull; i++) {
				pivot = full[i]
				for (j = i - 1; j >= 1 && full[j] > pivot; j--) {
					full[j + 1] = full[j]
				}
				full[j + 1] = pivot
			}
			fullscreen = ""
			for (i = 1; i <= nfull; i++) {
				fullscreen = fullscreen (i > 1 ? "|" : "") full[i]
			}
			next
		}
		/^_DWM_MONITOR_DESKTOPS/ { desktops = value(); gsub(/[[:space:]"]/, "", desktops); next }
		/^_DWM_SELECTED_MONITOR/ { split(value(), f, /[[:space:]]+/); selected = f[1]; next }
		# The selected window of each monitor, by logical index; "" for none.
		/^_DWM_MONITOR_WINDOWS/ {
			n = split(value(), f, /[[:space:],]+/)
			monitor_windows = ""
			for (i = 1; i <= n; i++) {
				id = (f[i] ~ /^0x[0-9a-fA-F]+$/ && f[i] !~ /^0x0+$/) ? f[i] : ""
				monitor_windows = monitor_windows (i > 1 ? "|" : "") id
			}
			next
		}
		/^_DWM_LAYOUT/ { split(value(), f, /[[:space:]]+/); layout = f[1]; next }
		# The active window, read here rather than by another process per
		# rebuild (#283); 0x0 is "none".
		/^_NET_ACTIVE_WINDOW/ {
			split(value(), f, /[[:space:],]+/)
			if (f[1] ~ /^0x[0-9a-fA-F]+$/ && f[1] != "0x0") active = f[1]
			next
		}
		/^WM_NAME/ { status = collapse(unquote(value())); next }
		END {
			printf "%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n",
				current, count, names, clients, fullscreen, desktops, selected, layout, status, active,
				monitor_windows
		}
	' < <(xprop -root _NET_CURRENT_DESKTOP _NET_NUMBER_OF_DESKTOPS _NET_DESKTOP_NAMES _NET_CLIENT_LIST _DWM_FULLSCREEN_MONITORS _DWM_MONITOR_DESKTOPS _DWM_SELECTED_MONITOR _DWM_MONITOR_WINDOWS _DWM_LAYOUT _NET_ACTIVE_WINDOW WM_NAME 2>/dev/null)
}

show_state() {
	local -a root_fields=()
	mapfile -t root_fields < <(root_snapshot)
	current=${root_fields[0]:-}
	count=${root_fields[1]:-}
	names=${root_fields[2]:-}
	clients=${root_fields[3]:-}
	fullscreen_monitors=${root_fields[4]:-}
	monitor_desktops=${root_fields[5]:-}
	focused_monitor=${root_fields[6]:-}
	layout=${root_fields[7]:-}
	status=${root_fields[8]:-}
	window_id=${root_fields[9]:-}
	monitor_windows=${root_fields[10]:-}

	current=${current:-0}
	count=${count:-9}
	[ -n "$names" ] || names=$(print_default_names "$count")
	occupied=
	apps=
	windows=
	local line entry title='' class='' found=0
	local -a entries=()
	if [[ ${state_cache:-0} == 1 ]]; then
		cached_client_snapshot "$clients"
		[[ -z $window_id || -z ${title_cache[$window_id]+set} ]] || title=${title_cache[$window_id]}
	else
		snapshot=$(client_snapshot "$clients")
		while IFS= read -r line; do
			[[ $line == "title $window_id "* ]] && title=${line#"title $window_id "}
		done <<<"$snapshot"
	fi
	occupied=${snapshot%%
*}
	occupied=${occupied#occupied=}
	rest=${snapshot#*
}
	apps=${rest%%
*}
	apps=${apps#apps=}
	windows=${rest#*
}
	windows=${windows%%
*}
	windows=${windows#windows=}
	monitor_desktops=${monitor_desktops:-$current}

	# The active window's class from its windows= entry, and its title from the
	# snapshot's title lines (#283). An active window outside the client list
	# is read on its own, as every one used to be.
	if [[ -n $window_id ]]; then
		IFS='|' read -r -a entries <<<"$windows"
		for entry in "${entries[@]}"; do
			[[ $entry == "$window_id:"* ]] || continue
			entry=${entry#*:}
			entry=${entry#*:}
			class=${entry%%:*}
			found=1
			break
		done
		if ((found == 0)); then
			title=$(window_title "$window_id" || true)
			class=$(window_class "$window_id" || true)
		fi
	fi
	title=${title:-Desktop}
	class=${class:-application-x-executable}

	printf 'current=%s\n' "$current"
	printf 'monitor_desktops=%s\n' "$monitor_desktops"
	printf 'focused_monitor=%s\n' "$focused_monitor"
	printf 'monitor_windows=%s\n' "$monitor_windows"
	printf 'layout=%s\n' "$layout"
	printf 'count=%s\n' "$count"
	printf 'names=%s\n' "$names"
	printf 'occupied=%s\n' "$occupied"
	printf 'fullscreen_monitors=%s\n' "$fullscreen_monitors"
	printf 'apps=%s\n' "$apps"
	printf 'windows=%s\n' "$windows"
	printf 'active_window=%s\n' "$window_id"
	printf 'title=%s\n' "$title"
	printf 'class=%s\n' "$class"
	printf 'status=%s\n' "$status"
}

# dwm-xwatch: installed beside the other private tools, or built in a checkout.
xwatch_path() {
	local candidate
	for candidate in "$lyona_lib/dwm-xwatch" "$lyona_lib/../dwm-xwatch"; do
		[[ -x $candidate ]] || continue
		printf '%s\n' "$candidate"
		return 0
	done
	return 1
}

# The client part of the state from the per-window cache (Sync Sprint 16
# R16-40): only the windows marked stale are read again, with the same parser
# as client_snapshot, and the occupied, apps and windows lines are rebuilt here
# in the client list's order, exactly as client_snapshot builds them. Sets
# snapshot.
cached_client_snapshot() {
	local client_list=$1 window_id entry rest desktop class line stale=() occupied_out='' apps_out='' windows_out=''
	# An indexed array of the occupied tags: its indices list in numeric order,
	# so they need no sort process (#283).
	local -a order=() desktops=()
	local -A present=() seen_class=()
	local IFS=,
	for window_id in $client_list; do
		window_id=${window_id##* }
		[[ $window_id == 0x[0-9a-fA-F]* ]] || continue
		order+=("$window_id")
		present[$window_id]=1
	done
	IFS=$' \t\n'
	for window_id in "${!window_cache[@]}"; do
		[[ -n ${present[$window_id]:-} ]] || unset 'window_cache[$window_id]' 'title_cache[$window_id]'
	done
	for window_id in "${order[@]}"; do
		[[ -n ${window_cache[$window_id]:-} && -z ${window_stale[$window_id]:-} ]] || stale+=("$window_id")
	done
	window_stale=()
	if ((${#stale[@]} > 0)); then
		# mapfile with a process substitution, not $(...), which would cost a
		# fork of its own on every rebuild (#283).
		local list
		local -a fresh=() entries=()
		if ((${#stale[@]} == 1)); then
			mapfile -t fresh < <(client_snapshot_one "${stale[0]}")
		else
			printf -v list '%s,' "${stale[@]}"
			mapfile -t fresh < <(client_snapshot "${list%,}")
		fi
		for line in "${fresh[@]}"; do
			case $line in
			'title '*)
				line=${line#title }
				title_cache[${line%% *}]=${line#* }
				;;
			windows=*)
				IFS='|' read -r -a entries <<<"${line#windows=}"
				;;
			'skip '*)
				# Cached as "-", so a dock is not read again on every rebuild.
				window_cache[${line#skip }]=-
				;;
			esac
		done
		IFS=$' \t\n'
		for entry in "${entries[@]}"; do
			[[ -n $entry ]] && window_cache[${entry%%:*}]=$entry
		done
	fi
	for window_id in "${order[@]}"; do
		entry=${window_cache[$window_id]:-}
		[[ -n $entry && $entry != - ]] || continue
		rest=${entry#*:}
		desktop=${rest%%:*}
		rest=${rest#*:}
		class=${rest%%:*}
		if [[ $desktop =~ ^[0-9]{1,9}$ ]]; then
			desktops[10#$desktop]=1
		fi
		if [[ -n $class && -z ${seen_class["|$class|"]:-} ]]; then
			seen_class["|$class|"]=1
			apps_out+=${apps_out:+|}$window_id:$class
		fi
		windows_out+=${windows_out:+|}$entry
	done
	for desktop in "${!desktops[@]}"; do
		occupied_out+=${occupied_out:+|}$desktop
	done
	printf -v snapshot 'occupied=%s\napps=%s\nwindows=%s' "$occupied_out" "$apps_out" "$windows_out"
}

# One dwm-xwatch for the root window and every client (Sync Sprint 16 R16-40):
# it says which window changed, so a change re-reads that window alone, where
# a resident "xprop -spy" per window, whose lines did not say which window they
# came from, made every change re-read them all. watch_state_spies, the old way,
# is only the fallback (#282): without the helper, or when it cannot watch the
# display (it never says "ready").
watch_state() {
	local xwatch event
	if ! xwatch=$(xwatch_path); then
		watch_state_spies
		return
	fi
	watch_dir=$(mktemp -d)
	declare -gA client_watchers=() window_cache=() window_stale=() title_cache=()
	root_pid=
	trap 'watch_cleanup' EXIT
	trap 'exit 129' HUP
	trap 'exit 130' INT
	trap 'exit 143' TERM
	mkfifo "$watch_dir/events"
	exec 3<>"$watch_dir/events"
	bound_to_this_shell "$xwatch" >&3 2>/dev/null &
	root_pid=$!
	# From here dwm-xwatch holds the only write end and this shell only reads,
	# so if the watcher dies (an OOM kill, a crash) the read sees end of file
	# and the watch ends, for WatchedProcess to start it again; with its own
	# write end open the read waited for ever, and the panel stopped updating
	# (#320). The read end opens at once: fd 3 is still a writer then.
	exec 4<"$watch_dir/events" 3>&- 3<&4 4<&-
	if ! IFS= read -r -t 2 event <&3 || [[ $event != ready ]]; then
		watch_cleanup
		trap - EXIT HUP INT TERM
		watch_state_spies
		return
	fi
	state_cache=1
	show_state
	printf '\n'
	last_rebuild=${EPOCHREALTIME//[!0-9]/}

	while IFS= read -r event <&3; do
		note_window_event "$event"
		drain_events note_window_event
		rebuild_after_gap note_window_event
	done
	printf 'dwm-quickshell-state: dwm-xwatch stopped; the watch ends, to be started again\n' >&2
}

# The state again, at most every 200 ms (#320): the drain merges a burst, but a
# window that retitles without pause (a progress title) used to rebuild about 17
# times a second, about 70 processes. Events in the rest of the gap join this
# rebuild. HANDLER notes them, as for drain_events.
rebuild_after_gap() {
	local handler=$1
	drain_events "$handler" $((last_rebuild + 200000))
	show_state
	printf '\n'
	last_rebuild=${EPOCHREALTIME//[!0-9]/}
}

# "window 0xID": that window is read again; root changes and the client list
# are read with the root snapshot on every rebuild anyway.
note_window_event() {
	case $1 in
	'window 0x'*) window_stale[${1#window }]=1 ;;
	esac
}

# Every property watcher writes its lines to one fifo; each burst of lines (a tag
# switch alone changes 3 or 4 properties) becomes one rebuild. Windows get one
# resident "xprop -spy" each, started when a window appears and stopped when it
# goes, never restarted wholesale. The fallback for when dwm-xwatch is missing
# or cannot watch the display.
watch_state_spies() {
	watch_dir=$(mktemp -d)
	declare -gA client_watchers=()
	clients_changed=0
	root_pid=
	trap 'watch_cleanup' EXIT
	trap 'exit 129' HUP
	trap 'exit 130' INT
	trap 'exit 143' TERM
	mkfifo "$watch_dir/events"
	exec 3<>"$watch_dir/events"

	# When setpriv is available, the kernel binds each xprop -spy to this shell
	# (Sync Sprint 13 S13-01). Without it, children may outlive this shell if
	# cleanup does not run.
	if xprop -root _DWM_MONITOR_DESKTOPS >/dev/null 2>&1; then
		bound_to_this_shell xprop -root -spy \
			DWM_TAG_UPDATE \
			_DWM_MONITOR_DESKTOPS \
			_DWM_SELECTED_MONITOR \
			_DWM_MONITOR_WINDOWS \
			_DWM_LAYOUT \
			_NET_NUMBER_OF_DESKTOPS \
			_NET_DESKTOP_NAMES \
			_NET_ACTIVE_WINDOW \
			_NET_CLIENT_LIST \
			_DWM_FULLSCREEN_MONITORS \
			WM_NAME >&3 2>/dev/null &
	else
		bound_to_this_shell xprop -root -spy \
			DWM_TAG_UPDATE \
			_NET_CURRENT_DESKTOP \
			_NET_NUMBER_OF_DESKTOPS \
			_NET_DESKTOP_NAMES \
			_NET_ACTIVE_WINDOW \
			_NET_CLIENT_LIST \
			_DWM_FULLSCREEN_MONITORS \
			WM_NAME >&3 2>/dev/null &
	fi
	root_pid=$!
	sync_client_watchers
	show_state
	printf '\n'
	last_rebuild=${EPOCHREALTIME//[!0-9]/}

	local rest
	while :; do
		event=
		# This shell keeps a write end, to start a watcher for each new window,
		# so the root watcher's death is never an end of file here: after 30 s
		# without an event, check it is still there (#320). Only this fallback
		# wakes so; the dwm-xwatch path above needs no timeout.
		if ! IFS= read -r -t 30 event <&3; then
			if [[ -z $event ]]; then
				kill -0 "$root_pid" 2>/dev/null || break
				continue
			fi
			IFS= read -r rest <&3 || true
			event=$event$rest
		fi
		clients_changed=0
		note_event "$event"
		drain_events
		# The drain after starting new watchers may see the list change again.
		while [ "$clients_changed" = 1 ]; do
			clients_changed=0
			sync_client_watchers
		done
		rebuild_after_gap note_event
	done
	printf 'dwm-quickshell-state: the root xprop -spy stopped; the watch ends, to be started again\n' >&2
}

note_event() {
	case $1 in
	_NET_CLIENT_LIST*) clients_changed=1 ;;
	esac
}

# Take every event that arrives in the next 50 ms, or until DEADLINE (in
# microseconds, as EPOCHREALTIME) when that is later, into the same rebuild,
# noting each with HANDLER (note_event by default).
drain_events() {
	local handler=${1:-note_event} deadline remaining timeout event rest
	deadline=$((${EPOCHREALTIME//[!0-9]/} + 50000))
	((${2:-0} > deadline)) && deadline=$2
	while :; do
		remaining=$((deadline - ${EPOCHREALTIME//[!0-9]/}))
		((remaining > 0)) || return 0
		printf -v timeout '0.%06d' "$remaining"
		event=
		if ! IFS= read -r -t "$timeout" event <&3; then
			[ -n "$event" ] || return 0
			# Timed out mid-line: the rest of the line is on its way.
			IFS= read -r rest <&3 || true
			event=$event$rest
		fi
		"$handler" "$event"
	done
}

# Start a watcher for each window that has none, stop the watchers of windows
# that are gone. A new watcher prints the window's properties at once; the
# drain takes those into the rebuild that follows instead of a rebuild each.
sync_client_watchers() {
	local window_id client_list started=0
	local -A wanted=()
	client_list=$(root_property_value _NET_CLIENT_LIST || true)
	local IFS=,
	for window_id in $client_list; do
		window_id=${window_id##* }
		case $window_id in
		0x[0-9a-fA-F]*) wanted[$window_id]=1 ;;
		esac
	done
	IFS=$' \t\n'
	for window_id in "${!client_watchers[@]}"; do
		[ -z "${wanted[$window_id]:-}" ] || continue
		kill "${client_watchers[$window_id]}" 2>/dev/null || true
		wait "${client_watchers[$window_id]}" 2>/dev/null || true
		unset 'client_watchers[$window_id]'
	done
	for window_id in "${!wanted[@]}"; do
		[ -z "${client_watchers[$window_id]:-}" ] || continue
		bound_to_this_shell xprop -id "$window_id" -spy _NET_WM_NAME WM_NAME WM_CLASS _NET_WM_DESKTOP _NET_WM_WINDOW_TYPE \
			>&3 2>/dev/null &
		client_watchers[$window_id]=$!
		started=1
	done
	[ "$started" = 0 ] || drain_events
}

watch_cleanup() {
	trap - EXIT HUP INT TERM
	for watcher_pid in "${client_watchers[@]}" $root_pid; do
		[ -n "$watcher_pid" ] || continue
		kill "$watcher_pid" 2>/dev/null || true
		wait "$watcher_pid" 2>/dev/null || true
	done
	exec 3>&-
	rm -f "$watch_dir/events"
	rmdir "$watch_dir"
}

# Ask dwm for a layout by index into its layouts[] (the index hotkeys.toml's
# layout_idx uses). dwm reads and clears this root property, and ignores an
# index outside its layouts, so the range is enforced there; only the shape is
# checked here.
set_layout() {
	index=${1:-}
	case $index in
	'' | *[!0-9]* | ???*)
		printf 'usage: %s layout <index>\n' "$0" >&2
		return 2
		;;
	esac
	xprop -root -f _DWM_SET_LAYOUT 32c -set _DWM_SET_LAYOUT "$index"
}

switch_workspace() {
	target=${1:-}
	case $target in
	'' | *[!0-9]*)
		printf 'usage: %s switch <zero-based-workspace>\n' "$0" >&2
		return 2
		;;
	esac
	if command -v xdotool >/dev/null 2>&1; then
		xdotool set_desktop "$target"
	elif command -v wmctrl >/dev/null 2>&1; then
		wmctrl -s "$target"
	else
		printf 'xdotool or wmctrl is required for workspace switching\n' >&2
		return 127
	fi
}

focus_window() {
	target=${1:-}
	case $target in
	0x[0-9a-fA-F]* | [0-9]*) ;;
	*)
		printf 'usage: %s focus <window-id>\n' "$0" >&2
		return 2
		;;
	esac
	if command -v xdotool >/dev/null 2>&1; then
		xdotool windowactivate "$target"
	elif command -v wmctrl >/dev/null 2>&1; then
		wmctrl -ia "$target"
	else
		printf 'xdotool or wmctrl is required for window focus\n' >&2
		return 127
	fi
}

# Closing a card from the overview popup (Sync Sprint 8 S8-04,
# docs/sprints/completed/SYNC-SPRINT-8-OVERVIEW-INTERACTION.md) is not selmon->sel, which is
# the only client dwm.c's own killclient() closes -- most cards are not the
# focused window. A plain ICCCM WM_DELETE_WINDOW client message sent
# directly to the target id (the same graceful-close request killclient()
# itself sends first) needs no dwm.c change and no new EWMH property; it is
# routed by the X server, not the window manager.
close_window() {
	target=${1:-}
	case $target in
	0x[0-9a-fA-F]* | [0-9]*) ;;
	*)
		printf 'usage: %s close <window-id>\n' "$0" >&2
		return 2
		;;
	esac
	if command -v xdotool >/dev/null 2>&1; then
		# windowquit sends that WM_DELETE_WINDOW request, so the application can
		# ask about unsaved work; windowclose would destroy the window outright
		# (Sync Sprint 12 S12-12).
		xdotool windowquit "$target"
	elif command -v wmctrl >/dev/null 2>&1; then
		wmctrl -ic "$target"
	else
		printf 'xdotool or wmctrl is required to close a window\n' >&2
		return 127
	fi
}

case ${1:-state} in
state)
	show_state
	;;
watch)
	watch_state
	;;
switch)
	switch_workspace "${2:-}"
	;;
focus)
	focus_window "${2:-}"
	;;
layout)
	set_layout "${2:-}"
	;;
close)
	close_window "${2:-}"
	;;
*)
	printf 'usage: %s [state|watch|switch <zero-based-workspace>|focus <window-id>|close <window-id>|layout <index>]\n' "$0" >&2
	exit 2
	;;
esac
