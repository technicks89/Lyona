#!/bin/sh

set -eu

light_locker_pid=
light_locker_started=0

start_light_locker() {
	command -v light-locker >/dev/null 2>&1 || return 0

	if command -v pgrep >/dev/null 2>&1 &&
		pgrep -u "$(id -u)" -x light-locker >/dev/null 2>&1; then
		return 0
	fi

	light-locker >/dev/null 2>&1 &
	light_locker_pid=$!
	light_locker_started=1
	if command -v sleep >/dev/null 2>&1; then
		sleep "${DWM_LOCK_START_DELAY:-0.2}"
	fi
}

stop_started_light_locker() {
	[ "$light_locker_started" = 1 ] || return 0
	[ -n "$light_locker_pid" ] || return 0

	kill "$light_locker_pid" 2>/dev/null || true
	wait "$light_locker_pid" 2>/dev/null || true
	light_locker_pid=
	light_locker_started=0
}

stop_started_light_locker_after_unlock() {
	[ "$light_locker_started" = 1 ] || return 0
	[ -n "$light_locker_pid" ] || return 0
	command -v sleep >/dev/null 2>&1 || return 0

	(
		active_seen=0
		attempts=0
		while kill -0 "$light_locker_pid" 2>/dev/null; do
			locker_state=$(LC_ALL=C light-locker-command --query 2>/dev/null || true)
			case $locker_state in
			*" is active") active_seen=1 ;;
			*" is inactive")
				if [ "$active_seen" = 1 ]; then
					kill "$light_locker_pid" 2>/dev/null || true
					exit 0
				fi
				;;
			esac

			attempts=$((attempts + 1))
			if [ "$active_seen" = 0 ] && [ "$attempts" -ge 30 ]; then
				kill "$light_locker_pid" 2>/dev/null || true
				exit 0
			fi
			sleep 1
		done
	) >/dev/null 2>&1 &
}

try_lock() {
	"$@" >/dev/null 2>&1
}

# loginctl lock-session only sends logind's Lock signal, and succeeds whether
# or not anything listens: it counts only once logind reports the session
# locked, within about two seconds (#269).
try_loginctl_lock() {
	[ "${DWM_LOCK_NO_LOGINCTL:-0}" != 1 ] || return 1
	command -v loginctl >/dev/null 2>&1 || return 1
	if [ -n "${XDG_SESSION_ID:-}" ]; then
		try_lock loginctl lock-session "$XDG_SESSION_ID" || return 1
	else
		try_lock loginctl lock-session || return 1
	fi
	lock_attempt=0
	while [ "$lock_attempt" -lt "${DWM_LOCK_VERIFY_TRIES:-20}" ]; do
		[ "$(loginctl show-session "${XDG_SESSION_ID:-self}" -p LockedHint --value 2>/dev/null)" != yes ] ||
			return 0
		lock_attempt=$((lock_attempt + 1))
		if command -v sleep >/dev/null 2>&1; then
			sleep 0.1
		fi
	done
	return 1
}

if command -v light-locker-command >/dev/null 2>&1; then
	start_light_locker
	if try_lock light-locker-command --lock; then
		stop_started_light_locker_after_unlock
		exit 0
	fi
	stop_started_light_locker
fi

if command -v xdg-screensaver >/dev/null 2>&1 &&
	try_lock xdg-screensaver lock; then
	exit 0
fi

if command -v mate-screensaver-command >/dev/null 2>&1 &&
	try_lock mate-screensaver-command --lock; then
	exit 0
fi

if command -v xfce4-screensaver-command >/dev/null 2>&1 &&
	try_lock xfce4-screensaver-command --lock; then
	exit 0
fi

if command -v cinnamon-screensaver-command >/dev/null 2>&1 &&
	try_lock cinnamon-screensaver-command --lock; then
	exit 0
fi

if command -v gnome-screensaver-command >/dev/null 2>&1 &&
	try_lock gnome-screensaver-command --lock; then
	exit 0
fi

if command -v xscreensaver-command >/dev/null 2>&1 &&
	pgrep -x xscreensaver >/dev/null 2>&1 &&
	try_lock xscreensaver-command -lock; then
	exit 0
fi

for locker in i3lock slock xlock; do
	if command -v "$locker" >/dev/null 2>&1 &&
		try_lock "$locker"; then
		exit 0
	fi
done

# Last: a listener on logind's Lock signal, once it reports the screen locked.
if try_loginctl_lock; then
	exit 0
fi

printf '%s\n' \
	'dwm-lock: no usable screen locker found.' \
	'Install i3lock or slock, or log in through LightDM for light-locker.' >&2
# Lock is often a key or a menu entry that shows no error: say so on screen too.
if command -v notify-send >/dev/null 2>&1; then
	notify-send -a lyona -u critical -- 'Screen not locked' \
		'No screen locker is available. Install i3lock or slock, or log in through LightDM for light-locker.' \
		>/dev/null 2>&1 || true
fi
exit 1
