#!/usr/bin/env bash
set -euo pipefail

usage() {
	cat <<'EOF'
Usage: scripts/lyona-release [options]

Create a GitHub release for the current config.mk VERSION.

lyona uses calendar versioning: YYYY.MM, or YYYY.MM.PATCH for a second
(or later) release in the same month. A pre-release appends -alpha.N,
-beta.N or -rc.N and is published to GitHub with --prerelease so it is
never promoted to Latest. Set VERSION in config.mk to the release you
want to cut before running this script.

Options:
  --version VERSION       Confirm the committed config.mk VERSION to release.
                          Accepts 2026.08.0 or v2026.08.0.
  --iso PATH              Upload an installer ISO alongside the source archive.
  --notes FILE            Use FILE as release notes.
  --bundle FILE           Publish FILE, the Sigstore bundle that signs the
                          source archive and the ISO, as
                          lyona-VERSION.sigstore.json, which lyona-update
                          checks (decision D-31). The ISO workflow signs
                          before it publishes, and passes this.
  --prerelease            Publish as a GitHub pre-release even without a
                          version suffix. The ISO workflow uses this so a
                          stable release stays one until it is promoted.
  --dry-run               Print the planned commands only.
  --skip-checks           Skip make release-check.
  -h, --help              Show this help.
EOF
}

err() {
	printf 'lyona-release: %s\n' "$*" >&2
}

run() {
	if [[ $dry_run == true ]]; then
		printf '+'
		printf ' %q' "$@"
		printf '\n'
	else
		"$@"
	fi
}

# The commit the remote tag points at, following an annotated tag to its
# commit; nothing when there is no such tag. Any failure but GitHub's 404 stops
# the release, so a transient error can never pass for "no tag".
remote_tag_commit() {
	local ref type sha err
	err=$(mktemp)
	if ! ref=$(gh api "repos/:owner/:repo/git/ref/tags/$tag" --jq '.object.type + " " + .object.sha' 2>"$err"); then
		if grep -Fq 'HTTP 404' "$err"; then
			rm -f -- "$err"
			return 0
		fi
		err "could not look up the remote tag $tag: $(cat "$err")"
		rm -f -- "$err"
		exit 1
	fi
	rm -f -- "$err"
	read -r type sha <<<"$ref"
	if [[ $type == tag ]]; then
		sha=$(gh api "repos/:owner/:repo/git/tags/$sha" --jq .object.sha) || {
			err "could not resolve the annotated tag $tag"
			exit 1
		}
	fi
	printf '%s\n' "$sha"
}

remote_release_exists() {
	gh release view "$tag" >/dev/null 2>&1
}

expand_user_path() {
	case "$1" in
	\~)
		printf '%s\n' "$HOME"
		;;
	\~/*)
		printf '%s/%s\n' "$HOME" "${1#"~/"}"
		;;
	*)
		printf '%s\n' "$1"
		;;
	esac
}

prompt_for_iso() {
	local fallback answer

	fallback="$HOME/Downloads/lyona.iso"
	if [[ ! -t 0 ]]; then
		err "ISO not found at $default_iso_path; continuing without ISO upload. Use --iso PATH to upload one."
		return 0
	fi

	if [[ -f $fallback ]]; then
		printf 'ISO not found at %s.\n' "$default_iso_path" >&2
		printf 'Path to lyona.iso [%s]: ' "$fallback" >&2
	else
		printf 'ISO not found at %s.\n' "$default_iso_path" >&2
		printf 'Path to lyona.iso (leave blank to skip ISO upload): ' >&2
	fi
	IFS= read -r answer

	if [[ -z $answer && -f $fallback ]]; then
		iso_path=$fallback
	elif [[ -n $answer ]]; then
		iso_path="$(expand_user_path "$answer")"
	fi
}

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
config_mk="$repo_root/config.mk"
default_iso_path="$repo_root/lyona.iso"
release_version=
iso_path=
notes_file=
bundle_path=
dry_run=false
skip_checks=false
force_prerelease=false

while (($# > 0)); do
	case "$1" in
	--version)
		if (($# < 2)); then
			err "--version requires a value."
			exit 1
		fi
		release_version=$2
		shift 2
		;;
	--version=*)
		release_version=${1#*=}
		shift
		;;
	--iso)
		if (($# < 2)); then
			err "--iso requires a value."
			exit 1
		fi
		iso_path=$2
		shift 2
		;;
	--iso=*)
		iso_path=${1#*=}
		shift
		;;
	--notes)
		if (($# < 2)); then
			err "--notes requires a value."
			exit 1
		fi
		notes_file=$2
		shift 2
		;;
	--notes=*)
		notes_file=${1#*=}
		shift
		;;
	--bundle)
		if (($# < 2)); then
			err "--bundle requires a value."
			exit 1
		fi
		bundle_path=$2
		shift 2
		;;
	--dry-run)
		dry_run=true
		shift
		;;
	--skip-checks)
		skip_checks=true
		shift
		;;
	--prerelease)
		force_prerelease=true
		shift
		;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		err "unknown argument: $1"
		usage >&2
		exit 1
		;;
	esac
done

if [[ ! -f $config_mk ]]; then
	err "missing config.mk at $config_mk"
	exit 1
fi

current_version="$(
	awk -F= '
		$1 ~ /^[[:space:]]*VERSION[[:space:]]*$/ {
			gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2)
			print $2
			exit
		}
	' "$config_mk"
)"

if [[ -z $current_version ]]; then
	err "could not read VERSION from config.mk"
	exit 1
fi

release_version=${release_version:-$current_version}
release_version=${release_version#v}

if [[ ! $release_version =~ ^[0-9]+(\.[0-9]+){1,2}(-(alpha|beta|rc)\.[0-9]+)?$ ]]; then
	err "version must look like YYYY.MM or YYYY.MM.PATCH, optionally with an"
	err "-alpha.N, -beta.N or -rc.N pre-release suffix: $release_version"
	exit 1
fi

# Split the pre-release suffix off before normalising the numeric part, so that
# 2026.08-beta.1 and 2026.08.0-beta.1 both settle on 2026.08.0-beta.1.
prerelease=
if [[ $release_version == *-* ]]; then
	prerelease=${release_version#*-}
fi
IFS=. read -r year month patch <<<"${release_version%%-*}"
patch=${patch:-0}
release_version="$year.$month.$patch${prerelease:+-$prerelease}"
tag="v$release_version"
release_archive="$repo_root/release/lyona-$release_version.tar.gz"
checksums="$repo_root/release/lyona-$release_version-SHA256SUMS"

if [[ $release_version != "$current_version" ]]; then
	err "requested version $release_version does not match committed config.mk VERSION $current_version"
	err "update config.mk and CHANGELOG.md, commit them, then rerun the release"
	exit 1
fi

if [[ -z $iso_path ]]; then
	if [[ -f $default_iso_path ]]; then
		iso_path=$default_iso_path
	else
		prompt_for_iso
	fi
else
	iso_path="$(expand_user_path "$iso_path")"
fi

if [[ -n $iso_path && ! -f $iso_path ]]; then
	err "ISO not found: $iso_path"
	exit 1
fi

if [[ -n $notes_file && ! -f $notes_file ]]; then
	err "release notes file not found: $notes_file"
	exit 1
fi

if [[ -n $bundle_path && ! -f $bundle_path ]]; then
	err "signature bundle not found: $bundle_path"
	exit 1
fi

if ! command -v gh >/dev/null 2>&1; then
	err "missing required command: gh"
	exit 1
fi

cd "$repo_root"

release_exists=false
head_sha="$(git rev-parse HEAD)"

if [[ $dry_run != true ]]; then
	if [[ -n $(git status --porcelain --untracked-files=normal) ]]; then
		err "release worktree is not clean"
		err "commit or remove local changes before creating $tag"
		exit 1
	fi
	if ! gh api "repos/:owner/:repo/commits/$head_sha" >/dev/null 2>&1; then
		err "release commit $head_sha is not available on GitHub"
		err "push the release commit before creating $tag"
		exit 1
	fi
fi

if [[ $skip_checks != true ]]; then
	run make release-check
else
	run make release
fi

assets=("$release_archive")
if [[ -n $iso_path ]]; then
	assets+=("$iso_path")
fi

if [[ $dry_run == true ]]; then
	printf '+ sha256sum'
	printf ' %q' "${assets[@]}"
	printf ' > %q\n' "$checksums"
else
	mkdir -p "$(dirname "$checksums")"
	# By file name, as a download lays them out, so `sha256sum -c` works on the
	# downloaded files (Sync Sprint 16 R16-07).
	: >"$checksums"
	for asset in "${assets[@]}"; do
		(cd "$(dirname "$asset")" && sha256sum "$(basename "$asset")") >>"$checksums"
	done
fi
assets+=("$checksums")

# The signature, only for exactly the files being published: the archive was
# rebuilt above, and a bundle that does not name its digest (and the ISO's)
# would make lyona-update refuse the release.
if [[ -n $bundle_path ]]; then
	signed_bundle="$repo_root/release/lyona-$release_version.sigstore.json"
	if [[ $dry_run != true ]]; then
		signed=$(jq -r '.dsseEnvelope.payload' "$bundle_path" | base64 -d |
			jq -r '.subject[].digest.sha256') || {
			err "could not read the signed digests from $bundle_path"
			exit 1
		}
		for asset in "$release_archive" ${iso_path:+"$iso_path"}; do
			digest=$(sha256sum -- "$asset" | awk '{ print $1 }')
			grep -Fqx -- "$digest" <<<"$signed" || {
				err "$bundle_path does not sign $(basename -- "$asset") ($digest)"
				exit 1
			}
		done
	fi
	run cp -- "$bundle_path" "$signed_bundle"
	assets+=("$signed_bundle")
fi

if [[ $dry_run == true ]]; then
	run gh api "repos/:owner/:repo/git/ref/tags/$tag"
	run gh api -X POST repos/:owner/:repo/git/refs \
		-f "ref=refs/tags/$tag" \
		-f "sha=$head_sha"
	run gh release view "$tag"
else
	tagged=$(remote_tag_commit) || exit 1
	if [[ -n $tagged && $tagged != "$head_sha" ]]; then
		# Never publish this commit's assets under a tag that names another
		# (Sync Sprint 16 R16-04).
		err "$tag already exists at $tagged, not at this commit ($head_sha)"
		err "bump VERSION in config.mk to release this commit"
		exit 1
	elif [[ -n $tagged ]]; then
		printf 'Remote tag %s already exists at this commit.\n' "$tag"
	else
		printf 'Remote tag %s does not exist; creating it at %s.\n' "$tag" "$head_sha"
		run gh api -X POST repos/:owner/:repo/git/refs \
			-f "ref=refs/tags/$tag" \
			-f "sha=$head_sha" >/dev/null
	fi

	if remote_release_exists; then
		release_exists=true
	fi
fi

if [[ $release_exists == true ]]; then
	# --prerelease (the ISO workflow) only ever replaces a pre-release's assets,
	# never those of a release that has already been promoted.
	if [[ $force_prerelease == true ]] &&
		[[ $(gh release view "$tag" --json isPrerelease --jq .isPrerelease) != true ]]; then
		err "$tag is already a normal release; --prerelease will not replace its assets"
		err "bump VERSION in config.mk to publish a new release"
		exit 1
	fi
	run gh release upload "$tag" "${assets[@]}" --clobber
else
	gh_args=(release create "$tag" "${assets[@]}" --title "lyona $tag" --verify-tag)
	if [[ -n $prerelease || $force_prerelease == true ]]; then
		# A pre-release must not be published as the latest stable release.
		gh_args+=(--prerelease)
	fi
	if [[ -n $notes_file ]]; then
		gh_args+=(--notes-file "$notes_file")
	else
		gh_args+=(--notes "lyona $tag${prerelease:+ pre-}release.")
	fi
	run gh "${gh_args[@]}"
fi
