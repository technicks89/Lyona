#!/usr/bin/env bash
set -euo pipefail

# A checkout keeps the shared shell code beside the scripts; an install keeps it
# in PREFIX/lib/lyona, beside PREFIX/bin (Sync Sprint 12 S12-13).
lyona_lib=${BASH_SOURCE[0]%/*}
[[ -f $lyona_lib/dwm-simple-watch.sh ]] || lyona_lib=${lyona_lib%bin}lib/lyona
# shellcheck source=scripts/dwm-simple-watch.sh
. "$lyona_lib/dwm-simple-watch.sh"

# The lock and token primitives (#277).
# shellcheck source=scripts/dwm-preview-core.sh
. "$lyona_lib/dwm-preview-core.sh"
# shellcheck source=scripts/dwm-xsession.sh
. "$lyona_lib/dwm-xsession.sh"
# shellcheck source=scripts/dwm-xdg.sh
. "$lyona_lib/dwm-xdg.sh"
lyona_xdg_dirs
config_dir=$config_home/lyona
settings_file="${DWM_INPUT_SETTINGS_FILE:-$config_dir/input-settings.conf}"
settings_dir=${settings_file%/*}
[[ $settings_dir != "$settings_file" ]] || settings_dir=.
runtime_base="${XDG_RUNTIME_DIR:-/tmp/lyona-$UID}"
state_dir="$runtime_base/dwm-settings-input"
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
self="$script_dir/${BASH_SOURCE[0]##*/}"
accessibility_key=accessx

# One entry per card: the parts of one physical device merged (#473). device_ids
# and device_part_keys hold the parts' X ids and keys, space-separated; the
# part_ arrays hold each part as XInput lists it.
declare -a device_ids=() device_keys=() device_kinds=() device_names=() device_persistable=()
declare -a device_part_keys=() device_groups=()
declare -a part_ids=() part_keys=() part_kinds=() part_names=() part_persistable=()
# The one-shot actions keep xinput output in a per-run scratch folder, removed on
# exit (a signal included): a RETURN trap does not run when the helper is stopped
# part-way through a scan, which left its files behind.
input_scratch=
input_tempfile() {
	if [[ -n $input_scratch ]]; then
		mktemp "$input_scratch/properties.XXXXXX"
	else
		mktemp
	fi
}
watch_event_fifo=
watch_monitor_pid=
watch_session_guard_pid=
usage() {
	cat >&2 <<'EOF'
usage: dwm-settings-input discover|watch OWNER_PID OWNER_START
       dwm-settings-input watch-apply|apply-saved
       dwm-settings-input preview TOKEN SECONDS DEVICE SETTING VALUE
       dwm-settings-input keep TOKEN
       dwm-settings-input revert TOKEN
       dwm-settings-input preview-status [TOKEN]
       dwm-settings-input reset DEVICE SETTING
EOF
}

die() {
	printf 'dwm-settings-input: %s\n' "$*" >&2
	exit 1
}
clean_field() { printf '%s' "$1" | tr '\011\015\012' '   '; }

need_tools() {
	command -v xinput >/dev/null 2>&1 || die "xinput is unavailable"
	[[ -n ${DISPLAY:-} ]] || die "DISPLAY is not set"
}

need_setxkbmap() {
	command -v setxkbmap >/dev/null 2>&1 || die "setxkbmap is unavailable"
}

# dwm-xkbset is Lyona's own XKB accessibility helper (xkbset is AUR-only). It
# is normally on PATH; a checkout that has not been installed keeps it beside
# this script.
xkbset_path() {
	if command -v dwm-xkbset 2>/dev/null; then
		return 0
	fi
	local sibling="${BASH_SOURCE[0]%/*}/dwm-xkbset"
	[[ -x $sibling ]] && printf '%s\n' "$sibling"
}

need_xkbset() {
	xkbset_path >/dev/null || die "dwm-xkbset is unavailable"
	command -v timeout >/dev/null 2>&1 || die "timeout is unavailable"
	[[ -n ${DISPLAY:-} ]] || die "DISPLAY is not set"
}

run_xkbset() {
	local timeout_path xkbset
	timeout_path=$(command -v timeout) || return 127
	xkbset=$(xkbset_path) || return 127
	"$timeout_path" --signal=TERM --kill-after=1 2 "$xkbset" "$@"
}

accessibility_label() {
	case $1 in
	accessx-shortcuts) printf '%s\n' 'Accessibility Features (AccessX)' ;;
	sticky-keys) printf '%s\n' 'Sticky-Keys' ;;
	slow-keys) printf '%s\n' 'Slow-Keys' ;;
	bounce-keys) printf '%s\n' 'Bounce-Keys' ;;
	mouse-keys) printf '%s\n' 'Mouse-Keys' ;;
	*) return 1 ;;
	esac
}

accessibility_value() {
	local setting=$1 snapshot=${2-} label value
	label=$(accessibility_label "$setting") || return 1
	if (($# < 2)); then
		need_xkbset
		snapshot=$(LC_ALL=C run_xkbset q) || die "unable to query XKB accessibility controls"
	fi
	value=$(awk -F ' = ' -v label="$label" '$1 == label { print $2; found = 1; exit }
		END { exit !found }' <<<"$snapshot") || return 1
	case $value in
	On) printf '1\n' ;;
	Off) printf '0\n' ;;
	*) return 1 ;;
	esac
}

apply_accessibility_value() {
	local setting=$1 value=$2 option
	need_xkbset
	case $setting in
	accessx-shortcuts) option=a ;;
	sticky-keys) option=st ;;
	slow-keys) option=sl ;;
	bounce-keys) option=bo ;;
	mouse-keys) option=m ;;
	*) die "unsupported accessibility setting: $setting" ;;
	esac
	if [[ $value == 1 ]]; then
		LC_ALL=C run_xkbset "$option"
	else
		LC_ALL=C run_xkbset "-$option"
	fi
}

trim() {
	local value=$1
	value=${value#"${value%%[![:space:]]*}"}
	value=${value%"${value##*[![:space:]]}"}
	printf '%s' "$value"
}

property_value() {
	local properties=$1 name=$2
	awk -v name="$name" '
		index($0, name " (") == 1 || index($0, "\t" name " (") == 1 {
			value = substr($0, index($0, ":") + 1)
			gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
			print value; exit
		}
	' "$properties"
}

# udev's properties for an input node, or nothing without udevadm or a node.
udev_properties() {
	[[ -n $1 ]] && command -v udevadm >/dev/null 2>&1 || return 0
	udevadm info --query=property --name="$1" 2>/dev/null || true
}

udev_value() { # PROPERTIES NAME
	awk -F= -v name="$2" '$1 == name {print substr($0, index($0, "=") + 1); exit}' <<<"$1"
}

stable_device_source() {
	local properties=$1 serial path devpath
	serial=$(udev_value "$properties" ID_SERIAL)
	path=$(udev_value "$properties" ID_PATH)
	devpath=$(udev_value "$properties" DEVPATH)
	if [[ -n $serial ]]; then
		printf 'serial:%s' "$serial"
		return
	fi
	if [[ -n $path ]]; then
		printf 'path:%s' "$path"
		return
	fi
	devpath=${devpath%/input/input[0-9]*/event[0-9]*}
	if [[ -n $devpath && $devpath != /devices/virtual* ]]; then
		printf 'sysfs:%s' "$devpath"
		return
	fi
	return 1
}

# A "keyboard" with keys but no keyboard keys (#473, upstream dwm-titus #385):
# the kernel's power, sleep and lid buttons, a consumer-control interface.
# udev's input_id says so; without udev nothing is hidden.
button_only() {
	[[ $(udev_value "$1" ID_INPUT_KEY) == 1 && $(udev_value "$1" ID_INPUT_KEYBOARD) != 1 ]]
}

# The physical device an XInput device is part of (#473): the USB device for
# one of its interfaces ("1-3" of "1-3:1.0"), else the HID device. Empty for a
# device with neither (PS/2, I2C, virtual), which is never merged. A port, not
# a serial: two identical mice are two devices.
physical_device() {
	local devpath
	devpath=$(udev_value "$1" DEVPATH)
	# .../usb1/1-3/1-3:1.0/...: the device directory, then one of its
	# interfaces; behind a hub, .../1-3/1-3.2/1-3.2:1.0/.
	if [[ $devpath =~ ^(/devices/.*/[0-9]+-[0-9.]+)/[0-9]+-[0-9.]+:[0-9]+\.[0-9]+/ ]]; then
		printf 'usb:%s' "${BASH_REMATCH[1]}"
	elif [[ $devpath =~ ^(/devices/.*/[0-9A-Fa-f]{4}:[0-9A-Fa-f]{4}:[0-9A-Fa-f]{4}\.[0-9A-Fa-f]{4})/input/ ]]; then
		printf 'hid:%s' "${BASH_REMATCH[1]}"
	fi
}

short_key() { printf '%s' "$1" | sha256sum | awk '{print substr($1, 1, 16)}'; }

scan_devices() {
	local line id kind name properties product node source identity persistable devices udev group
	local index d found merged
	local -a part_identities=() part_groups=() device_identities=()
	need_tools
	device_ids=()
	device_keys=()
	device_kinds=()
	device_names=()
	device_persistable=()
	device_part_keys=()
	device_groups=()
	part_ids=()
	part_keys=()
	part_kinds=()
	part_names=()
	part_persistable=()
	if ! devices=$(xinput --list --short); then
		die "unable to query XInput devices"
	fi
	while IFS= read -r line; do
		if [[ $line =~ id=([0-9]+)[[:space:]]+\[(slave|floating)[[:space:]]+(pointer|keyboard) ]]; then
			id=${BASH_REMATCH[1]}
			kind=${BASH_REMATCH[3]}
			properties=$(input_tempfile)
			xinput list-props "$id" >"$properties" 2>/dev/null || {
				rm -f "$properties"
				continue
			}
			name=$(sed -n "1{s/^Device '//; s/':$//; p;}" "$properties")
			[[ -n $name ]] || {
				rm -f "$properties"
				continue
			}
			[[ $name != *"XTEST"* ]] || {
				rm -f "$properties"
				continue
			}
			product=$(property_value "$properties" "Device Product ID")
			node=$(property_value "$properties" "Device Node")
			node=${node#\"}
			node=${node%\"}
			rm -f "$properties"
			udev=$(udev_properties "$node")
			if [[ $kind == keyboard ]] && button_only "$udev"; then
				continue
			fi
			if [[ $kind == pointer && $name =~ ([Tt]ouch[Pp]ad|[Tt]rack[Pp]ad) ]]; then
				kind=touchpad
			fi
			if source=$(stable_device_source "$udev"); then
				persistable=1
			else
				source=unstable
				persistable=0
			fi
			identity="$kind|$name|$product|$source"
			group=$(physical_device "$udev")
			part_ids+=("$id")
			part_keys+=("$(short_key "$identity")")
			part_kinds+=("$kind")
			part_names+=("$name")
			part_persistable+=("$persistable")
			part_identities+=("$identity")
			part_groups+=("${group:+$kind|$group}")
		fi
	done <<<"$devices"
	# One card per physical device and kind: a mouse's several interfaces
	# merge; its keyboard interface stays a keyboard card.
	for index in "${!part_ids[@]}"; do
		found=
		if [[ -n ${part_groups[$index]} ]]; then
			for d in "${!device_groups[@]}"; do
				[[ ${device_groups[$d]} == "${part_groups[$index]}" ]] || continue
				found=$d
				break
			done
		fi
		if [[ -z $found ]]; then
			device_ids+=("${part_ids[$index]}")
			device_keys+=("${part_keys[$index]}")
			device_part_keys+=("${part_keys[$index]}")
			device_kinds+=("${part_kinds[$index]}")
			device_names+=("${part_names[$index]}")
			device_persistable+=("${part_persistable[$index]}")
			device_groups+=("${part_groups[$index]}")
			device_identities+=("${part_identities[$index]}")
			continue
		fi
		device_ids[found]+=" ${part_ids[$index]}"
		device_part_keys[found]+=" ${part_keys[$index]}"
		device_identities[found]+=$'\n'"${part_identities[$index]}"
		[[ ${part_persistable[$index]} == 1 ]] || device_persistable[found]=0
		# The shortest name: "Gaming Mouse", not "Gaming Mouse Consumer Control".
		((${#part_names[$index]} >= ${#device_names[found]})) || device_names[found]=${part_names[$index]}
	done
	# A merged card's key: its parts' identities, in a fixed order, so it is the
	# same each session while the parts are; a single part keeps its own key.
	for d in "${!device_ids[@]}"; do
		[[ ${device_ids[$d]} == *' '* ]] || continue
		merged=$(sort <<<"${device_identities[$d]}")
		device_keys[d]=$(short_key "merged|${device_kinds[$d]}|$merged")
	done
}

device_can_persist() {
	local wanted=$1 index
	[[ $wanted != "$accessibility_key" ]] || return 0
	scan_devices
	for index in "${!device_keys[@]}"; do
		[[ ${device_keys[$index]} == "$wanted" ]] || continue
		[[ ${device_persistable[$index]} == 1 ]] || return 1
		return 0
	done
	for index in "${!part_keys[@]}"; do
		[[ ${part_keys[$index]} == "$wanted" ]] || continue
		[[ ${part_persistable[$index]} == 1 ]] || return 1
		return 0
	done
	return 1
}

# The parts KEY names, one "PART-KEY<TAB>ID" line each: every part of a card,
# or, for a part's own key (a setting saved before the parts merged), that part.
resolve_parts() {
	local wanted=$1 index found='' keys ids part
	local -a key_list=() id_list=()
	scan_devices
	for index in "${!device_keys[@]}"; do
		[[ ${device_keys[$index]} == "$wanted" ]] || continue
		[[ -z $found ]] || die "stable device identity is ambiguous"
		found=1
		keys=${device_part_keys[$index]}
		ids=${device_ids[$index]}
	done
	if [[ -z $found ]]; then
		for index in "${!part_keys[@]}"; do
			[[ ${part_keys[$index]} == "$wanted" ]] || continue
			[[ -z $found ]] || die "stable device identity is ambiguous"
			found=1
			keys=${part_keys[$index]}
			ids=${part_ids[$index]}
		done
	fi
	[[ -n $found ]] || die "device is disconnected or unavailable: $wanted"
	read -r -a key_list <<<"$keys"
	read -r -a id_list <<<"$ids"
	for part in "${!key_list[@]}"; do
		printf '%s\t%s\n' "${key_list[$part]}" "${id_list[$part]}"
	done
}

resolve_device() {
	local first
	first=$(resolve_parts "$1") || return 1
	first=${first%%$'\n'*}
	printf '%s\n' "${first#*$'\t'}"
}

emit_setting() {
	printf 'setting\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
		"$(clean_field "$1")" "$(clean_field "$2")" "$(clean_field "$3")" \
		"$(clean_field "$4")" "$(clean_field "$5")" "$(clean_field "$6")" \
		"$(clean_field "$7")" "$(clean_field "$8")"
}

emit_unsupported() {
	printf 'unsupported\t%s\t%s\t%s\n' \
		"$(clean_field "$1")" "$(clean_field "$2")" "$(clean_field "$3")"
}

discover() {
	local index id key kind name properties value default layout options keyboard_query accessibility_query setting label part
	local -a ids=()
	scan_devices
	printf 'input-protocol\t1\n'
	printf 'device\t%s\tsession\taccessibility\tKeyboard accessibility\n' "$accessibility_key"
	if xkbset_path >/dev/null && command -v timeout >/dev/null 2>&1 &&
		accessibility_query=$(LC_ALL=C run_xkbset q 2>/dev/null); then
		for setting in accessx-shortcuts sticky-keys slow-keys bounce-keys mouse-keys; do
			case $setting in
			accessx-shortcuts) label='Accessibility shortcuts' ;;
			sticky-keys) label='Sticky keys' ;;
			slow-keys) label='Slow keys' ;;
			bounce-keys) label='Bounce keys' ;;
			mouse-keys) label='Mouse keys' ;;
			esac
			if value=$(accessibility_value "$setting" "$accessibility_query"); then
				if ! default=$(persisted_default "$accessibility_key" "$setting"); then default=$value; fi
				emit_setting "$accessibility_key" "$setting" "$label" boolean "$value" "$default" 0 1
			else
				emit_unsupported "$accessibility_key" "$setting" "dwm-xkbset did not report this XKB control"
			fi
		done
	else
		emit_unsupported "$accessibility_key" accessx "Keyboard accessibility controls need dwm-xkbset and an X11 session"
	fi
	for index in "${!device_ids[@]}"; do
		read -r -a ids <<<"${device_ids[$index]}"
		id=${ids[0]}
		key=${device_keys[$index]}
		kind=${device_kinds[$index]}
		name=${device_names[$index]}
		# A merged card's parts' properties, first part first: each setting
		# shows the first part that has it.
		properties=$(input_tempfile)
		for part in "${ids[@]}"; do
			if ! xinput list-props "$part" >>"$properties" 2>/dev/null; then
				rm -f "$properties"
				continue 2
			fi
		done
		id=$(
			IFS=,
			printf '%s' "${ids[*]}"
		)
		printf 'device\t%s\t%s\t%s\t%s\n' "$key" "$id" "$kind" "$(clean_field "$name")"
		id=${ids[0]}
		if [[ ${device_persistable[$index]} != 1 ]]; then
			emit_unsupported "$key" persistence "No stable udev serial, path, or physical sysfs identity; changes are session-only"
		fi
		if [[ $kind == pointer || $kind == touchpad ]]; then
			value=$(property_value "$properties" "libinput Accel Speed")
			default=$(property_value "$properties" "libinput Accel Speed Default")
			if [[ -n $value ]]; then
				emit_setting "$key" pointer-speed "Pointer acceleration / speed" number "$value" "${default:-0}" -1 1
			else
				emit_unsupported "$key" pointer-speed "The X11 driver does not expose libinput acceleration"
			fi
			value=$(property_value "$properties" "libinput Natural Scrolling Enabled")
			default=$(property_value "$properties" "libinput Natural Scrolling Enabled Default")
			if [[ -n $value ]]; then
				emit_setting "$key" natural-scroll "Natural scrolling" boolean "$value" "${default:-0}" 0 1
			else
				emit_unsupported "$key" natural-scroll "The X11 driver does not expose natural scrolling"
			fi
			value=$(property_value "$properties" "libinput Tapping Enabled")
			default=$(property_value "$properties" "libinput Tapping Enabled Default")
			if [[ -n $value ]]; then
				emit_setting "$key" tap-to-click "Tap to click" boolean "$value" "${default:-0}" 0 1
			else
				emit_unsupported "$key" tap-to-click "The X11 driver does not expose tap-to-click"
			fi
		fi
		if [[ $kind == keyboard ]]; then
			if command -v setxkbmap >/dev/null 2>&1; then
				if keyboard_query=$(setxkbmap -device "$id" -query 2>/dev/null); then
					layout=$(awk '$1 == "layout:" {print $2; exit}' <<<"$keyboard_query")
					options=$(awk '$1 == "options:" {$1=""; sub(/^[[:space:]]+/, ""); print; exit}' <<<"$keyboard_query")
					if [[ -n $layout ]]; then
						if ! default=$(persisted_default "$key" keyboard-layout); then default=$layout; fi
						emit_setting "$key" keyboard-layout "Keyboard layout" text "$layout" "$default" 0 0
					else
						emit_unsupported "$key" keyboard-layout "setxkbmap did not report a keyboard layout"
					fi
					if ! default=$(persisted_default "$key" modifier-options); then default=$options; fi
					emit_setting "$key" modifier-options "Modifier options" text "$options" "$default" 0 0
				else
					emit_unsupported "$key" keyboard-layout "setxkbmap could not query this keyboard"
					emit_unsupported "$key" modifier-options "setxkbmap could not query this keyboard"
				fi
			else
				emit_unsupported "$key" keyboard-layout "setxkbmap is unavailable"
				emit_unsupported "$key" modifier-options "setxkbmap is unavailable"
			fi
			emit_unsupported "$key" repeat "Per-device key repeat is not exposed by X11"
		fi
		rm -f "$properties"
	done
}

setting_property() {
	case $1 in
	pointer-speed) printf '%s\n' "libinput Accel Speed" ;;
	natural-scroll) printf '%s\n' "libinput Natural Scrolling Enabled" ;;
	tap-to-click) printf '%s\n' "libinput Tapping Enabled" ;;
	*) return 1 ;;
	esac
}

validate_value() {
	local setting=$1 value=$2
	case $setting in
	pointer-speed)
		[[ $value =~ ^-?[0-9]+([.][0-9]+)?$ ]] || return 1
		awk -v value="$value" 'BEGIN { exit !(value >= -1 && value <= 1) }'
		;;
	natural-scroll | tap-to-click | accessx-shortcuts | sticky-keys | slow-keys | bounce-keys | mouse-keys)
		[[ $value == 0 || $value == 1 ]]
		;;
	keyboard-layout) [[ $value =~ ^[A-Za-z0-9_-]+(,[A-Za-z0-9_-]+)*$ ]] ;;
	modifier-options) [[ $value =~ ^[A-Za-z0-9_:+,.-]*$ ]] ;;
	*) return 1 ;;
	esac
}

# One part's value, by X id.
read_part() {
	local id=$1 setting=$2 properties property value
	case $setting in
	keyboard-layout)
		need_setxkbmap
		# awk reads to the end and keeps the first match: an `exit` there can close
		# the pipe while setxkbmap still writes, and under pipefail its SIGPIPE
		# (141) ended this helper (#485).
		setxkbmap -device "$id" -query | awk '$1 == "layout:" && !done {print $2; done = 1}'
		;;
	modifier-options)
		need_setxkbmap
		setxkbmap -device "$id" -query | awk '$1 == "options:" && !done {$1=""; sub(/^[[:space:]]+/, ""); print; done = 1}'
		;;
	*)
		property=$(setting_property "$setting") || die "unsupported setting: $setting"
		# No RETURN trap: it would stay set after this returns (#473).
		properties=$(input_tempfile)
		if ! xinput list-props "$id" >"$properties"; then
			rm -f "$properties"
			return 1
		fi
		value=$(property_value "$properties" "$property")
		rm -f "$properties"
		[[ -n $value ]] || return 1
		printf '%s\n' "$value"
		;;
	esac
}

# Whether a part has the setting: every keyboard part has the XKB ones; an
# XInput property only where the driver exposes it. 1: it does not; 2: its
# properties could not be read, which is not the same.
part_supports() {
	local id=$1 setting=$2 property properties value
	case $setting in
	keyboard-layout | modifier-options) return 0 ;;
	esac
	property=$(setting_property "$setting") || return 1
	properties=$(input_tempfile)
	if ! xinput list-props "$id" >"$properties" 2>/dev/null; then
		rm -f "$properties"
		return 2
	fi
	value=$(property_value "$properties" "$property")
	rm -f "$properties"
	[[ -n $value ]]
}

apply_part() {
	local id=$1 setting=$2 value=$3 property
	case $setting in
	keyboard-layout)
		need_setxkbmap
		setxkbmap -device "$id" -layout "$value"
		;;
	modifier-options)
		need_setxkbmap
		setxkbmap -device "$id" -option '' -option "$value"
		;;
	*)
		property=$(setting_property "$setting") || die "unsupported setting: $setting"
		xinput set-prop "$id" "$property" "$value"
		;;
	esac
}

# The device's value: its first part that has the setting.
read_value() {
	local key=$1 setting=$2 line id value
	if [[ $key == "$accessibility_key" ]]; then
		accessibility_value "$setting"
		return
	fi
	setting_property "$setting" >/dev/null || [[ $setting == keyboard-layout || $setting == modifier-options ]] ||
		die "unsupported setting: $setting"
	while IFS= read -r line; do
		id=${line#*$'\t'}
		part_supports "$id" "$setting" || continue
		value=$(read_part "$id" "$setting") || continue
		printf '%s\n' "$value"
		return 0
	done < <(resolve_parts "$key" || printf 'unresolved\n')
	[[ $line != unresolved ]] || return 1
	die "$setting is unsupported by device $key"
}

# Each part that has the setting, as "PART-KEY=VALUE" joined by ";": what a
# preview of a merged card restores, part by part, even after a replug gives
# the parts new X ids. A device of one part is its plain value.
snapshot_value() {
	local key=$1 setting=$2 line part id value snapshot='' count=0 supported
	if [[ $key == "$accessibility_key" ]]; then
		accessibility_value "$setting"
		return
	fi
	local -a lines=()
	mapfile -t lines < <(resolve_parts "$key" || printf 'unresolved\n')
	[[ ${lines[0]:-unresolved} != unresolved ]] || return 1
	if ((${#lines[@]} == 1)); then
		read_value "$key" "$setting"
		return
	fi
	for line in "${lines[@]}"; do
		part=${line%%$'\t'*}
		id=${line#*$'\t'}
		# A part that could not be asked would go uncaptured, and Revert could
		# not give its value back: nothing is changed then.
		supported=0
		part_supports "$id" "$setting" || supported=$?
		((supported != 2)) || die "could not read part $id of device $key; nothing was changed"
		((supported == 0)) || continue
		value=$(read_part "$id" "$setting") || die "could not read $setting from a part of device $key"
		[[ $value != *[\;=]* ]] || die "a part's value contains a reserved separator"
		snapshot+=${snapshot:+;}$part=$value
		count=$((count + 1))
	done
	((count > 0)) || die "$setting is unsupported by device $key"
	printf '%s\n' "$snapshot"
}

# Puts back what snapshot_value captured. Every part is tried; a part that
# cannot be put back (unplugged) fails the whole, so the preview keeps its
# recovery state and a later retry restores it.
restore_value() {
	local key=$1 setting=$2 previous=$3 entry part id status=0
	local -a entries=()
	if [[ $key == "$accessibility_key" || $previous != *=* ]]; then
		apply_value "$key" "$setting" "$previous"
		return
	fi
	IFS=';' read -r -a entries <<<"$previous"
	for entry in "${entries[@]}"; do
		part=${entry%%=*}
		id=$(resolve_device "$part" 2>/dev/null) || {
			status=1
			continue
		}
		(apply_part "$id" "$setting" "${entry#*=}") || status=1
	done
	return "$status"
}

# Applies VALUE to every part of the device that has the setting, or to none:
# when a part fails, the parts already changed are put back. If one of those
# cannot be put back either, it exits 3 and says which, so a preview keeps its
# recovery state instead of clearing it.
apply_value() {
	local key=$1 setting=$2 value=$3 line id i j part_value supported stuck=''
	local -a targets=() previous=()
	validate_value "$setting" "$value" || die "invalid value for $setting"
	if [[ $key == "$accessibility_key" ]]; then
		apply_accessibility_value "$setting" "$value"
		return
	fi
	local -a lines=()
	mapfile -t lines < <(resolve_parts "$key" || printf 'unresolved\n')
	[[ ${lines[0]:-unresolved} != unresolved ]] || return 1
	if ((${#lines[@]} == 1)); then
		apply_part "${lines[0]#*$'\t'}" "$setting" "$value"
		return
	fi
	for line in "${lines[@]}"; do
		id=${line#*$'\t'}
		supported=0
		part_supports "$id" "$setting" || supported=$?
		((supported != 2)) || die "could not read part $id of device $key; nothing was changed"
		((supported == 0)) || continue
		part_value=$(read_part "$id" "$setting") || die "could not read $setting from part $id of device $key"
		targets+=("$id")
		previous+=("$part_value")
	done
	((${#targets[@]} > 0)) || die "$setting is unsupported by device $key"
	for i in "${!targets[@]}"; do
		(apply_part "${targets[$i]}" "$setting" "$value") && continue
		for ((j = 0; j < i; j++)); do
			(apply_part "${targets[$j]}" "$setting" "${previous[$j]}") || stuck+=" ${targets[$j]}"
		done
		if [[ -n $stuck ]]; then
			printf 'dwm-settings-input: %s failed on part %s of device %s, and part(s)%s could not be put back\n' \
				"$setting" "${targets[$i]}" "$key" "$stuck" >&2
			exit 3
		fi
		die "$setting failed on part ${targets[$i]} of device $key; the other parts were put back"
	done
}

persist_value() {
	local key=$1 setting=$2 value=$3 baseline=${4-} persistable=${5:-} temporary existing_baseline parts
	if [[ -z $persistable ]]; then
		if device_can_persist "$key"; then persistable=1; else persistable=0; fi
	fi
	[[ $persistable == 0 || $persistable == 1 ]] || die "invalid captured persistence state"
	if [[ $persistable == 0 ]]; then
		printf 'dwm-settings-input: device %s has no stable persistence identity; keeping the session value only\n' "$key" >&2
		return 0
	fi
	mkdir -p "$settings_dir"
	[[ $settings_dir != "$config_dir" ]] || chmod 700 "$settings_dir"
	# A merged card's value replaces what its parts had saved for the setting
	# on their own (#473), which would otherwise apply after it at login.
	parts=$(resolve_parts "$key" 2>/dev/null | cut -f1 | tr '\n' ' ') || parts=''
	temporary=$(mktemp "$settings_dir/.input-settings.XXXXXX")
	if [[ -f $settings_file ]]; then
		if existing_baseline=$(persisted_default "$key" "$setting"); then
			baseline=$existing_baseline
		fi
		awk -F '\t' -v key="$key" -v setting="$setting" -v parts="$parts" '
			BEGIN { n = split(parts, list, " "); for (i = 1; i <= n; i++) part[list[i]] = 1 }
			!($2 == setting && ($1 == key || $1 in part))
		' "$settings_file" >"$temporary"
	fi
	printf '%s\t%s\t%s\t%s\n' "$key" "$setting" "$value" "$baseline" >>"$temporary"
	chmod 600 "$temporary"
	mv -fT "$temporary" "$settings_file"
}

persisted_default() {
	local key=$1 setting=$2
	[[ -f $settings_file ]] || return 1
	awk -F '\t' -v key="$key" -v setting="$setting" '
		$1 == key && $2 == setting && NF >= 4 { print $4; found = 1; exit }
		END { exit !found }
	' "$settings_file"
}

remove_persisted_value() {
	local key=$1 setting=$2 temporary parts
	[[ -f $settings_file ]] || return 0
	mkdir -p "$settings_dir"
	[[ $settings_dir != "$config_dir" ]] || chmod 700 "$settings_dir"
	# A merged card's parts' own entries go with it (#473), or they would
	# apply again at login.
	parts=$(resolve_parts "$key" 2>/dev/null | cut -f1 | tr '\n' ' ') || parts=''
	temporary=$(mktemp "$settings_dir/.input-settings.XXXXXX")
	awk -F '\t' -v key="$key" -v setting="$setting" -v parts="$parts" '
		BEGIN { n = split(parts, list, " "); for (i = 1; i <= n; i++) part[list[i]] = 1 }
		!($2 == setting && ($1 == key || $1 in part))
	' "$settings_file" >"$temporary"
	if [[ -s $temporary ]]; then
		chmod 600 "$temporary"
		mv -fT "$temporary" "$settings_file"
	else
		rm -f "$temporary" "$settings_file"
	fi
}

ensure_state_dir() {
	if [[ ! -e $runtime_base ]]; then
		mkdir -m 700 "$runtime_base" 2>/dev/null || true
	fi
	[[ -d $runtime_base && ! -L $runtime_base ]] || die "unsafe runtime base directory"
	[[ $(stat -c %u "$runtime_base") == "$UID" ]] || die "runtime base directory has the wrong owner"
	[[ $(stat -c %a "$runtime_base") == 700 ]] || die "runtime base directory is too permissive"
	if [[ ! -e $state_dir ]]; then
		mkdir -m 700 "$state_dir" 2>/dev/null || true
	fi
	[[ -d $state_dir && ! -L $state_dir ]] || die "unsafe preview state directory"
	[[ $(stat -c %u "$state_dir") == "$UID" ]] || die "preview state directory has the wrong owner"
	[[ $(stat -c %a "$state_dir") == 700 ]] || die "preview state directory is too permissive"
}

acquire_mutation_lock() {
	local mutation_lock
	command -v flock >/dev/null 2>&1 || die "flock is unavailable"
	ensure_state_dir
	mutation_lock=$state_dir/input-mutation.lock
	preview_lock "$mutation_lock" 7 || die "unsafe input mutation lock"
}

token_file() {
	preview_valid_token "$1" || die "invalid preview token"
	printf '%s/%s.%s\n' "$state_dir" "$1" "$2"
}
# Removes the preview's files. The reservation goes only when it is this
# preview's: an old token must never free a newer preview's (#371).
cleanup_preview() {
	local current_token=
	rm -f "$(token_file "$1" state)" "$(token_file "$1" failed)" \
		"$(token_file "$1" session)" "$(token_file "$1" watch)"
	if [[ -f $state_dir/current ]]; then
		IFS= read -r current_token <"$state_dir/current" || current_token=
		[[ $current_token != "$1" ]] || rm -f "$state_dir/current"
	fi
	rmdir "$(token_file "$1" claim)" 2>/dev/null || true
}

# The finalize claim, taken under the mutation lock: a claim left behind is by
# then always one whose holder has exited (Quickshell restarted, the session
# ended), and is removed (#371).
claim_preview() {
	local token=$1 claim
	claim=$(token_file "$token" claim)
	rmdir -- "$claim" 2>/dev/null || true
	mkdir "$claim" 2>/dev/null || die "input preview is already being finalized"
	printf '%s\n' "$claim"
}

# A preview belongs to the X server it was made on and to the watchdog that
# reverts it, as display previews do (#369, #371). A session that ended
# mid-preview took the watchdog with it and left the preview active for good.
record_preview_session() {
	local session identity
	session=$(token_file "$1" session)
	identity=$(x11_session_identity "${DISPLAY:-}") || identity=
	printf '%s\t%s\n' "$(normalize_x11_display "${DISPLAY:-}")" "$identity" >"$session"
	chmod 600 "$session"
}

record_preview_watchdog() {
	local watch start
	watch=$(token_file "$1" watch)
	start=$(proc_starttime "$2") || start=
	printf '%s %s\n' "$2" "$start" >"$watch"
	chmod 600 "$watch"
}

# preview_foreign TOKEN: the preview was made on an X server that is no longer
# running (its display's server is gone or was restarted), so its captured value
# means nothing now and is never applied. A preview from before these records
# (no watch file) is foreign once older than any timeout can be.
preview_foreign() {
	local token=$1 state session watch display='' recorded='' current
	state=$(token_file "$token" state)
	session=$(token_file "$token" session)
	watch=$(token_file "$token" watch)
	[[ -f $state ]] || return 1
	if [[ -s $session ]]; then
		IFS=$'\t' read -r display recorded <"$session" || :
		[[ -n $recorded ]] || return 1
		current=$(x11_session_identity "$display") || current=
		[[ $current == "$recorded" ]] && return 1
		return 0
	fi
	[[ ! -f $watch ]] || return 1
	[[ -n $(find "$state" -maxdepth 0 -mmin +10 2>/dev/null) ]]
}

# preview_orphaned TOKEN: the preview is on the server running now and still
# active, but its watchdog is gone, so nothing will revert it. It is kept: its
# captured value is still good here, and Keep or Revert decides.
preview_orphaned() {
	local token=$1 state session watch failed pid='' start=''
	state=$(token_file "$token" state)
	session=$(token_file "$token" session)
	watch=$(token_file "$token" watch)
	failed=$(token_file "$token" failed)
	[[ -f $state && ! -f $failed ]] || return 1
	if [[ ! -f $watch ]]; then
		# Its session is recorded but no watchdog was: the preview died while
		# applying, before starting one. Orphaned once older than the longest
		# timeout (99 s) can be; a preview with no records at all is
		# preview_foreign's.
		[[ -s $session ]] || return 1
		[[ -n $(find "$state" -maxdepth 0 -mmin +2 2>/dev/null) ]]
		return
	fi
	read -r pid start <"$watch" || :
	[[ -n $pid && -n $start ]] && preview_process_owned "$pid" "$start" && return 1
	return 0
}

preview_value() {
	local token=$1 seconds=$2 key=$3 setting=$4 value=$5 previous state persistable=0 apply_status=0 failed
	[[ $seconds =~ ^[1-9][0-9]?$ ]] || die "preview timeout must be between 1 and 99 seconds"
	ensure_state_dir
	validate_value "$setting" "$value" || die "invalid value for $setting"
	state=$(token_file "$token" state)
	previous=$(snapshot_value "$key" "$setting")
	device_can_persist "$key" && persistable=1
	[[ $previous != *'|'* ]] || die "captured value contains the reserved preview-state separator"
	if ! (
		set -o noclobber
		: >"$state"
	) 2>/dev/null; then
		die "preview token is already in use"
	fi
	if ! printf '%s|%s|%s|%s|%s\n' "$key" "$setting" "$previous" "$value" "$persistable" >"$state"; then
		rm -f "$state"
		die "could not write input preview recovery state"
	fi
	chmod 600 "$state"
	if ! (
		set -o noclobber
		printf '%s\n' "$token" >"$state_dir/current"
	) 2>/dev/null; then
		rm -f "$state"
		die "another input preview is active"
	fi
	record_preview_session "$token"
	(apply_value "$key" "$setting" "$value") || apply_status=$?
	if ((apply_status == 3)); then
		# A merged device's part failed and another could not be put back:
		# keep the captured values, so Revert can retry them (#473).
		failed=$(token_file "$token" failed)
		printf 'The change failed on one part of the device and another part could not be put back; Revert retries it.\n' >"$failed"
		chmod 600 "$failed"
		# On stdout too, as preview-status reports it, so Settings offers
		# Revert for this token now.
		printf 'preview-failed\t%s\t%s\n' "$token" "$(clean_field "$(<"$failed")")"
		die "input preview failed on part of the device; recovery state was retained for Revert"
	elif ((apply_status != 0)); then
		cleanup_preview "$token"
		die "input preview failed; recovery state was cleared"
	fi
	# exec: the recorded PID is the watchdog itself, not a subshell around it.
	# The mutation lock's descriptor is not inherited.
	(exec "$self" _watch "$token" "$seconds" >/dev/null 2>&1 7>&-) &
	record_preview_watchdog "$token" "$!"
	printf 'preview\t%s\t%s\n' "$token" "$seconds"
}

finish_preview() {
	local action=$1 token=$2 state key setting previous value persistable claim
	ensure_state_dir
	state=$(token_file "$token" state)
	if preview_foreign "$token"; then
		cleanup_preview "$token"
		printf 'result\tstale\t%s\n' "$token"
		return 0
	fi
	[[ -f $state ]] || die "input preview is not active"
	claim=$(claim_preview "$token")
	trap 'rmdir "$claim" 2>/dev/null || true' RETURN
	IFS='|' read -r key setting previous value persistable <"$state"
	if [[ $action == keep ]]; then
		[[ $previous != *=* || $key == "$accessibility_key" ]] || previous=${previous%%;*} previous=${previous#*=}
		persist_value "$key" "$setting" "$value" "$previous" "$persistable"
	elif ! (restore_value "$key" "$setting" "$previous"); then
		printf 'Input rollback failed; the captured value is retained for retry.\n' >"$(token_file "$token" failed)"
		chmod 600 "$(token_file "$token" failed)"
		rmdir "$claim" 2>/dev/null || true
		die "input device is unavailable; preview state was retained for rollback retry"
	fi
	cleanup_preview "$token"
	if [[ $action == keep ]]; then
		apply_pending_hotplug
	else
		apply_pending_hotplug "$key" "$setting"
	fi
	printf 'result\t%s\t%s\n' "$action" "$token"
}

watchdog() {
	local token=$1 seconds=$2 state key setting previous value persistable claim failed
	sleep "$seconds"
	acquire_mutation_lock
	state=$(token_file "$token" state)
	# Kept, reverted or failed while asleep: nothing to do. The lock was waited
	# for, so a finalize that held it has finished (#371).
	if [[ -f $state && ! -f $(token_file "$token" failed) ]]; then
		# A server that is not the preview's own gets nothing of it.
		if preview_foreign "$token"; then
			cleanup_preview "$token"
			return 0
		fi
		claim=$(claim_preview "$token")
		IFS='|' read -r key setting previous value persistable <"$state"
		if (restore_value "$key" "$setting" "$previous"); then
			cleanup_preview "$token"
			apply_pending_hotplug "$key" "$setting"
		else
			failed=$(token_file "$token" failed)
			printf 'Automatic input rollback failed; the captured value is retained for retry.\n' >"$failed"
			chmod 600 "$failed"
			rmdir "$claim" 2>/dev/null || true
		fi
	fi
}

preview_status() {
	local token=${1:-} state failed
	ensure_state_dir
	if [[ -z $token ]]; then
		if [[ ! -f $state_dir/current ]]; then
			printf 'result\tnone\n'
			return
		fi
		IFS= read -r token <"$state_dir/current"
		[[ -n $token ]] || die "active input preview token is empty"
	fi
	state=$(token_file "$token" state)
	failed=$(token_file "$token" failed)
	if preview_foreign "$token" || preview_orphaned "$token" ||
		[[ ! -f $state && -f $state_dir/current ]]; then
		acquire_mutation_lock
		if preview_foreign "$token"; then
			cleanup_preview "$token"
			printf 'result\tstale\t%s\n' "$token"
			return
		fi
		if preview_orphaned "$token"; then
			printf 'The automatic rollback is no longer running.\n' >"$failed"
			chmod 600 "$failed"
		elif [[ ! -f $state && ! -f $failed ]]; then
			# A reservation with nothing behind it refused every new preview.
			cleanup_preview "$token"
		fi
	fi
	if [[ -f $failed ]]; then
		printf 'preview-failed\t%s\t%s\n' "$token" "$(clean_field "$(<"$failed")")"
	elif [[ -f $state ]]; then
		printf 'preview-active\t%s\n' "$token"
	else
		printf 'result\texpired\t%s\n' "$token"
	fi
}

reset_setting() {
	local key=$1 setting=$2 id properties default_name default line
	if [[ $key == "$accessibility_key" ]]; then
		case $setting in
		accessx-shortcuts | sticky-keys | slow-keys | bounce-keys | mouse-keys) ;;
		*) die "unsupported setting: $setting" ;;
		esac
		if ! default=$(persisted_default "$key" "$setting"); then
			default=$(read_value "$key" "$setting")
		fi
		apply_value "$key" "$setting" "$default"
		remove_persisted_value "$key" "$setting"
		printf 'result\treset\t%s\n' "$setting"
		return
	fi
	case $setting in
	pointer-speed) default_name="libinput Accel Speed Default" ;;
	natural-scroll) default_name="libinput Natural Scrolling Enabled Default" ;;
	tap-to-click) default_name="libinput Tapping Enabled Default" ;;
	keyboard-layout | modifier-options)
		if ! default=$(persisted_default "$key" "$setting"); then
			default=$(read_value "$key" "$setting")
		fi
		;;
	*) die "unsupported setting: $setting" ;;
	esac
	if [[ -z ${default+x} ]]; then
		# The first part of the card that has the setting: a merged card's
		# first part may not (#473).
		id=
		local -a lines=()
		mapfile -t lines < <(resolve_parts "$key" || printf 'unresolved\n')
		[[ ${lines[0]:-unresolved} != unresolved ]] || return 1
		for line in "${lines[@]}"; do
			part_supports "${line#*$'\t'}" "$setting" || continue
			id=${line#*$'\t'}
			break
		done
		[[ -n $id ]] || die "$setting is unsupported by device $key"
		properties=$(input_tempfile)
		trap 'rm -f "$properties"' RETURN
		xinput list-props "$id" >"$properties"
		default=$(property_value "$properties" "$default_name")
		[[ -n $default ]] || die "default is unavailable for $setting"
	fi
	apply_value "$key" "$setting" "$default"
	remove_persisted_value "$key" "$setting"
	printf 'result\treset\t%s\n' "$setting"
}

apply_saved() {
	local skip_key=${1:-} skip_setting=${2:-} line key setting value baseline remainder pending
	pending=$state_dir/hotplug-replay.pending
	if [[ -f $state_dir/current ]]; then
		: >"$pending"
		chmod 600 "$pending"
		return 0
	fi
	rm -f "$pending"
	[[ -f $settings_file ]] || return 0
	while IFS= read -r line <&3; do
		[[ $line == *$'\t'*$'\t'* ]] || continue
		key=${line%%$'\t'*}
		remainder=${line#*$'\t'}
		setting=${remainder%%$'\t'*}
		remainder=${remainder#*$'\t'}
		if [[ $remainder == *$'\t'* ]]; then
			value=${remainder%%$'\t'*}
			baseline=${remainder#*$'\t'}
		else
			value=$remainder
			baseline=
		fi
		[[ -n $key && -n $setting ]] || continue
		[[ $key != "$skip_key" || $setting != "$skip_setting" ]] || continue
		(apply_value "$key" "$setting" "$value") ||
			printf 'dwm-settings-input: skipped unavailable %s/%s\n' "$key" "$setting" >&2
	done 3<"$settings_file"
}

apply_pending_hotplug() {
	local skip_key=${1:-} skip_setting=${2:-}
	[[ -f $state_dir/hotplug-replay.pending ]] || return 0
	apply_saved "$skip_key" "$skip_setting"
}

# With builtins only, as it runs all session (Sync Sprint 16 R16-32). A zombie
# has exited: waitpid returns at once for it, so counting it alive would spin
# until its parent reaps it.
session_parent_alive() {
	local session_pid=${DWM_INPUT_SESSION_PID:-} expected_start=${DWM_INPUT_SESSION_START:-}
	proc_alive "$session_pid" || return 1
	[[ -z $expected_start || $proc_start == "$expected_start" ]]
}

cleanup_watch_apply() {
	if [[ -n $watch_session_guard_pid ]]; then
		kill "$watch_session_guard_pid" 2>/dev/null || true
		wait "$watch_session_guard_pid" 2>/dev/null || true
	fi
	if [[ -n $watch_monitor_pid ]]; then
		kill "$watch_monitor_pid" 2>/dev/null || true
		wait "$watch_monitor_pid" 2>/dev/null || true
	fi
	[[ -z $watch_event_fifo ]] || rm -f "$watch_event_fifo"
	[[ -z $input_scratch ]] || rm -rf -- "$input_scratch"
}

watch_events() {
	simple_watch_events input input "$@"
}

watch_apply_events() {
	local line read_status stream_open=1 watch_lock watcher_pid session_pid session_start
	need_tools
	command -v udevadm >/dev/null 2>&1 || die "udevadm is unavailable"
	command -v flock >/dev/null 2>&1 || die "flock is unavailable"
	ensure_state_dir
	hotplug_settle_seconds=${DWM_INPUT_HOTPLUG_SETTLE_SECONDS:-1}
	[[ $hotplug_settle_seconds =~ ^[0-9]+([.][0-9]+)?$ ]] &&
		[[ ! $hotplug_settle_seconds =~ ^0+([.]0+)?$ ]] || die "hotplug settle interval must be positive"
	watch_lock=$state_dir/hotplug-watch.lock
	preview_lock "$watch_lock" 9 0 || {
		(($? == 1)) || die "unsafe input hotplug watcher lock"
		die "input hotplug watcher is already running"
	}
	trap 'exit 0' HUP INT TERM
	trap cleanup_watch_apply EXIT
	session_pid=${DWM_INPUT_SESSION_PID:-}
	session_start=${DWM_INPUT_SESSION_START:-}
	if [[ -n $session_pid || -n $session_start ]]; then
		[[ $session_pid =~ ^[1-9][0-9]*$ ]] || die "invalid input watcher session PID"
		[[ -z $session_start || $session_start =~ ^[1-9][0-9]*$ ]] ||
			die "invalid input watcher session start identity"
		session_parent_alive || die "input watcher session process is unavailable"
		watcher_pid=$BASHPID
		# util-linux's waitpid blocks on the session process until it exits,
		# with no wakeups (#288). Without it, or if it fails, every 5 s, as
		# dwm-watchdog.sh's backstop: one sleep, where this used to start about
		# 8 processes a second (Sync Sprint 16 R16-32). The start identity is
		# checked again after each wait, so a reused PID never keeps it going.
		session_poll_seconds=${DWM_INPUT_SESSION_POLL_SECONDS:-5}
		[[ $session_poll_seconds =~ ^[0-9]+([.][0-9]+)?$ ]] || session_poll_seconds=5
		(
			while session_parent_alive; do
				if ! command -v waitpid >/dev/null 2>&1 ||
					! waitpid -- "$session_pid" >/dev/null 2>&1; then
					sleep "$session_poll_seconds"
				fi
			done
			kill -TERM "$watcher_pid" 2>/dev/null || true
		) &
		watch_session_guard_pid=$!
	fi
	watch_event_fifo=$state_dir/hotplug-events.$BASHPID
	[[ ! -e $watch_event_fifo ]] || die "unsafe input hotplug event pipe"
	mkfifo -m 600 "$watch_event_fifo"
	udevadm monitor --udev --subsystem-match=input --property >"$watch_event_fifo" 2>/dev/null &
	watch_monitor_pid=$!
	exec 8<"$watch_event_fifo"
	rm -f "$watch_event_fifo"
	watch_event_fifo=
	while IFS= read -r line <&8; do
		case $line in
		ACTION=add | ACTION=bind | ACTION=change)
			while :; do
				if IFS= read -r -t "$hotplug_settle_seconds" line <&8; then
					continue
				else
					read_status=$?
				fi
				if ((read_status < 128)); then
					sleep "$hotplug_settle_seconds"
					stream_open=0
				fi
				break
			done
			"$self" apply-saved || true
			((stream_open == 1)) || break
			;;
		esac
	done
}

# Every action but watch, whose shared watcher sets its own EXIT trap and never
# reads xinput (watch-apply removes the folder in cleanup_watch_apply).
case ${1:-} in
watch) ;;
*)
	input_scratch=$(mktemp -d)
	trap 'rm -rf -- "$input_scratch"' EXIT
	trap 'exit 129' HUP
	trap 'exit 130' INT
	trap 'exit 143' TERM
	;;
esac

case ${1:-} in
discover)
	[[ $# == 1 ]] || die "discover takes no arguments"
	discover
	;;
watch)
	[[ $# == 3 ]] || die "watch requires an owner PID and start identity"
	watch_events "$2" "$3"
	;;
watch-apply)
	[[ $# == 1 ]] || die "watch-apply takes no arguments"
	watch_apply_events
	;;
apply-saved)
	[[ $# == 1 ]] || die "apply-saved takes no arguments"
	acquire_mutation_lock
	apply_saved
	;;
preview)
	[[ $# == 6 ]] || die "preview requires token, timeout, device, setting, and value"
	acquire_mutation_lock
	preview_value "$2" "$3" "$4" "$5" "$6"
	;;
keep | revert)
	[[ $# == 2 ]] || die "$1 requires a token"
	acquire_mutation_lock
	finish_preview "$1" "$2"
	;;
preview-status)
	[[ $# == 1 || $# == 2 ]] || die "preview-status accepts an optional token"
	preview_status "${2:-}"
	;;
reset)
	[[ $# == 3 ]] || die "reset requires device and setting"
	acquire_mutation_lock
	reset_setting "$2" "$3"
	;;
_watch)
	[[ $# == 3 ]] || exit 2
	watchdog "$2" "$3"
	;;
-h | --help | help) usage ;;
*)
	usage
	exit 2
	;;
esac
