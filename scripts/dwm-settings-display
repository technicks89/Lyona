#!/usr/bin/env bash
set -euo pipefail

# A checkout keeps the shared shell code beside the scripts; an install keeps it
# in PREFIX/lib/lyona, beside PREFIX/bin (Sync Sprint 12 S12-13).
lyona_lib=${BASH_SOURCE[0]%/*}
[[ -f $lyona_lib/dwm-simple-watch.sh ]] || lyona_lib=${lyona_lib%bin}lib/lyona
# shellcheck source=scripts/dwm-simple-watch.sh
. "$lyona_lib/dwm-simple-watch.sh"
# The token primitive (#277).
# shellcheck source=scripts/dwm-preview-core.sh
. "$lyona_lib/dwm-preview-core.sh"
# shellcheck source=scripts/dwm-xsession.sh
. "$lyona_lib/dwm-xsession.sh"
# shellcheck source=scripts/dwm-xsettings-config.sh
. "$lyona_lib/dwm-xsettings-config.sh"
# shellcheck source=scripts/dwm-trust.sh
. "$lyona_lib/dwm-trust.sh"

# shellcheck source=scripts/dwm-xdg.sh
. "$lyona_lib/dwm-xdg.sh"
lyona_xdg_dirs
config_dir=$config_home/lyona
profile_dir="${DWM_DISPLAY_PROFILE_DIR:-$config_dir/display-profiles}"
dpi_resources="${DWM_DPI_RESOURCES:-$config_dir/dpi.Xresources}"
xsettings_config="${DWM_XSETTINGS_CONFIG:-$config_dir/xsettingsd.conf}"
default_dpi=96
minimum_dpi=72
maximum_dpi=384
runtime_base="${XDG_RUNTIME_DIR:-/tmp/lyona-$UID}"
state_dir="$runtime_base/dwm-settings-display"
# The layout last kept in Settings, which the next login applies again: Keep
# alone lasted only for the session, so a chosen resolution was back to the
# default at every login.
kept_layout="${DWM_DISPLAY_KEPT_LAYOUT:-$state_home/lyona/display-kept.conf}"
dpi_state="$state_dir/dpi.current"
managed_config="${DWM_XORG_CONFIG:-/etc/X11/xorg.conf.d/90-lyona-display.conf}"

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
setup_helper="${DWM_DISPLAY_SETUP:-$script_dir/dwm-display-setup}"
picom_helper="${DWM_DISPLAY_PICOM_HELPER:-$script_dir/dwm-settings-picom}"
self="$script_dir/${BASH_SOURCE[0]##*/}"

usage() {
	cat >&2 <<'EOF'
usage: dwm-settings-display discover|watch OWNER_PID OWNER_START
       dwm-settings-display save NAME SPEC...
       dwm-settings-display preview TOKEN SECONDS SPEC...
       dwm-settings-display preview-profile TOKEN SECONDS NAME
       dwm-settings-display keep TOKEN [NAME]
       dwm-settings-display apply-kept
       dwm-settings-display revert TOKEN
       dwm-settings-display discard TOKEN
       dwm-settings-display preview-status [TOKEN]
       dwm-settings-display install-profile NAME
       dwm-settings-display rollback-system
       dwm-settings-display dpi-set VALUE
       dwm-settings-display dpi-reset
       dwm-settings-display dpi-apply-saved

SPEC is output|enabled|mode|rate|x|y|rotation|primary.
VALUE is an integer Xft DPI between 72 and 384.
EOF
}

die() {
	printf 'dwm-settings-display: %s\n' "$*" >&2
	exit 1
}

clean_field() {
	printf '%s' "$1" | tr '\011\015\012' '   '
}

valid_name() {
	[[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ && $1 != *..* ]]
}

profile_path() {
	valid_name "$1" || die "invalid profile name: $1"
	printf '%s/%s.conf\n' "$profile_dir" "$1"
}

ensure_state_dir() {
	if [[ ! -e $runtime_base ]]; then
		mkdir -m 700 "$runtime_base" 2>/dev/null || true
	fi
	[[ -d $runtime_base && ! -L $runtime_base ]] || die "unsafe runtime base directory"
	[[ $(stat -c %u "$runtime_base") == "$UID" ]] || die "runtime base directory has the wrong owner"
	[[ $(stat -c %a "$runtime_base") == 700 ]] || die "runtime base directory is too permissive"
	if [[ ! -e $state_dir ]]; then
		mkdir -m 700 "$state_dir" 2>/dev/null || true
	fi
	[[ -d $state_dir && ! -L $state_dir ]] || die "unsafe preview state directory"
	[[ $(stat -c %u "$state_dir") == "$UID" ]] || die "preview state directory has the wrong owner"
	[[ $(stat -c %a "$state_dir") == 700 ]] || die "preview state directory is too permissive"
}

token_path() {
	local token=$1 suffix=$2
	preview_valid_token "$token" || die "invalid preview token"
	printf '%s/%s.%s\n' "$state_dir" "$token" "$suffix"
}

write_specs() {
	local destination=$1
	shift
	local spec output enabled mode rate x y rotation primary extra
	local enabled_count=0 primary_count=0
	((${#@} > 0)) || die "a complete layout requires at least one output"
	: >"$destination"
	chmod 600 "$destination"
	for spec in "$@"; do
		IFS='|' read -r output enabled mode rate x y rotation primary extra <<<"$spec"
		[[ -z ${extra:-} ]] || die "invalid display specification"
		[[ $output =~ ^[A-Za-z0-9_.:-]+$ ]] || die "invalid output name"
		case $enabled in
		0)
			printf '%s --off\n' "$output" >>"$destination"
			;;
		1)
			[[ $mode =~ ^[A-Za-z0-9_.:+-]+$ ]] || die "invalid mode for $output"
			[[ $rate =~ ^[0-9]+([.][0-9]+)?$ ]] || die "invalid refresh rate for $output"
			[[ $x =~ ^-?[0-9]+$ && $y =~ ^-?[0-9]+$ ]] || die "invalid position for $output"
			case $rotation in normal | left | right | inverted) ;; *) die "invalid rotation for $output" ;; esac
			case $primary in 0 | 1) ;; *) die "invalid primary state for $output" ;; esac
			printf '%s --mode %s --rate %s --pos %sx%s --rotate %s' \
				"$output" "$mode" "$rate" "$x" "$y" "$rotation" >>"$destination"
			if [[ $primary == 1 ]]; then
				printf ' --primary' >>"$destination"
				((primary_count += 1))
			fi
			printf '\n' >>"$destination"
			((enabled_count += 1))
			;;
		*) die "invalid enabled state for $output" ;;
		esac
	done
	((enabled_count > 0)) || die "a layout must keep at least one output enabled"
	((primary_count <= 1)) || die "a layout may select only one primary output"
}

atomic_save() {
	local source=$1 name=$2 destination temporary
	destination=$(profile_path "$name")
	mkdir -p "$profile_dir"
	chmod 700 "$profile_dir"
	temporary=$(mktemp "$profile_dir/.${name}.XXXXXX")
	trap 'rm -f "${temporary:-}"' RETURN
	install -m 600 "$source" "$temporary"
	mv -fT "$temporary" "$destination"
	temporary=
	printf 'result\tsaved\t%s\n' "$(clean_field "$name")"
}

profile_is_complete() {
	local source=$1 line required record_count=0
	while IFS= read -r line || [[ -n $line ]]; do
		line=${line%%#*}
		[[ $line =~ ^[[:space:]]*$ ]] && continue
		((record_count += 1))
		if [[ " $line " == *" --off " ]]; then
			continue
		fi
		for required in --mode --rate --pos --rotate; do
			[[ " $line " == *" $required "* ]] || return 1
		done
	done <"$source"
	((record_count > 0))
}

valid_dpi() {
	local value=$1
	[[ $value =~ ^[0-9]{2,3}$ ]] || return 1
	((10#$value >= minimum_dpi && 10#$value <= maximum_dpi))
}

x11_resources_available() {
	command -v xrdb >/dev/null 2>&1 && [[ -n ${DISPLAY:-} ]]
}

persisted_dpi() {
	local line value
	[[ -f $dpi_resources && ! -L $dpi_resources ]] || return 1
	while IFS= read -r line || [[ -n $line ]]; do
		[[ $line == Xft.dpi:* ]] || continue
		value=${line#Xft.dpi:}
		value=${value//[[:space:]]/}
		valid_dpi "$value" || return 1
		printf '%s\n' "$value"
		return 0
	done <"$dpi_resources"
	return 1
}

session_dpi() {
	local value
	x11_resources_available || return 1
	value=$(xrdb -query 2>/dev/null |
		awk -F: '$1 == "Xft.dpi" { value = $2; gsub(/[[:space:]]/, "", value); print value; exit }')
	valid_dpi "$value" || return 1
	printf '%s\n' "$value"
}

recommended_dpi() {
	local query=$1 value
	value=$(awk -v minimum="$minimum_dpi" -v maximum="$maximum_dpi" '
		$2 == "connected" {
			width = 0; millimetres = 0; primary = 0
			for (i = 3; i <= NF; i++) {
				if ($i == "primary") primary = 1
				if ($i ~ /^[0-9]+x[0-9]+[+-][0-9]+[+-][0-9]+$/) {
					match($i, /^[0-9]+/); width = substr($i, RSTART, RLENGTH) + 0
				}
				if ($i ~ /^[0-9]+mm$/ && $(i + 1) == "x") {
					match($i, /^[0-9]+/); millimetres = substr($i, RSTART, RLENGTH) + 0
				}
			}
			if (width <= 0 || millimetres <= 0) next
			candidate = int((width * 25.4 / millimetres) + 0.5)
			if (candidate < minimum || candidate > maximum) next
			if (primary) { found = candidate; exit }
			if (fallback == 0) fallback = candidate
		}
		END {
			if (found > 0) print found
			else if (fallback > 0) print fallback
		}
	' "$query")
	valid_dpi "$value" || return 1
	printf '%s\n' "$value"
}

emit_dpi() {
	local query=$1 persisted session recommended active source
	persisted=$(persisted_dpi || true)
	session=$(session_dpi || true)
	recommended=$(recommended_dpi "$query" || true)
	if [[ -n $session ]]; then
		active=$session
		if [[ $session == "$persisted" ]]; then source=saved; else source=session; fi
	elif [[ -n $persisted ]]; then
		active=$persisted
		source=saved
	else
		active=96
		source=default
	fi
	printf 'dpi\t%s\t%s\t%s\t%s\n' \
		"$active" "$source" "${persisted:-none}" "${recommended:-none}"
}

warn() {
	printf 'dwm-settings-display: %s\n' "$*" >&2
}

merge_dpi() {
	local value=$1
	x11_resources_available || return 0
	printf 'Xft.dpi: %s\n' "$value" | xrdb -merge 2>/dev/null ||
		warn "could not merge Xft.dpi into the running X resource database"
}

clear_merged_dpi() {
	local remaining
	x11_resources_available || return 0
	remaining=$(mktemp)
	trap 'rm -f "${remaining:-}"' RETURN
	if xrdb -query >"$remaining" 2>/dev/null; then
		awk -F: '$1 != "Xft.dpi"' "$remaining" | xrdb -load 2>/dev/null ||
			warn "could not clear Xft.dpi from the running X resource database"
	fi
}

apply_server_dpi() {
	local value=$1
	command -v xrandr >/dev/null 2>&1 && [[ -n ${DISPLAY:-} ]] || return 0
	xrandr --dpi "$value" >/dev/null 2>&1 ||
		warn "the X server refused a DPI change; running clients keep the old screen size"
}

write_xsettings_dpi() {
	local value=$1 line=""
	[[ -n $value ]] && line=$(printf 'Xft/DPI %s' "$((10#$value * 1024))")
	xsettingsd_write_line "$xsettings_config" '^[[:space:]]*Xft/DPI[[:space:]]' "$line"
}

publish_dpi_state() {
	local value=$1 temporary
	[[ -d $runtime_base && ! -L $runtime_base ]] || return 0
	if [[ ! -e $state_dir ]]; then
		mkdir -m 700 "$state_dir" 2>/dev/null || return 0
	fi
	[[ -d $state_dir && ! -L $state_dir ]] || return 0
	temporary=$(mktemp "$state_dir/.dpi.XXXXXX" 2>/dev/null) || return 0
	printf 'dpi-state-protocol\t1\ndpi\t%s\n' "$value" >"$temporary"
	chmod 600 "$temporary"
	mv -fT "$temporary" "$dpi_state" 2>/dev/null || rm -f "$temporary"
}

apply_dpi_runtime() {
	local value=$1

	merge_dpi "$value"
	write_xsettings_dpi "$value"
	apply_server_dpi "$value"
	publish_dpi_state "$value"
}

set_dpi() {
	local value=$1 temporary
	valid_dpi "$value" ||
		die "DPI must be an integer between $minimum_dpi and $maximum_dpi"
	[[ ! -L $dpi_resources ]] || die "refusing to write through a symlinked DPI resource file"
	mkdir -p "$config_dir"
	temporary=$(mktemp "$config_dir/.dpi.XXXXXX")
	trap 'rm -f "${temporary:-}"' RETURN
	printf 'Xft.dpi: %s\n' "$value" >"$temporary"
	chmod 644 "$temporary"
	mv -fT "$temporary" "$dpi_resources"
	temporary=
	apply_dpi_runtime "$value"
	printf 'result\tdpi-set\t%s\n' "$value"
}

reset_dpi() {
	[[ ! -L $dpi_resources ]] || die "refusing to remove a symlinked DPI resource file"
	rm -f "$dpi_resources"
	clear_merged_dpi
	write_xsettings_dpi ""
	publish_dpi_state "$default_dpi"
	printf 'result\tdpi-reset\tdefault\n'
}

apply_saved_dpi() {
	local value
	if ! value=$(persisted_dpi); then
		publish_dpi_state "$(session_dpi || printf '%s' "$default_dpi")"
		return 0
	fi
	apply_dpi_runtime "$value"
}

discover() {
	local query properties capabilities verbose profile
	command -v xrandr >/dev/null 2>&1 || die "xrandr is unavailable"
	[[ -n ${DISPLAY:-} ]] || die "DISPLAY is not set"
	discover_dir=$(mktemp -d)
	# EXIT too: die() exits, and a RETURN trap does not run on exit. discover is
	# the whole run (the "discover" action), so no other EXIT trap is replaced.
	trap '[[ -z ${discover_dir:-} ]] || rm -rf -- "$discover_dir"; discover_dir=' RETURN EXIT
	query=$discover_dir/query
	properties=$discover_dir/properties
	capabilities=$discover_dir/capabilities
	verbose=$discover_dir/verbose
	xrandr --query >"$query"
	grep -q '^Screen [0-9][0-9]*:' "$query" || die "xrandr returned malformed display state"
	grep -Eq '^[A-Za-z0-9_.:+-]+ connected([[:space:]]|$)' "$query" || die "xrandr reported no connected outputs"
	xrandr --prop >"$properties" 2>/dev/null || : >"$properties"
	xrandr --verbose >"$verbose" 2>/dev/null || : >"$verbose"
	if ! "$setup_helper" capabilities >"$capabilities" 2>/dev/null; then
		printf 'display-capability-protocol\t1\n' >"$capabilities"
	fi
	grep -Fqx $'display-capability-protocol\t1' "$capabilities" ||
		die "display setup returned an unsupported capability protocol"
	printf 'display-protocol\t1\n'
	awk -v props="$properties" -v capabilities="$capabilities" -v verbose="$verbose" '
		function yes(value) { return value ? "1" : "0" }
		BEGIN {
			# Mode labels are arbitrary. Read pixel sizes from RandR timings,
			# keyed by connector, label, and rate rather than guessing the label.
			while ((getline line < verbose) > 0) {
				sub(/[[:space:]]+$/, "", line)
				count = split(line, values, /[[:space:]]+/)
				if (line ~ /^[^[:space:]]/) {
					connector = values[2] == "connected" ? values[1] : ""
					mode_name = ""
				} else if (values[3] ~ /^\(0x[0-9a-fA-F]+\)$/) {
					mode_name = values[2]; pixel_width = 0
				} else if (values[2] == "h:" && values[3] == "width") {
					pixel_width = values[4] + 0
				} else if (values[2] == "v:" && values[3] == "height" && connector != "" && mode_name != "") {
					pixel_height = values[4] + 0; mode_rate = values[count]; sub(/Hz$/, "", mode_rate)
					key = connector SUBSEP mode_name SUBSEP mode_rate
					if (pixel_width > 0 && pixel_height > 0 && mode_rate ~ /^[0-9]+([.][0-9]+)?$/ && !seen_size[key]++)
						printf "mode-size\t%s\t%s\t%s\t%d\t%d\n", connector, mode_name, mode_rate, pixel_width, pixel_height
				}
			}
			close(verbose)
		}
		$2 == "connected" {
			output = $1; primary = 0; enabled = 0; mode = ""; x = 0; y = 0; rotation = "normal"; geometry_index = 0
			for (i = 3; i <= NF; i++) {
				if ($i == "primary") primary = 1
				if ($i ~ /^[0-9]+x[0-9]+[+-][0-9]+[+-][0-9]+$/) {
					enabled = 1; match($i, /^[0-9]+x[0-9]+/); mode = substr($i, RSTART, RLENGTH); geometry_index = i
					match($i, /[+-][0-9]+[+-][0-9]+$/); offsets = substr($i, RSTART)
					match(offsets, /^[+-][0-9]+/); x = substr(offsets, RSTART, RLENGTH) + 0
					y = substr(offsets, RLENGTH + 1) + 0
				}
			}
			if (geometry_index > 0 && $(geometry_index + 1) ~ /^(normal|left|right|inverted)$/)
				rotation = $(geometry_index + 1)
			tearfree = "unsupported"
			while ((getline property_line < props) > 0) {
				if (property_line ~ ("^" output " connected")) in_output = 1
				else if (property_line ~ /^[^[:space:]]/) in_output = 0
				else if (in_output && property_line ~ /^[[:space:]]*TearFree:/) tearfree = "available"
			}
			close(props)
			full_composition_pipeline = "unsupported"
			while ((getline capability_line < capabilities) > 0) {
				split(capability_line, capability_fields, "\t")
				if (capability_fields[1] == "output" && capability_fields[2] == output) {
					tearfree = capability_fields[3]
					full_composition_pipeline = capability_fields[4]
					break
				}
			}
			close(capabilities)
			printf "output\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", output, enabled, primary, mode, x, y, rotation, tearfree, full_composition_pipeline
			current_output = output
			next
		}
		/^[^[:space:]]/ && $2 != "connected" { current_output = ""; next }
		# Global modelines from additional RandR providers are not output modes.
		/^[[:space:]]+[^[:space:]]+[[:space:]]+\(0x[0-9a-fA-F]+\)/ { current_output = ""; next }
		/^[[:space:]]/ && $1 ~ /^[A-Za-z0-9_.:+-]+$/ && current_output != "" {
			mode = $1
			for (i = 2; i <= NF; i++) {
				rate = $i; current = index(rate, "*") > 0; preferred = index(rate, "+") > 0
				# Some drivers separate the preferred/current markers from the rate.
				if (i < NF && $(i + 1) ~ /^[+*]+$/) {
					current = current || index($(i + 1), "*") > 0
					preferred = preferred || index($(i + 1), "+") > 0
				}
				gsub(/[+*]/, "", rate)
				if (rate ~ /^[0-9]+([.][0-9]+)?$/)
					printf "mode\t%s\t%s\t%s\t%s\t%s\n", current_output, mode, rate, yes(current), yes(preferred)
			}
		}
	' "$query"
	if [[ -d $profile_dir ]]; then
		for profile in "$profile_dir"/*.conf; do
			[[ -f $profile ]] || continue
			if profile_is_complete "$profile"; then
				profile=${profile##*/}
				printf 'profile\t%s\n' "$(clean_field "${profile%.conf}")"
			else
				printf 'profile-unsupported\t%s\t%s\n' \
					"$(clean_field "${profile##*/}")" \
					'Legacy profile omits complete mode, rate, position, or rotation state'
			fi
		done
	fi
	if [[ -r $managed_config ]]; then
		printf 'persistence\tinstalled\t%s\n' "$(clean_field "$managed_config")"
	else
		printf 'persistence\tabsent\t%s\n' "$(clean_field "$managed_config")"
	fi
	emit_dpi "$query"
}

watch_events() {
	simple_watch_events drm display "$@"
}

trusted_root_helper() {
	trusted_root_helper_path dwm-settings-display-root "${BASH_SOURCE[0]}" dwm-settings-display
}

install_profile() {
	local name=$1 source helper line
	local -a records=()
	source=$(profile_path "$name")
	[[ -f $source && ! -L $source ]] || die "profile not found: $name"
	profile_is_complete "$source" || die "profile is incomplete; save it from Settings before persistent installation"
	helper=$(trusted_root_helper) || die "trusted persistent-display helper is unavailable"
	command -v pkexec >/dev/null 2>&1 || die "pkexec is unavailable"
	while IFS= read -r line || [[ -n $line ]]; do
		line=${line%%#*}
		[[ $line =~ ^[[:space:]]*$ ]] || records+=("$line")
	done <"$source"
	((${#records[@]} > 0)) || die "profile is empty"
	pkexec "$helper" install "${DISPLAY:-}" "${XAUTHORITY:-}" "${records[@]}"
	printf 'result\tinstalled\t%s\n' "$name"
}

rollback_system() {
	local helper
	helper=$(trusted_root_helper) || die "trusted persistent-display helper is unavailable"
	command -v pkexec >/dev/null 2>&1 || die "pkexec is unavailable"
	pkexec "$helper" rollback
	printf 'result\trolled-back\tsystem\n'
}

reserve_preview() {
	local token=$1 active
	ensure_state_dir
	token_path "$token" active >/dev/null
	active="$state_dir/current"
	if ! (
		set -o noclobber
		printf '%s\n' "$token" >"$active"
	) 2>/dev/null; then
		die "another display preview is active"
	fi
	if ! chmod 600 "$active"; then
		cleanup_preview "$token"
		die "could not secure display preview reservation"
	fi
}

# Picom's GL backends page-flip their overlay window. With xf86-video-amdgpu
# 25.0, a layout change that resizes the screen, such as rotating an output,
# fails a flip that is still queued, and the driver's flip-abort path then
# crashes Xorg, taking the session with it. Stop the compositor for the change
# and start it again afterwards; a Picom that was not running stays stopped.
apply_layout() {
	local layout=$1 paused=0 status=0
	if [[ -x $picom_helper && $("$picom_helper" status 2>/dev/null) == *'"running": true'* ]]; then
		"$picom_helper" stop >/dev/null && paused=1
	fi
	"$setup_helper" apply "$layout" --tearfree off || status=$?
	if ((paused)) && ! "$picom_helper" start >/dev/null; then
		warn "Picom did not restart after the display change; start it from Settings > Appearance > Compositor"
	fi
	return "$status"
}

preview_file() {
	local token=$1 seconds=$2 proposed=$3 previous marker failed
	previous=$(token_path "$token" previous)
	proposed=$(token_path "$token" proposed)
	marker=$(token_path "$token" active)
	failed=$(token_path "$token" failed)
	"$setup_helper" validate "$proposed" --tearfree off
	"$setup_helper" capture >"$previous"
	chmod 600 "$previous" "$proposed"
	record_preview_session "$token"
	: >"$marker"
	chmod 600 "$marker"
	if ! apply_layout "$proposed"; then
		if apply_layout "$previous"; then
			cleanup_preview "$token"
			die "display preview failed; the previous layout was restored"
		fi
		printf 'Display apply and immediate rollback both failed; the captured layout is retained for retry.\n' >"$failed"
		chmod 600 "$failed"
		printf 'preview-failed\t%s\t%s\n' "$token" "$(clean_field "$(<"$failed")")"
		return 0
	fi
	# exec: the recorded PID is the watchdog itself, not a subshell around it
	# (#369). The mutation lock's descriptor is not inherited.
	(exec "$self" _watch "$token" "$seconds" >/dev/null 2>&1 7>&-) &
	record_preview_watchdog "$token" "$!"
	printf 'preview\t%s\t%s\n' "$token" "$seconds"
}

# Every step that changes a preview's state holds this lock (#369): starting a
# preview, keep, revert, discard, the watchdog's rollback, and a status that
# clears a finished preview. The kernel releases it when its holder exits, so
# a keep or revert killed mid-way, or a session that died, never leaves the
# others locked out, and two of them can never act on one preview at once.
acquire_mutation_lock() {
	local wait=${1:-}
	command -v flock >/dev/null 2>&1 || die "flock is unavailable"
	ensure_state_dir
	local status=0
	preview_lock "$state_dir/display-mutation.lock" 7 ${wait:+"$wait"} || status=$?
	case $status in
	0) ;;
	1) die "display settings are busy; try again in a moment" ;;
	*) die "unsafe display mutation lock" ;;
	esac
}

start_preview() {
	local token=$1 seconds=$2 temporary
	shift 2
	[[ $seconds =~ ^[1-9][0-9]?$ ]] || die "preview timeout must be between 1 and 99 seconds"
	acquire_mutation_lock 30
	reserve_preview "$token"
	trap 'cleanup_preview "$token"' EXIT
	temporary=$(mktemp "$state_dir/.proposed.XXXXXX")
	write_specs "$temporary" "$@"
	local destination
	destination=$(token_path "$token" proposed)
	mv -fT "$temporary" "$destination"
	preview_file "$token" "$seconds" "$destination"
	trap - EXIT
}

preview_profile() {
	local token=$1 seconds=$2 name=$3 source destination
	[[ $seconds =~ ^[1-9][0-9]?$ ]] || die "preview timeout must be between 1 and 99 seconds"
	source=$(profile_path "$name")
	[[ -f $source && ! -L $source ]] || die "profile not found: $name"
	profile_is_complete "$source" || die "profile is incomplete; save a complete layout from Settings before preview"
	acquire_mutation_lock 30
	reserve_preview "$token"
	trap 'cleanup_preview "$token"' EXIT
	destination=$(token_path "$token" proposed)
	install -m 600 "$source" "$destination"
	preview_file "$token" "$seconds" "$destination"
	trap - EXIT
}

# Removes the preview's files. The reservation goes only when it is this
# preview's: an old token must never free a newer preview's.
cleanup_preview() {
	local token=$1 current_token=
	rm -f "$(token_path "$token" active)" "$(token_path "$token" previous)" \
		"$(token_path "$token" proposed)" "$(token_path "$token" failed)" \
		"$(token_path "$token" session)" "$(token_path "$token" watch)"
	if [[ -f $state_dir/current ]]; then
		IFS= read -r current_token <"$state_dir/current" || current_token=
		[[ $current_token != "$token" ]] || rm -f "$state_dir/current"
	fi
	rmdir "$(token_path "$token" claim)" 2>/dev/null || true
}

# A preview belongs to the X server it was made on and to the watchdog that
# reverts it (#369). A session that ended mid-preview (Xorg crashed rotating an
# output) left the preview marked active for good: every status said active,
# so Settings asked Keep or Revert forever. The server is recorded with its
# display (dwm-xsession.sh), so a preview is judged by its own display, not by
# whichever one Settings runs on.
record_preview_session() {
	local session identity
	session=$(token_path "$1" session)
	identity=$(x11_session_identity "${DISPLAY:-}") || identity=
	printf '%s\t%s\n' "$(normalize_x11_display "${DISPLAY:-}")" "$identity" >"$session"
	chmod 600 "$session"
}

record_preview_watchdog() {
	local watch start
	watch=$(token_path "$1" watch)
	start=$(proc_starttime "$2") || start=
	printf '%s %s\n' "$2" "$start" >"$watch"
	chmod 600 "$watch"
}

# preview_foreign TOKEN: the preview was made on an X server that is no longer
# running (its display's server is gone or was restarted), so its captured
# layout means nothing now and is never applied. A preview from before these
# records (no watch file) is foreign once older than any timeout can be.
preview_foreign() {
	local token=$1 marker session watch display='' recorded='' current
	marker=$(token_path "$token" active)
	session=$(token_path "$token" session)
	watch=$(token_path "$token" watch)
	[[ -f $marker ]] || return 1
	if [[ -s $session ]]; then
		IFS=$'\t' read -r display recorded <"$session" || :
		[[ -n $recorded ]] || return 1
		current=$(x11_session_identity "$display") || current=
		[[ $current == "$recorded" ]] && return 1
		return 0
	fi
	[[ ! -f $watch ]] || return 1
	[[ -n $(find "$marker" -maxdepth 0 -mmin +10 2>/dev/null) ]]
}

# preview_orphaned TOKEN: the preview is on the server running now and still
# active, but its watchdog is gone (killed, or it never started), so nothing
# will revert it. It is not dropped: its captured layout is still valid here,
# and the user decides with Keep, Revert or Discard.
preview_orphaned() {
	local token=$1 marker session watch failed pid='' start=''
	marker=$(token_path "$token" active)
	session=$(token_path "$token" session)
	watch=$(token_path "$token" watch)
	failed=$(token_path "$token" failed)
	[[ -f $marker && ! -f $failed ]] || return 1
	if [[ ! -f $watch ]]; then
		# Its session is recorded but no watchdog was: the preview died while
		# applying the layout (where Xorg crashed rotating an output), before
		# starting one. Orphaned once older than the longest timeout (99 s) can
		# be; a preview with no records at all is preview_foreign's.
		[[ -s $session ]] || return 1
		[[ -n $(find "$marker" -maxdepth 0 -mmin +2 2>/dev/null) ]]
		return
	fi
	read -r pid start <"$watch" || :
	[[ -n $pid && -n $start ]] && preview_process_owned "$pid" "$start" && return 1
	return 0
}

record_preview_failure() { # TOKEN MESSAGE
	local failed
	failed=$(token_path "$1" failed)
	printf '%s\n' "$2" >"$failed"
	chmod 600 "$failed"
}

# The finalize claim, taken under the mutation lock: a claim left behind is
# by then always one whose holder has exited, and is removed.
claim_preview() {
	local token=$1 claim
	claim=$(token_path "$token" claim)
	rmdir -- "$claim" 2>/dev/null || true
	mkdir -- "$claim" 2>/dev/null || die "display preview is already being finalized"
	printf '%s\n' "$claim"
}

# restore_previous TOKEN WHO: apply the captured layout, or record why it cannot be,
# in which case the preview stays for Keep, Revert or Discard. dwm-display-setup
# validates it first, so a layout naming an output that is no longer connected
# (a change of X driver renames them) is refused before anything is touched.
restore_previous() { # TOKEN WHO: WHO names the step in a failure ("Automatic rollback", "Revert")
	local token=$1 who=$2 previous error
	previous=$(token_path "$token" previous)
	if ! error=$("$setup_helper" validate "$previous" --tearfree off 2>&1 >/dev/null); then
		error=${error#dwm-display-setup: }
		error=${error#error: }
		record_preview_failure "$token" "The previous layout cannot be restored: ${error:-it is not valid for the connected displays}."
		return 1
	fi
	if ! apply_layout "$previous"; then
		record_preview_failure "$token" "$who failed; the captured layout is retained for retry."
		return 1
	fi
}

print_preview_failure() {
	printf 'preview-failed\t%s\t%s\n' "$1" "$(clean_field "$(<"$(token_path "$1" failed)")")"
}

finish_foreign() {
	cleanup_preview "$1"
	printf 'result\tstale\t%s\n' "$1"
}

keep_preview() {
	local token=$1 name=${2:-} proposed marker failed claim
	acquire_mutation_lock 30
	marker=$(token_path "$token" active)
	proposed=$(token_path "$token" proposed)
	failed=$(token_path "$token" failed)
	[[ -z $name ]] || valid_name "$name" || die "invalid profile name: $name"
	if preview_foreign "$token"; then
		finish_foreign "$token"
		return 0
	fi
	claim=$(claim_preview "$token")
	trap 'rmdir "$claim" 2>/dev/null || true' RETURN EXIT
	[[ -f $marker && -f $proposed ]] || die "display preview is not active"
	[[ -z $name || ! -f $failed ]] ||
		die "cannot save a named profile after rollback failure; accept the current layout without a name or retry Revert"
	if [[ -n $name ]]; then
		atomic_save "$proposed" "$name"
	fi
	save_kept_layout "$proposed"
	cleanup_preview "$token"
	trap - RETURN EXIT
	printf 'result\tkept\t%s\n' "$token"
}

# Best effort: a layout that could not be remembered still stays for the session.
save_kept_layout() {
	local source=$1 temporary
	mkdir -p "${kept_layout%/*}" 2>/dev/null || return 0
	temporary=$(mktemp "${kept_layout%/*}/.display-kept.XXXXXX" 2>/dev/null) || return 0
	if install -m 600 "$source" "$temporary" 2>/dev/null; then
		mv -fT "$temporary" "$kept_layout" 2>/dev/null || rm -f "$temporary"
	else
		rm -f "$temporary"
	fi
}

# At login: the kept layout again, only when exactly the outputs it names are
# connected, so a laptop away from its desk keeps the layout X chose.
apply_kept_layout() {
	local kept connected
	[[ -f $kept_layout && ! -L $kept_layout ]] || return 0
	command -v xrandr >/dev/null 2>&1 || return 0
	kept=$(awk '{ sub(/#.*/, "") } NF { print $1 }' "$kept_layout" | sort -u)
	connected=$(xrandr --query 2>/dev/null | awk '$2 == "connected" { print $1 }' | sort -u)
	[[ -n $kept && $kept == "$connected" ]] || return 0
	apply_layout "$kept_layout" >/dev/null
}

revert_preview() {
	local token=$1 previous marker claim
	acquire_mutation_lock 30
	marker=$(token_path "$token" active)
	previous=$(token_path "$token" previous)
	if preview_foreign "$token"; then
		finish_foreign "$token"
		return 0
	fi
	[[ -f $marker && -f $previous ]] || die "display preview is not active"
	claim=$(claim_preview "$token")
	# EXIT too: a claim left behind by a failed revert blocked every later
	# keep and revert (#369).
	trap 'rmdir "$claim" 2>/dev/null || true' RETURN EXIT
	if ! restore_previous "$token" Revert; then
		rmdir "$claim" 2>/dev/null || true
		trap - RETURN EXIT
		print_preview_failure "$token"
		return 0
	fi
	cleanup_preview "$token"
	trap - RETURN EXIT
	printf 'result\treverted\t%s\n' "$token"
}

# discard TOKEN: forget the preview without applying anything, whatever state
# it is in. The way out when the captured layout cannot be restored.
discard_preview() {
	local token=$1
	acquire_mutation_lock 30
	cleanup_preview "$token"
	printf 'result\tdiscarded\t%s\n' "$token"
}

watchdog() {
	local token=$1 seconds=$2 marker previous claim
	sleep "$seconds"
	acquire_mutation_lock
	marker=$(token_path "$token" active)
	previous=$(token_path "$token" previous)
	# Kept, reverted or discarded while asleep: nothing to do.
	[[ -f $marker && -f $previous && ! -f $(token_path "$token" failed) ]] || return 0
	# A server that is not the preview's own gets nothing of it.
	if preview_foreign "$token"; then
		cleanup_preview "$token"
		return 0
	fi
	claim=$(claim_preview "$token")
	if restore_previous "$token" "Automatic rollback"; then
		cleanup_preview "$token"
	fi
	rmdir "$claim" 2>/dev/null || true
}

preview_status() {
	local token=${1:-} marker failed
	ensure_state_dir
	if [[ -z $token ]]; then
		if [[ ! -f $state_dir/current ]]; then
			printf 'result\tnone\n'
			return
		fi
		IFS= read -r token <"$state_dir/current"
		[[ -n $token ]] || die "active display preview token is empty"
	fi
	marker=$(token_path "$token" active)
	failed=$(token_path "$token" failed)
	if preview_foreign "$token" || preview_orphaned "$token" ||
		[[ ! -f $marker && -f $state_dir/current ]]; then
		acquire_mutation_lock 30
		if preview_foreign "$token"; then
			finish_foreign "$token"
			return
		fi
		if preview_orphaned "$token"; then
			record_preview_failure "$token" "The automatic rollback is no longer running."
		elif [[ ! -f $marker && ! -f $failed ]]; then
			# A reservation with nothing behind it (a preview killed while it
			# started) refused every new preview.
			cleanup_preview "$token"
		fi
	fi
	if [[ -f $failed ]]; then
		print_preview_failure "$token"
	elif [[ -f $marker ]]; then
		printf 'preview-active\t%s\n' "$token"
	else
		printf 'result\texpired\t%s\n' "$token"
	fi
}

command=${1:-}
case $command in
discover)
	[[ $# == 1 ]] || die "discover takes no arguments"
	discover
	;;
watch)
	[[ $# == 3 ]] || die "watch requires an owner PID and start identity"
	watch_events "$2" "$3"
	;;
save)
	[[ $# -ge 3 ]] || die "save requires a name and complete layout"
	name=$2
	shift 2
	temporary=$(mktemp)
	trap 'rm -f "$temporary"' EXIT
	write_specs "$temporary" "$@"
	"$setup_helper" validate "$temporary" --tearfree off
	atomic_save "$temporary" "$name"
	;;
preview)
	[[ $# -ge 4 ]] || die "preview requires a token, timeout, and complete layout"
	token=$2
	seconds=$3
	shift 3
	start_preview "$token" "$seconds" "$@"
	;;
preview-profile)
	[[ $# == 4 ]] || die "preview-profile requires token, timeout, and name"
	preview_profile "$2" "$3" "$4"
	;;
keep)
	[[ $# == 2 || $# == 3 ]] || die "keep requires token and optional profile name"
	keep_preview "$2" "${3:-}"
	;;
apply-kept)
	[[ $# == 1 ]] || die "apply-kept takes no arguments"
	apply_kept_layout
	;;
revert)
	[[ $# == 2 ]] || die "revert requires token"
	revert_preview "$2"
	;;
discard)
	[[ $# == 2 ]] || die "discard requires token"
	discard_preview "$2"
	;;
preview-status)
	[[ $# == 1 || $# == 2 ]] || die "preview-status accepts an optional token"
	preview_status "${2:-}"
	;;
install-profile)
	[[ $# == 2 ]] || die "install-profile requires a profile name"
	install_profile "$2"
	;;
rollback-system)
	[[ $# == 1 ]] || die "rollback-system takes no arguments"
	rollback_system
	;;
dpi-set)
	[[ $# == 2 ]] || die "dpi-set requires a DPI value"
	set_dpi "$2"
	;;
dpi-reset)
	[[ $# == 1 ]] || die "dpi-reset takes no arguments"
	reset_dpi
	;;
dpi-apply-saved)
	[[ $# == 1 ]] || die "dpi-apply-saved takes no arguments"
	apply_saved_dpi
	;;
_watch)
	[[ $# == 3 ]] || exit 2
	watchdog "$2" "$3"
	;;
-h | --help | help) usage ;;
*)
	usage
	exit 2
	;;
esac
