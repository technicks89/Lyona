#!/usr/bin/python3
"""Write config/nvidia-legacy-gpus.tsv from NVIDIA's supportedchips.html.

Sync Sprint 14 S14-02: the live medium picks the driver branch an NVIDIA GPU
needs from its PCI device ID. NVIDIA's own table, installed by Arch's
nvidia-utils as /usr/share/doc/nvidia/html/supportedchips.html, lists every
device in a <tr id="devidXXXX"> row, in a "Current NVIDIA GPUs" section and
then one section per legacy branch (<a name="legacy_580.xx">, ...). A
developer tool, not installed: run it when nvidia-utils moves on, and commit
the result.

    lyona-nvidia-gpu-table SUPPORTEDCHIPS.HTML NVIDIA-UTILS-VERSION > config/nvidia-legacy-gpus.tsv
"""

import hashlib
import re
import sys

# The branches the live medium can install (decision D-23); every older one is
# a GPU no packaged driver supports.
INSTALLABLE = {"580.xx": "580xx", "470.xx": "470xx"}


def main(argv):
    if len(argv) != 3:
        print(__doc__.strip().splitlines()[-1].strip(), file=sys.stderr)
        return 2
    path, version = argv[1], argv[2]
    data = open(path, "rb").read()
    html = data.decode("utf-8", errors="replace")
    sections = [(m.start(), m.group(1)) for m in re.finditer(r'<a name="legacy_([0-9.]+xx)"', html)]
    if not sections or "Current NVIDIA GPUs" not in html[:sections[0][0]]:
        print("lyona-nvidia-gpu-table: not NVIDIA's supportedchips.html", file=sys.stderr)
        return 1
    branches = {}
    for row in re.finditer(r'<tr id="devid([0-9A-Fa-f]{4})[^"]*"', html):
        section = "current"
        for start, name in sections:
            if row.start() >= start:
                section = name
        if section == "current":
            continue
        device = row.group(1).lower()
        branch = INSTALLABLE.get(section, "unsupported")
        if branches.get(device, branch) != branch:
            print(f"lyona-nvidia-gpu-table: {device} is in two legacy sections", file=sys.stderr)
            return 1
        branches[device] = branch
    print("# NVIDIA GPU driver branches for the live medium (Sync Sprint 14 S14-02).")
    print(f"# Generated by scripts/lyona-nvidia-gpu-table from supportedchips.html in nvidia-utils {version}")
    print(f"# (sha256 {hashlib.sha256(data).hexdigest()}). Do not edit; regenerate.")
    print("# device<TAB>branch: 580xx or 470xx (a legacy driver the medium installs), or unsupported (no")
    print("# packaged driver: nouveau stays). A device not listed is open (nvidia-open), unless its ID is")
    print("# below 1e00, the first Turing ID, which counts as unsupported.")
    for device in sorted(branches):
        print(f"{device}\t{branches[device]}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
