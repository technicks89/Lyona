#!/usr/bin/env bash
set -eu

# A checkout keeps the shared shell code beside the scripts; an install keeps it
# in PREFIX/lib/lyona (Sync Sprint 12 S12-13).
lyona_lib=${0%/*}
[ "$lyona_lib" != "$0" ] || lyona_lib=.
[ -f "$lyona_lib/dwm-xdg.sh" ] || lyona_lib=${lyona_lib%bin}lib/lyona
# shellcheck source=scripts/dwm-xdg.sh
. "$lyona_lib/dwm-xdg.sh"
# shellcheck source=scripts/dwm-desktop-entry.sh
. "$lyona_lib/dwm-desktop-entry.sh"

usage() {
	printf 'usage: %s list|launch <desktop-file>\n' "$0" >&2
}

desktop_id() {
	file=$1
	base=${file##*/}
	printf '%s\n' "${base%.desktop}"
}

data_dirs() {
	sep=
	seen=:

	add_dir() {
		case $seen in
		*:"$1":*) return 0 ;;
		esac

		printf '%s%s/applications' "$sep" "$1"
		sep=':'
		seen=$seen$1:
	}

	# Lenient: without HOME there is no user data directory to list.
	lyona_xdg_dirs lenient
	[ -z "$data_home" ] || add_dir "$data_home"

	if [ -n "${HOME:-}" ]; then
		add_dir "$HOME/.local/share/flatpak/exports/share"
		add_dir "$HOME/.local/share/snapd"
		add_dir "$HOME/.nix-profile/share"
	fi
	add_dir /var/lib/flatpak/exports/share
	add_dir /var/lib/snapd/desktop
	add_dir /nix/var/nix/profiles/default/share

	old_ifs=$IFS
	IFS=:
	for dir in ${XDG_DATA_DIRS:-/usr/local/share:/usr/share}; do
		[ -n "$dir" ] || continue
		add_dir "$dir"
	done
	IFS=$old_ifs
	printf '\n'
}

desktop_files() {
	data_dirs |
		tr ':' '\n' |
		while IFS= read -r dir; do
			[ -d "$dir" ] || continue
			find "$dir" \( -type f -o -type l \) -name '*.desktop' | sort
		done
}

# desktop_entry_summary [FILE...]: one row per entry the launcher shows, from
# the files given, or from the list on stdin. All of them are read in one pass
# of the shared reader (#308), which refuses a malformed entry whole.
desktop_entry_summary() {
	local locale locale_short current_desktop
	local -a files=("$@")
	locale=${LC_MESSAGES:-${LANG:-}}
	locale=${locale%%.*}
	locale_short=${locale%%_*}
	# Lyona sessions export X-DWM and dwm; the same names when run outside one.
	current_desktop=${XDG_CURRENT_DESKTOP:-X-DWM:dwm}
	(($# > 0)) || mapfile -t files

	desktop_entries_read 'Desktop Entry' "${files[@]}" |
		awk -F '\t' -v locale="$locale" -v locale_short="$locale_short" -v current_desktop="$current_desktop" '
		function clean(value) {
			gsub(/\t/, " ", value)
			gsub(/\r/, "", value)
			return value
		}

		function localized_match(key, base) {
			return locale != "" &&
				(key == base "[" locale "]" ||
				 key == base "[" locale_short "]")
		}

		# True when desktop matches a name in the semicolon-separated list
		# (a comparison that is case sensitive, as the Desktop Entry
		# specification has it).
		function desktop_matches(desktop, list_str, n_names, names, j) {
			n_names = split(list_str, names, ";")
			for (j = 1; j <= n_names; j++) {
				if (names[j] == desktop) return 1
			}
			return 0
		}

		# OnlyShowIn and NotShowIn scope an entry to desktops. GLib evaluates
		# the XDG_CURRENT_DESKTOP tokens in order, preferring OnlyShowIn over
		# NotShowIn for each token. An empty OnlyShowIn lists no desktop, so it
		# shows the entry nowhere.
		function shown_on_this_desktop(n_desktops, desktops, i, desktop) {
			n_desktops = split(current_desktop, desktops, ":")
			for (i = 1; i <= n_desktops; i++) {
				desktop = desktops[i]
				if (desktop == "") continue
				if ("OnlyShowIn" in key && desktop_matches(desktop, key["OnlyShowIn"])) return 1
				if ("NotShowIn" in key && desktop_matches(desktop, key["NotShowIn"])) return 0
			}
			return !("OnlyShowIn" in key)
		}

		# A localized value for this locale wins over the plain one.
		function localized(base) {
			return localized_value[base] != "" ? localized_value[base] : key[base]
		}

		function emit(file, name) {
			name = localized("Name")
			if (key["Type"] == "Application" && name != "" && key["Exec"] != "" &&
			    tolower(key["Hidden"]) != "true" && tolower(key["NoDisplay"]) != "true" &&
			    shown_on_this_desktop()) {
				printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n",
					clean(name), clean(localized("GenericName")), clean(localized("Comment")),
					clean(key["Exec"]), clean(key["Icon"]), clean(file),
					clean(localized("Keywords")), clean(key["Categories"]),
					clean(key["StartupWMClass"]), clean(key["Actions"])
			}
		}

		# The status line ends each file: its keys are complete.
		$2 == "" {
			if ($3 == "ok") emit($1)
			delete key
			delete localized_value
			next
		}

		{
			value = substr($0, length($1) + length($2) + 3)
			if ($2 ~ /\[/) {
				base = $2
				sub(/\[.*/, "", base)
				if (localized_match($2, base)) localized_value[base] = value
			} else {
				key[$2] = value
			}
		}
	'
}

list_apps() {
	desktop_files |
		{
			seen_ids=:
			while IFS= read -r file; do
				id=${file##*/}
				id=${id%.desktop}
				case $seen_ids in
				*:"$id":*) continue ;;
				esac

				seen_ids=$seen_ids$id:
				printf '%s\n' "$file"
			done
		} |
		desktop_entry_summary |
		awk -F '\t' '
					{
						row_count++
						rows[row_count] = $0
						name = tolower($1)
						exec_line = tolower($4)
						categories = ";" tolower($8)
						web[row_count] = name == "chatgpt" &&
							(index(exec_line, "chatgpt.com") > 0 ||
							 index(categories, ";webapp;") > 0)
						if (name == "chatgpt" && !web[row_count]) {
							native_chatgpt = 1
						}
					}

					END {
						for (row = 1; row <= row_count; row++) {
							if (!native_chatgpt || !web[row]) {
								print rows[row]
							}
						}
					}
				' |
		sort -f
}

desktop_value() {
	desktop_entry_get "$1" "$2" || true
}

is_chatgpt_entry() {
	file=$1
	name=$(desktop_value "$file" Name | tr '[:upper:]' '[:lower:]')
	[ "$name" = chatgpt ]
}

is_chatgpt_web_entry() {
	file=$1
	is_chatgpt_entry "$file" || return 1

	exec_line=$(desktop_value "$file" Exec | tr '[:upper:]' '[:lower:]')
	categories=$(desktop_value "$file" Categories | tr '[:upper:]' '[:lower:]')
	case $exec_line in
	*chatgpt.com*) return 0 ;;
	esac
	case ";$categories" in
	*";webapp;"*) return 0 ;;
	esac
	return 1
}

is_chatgpt_native_entry() {
	file=$1
	is_chatgpt_entry "$file" || return 1
	is_chatgpt_web_entry "$file" && return 1
	[ -n "$(desktop_entry_summary "$file")" ]
}

chatgpt_native_desktop() {
	desktop_files |
		while IFS= read -r file; do
			if is_chatgpt_native_entry "$file"; then
				printf '%s\n' "$file"
				break
			fi
		done
}

fallback_launch() {
	file=$1
	exec_line=$(desktop_value "$file" Exec)
	terminal=$(desktop_value "$file" Terminal | tr '[:upper:]' '[:lower:]')
	command=$(printf '%s\n' "$exec_line" | sed 's/%[fFuUdDnNickvm]//g; s/[[:space:]][[:space:]]*/ /g; s/^ //; s/ $//')

	[ -n "$command" ] || {
		printf 'desktop entry has no Exec line: %s\n' "$file" >&2
		return 1
	}

	if [ "$terminal" = true ]; then
		launch_background dwm-terminal -e sh -c "$command"
	else
		launch_background sh -c "$command"
	fi
}

# Applications started from here inherit this process's environment, which was
# fixed at login. dwm-session-launch re-reads the theme environment first, so a
# theme change reaches them without a re-login.
session_launcher=${0%/*}/dwm-session-launch
if [ ! -x "$session_launcher" ]; then
	session_launcher=$(command -v dwm-session-launch 2>/dev/null || true)
fi

launch_background() {
	if [ -n "$session_launcher" ]; then
		set -- "$session_launcher" "$@"
	fi
	if command -v setsid >/dev/null 2>&1; then
		setsid "$@" >/dev/null 2>&1 &
	else
		"$@" >/dev/null 2>&1 &
	fi
}

launch_app() {
	file=$1

	[ -f "$file" ] || {
		printf 'desktop entry not found: %s\n' "$file" >&2
		return 1
	}

	if command -v dex >/dev/null 2>&1; then
		launch_background dex "$file"
		return 0
	fi

	if command -v gtk-launch >/dev/null 2>&1; then
		launch_background gtk-launch "$(desktop_id "$file")"
		return 0
	fi

	fallback_launch "$file"
}

launch_chatgpt() {
	file=$(chatgpt_native_desktop)
	if [ -n "$file" ]; then
		launch_app "$file"
		return
	fi

	command -v webapp-launch >/dev/null 2>&1 || {
		printf 'ChatGPT is not installed and webapp-launch is unavailable\n' >&2
		return 1
	}
	launch_background env DWM_CHATGPT_WEB_FALLBACK=1 webapp-launch https://chatgpt.com
}

case ${1:-list} in
list)
	list_apps
	;;
launch)
	if [ $# -ne 2 ]; then
		usage
		exit 2
	fi
	launch_app "$2"
	;;
launch-chatgpt)
	if [ $# -ne 1 ]; then
		usage
		exit 2
	fi
	launch_chatgpt
	;;
*)
	usage
	exit 2
	;;
esac
