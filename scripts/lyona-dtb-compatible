#!/usr/bin/env python3
"""Print the root compatible string of each flattened device tree given.

Snapdragon X laptops (issue #92): the installer matches the device tree the
live medium booted with (systemd-stub picked it from the laptop's hardware
IDs) to the file of the same board in the new system's kernel. A board is
named by the first string of the root node's `compatible` property, for
example `dell,xps13-9345`.

Usage: lyona-dtb-compatible FILE...
Prints `COMPATIBLE<TAB>FILE` for each file it can read; a file that is not a
device tree, or has no root `compatible`, is skipped. Exit status 0 when at
least one line was printed, 1 otherwise, 2 on a usage error.

Only the standard library: it runs on the live medium, where Python is there
for archinstall.
"""

import struct
import sys

FDT_MAGIC = 0xD00DFEED
FDT_BEGIN_NODE = 1
FDT_END_NODE = 2
FDT_PROP = 3
FDT_NOP = 4
FDT_END = 9
# A device tree for one laptop is about 200 KiB; refuse anything absurd.
MAX_SIZE = 16 * 1024 * 1024


def _align4(pos):
    return (pos + 3) & ~3


def root_compatible(data):
    """The first string of the root node's compatible, or None."""
    if len(data) < 40:
        return None
    magic, totalsize, off_struct, off_strings = struct.unpack_from(">4I", data, 0)
    size_strings, size_struct = struct.unpack_from(">2I", data, 32)
    if magic != FDT_MAGIC or totalsize > len(data):
        return None
    end_struct = off_struct + size_struct
    if end_struct > totalsize or off_strings + size_strings > totalsize:
        return None

    pos = off_struct
    depth = 0
    while pos + 4 <= end_struct:
        (token,) = struct.unpack_from(">I", data, pos)
        pos += 4
        if token == FDT_BEGIN_NODE:
            name_end = data.find(b"\0", pos, end_struct)
            if name_end < 0:
                return None
            pos = _align4(name_end + 1)
            depth += 1
            # The root's properties come before its first child node.
            if depth > 1:
                return None
        elif token == FDT_PROP:
            if pos + 8 > end_struct:
                return None
            length, name_off = struct.unpack_from(">2I", data, pos)
            pos += 8
            value = data[pos : pos + length]
            pos = _align4(pos + length)
            if pos > end_struct or name_off >= size_strings:
                return None
            name_start = off_strings + name_off
            name_end = data.find(b"\0", name_start, off_strings + size_strings)
            if name_end < 0:
                return None
            if depth == 1 and data[name_start:name_end] == b"compatible":
                first = value.split(b"\0", 1)[0]
                try:
                    text = first.decode("ascii")
                except UnicodeDecodeError:
                    return None
                return text or None
        elif token == FDT_NOP:
            continue
        else:  # FDT_END_NODE, FDT_END or anything malformed
            return None
    return None


def main(argv):
    if len(argv) < 2:
        print("usage: lyona-dtb-compatible FILE...", file=sys.stderr)
        return 2
    printed = False
    for path in argv[1:]:
        try:
            with open(path, "rb") as handle:
                data = handle.read(MAX_SIZE + 1)
        except OSError:
            continue
        if len(data) > MAX_SIZE:
            continue
        compatible = root_compatible(data)
        if compatible is None or "\t" in compatible or "\n" in compatible:
            continue
        print(f"{compatible}\t{path}")
        printed = True
    return 0 if printed else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
