#!/bin/sh
set -eu

# Parameter expansion rather than dirname: these run on every panel poll, and
# the directory prefix of $0 is all that is needed. $0 carries a path whenever
# the script is executed, including through a PATH lookup.
script_dir=${0%/*}
# The other helpers are beside this one: in scripts/ in a checkout, in
# PREFIX/bin once installed. Never ../scripts, which an install does not have
# (Sync Sprint 16 R16-03).
[ "$script_dir" != "$0" ] || script_dir=.
# A checkout keeps the shared shell code beside the scripts; an install keeps it
# in PREFIX/lib/lyona, beside PREFIX/bin (Sync Sprint 12 S12-13).
lyona_lib=$script_dir
[ -f "$lyona_lib/dwm-watchdog.sh" ] || lyona_lib=${lyona_lib%bin}lib/lyona
# shellcheck source=scripts/dwm-proc.sh
. "$lyona_lib/dwm-proc.sh"
# shellcheck source=scripts/dwm-xdg.sh
. "$lyona_lib/dwm-xdg.sh"
# Lenient: every panel poll runs this, and a missing HOME must not end it.
lyona_xdg_dirs lenient
dwm_config_dir=$config_home/lyona

# The shipped defaults: PREFIX/share/lyona/config beside an installed
# PREFIX/lib/lyona, else config/ in a checkout (Sync Sprint 12 S12-13). The POSIX
# form of lyona_default_config_dir in dwm-paths.sh, which is Bash; a missing
# directory is printed as it is, so an error names it.
default_config_dir() (
	case $lyona_lib in
	*lib/lyona) dir=$lyona_lib/../../share/lyona/config ;;
	*) dir=$lyona_lib/../config ;;
	esac
	CDPATH='' cd -P -- "$dir" 2>/dev/null && pwd || printf '%s\n' "$dir"
)

config_file() {
	name=$1
	if [ -f "$dwm_config_dir/$name" ]; then
		printf '%s\n' "$dwm_config_dir/$name"
	else
		printf '%s/%s\n' "$(default_config_dir)" "$name"
	fi
}

# Session actions bound their system calls with run_bounded.
# shellcheck source=scripts/dwm-watchdog.sh
. "$lyona_lib/dwm-watchdog.sh"

session_pid_identity() {
	session_pid=$1
	case $session_pid in
	'' | *[!0-9]*) return 1 ;;
	esac
	[ "$session_pid" -ge 2 ] || return 1
	[ "$(stat -c %u "/proc/$session_pid" 2>/dev/null)" = "$(id -u)" ] || return 1
	session_executable=$(readlink "/proc/$session_pid/exe" 2>/dev/null) || return 1
	case $session_executable in
	*' (deleted)') session_executable=${session_executable%' (deleted)'} ;;
	esac
	[ "${session_executable##*/}" = dwm ] || return 1
	session_starttime=$(proc_starttime "$session_pid") || return 1
	printf '%s:%s\n' "$session_pid" "$session_starttime"
}

session_resolve_dwm() {
	for session_command in xprop awk stat id readlink; do
		command -v "$session_command" >/dev/null 2>&1 || {
			printf 'required session command is unavailable: %s\n' "$session_command" >&2
			return 127
		}
	done
	[ -n "${DISPLAY:-}" ] || {
		printf 'current X11 display is unavailable\n' >&2
		return 1
	}

	session_root_properties=$(LC_ALL=C run_bounded 3 xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null) || {
		printf 'current window manager is unavailable\n' >&2
		return 1
	}
	session_wm_window=$(printf '%s\n' "$session_root_properties" | awk '
		$1 == "_NET_SUPPORTING_WM_CHECK(WINDOW):" && $2 == "window" &&
			$3 == "id" && $4 == "#" && $5 ~ /^0x[0-9A-Fa-f]+$/ {
			window = $5
			matches++
		}
		END {
			if (matches == 1) print window
			exit(matches == 1 ? 0 : 1)
		}
	') || {
		printf 'current window manager identity is malformed\n' >&2
		return 1
	}

	session_wm_properties=$(LC_ALL=C run_bounded 3 xprop -id "$session_wm_window" \
		_NET_SUPPORTING_WM_CHECK _NET_WM_NAME _NET_WM_PID 2>/dev/null) || {
		printf 'current window manager identity is unavailable\n' >&2
		return 1
	}
	session_self_window=$(printf '%s\n' "$session_wm_properties" | awk '
		$1 == "_NET_SUPPORTING_WM_CHECK(WINDOW):" && $2 == "window" &&
			$3 == "id" && $4 == "#" && $5 ~ /^0x[0-9A-Fa-f]+$/ {
			window = $5
			matches++
		}
		END {
			if (matches == 1) print window
			exit(matches == 1 ? 0 : 1)
		}
	') || {
		printf 'current window manager self-check is malformed\n' >&2
		return 1
	}
	[ "$session_self_window" = "$session_wm_window" ] || {
		printf 'current window manager self-check does not match the X11 owner\n' >&2
		return 1
	}
	printf '%s\n' "$session_wm_properties" |
		awk '$0 == "_NET_WM_NAME(UTF8_STRING) = \"dwm\"" { matches++ }
			END { exit(matches == 1 ? 0 : 1) }' || {
		printf 'current window manager is not the managed dwm session\n' >&2
		return 1
	}
	session_wm_pid=$(printf '%s\n' "$session_wm_properties" | awk -F ' = ' '
		$1 == "_NET_WM_PID(CARDINAL)" && $2 ~ /^[0-9]+$/ {
			pid = $2
			matches++
		}
		END {
			if (matches == 1) print pid
			exit(matches == 1 ? 0 : 1)
		}
	') || {
		printf 'current dwm does not expose the managed logout endpoint; restart the installed DWM session\n' >&2
		return 1
	}
	session_pid_identity "$session_wm_pid" || {
		printf 'current dwm process identity could not be verified\n' >&2
		return 1
	}
}

session_lock() {
	session_lock_helper=$script_dir/dwm-lock
	if [ ! -x "$session_lock_helper" ]; then
		session_lock_helper=$(command -v dwm-lock 2>/dev/null || true)
	fi
	[ -n "$session_lock_helper" ] || {
		printf 'dwm-lock is unavailable\n' >&2
		return 127
	}
	"$session_lock_helper" || return
	printf 'session-action\tlock\taccepted\n'
}

session_logout() {
	session_identity=$(session_resolve_dwm) || return
	[ "$(session_resolve_dwm)" = "$session_identity" ] || {
		printf 'current dwm changed while logout was being requested\n' >&2
		return 1
	}
	session_pid=${session_identity%%:*}
	kill -USR2 "$session_pid" 2>/dev/null || {
		printf 'could not request a graceful exit from the current dwm\n' >&2
		return 1
	}
	printf 'session-action\tlogout\taccepted\n'
}

session_system_action() {
	session_action_name=$1
	session_systemctl_action=$2
	command -v systemctl >/dev/null 2>&1 || {
		printf 'systemctl is unavailable for %s\n' "$session_action_name" >&2
		return 127
	}
	if ! run_bounded 15 systemctl --no-block "$session_systemctl_action" >/dev/null; then
		printf '%s request was denied or could not be accepted\n' "$session_action_name" >&2
		return 1
	fi
	printf 'session-action\t%s\taccepted\n' "$session_action_name"
}

session_action() {
	case ${1:-} in
	lock) session_lock ;;
	logout) session_logout ;;
	suspend) session_system_action suspend suspend ;;
	reboot) session_system_action reboot reboot ;;
	shutdown) session_system_action shutdown poweroff ;;
	*)
		printf 'unknown session action: %s\n' "${1:-}" >&2
		return 2
		;;
	esac
}

# Every lyona notification has the one sender name, "lyona" (#293).
notify() {
	if command -v notify-send >/dev/null 2>&1; then
		notify-send -a lyona "$@" 2>/dev/null || true
	fi
}

# Applications started from here inherit this process's environment, which was
# fixed at login. dwm-session-launch re-reads the theme environment first, so a
# theme change reaches them without a re-login.
session_launcher=$script_dir/dwm-session-launch
if [ ! -x "$session_launcher" ]; then
	session_launcher=$(command -v dwm-session-launch 2>/dev/null || true)
fi

launch_background() {
	if [ "${DWM_TEST_SYNC:-0}" = 1 ]; then
		"$@"
		return
	fi

	if [ -n "$session_launcher" ]; then
		set -- "$session_launcher" "$@"
	fi
	if command -v setsid >/dev/null 2>&1; then
		setsid "$@" >/dev/null 2>&1 &
	else
		"$@" >/dev/null 2>&1 &
	fi
}

# Set when an action opened a terminal, so the Control Center says so rather
# than "Done" (#293).
action_terminal=

terminal_run() {
	if command -v dwm-terminal >/dev/null 2>&1; then
		action_terminal=1
		launch_background dwm-terminal -e sh -c "$1"
	else
		sh -c "$1"
	fi
}

health() {
	health_helper=$script_dir/dwm-system-health
	if [ ! -x "$health_helper" ]; then
		health_helper=$(command -v dwm-system-health 2>/dev/null || true)
	fi
	if [ -z "$health_helper" ]; then
		printf 'error\tSystem health helper\tdwm-system-health missing\n'
		return 1
	fi

	"$health_helper" scan-user | awk -F '\t' '
		$1 == "check" {
			status = $3
			if (status == "info") status = "ok"
			printf "%s\t%s\t%s\n", status, $5, $6
		}
	'
}

info() {
	os_name=unknown
	if [ -r /etc/os-release ]; then
		os_name=$(awk -F= '$1 == "PRETTY_NAME" { gsub(/^"|"$/, "", $2); print $2; exit }' /etc/os-release)
	fi

	compositor=stopped
	if pgrep -x picom >/dev/null 2>&1; then
		compositor=running
	fi

	audio=unavailable
	if command -v pactl >/dev/null 2>&1; then
		audio=$(pactl info 2>/dev/null | awk -F': ' '$1 == "Server Name" { print $2; exit }')
		audio=${audio:-available}
	elif command -v wpctl >/dev/null 2>&1; then
		audio=wireplumber
	fi

	printf 'OS\t%s\n' "$os_name"
	printf 'Kernel\t%s\n' "$(uname -sr)"
	printf 'Host\t%s\n' "$(hostname 2>/dev/null || printf unknown)"
	printf 'Uptime\t%s\n' "$(uptime -p 2>/dev/null || uptime 2>/dev/null || printf unknown)"
	printf 'Terminal\t%s\n' "${TERMINAL:-dwm-terminal}"
	printf 'Compositor\t%s\n' "$compositor"
	printf 'Audio\t%s\n' "$audio"
	printf 'Theme\t%s\n' "$(active_theme)"
}

# themes.toml through lyona-toml, on dwm's own parser (Sync Sprint 12 S12-14,
# D-20): the POSIX form of dwm-paths.sh's lyona_toml, installed beside the
# libraries or built beside a checkout's scripts/.
lyona_toml() {
	if [ -x "$lyona_lib/lyona-toml" ]; then
		"$lyona_lib/lyona-toml" "$@"
	else
		"$lyona_lib/../lyona-toml" "$@"
	fi
}

active_theme() {
	lyona_toml get "$(config_file themes.toml)" active theme 2>/dev/null || true
}

# The [theme.<id>] sections that hold at least one entry, in file order.
themes() {
	active=$(active_theme)
	lyona_toml dump "$(config_file themes.toml)" 2>/dev/null | awk -F'\t' -v active="$active" '
		$2 == -1 && $1 ~ /^theme\./ {
			name = $1
			sub(/^theme\./, "", name)
			if (seen[name]++) next
			status = name == active ? "active" : "available"
			printf "%s\t%s\n", status, name
		}
	'
}

theme_set() {
	name=$1
	# The helper finds the shipped themes itself, beside its own libraries.
	theme_helper=$script_dir/dwm-settings-theme
	[ -x "$theme_helper" ] ||
		theme_helper=$(command -v dwm-settings-theme 2>/dev/null || true)
	if [ -z "$theme_helper" ]; then
		printf 'dwm-settings-theme is unavailable\n' >&2
		return 1
	fi
	"$theme_helper" apply "$name" >/dev/null || return 1

	notify "Theme changed" "$name"
	printf 'theme\t%s\n' "$name"
}

keybinds() {
	awk '
		function value(line, key, pattern, result) {
			pattern = key "=\"[^\"]*\""
			if (match(line, pattern)) {
				result = substr(line, RSTART + length(key) + 2, RLENGTH - length(key) - 3)
				return result
			}
			return ""
		}

		/^[[:space:]]*\{/ && /desc=/ {
			mod = value($0, "mod")
			key = value($0, "key")
			desc = value($0, "desc")
			if (key == "") {
				next
			}
			label = mod == "" ? key : mod "+" key
			gsub(/SUPER/, "Super", label)
			gsub(/SHIFT/, "Shift", label)
			gsub(/CTRL/, "Ctrl", label)
			gsub(/ALT/, "Alt", label)
			gsub(/\+/, " + ", label)
			printf "%s\t%s\n", label, desc
		}
	' "$(config_file hotkeys.toml)"
}

picom_action() {
	picom_helper=$(command -v dwm-settings-picom 2>/dev/null || printf '%s' "$script_dir/dwm-settings-picom")
	"$picom_helper" "$1" >/dev/null
}

restart_picom() {
	if ! command -v picom >/dev/null 2>&1; then
		printf 'picom is not installed\n' >&2
		return 1
	fi
	picom_action restart || return 1
	notify "Picom restarted"
}

restart_quickshell() {
	config=$config_home/quickshell/shell.qml
	if [ ! -f "$config" ]; then
		printf 'quickshell config is unavailable: %s\n' "$config" >&2
		return 1
	fi
	version_check=$script_dir/dwm-quickshell-version-check
	if [ ! -x "$version_check" ]; then
		version_check=$(command -v dwm-quickshell-version-check 2>/dev/null || true)
	fi
	if [ -z "$version_check" ] || ! "$version_check"; then
		printf 'compatible Quickshell 0.3.0 or newer is required\n' >&2
		return 1
	fi

	if ! command -v quickshell >/dev/null 2>&1; then
		printf 'quickshell is not installed\n' >&2
		return 1
	fi
	# The Control Center runs this as a child of the Quickshell it stops, and
	# Quickshell kills its children as it exits: stopped there, this never got
	# to start it again, and the shell just disappeared. Once the checks above
	# have passed, a copy in its own session does the restart.
	if [ "${LYONA_QUICKSHELL_RESTART_DETACHED:-0}" != 1 ] && command -v setsid >/dev/null 2>&1; then
		setsid -f env LYONA_QUICKSHELL_RESTART_DETACHED=1 "$script_dir/${0##*/}" action restart-quickshell \
			</dev/null >/dev/null 2>&1
		return
	fi
	# As autostart does (Sync Sprint 16 R16-49): only the managed instance, by
	# identity, then started again with --path, the instance the keys address.
	# shellcheck source=scripts/dwm-quickshell-lifecycle.sh
	. "$lyona_lib/dwm-quickshell-lifecycle.sh"
	stop_managed_quickshell "$config" >/dev/null 2>&1 || true
	launch_background quickshell --path "$config" --no-duplicate
	notify "Quickshell restarted"
}

reload_wallpaper() {
	wallpaper_dir=${HOME:-}/Pictures/backgrounds
	wallpaper_helper=${DWM_SETTINGS_WALLPAPER_HELPER:-}
	if [ -z "$wallpaper_helper" ]; then
		wallpaper_helper=dwm-settings-wallpaper
		if ! command -v "$wallpaper_helper" >/dev/null 2>&1; then
			case $0 in
			*/*) wallpaper_helper=${0%/*}/dwm-settings-wallpaper ;;
			esac
		fi
	fi
	if command -v "$wallpaper_helper" >/dev/null 2>&1 || [ -x "$wallpaper_helper" ]; then
		if "$wallpaper_helper" randomize >/dev/null; then
			notify "Wallpaper reloaded"
			return 0
		fi
		printf 'failed to reload wallpaper through managed settings\n' >&2
		return 1
	fi

	if ! command -v feh >/dev/null 2>&1; then
		printf 'feh is unavailable\n' >&2
		return 1
	fi
	if [ ! -d "$wallpaper_dir" ]; then
		printf 'wallpaper folder is unavailable: %s\n' "$wallpaper_dir" >&2
		notify "Wallpaper folder missing" "$wallpaper_dir"
		return 1
	fi
	if ! find "$wallpaper_dir" -type f \
		\( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' -o -iname '*.bmp' -o -iname '*.gif' \) \
		-print -quit | grep -q .; then
		printf 'no loadable wallpaper images found in %s\n' "$wallpaper_dir" >&2
		notify "No wallpapers found" "$wallpaper_dir"
		return 1
	fi
	if find "$wallpaper_dir" -type f \
		\( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' -o -iname '*.bmp' -o -iname '*.gif' \) \
		-exec feh --randomize --bg-fill {} + >/dev/null 2>&1; then
		notify "Wallpaper reloaded"
	else
		printf 'failed to reload wallpaper from %s\n' "$wallpaper_dir" >&2
		return 1
	fi
}

toggle_compositor() {
	# A troubleshooting action (#244): previews need Picom running. The helper's
	# answer is for this display, which a process search is not.
	picom_helper=$(command -v dwm-settings-picom 2>/dev/null || printf '%s' "$script_dir/dwm-settings-picom")
	toggled=$("$picom_helper" toggle) || return 1
	case $toggled in
	*'"Picom stopped"'*)
		notify "Compositor stopped" "Window previews in the overview are off until Picom starts again."
		;;
	*) notify "Compositor started" ;;
	esac
}

# The System Health repair (#282): the trusted installed helper restarts it
# through polkit, which asks through the session's agent, as the dashboard's
# Restart NetworkManager does. This used to run sudo in a terminal.
restart_networkmanager() {
	health_helper=$script_dir/dwm-system-health
	[ -x "$health_helper" ] || health_helper=$(command -v dwm-system-health 2>/dev/null || true)
	if [ -z "$health_helper" ]; then
		printf 'Reinstall lyona to restore the System Health helper\n' >&2
		return 1
	fi
	"$health_helper" repair-privileged restart-networkmanager >/dev/null
}

dependency_check() {
	terminal_run "'$script_dir/check-deps.sh'; printf '\\nPress enter to close...'; read -r _"
}

# From a checkout, its own install.sh. An installed system has no install.sh:
# it installs the required and desktop package groups through the installed
# package library instead (Sync Sprint 16 R16-03).
install_missing_deps() {
	if [ -x "$script_dir/../install.sh" ] && [ -f "$script_dir/dwm-packages.sh" ]; then
		checkout=$(CDPATH='' cd -- "$script_dir/.." && pwd)
		terminal_run "cd '$checkout' && ./install.sh; printf '\\nPress enter to close...'; read -r _"
	else
		lib=${script_dir%bin}lib/lyona
		terminal_run "bash -c '. \"\$1/dwm-utils.sh\" && . \"\$1/dwm-packages.sh\" && dwm_install_package_profile build x11 runtime-required desktop' sh '$lib'; printf '\\nPress enter to close...'; read -r _"
	fi
}

# The configured Self-Heal script, or a reason on stderr and status 1.
self_heal_script_path() {
	self_heal_script=${DWM_SELF_HEAL_SCRIPT:-}
	self_heal_path_file=$dwm_config_dir/self-heal.path
	if [ -z "$self_heal_script" ] && [ -f "$self_heal_path_file" ]; then
		self_heal_script=$(cat -- "$self_heal_path_file")
	fi
	if [ -z "$self_heal_script" ]; then
		self_heal_script=$(command -v dwm-self-heal 2>/dev/null || true)
	fi
	case $self_heal_script in
	/*) ;;
	*)
		printf 'Self-Heal is not configured. Set an absolute script path in %s.\n' "$self_heal_path_file" >&2
		return 1
		;;
	esac
	if [ ! -f "$self_heal_script" ] || [ ! -x "$self_heal_script" ]; then
		printf 'Self-Heal script is not executable: %s\n' "$self_heal_script" >&2
		return 1
	fi
	printf '%s\n' "$self_heal_script"
}

self_heal() {
	self_heal_script=$(self_heal_script_path) || return 1
	if ! command -v dwm-terminal >/dev/null 2>&1 ||
		! dwm-terminal --print-command >/dev/null 2>&1; then
		printf 'Self-Heal requires an available terminal to show progress and authorization prompts.\n' >&2
		return 1
	fi
	# The script is an argv value, never shell source. It owns any confirmation
	# and privilege prompts; the Quickshell frontend stays unprivileged.
	action_terminal=1
	# shellcheck disable=SC2016 # Expand positional arguments in the terminal shell.
	launch_background dwm-terminal -e sh -c '
		"$1"
		status=$?
		printf "\nSelf-Heal exited with status %s. Press Enter to close..." "$status"
		read -r _
		exit "$status"
	' sh "$self_heal_script"
}

open_wallpapers() {
	if command -v xdg-open >/dev/null 2>&1; then
		launch_background xdg-open "${HOME:-}/Pictures/backgrounds"
	else
		printf 'xdg-open is unavailable\n' >&2
		return 1
	fi
}

gtk_settings() {
	if command -v nwg-look >/dev/null 2>&1; then
		launch_background nwg-look
	else
		printf 'nwg-look is unavailable\n' >&2
		return 1
	fi
}

action() {
	case ${1:-} in
	restart-picom) restart_picom ;;
	restart-quickshell) restart_quickshell ;;
	reload-wallpaper) reload_wallpaper ;;
	toggle-compositor) toggle_compositor ;;
	restart-networkmanager) restart_networkmanager ;;
	dependency-check) dependency_check ;;
	install-missing-deps) install_missing_deps ;;
	self-heal) self_heal ;;
	open-wallpapers) open_wallpapers ;;
	gtk-settings) gtk_settings ;;
	terminal) launch_background dwm-terminal ;;
	browser) launch_background dwm-default-apps open https:// ;;
	*)
		printf 'unknown action: %s\n' "${1:-}" >&2
		return 2
		;;
	esac
	printf 'action\t%s%s\n' "$1" "${action_terminal:+	terminal}"
}

# The Quick Actions that depend on something optional, one per line, when it is
# there: Self-Heal only once a script is set up, GTK Settings with nwg-look (#293).
optional_actions() {
	! command -v nwg-look >/dev/null 2>&1 || printf 'optional-action\tgtk-settings\n'
	! self_heal_script_path >/dev/null 2>&1 || printf 'optional-action\tself-heal\n'
}

usage() {
	printf 'usage: %s health|optional-actions|info|themes|theme-set <name>|keybinds|session-action lock|logout|suspend|reboot|shutdown|action <name>\n' "$0" >&2
}

case ${1:-} in
health) health ;;
optional-actions) optional_actions ;;
info) info ;;
themes) themes ;;
theme-set)
	if [ $# -ne 2 ]; then
		usage
		exit 2
	fi
	theme_set "$2"
	;;
keybinds) keybinds ;;
power-*)
	# The power provider is dwm-settings-power now (#282). A shell that
	# predates it, still running across an update, asks here.
	power_helper=$script_dir/dwm-settings-power
	[ -x "$power_helper" ] || power_helper=$(command -v dwm-settings-power 2>/dev/null || true)
	[ -n "$power_helper" ] || {
		printf 'dwm-settings-power is unavailable\n' >&2
		exit 127
	}
	exec "$power_helper" "$@"
	;;
session-action)
	if [ $# -ne 2 ]; then
		usage
		exit 2
	fi
	session_action "$2"
	;;
action)
	if [ $# -ne 2 ]; then
		usage
		exit 2
	fi
	action "$2"
	;;
*)
	usage
	exit 2
	;;
esac
