#!/bin/sh
set -eu

action=${1:-toggle}
case "$action" in
open | close | toggle | refresh | status) ;;
*)
	printf 'usage: %s [open|close|toggle|refresh|status]\n' "$0" >&2
	exit 2
	;;
esac

# lyona-shell knows the managed shell's config path and IPC targets (#320).
shell=lyona-shell
[ ! -x "${0%/*}/lyona-shell" ] || shell=${0%/*}/lyona-shell
exec "$shell" settings "$action"
