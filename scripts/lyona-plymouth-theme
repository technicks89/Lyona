#!/usr/bin/env bash
#
# Generate a Plymouth boot splash theme from a lyona palette.
#
# The ISO boots with `quiet loglevel=3 vt.global_cursor_default=0`, which turns
# the whole boot into a black screen. That reads as a hang rather than as a
# boot, so the same silence is given something to show instead.
#
#     lyona-plymouth-theme generate THEME_ID THEMES_FILE ASSET_DIR OUTDIR
#
# The palette supplies the background; the logo variant follows dark_mode, the
# same way the README picks one by prefers-color-scheme. Output is
# deterministic: the same palette always produces the same bytes.
#
# Plymouth's script module wants colours as RGB floats rather than hex, and it
# has no layout engine, so the script positions one centred sprite and scales
# it against the resolution it finds at boot.

set -euo pipefail
export LC_ALL=C

theme_name=lyona
install_root=/usr/share/plymouth/themes/$theme_name

die() {
	printf 'lyona-plymouth-theme: %s\n' "$*" >&2
	exit 1
}

usage() {
	cat >&2 <<'EOF'
usage: lyona-plymouth-theme generate THEME_ID THEMES_FILE ASSET_DIR OUTDIR
EOF
	exit 2
}

# Copied from lyona-gtk-theme, which copied it from theme-apply.sh: none of
# the three has a sourceable form, and a shared file would need an install
# path and a runtime lookup for no gain.
toml_get() {
	local section="$1" key="$2" file="$3"
	awk -v sec="[$section]" -v key="$key" '
		/^[[:space:]]*\[/ {
			header = $0
			sub(/^[[:space:]]*/, "", header)
			sub(/[[:space:]]*#.*/, "", header)
			sub(/[[:space:]]+$/, "", header)
			in_sec = (header == sec)
		}
		in_sec && $0 ~ "^[[:space:]]*" key "[[:space:]]*=" {
			sub(/^[^=]*=[[:space:]]*/, "")
			gsub(/"/, "")
			gsub(/[[:space:]]+#.*$/, "")
			sub(/[[:space:]]+$/, "")
			print; exit
		}
	' "$file"
}

valid_theme_id() {
	case ${1:-} in
	"" | *[/\\]* | *..* | *[[:space:]]*) return 1 ;;
	esac
	[[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]
}

valid_hex() {
	[[ ${1:-} =~ ^#[0-9A-Fa-f]{6}$ ]]
}

first_colour() {
	local candidate
	for candidate in "$@"; do
		valid_hex "$candidate" && {
			printf '%s' "$candidate"
			return 0
		}
	done
	return 1
}

# #RRGGBB as the three 0..1 floats Window.SetBackground*Color wants.
hex_to_floats() {
	local colour=$1
	printf '%.3f, %.3f, %.3f' \
		"$(awk -v v="$((16#${colour:1:2}))" 'BEGIN { print v / 255 }')" \
		"$(awk -v v="$((16#${colour:3:2}))" 'BEGIN { print v / 255 }')" \
		"$(awk -v v="$((16#${colour:5:2}))" 'BEGIN { print v / 255 }')"
}

# #RRGGBB as the 0xRRGGBB form the .plymouth key wants.
hex_to_console() {
	local colour=$1
	printf '0x%s' "$(printf '%s' "${colour:1}" | tr '[:upper:]' '[:lower:]')"
}

emit_theme_descriptor() {
	local id=$1 console_bg=$2
	cat <<EOF
# Generated by lyona-plymouth-theme from the $id palette. Do not edit.
[Plymouth Theme]
Name=Lyona
Description=Lyona boot splash generated from the $id palette
ModuleName=script

[script]
ImageDir=$install_root
ScriptFile=$install_root/$theme_name.script
ConsoleLogBackgroundColor=$console_bg
EOF
}

emit_script() {
	local id=$1 background=$2 foreground=$3
	cat <<EOF
# Generated by lyona-plymouth-theme from the $id palette. Do not edit.
#
# Plymouth's script module gives no layout, so the logo is placed by hand
# against whatever resolution the boot lands on and scaled down when it would
# otherwise overflow a small one.

Window.SetBackgroundTopColor($background);
Window.SetBackgroundBottomColor($background);

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

logo.image = Image("logo.png");
logo.width = logo.image.GetWidth();
logo.height = logo.image.GetHeight();

# Never wider than 40% of the screen, and never enlarged past its own size:
# upscaling a wordmark looks worse than showing it small.
target_width = screen_width * 0.4;
if (target_width < logo.width) {
	logo.height = logo.height * target_width / logo.width;
	logo.width = target_width;
	logo.image = logo.image.Scale(logo.width, logo.height);
}

logo.sprite = Sprite(logo.image);
logo.sprite.SetPosition(
	(screen_width - logo.width) / 2,
	(screen_height - logo.height) / 2,
	0);

# The password prompt has to be answerable, or an encrypted root cannot be
# unlocked with the splash showing.
prompt.bullets = "";

fun display_password_callback(prompt_string, bullet_count) {
	prompt.bullets = "";
	index = 0;
	while (index < bullet_count) {
		prompt.bullets = prompt.bullets + "*";
		index++;
	}
	prompt.image = Image.Text(prompt_string + " " + prompt.bullets, $foreground);
	prompt.sprite = Sprite(prompt.image);
	prompt.sprite.SetPosition(
		(screen_width - prompt.image.GetWidth()) / 2,
		(screen_height + logo.height) / 2 + 40,
		1);
}

fun display_normal_callback() {
	prompt.sprite = NULL;
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
EOF
}

generate_one() {
	local id=$1 file=$2 asset_dir=$3 outdir=$4
	local section="theme.$id"
	local term_bg norm_bg term_fg norm_fg dark_mode background foreground logo

	valid_theme_id "$id" || die "unsafe theme id: $id"
	[[ -f $file ]] || die "themes file not found: $file"
	[[ -d $asset_dir ]] || die "asset directory not found: $asset_dir"

	term_bg=$(toml_get "$section" term_bg "$file")
	norm_bg=$(toml_get "$section" normbgcolor "$file")
	term_fg=$(toml_get "$section" term_fg "$file")
	norm_fg=$(toml_get "$section" normfgcolor "$file")
	dark_mode=$(toml_get "$section" dark_mode "$file")
	[[ -n $dark_mode ]] || dark_mode=true

	# term_bg, not normbgcolor, for the same reason as the GTK themes: on a
	# light palette normbgcolor is the dwm bar's mid grey.
	background=$(first_colour "$term_bg" "$norm_bg") ||
		die "theme '$id' has no usable background colour"
	foreground=$(first_colour "$term_fg" "$norm_fg") ||
		die "theme '$id' has no usable foreground colour"

	# The dark wordmark is the one with white text, so it goes on a dark
	# background -- the same pairing the README makes by prefers-color-scheme.
	if [[ $dark_mode == true ]]; then
		logo=$asset_dir/lyona-logo-horizontal-dark.png
	else
		logo=$asset_dir/lyona-logo-horizontal-light.png
	fi
	[[ -f $logo ]] || die "logo not found: $logo"

	mkdir -p -- "$outdir" || die "could not create $outdir"
	emit_theme_descriptor "$id" "$(hex_to_console "$background")" \
		>"$outdir/$theme_name.plymouth"
	emit_script "$id" "$(hex_to_floats "$background")" \
		"$(hex_to_floats "$foreground")" >"$outdir/$theme_name.script"
	install -Dm644 "$logo" "$outdir/logo.png"
}

case ${1:-} in
generate)
	[[ $# -eq 5 ]] || usage
	generate_one "$2" "$3" "$4" "$5"
	;;
-h | --help | help) usage ;;
*) usage ;;
esac
