#!/usr/bin/env bash

set -euo pipefail

# shellcheck source=scripts/dwm-paths.sh
. "${BASH_SOURCE[0]%/*}/dwm-paths.sh"

# Capabilities the user may override independently of the active theme, and
# the sentinel that hands each one back to the theme.
capabilities=(cursor icon gtk qt)
declare -A capability_default=(
	[cursor]=follow-theme
	[icon]=follow-system
	[gtk]=follow-theme
	[qt]=follow-theme
)
protocol_header=$'toolkit-protocol\t1\t0'
action_header=$'toolkit-action-protocol\t1\t0'
home_dir=${HOME:-}
config_home=${XDG_CONFIG_HOME:-}
state_home=${XDG_STATE_HOME:-}
[[ $config_home == /* ]] || config_home=${home_dir:+$home_dir/.config}
[[ $state_home == /* ]] || state_home=${home_dir:+$home_dir/.local/state}
config_dir=$config_home/lyona
config_file=$config_dir/personalization.conf
state_base=$state_home/lyona
appearance_state_dir=$state_base/appearance
state_dir=$state_home/lyona/appearance/toolkit
lock_file=$state_dir/mutation.lock
preview_file=$state_dir/preview.current
preview_meta=$state_dir/preview.meta
preview_baseline=$state_dir/preview.baseline
preview_failed=$state_dir/preview.failed
icon_baseline_file=$state_dir/baseline-icon
preview_setup_active=false
preview_setup_pid=''
preview_setup_hash=''
preview_setup_present=no
preview_setup_mode=600
published_config_retained=false
exchange_failure_detail=''

usage() {
	printf '%s\n' \
		'usage: dwm-settings-toolkit status' \
		'       dwm-settings-toolkit mutation-ready' \
		'       dwm-settings-toolkit preview TOKEN SECONDS CAPABILITY VALUE' \
		'       dwm-settings-toolkit keep TOKEN' \
		'       dwm-settings-toolkit revert TOKEN' \
		'       dwm-settings-toolkit abandon TOKEN' \
		'       dwm-settings-toolkit apply CAPABILITY VALUE' \
		'       dwm-settings-toolkit reset CAPABILITY' \
		'' \
		'CAPABILITY is cursor, icon, gtk or qt.' \
		'VALUE is a theme name, or follow-theme/follow-system to stop overriding.' >&2
}

die() {
	printf '%s\n' "$*" >&2
	exit 1
}

clean_field() {
	local value=$1
	value=${value//$'\t'/ }
	value=${value//$'\r'/ }
	value=${value//$'\n'/ }
	printf '%.512s' "$value"
}

require_paths() {
	[[ -n $home_dir ]] || die 'HOME is unavailable'
	valid_absolute_path "$home_dir" || die 'HOME must be an absolute path'
	valid_absolute_path "$config_home" || die 'XDG_CONFIG_HOME must be an absolute path'
	valid_absolute_path "$state_home" || die 'XDG_STATE_HOME must be an absolute path'
}

validate_file() {
	local path=$1 label=$2 uid
	[[ ! -e $path && ! -L $path ]] && return 0
	uid=$(id -u)
	[[ -f $path && ! -L $path ]] || die "$label must be a regular file: $path"
	[[ $(stat -c %u -- "$path" 2>/dev/null) == "$uid" ]] ||
		die "$label is not owned by the current user: $path"
	[[ $(stat -c %h -- "$path" 2>/dev/null) == 1 ]] ||
		die "$label must not have multiple hard links: $path"
}

prepare_state() {
	require_paths
	existing_path_chain_is_safe "$state_dir/.toolkit-ready" || die "unsafe toolkit state path: $state_dir"
	ensure_owned_directory "$state_home" 'state home'
	ensure_owned_directory "$state_base" 'lyona state'
	ensure_owned_directory "$appearance_state_dir" 'appearance state'
	ensure_owned_directory "$state_dir" 'toolkit state'
	chmod 700 -- "$state_base" "$appearance_state_dir" "$state_dir"
	validate_file "$lock_file" 'toolkit mutation lock'
}

prepare_config() {
	local allow_oversized=${1:-no}
	require_paths
	existing_path_chain_is_safe "$config_file" || die "unsafe toolkit configuration path: $config_file"
	ensure_owned_directory "$config_home" 'configuration home'
	ensure_owned_directory "$config_dir" 'lyona configuration'
	validate_file "$config_file" 'toolkit configuration'
	if [[ $allow_oversized != yes && -e $config_file && $(stat -c %s -- "$config_file") -gt 4096 ]]; then
		die "toolkit configuration is too large: $config_file"
	fi
}

valid_capability() {
	local candidate=$1 known
	for known in "${capabilities[@]}"; do
		[[ $candidate == "$known" ]] && return 0
	done
	return 1
}

is_sentinel() {
	local capability=$1 value=$2
	[[ $value == "${capability_default[$capability]}" ]]
}

valid_value_syntax() {
	local value=$1
	[[ -n $value && ${#value} -le 128 && $value != *$'\t'* && $value != *$'\n'* &&
		$value != *$'\r'* && $value != */* && $value != *\\* && $value != .. && $value != . ]]
}

# The same roots theme-apply.sh searches, so what Settings offers and what the
# applier can resolve cannot drift apart.
theme_roots() {
	printf '%s\n' \
		"${XDG_DATA_HOME:-$home_dir/.local/share}/themes" \
		"$home_dir/.themes" \
		/usr/local/share/themes \
		/usr/share/themes
}

icon_roots() {
	printf '%s\n' \
		"${XDG_DATA_HOME:-$home_dir/.local/share}/icons" \
		"$home_dir/.icons" \
		/usr/local/share/icons \
		/usr/share/icons
}

gtk_available() {
	local name=$1 root
	case $name in
	Adwaita | Adwaita-dark) return 0 ;;
	esac
	while IFS= read -r root; do
		[[ -d $root/$name/gtk-3.0 || -d $root/$name/gtk-4.0 ]] && return 0
	done < <(theme_roots)
	return 1
}

cursor_available() {
	local name=$1 root
	while IFS= read -r root; do
		[[ -d $root/$name/cursors ]] && return 0
	done < <(icon_roots)
	return 1
}

# An icon theme must declare directories. Without that it is a cursor theme or
# a stub, and choosing it would leave applications with no icons at all.
icon_available() {
	local name=$1 root index
	while IFS= read -r root; do
		index=$root/$name/index.theme
		[[ -f $index ]] || continue
		grep -Eq '^[[:space:]]*(Scaled)?Directories[[:space:]]*=' "$index" && return 0
	done < <(icon_roots)
	return 1
}

qt_available() {
	case $1 in
	gtk3) return 0 ;;
	qt5ct | qt6ct) command -v "$1" >/dev/null 2>&1 ;;
	*) return 1 ;;
	esac
}

value_available() {
	local capability=$1 value=$2
	is_sentinel "$capability" "$value" && return 0
	case $capability in
	cursor) cursor_available "$value" ;;
	icon) icon_available "$value" ;;
	gtk) gtk_available "$value" ;;
	qt) qt_available "$value" ;;
	*) return 1 ;;
	esac
}

valid_token() {
	[[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$ ]]
}

valid_seconds() {
	[[ $1 =~ ^[0-9]+$ ]] && ((10#$1 >= 5 && 10#$1 <= 120))
}

read_now() {
	if [[ -n ${DWM_SETTINGS_TOOLKIT_NOW:-} ]]; then
		[[ $DWM_SETTINGS_TOOLKIT_NOW =~ ^[0-9]+$ ]] || die 'DWM_SETTINGS_TOOLKIT_NOW must be a monotonic timestamp'
		printf '%s\n' "$DWM_SETTINGS_TOOLKIT_NOW"
	else
		local uptime
		IFS=' ' read -r uptime _ </proc/uptime || die 'monotonic clock is unavailable'
		[[ $uptime =~ ^[0-9]+([.][0-9]+)?$ ]] || die 'monotonic clock is invalid'
		printf '%s\n' "${uptime%%.*}"
	fi
}

read_boot_id() {
	local boot_id
	if [[ -n ${DWM_SETTINGS_TOOLKIT_BOOT_ID:-} ]]; then
		boot_id=$DWM_SETTINGS_TOOLKIT_BOOT_ID
	else
		IFS= read -r boot_id </proc/sys/kernel/random/boot_id || die 'boot identity is unavailable'
	fi
	[[ $boot_id =~ ^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$ ]] ||
		die 'boot identity is invalid'
	printf '%s\n' "$boot_id"
}

# selected[capability] holds a sentinel or a concrete name. The file keeps a
# fixed record order, like the other helpers' configs.
declare -A selected=()

read_config() {
	local capability
	for capability in "${capabilities[@]}"; do
		selected[$capability]=${capability_default[$capability]}
	done
	configured_state=default
	configured_detail='Toolkit choices follow the active theme'
	[[ -e $config_file ]] || return 0
	validate_file "$config_file" 'toolkit configuration'
	if [[ $(stat -c %s -- "$config_file") -gt 4096 ]]; then
		configured_state=invalid
		configured_detail='Toolkit configuration is too large; theme defaults remain active'
		return 1
	fi
	local header='' record value extra records=0 index
	local -A parsed=()
	while IFS=$'\t' read -r record value extra || [[ -n $record$value$extra ]]; do
		((records += 1))
		if ((records == 1)); then
			header=$record$'\t'$value$'\t'$extra
			continue
		fi
		index=$((records - 2))
		if ((index >= ${#capabilities[@]})) ||
			[[ $record != "${capabilities[index]}" || -n $extra ]]; then
			configured_state=invalid
			configured_detail='Toolkit configuration has unexpected records'
			return 1
		fi
		parsed[$record]=$value
	done <"$config_file"
	if [[ $header != "$protocol_header" ]] || ((records != ${#capabilities[@]} + 1)); then
		configured_state=invalid
		configured_detail='Toolkit configuration is malformed; theme defaults remain active'
		return 1
	fi
	for capability in "${capabilities[@]}"; do
		value=${parsed[$capability]:-}
		if ! valid_value_syntax "$value"; then
			configured_state=invalid
			configured_detail='Toolkit configuration is malformed; theme defaults remain active'
			return 1
		fi
		selected[$capability]=$value
	done
	configured_state=configured
	configured_detail='Toolkit choices are persisted'
}

# Rendered from the map, so writing and hashing cannot disagree.
config_body() {
	local capability
	printf '%s\n' "$protocol_header"
	for capability in "${capabilities[@]}"; do
		printf '%s\t%s\n' "$capability" "${selected[$capability]}"
	done
}

config_path_hash() {
	local path=$1
	[[ -f $path && ! -L $path && $(stat -c %u -- "$path") == "$(id -u)" &&
	$(stat -c %h -- "$path") == 1 && $(stat -c %s -- "$path") -le 4096 ]] || return 1
	sha256sum -- "$path" | awk '{ print $1 }'
}

retain_external_config() {
	local path=$1
	printf 'dwm-settings-toolkit: concurrent toolkit configuration retained at %s\n' "$path" >&2
}

mv_exchange_options_supported() {
	local help
	help=$(LC_ALL=C mv --help 2>/dev/null) || return 1
	[[ $help == *'--exchange'* && $help == *'--no-copy'* ]]
}

publish_config_if_hash() {
	local staged=$1 expected_hash=$2 expected_mode=${3:-} published_hash captured_hash captured_mode rollback_hash
	published_config_retained=false
	published_hash=$(config_path_hash "$staged") || return 1
	if [[ $expected_hash == absent ]]; then
		mv --no-clobber --no-target-directory -- "$staged" "$config_file" || return 1
		[[ ! -e $staged && ! -L $staged ]] || return 1
		[[ $(config_path_hash "$config_file" 2>/dev/null || true) == "$published_hash" ]]
		return
	fi
	if ! mv_exchange_options_supported; then
		printf 'dwm-settings-toolkit: GNU mv with --exchange and --no-copy is required (coreutils 9.5 or newer)\n' >&2
		return 1
	fi
	if ! mv --exchange --no-copy -- "$staged" "$config_file"; then
		printf 'dwm-settings-toolkit: atomic file exchange is unavailable on the toolkit configuration filesystem\n' >&2
		return 1
	fi
	captured_hash=$(config_path_hash "$staged" 2>/dev/null || true)
	captured_mode=$(stat -c %a -- "$staged" 2>/dev/null || true)
	if [[ $captured_hash == "$expected_hash" &&
		(-z $expected_mode || $captured_mode == "$expected_mode") ]]; then
		unlink -- "$staged"
		return 0
	fi
	if [[ $(config_path_hash "$config_file" 2>/dev/null || true) != "$published_hash" ]]; then
		retain_external_config "$staged"
		published_config_retained=true
		return 1
	fi
	if mv --exchange --no-copy -- "$staged" "$config_file"; then
		rollback_hash=$(config_path_hash "$staged" 2>/dev/null || true)
		if [[ $rollback_hash == "$published_hash" ]]; then
			unlink -- "$staged"
		else
			retain_external_config "$staged"
			published_config_retained=true
		fi
	else
		retain_external_config "$staged"
		published_config_retained=true
	fi
	return 1
}

write_config() {
	local expected_hash=$1 expected_mode=${2:-} requested_temp=${3:-} temp mode=600
	prepare_config
	if [[ -e $config_file ]]; then
		if [[ -n $expected_mode ]]; then
			mode=$expected_mode
		else
			mode=$(stat -c %a -- "$config_file")
		fi
	fi
	if [[ -n $requested_temp ]]; then
		[[ $requested_temp == "$config_dir"/.personalization.conf.preview-exchange.* &&
			! -e $requested_temp && ! -L $requested_temp ]] || return 1
		(umask 077 && set -o noclobber && : >"$requested_temp") 2>/dev/null || return 1
		temp=$requested_temp
	else
		temp=$(mktemp --tmpdir="$config_dir" .personalization.conf.XXXXXX) || return 1
	fi
	trap 'unlink -- "${temp:-}" 2>/dev/null || true' RETURN
	config_body >"$temp" || return 1
	chmod "$mode" -- "$temp" || return 1
	if ! publish_config_if_hash "$temp" "$expected_hash" "$expected_mode"; then
		[[ $published_config_retained == false ]] || temp=
		return 1
	fi
	temp=
	trap - RETURN
}

selection_hash() {
	config_body | sha256sum | awk '{ print $1 }'
}

remove_config() {
	local expected_hash=$1 expected_mode=${2:-} captured captured_hash captured_mode
	prepare_config
	[[ $expected_hash != absent ]] || {
		[[ ! -e $config_file && ! -L $config_file ]]
		return
	}
	captured=$(mktemp --tmpdir="$config_dir" .personalization.conf.removed.XXXXXX) || return 1
	unlink -- "$captured" || return 1
	trap 'if [[ -e ${captured:-} || -L ${captured:-} ]]; then unlink -- "$captured" 2>/dev/null || true; fi' RETURN
	mv --no-clobber --no-target-directory -- "$config_file" "$captured" || return 1
	[[ ! -e $config_file && ! -L $config_file && -e $captured ]] || return 1
	captured_hash=$(config_path_hash "$captured" 2>/dev/null || true)
	captured_mode=$(stat -c %a -- "$captured" 2>/dev/null || true)
	if [[ $captured_hash == "$expected_hash" &&
		(-z $expected_mode || $captured_mode == "$expected_mode") ]]; then
		unlink -- "$captured"
		captured=
		trap - RETURN
		return 0
	fi
	if mv --no-clobber --no-target-directory -- "$captured" "$config_file" &&
		[[ ! -e $captured && ! -L $captured ]]; then
		captured=
	else
		retain_external_config "$captured"
		captured=
	fi
	return 1
}

file_hash() {
	if [[ -e $config_file ]]; then
		sha256sum -- "$config_file" | awk '{ print $1 }'
	else
		printf '%s\n' absent
	fi
}

file_mode() {
	if [[ -e $config_file ]]; then
		stat -c %a -- "$config_file"
	else
		printf '%s\n' absent
	fi
}

exchange_supported() {
	local probe_a probe_b status=1
	exchange_failure_detail='Atomic file exchange readiness could not be verified'
	if ! mv_exchange_options_supported; then
		exchange_failure_detail='GNU mv with --exchange and --no-copy is required (coreutils 9.5 or newer)'
		return 1
	fi
	prepare_config
	probe_a=$(mktemp --tmpdir="$config_dir" .toolkit-exchange-a.XXXXXX) || return 1
	probe_b=$(mktemp --tmpdir="$config_dir" .toolkit-exchange-b.XXXXXX) || {
		unlink -- "$probe_a"
		return 1
	}
	if mv --exchange --no-copy -- "$probe_a" "$probe_b" 2>/dev/null; then
		status=0
	else
		exchange_failure_detail='Atomic file exchange is unavailable on the toolkit configuration filesystem'
	fi
	unlink -- "$probe_a"
	unlink -- "$probe_b"
	return "$status"
}

preview_exchange_path() {
	local token=$1
	valid_token "$token" || return 1
	printf '%s/.personalization.conf.preview-exchange.%s\n' "$config_dir" "$token"
}

cleanup_preview_exchange() {
	local token=$1 path baseline_hash captured_hash baseline_mode captured_mode
	path=$(preview_exchange_path "$token") || return 1
	[[ -e $path || -L $path ]] || return 0
	[[ -f $preview_baseline && ! -L $preview_baseline ]] || return 1
	baseline_hash=$(config_path_hash "$preview_baseline" 2>/dev/null || true)
	captured_hash=$(config_path_hash "$path" 2>/dev/null || true)
	baseline_mode=$(meta_value baseline-mode 2>/dev/null || true)
	captured_mode=$(stat -c %a -- "$path" 2>/dev/null || true)
	[[ -n $baseline_hash && $captured_hash == "$baseline_hash" &&
		$baseline_mode == "$captured_mode" ]] || return 1
	unlink -- "$path"
}

restore_interrupted_exchange() {
	local token=$1 expected_hash=$2 expected_mode=$3 path path_hash path_mode current_hash current_mode
	local baseline_present baseline_hash
	path=$(preview_exchange_path "$token") || return 1
	[[ -e $path || -L $path ]] || return 2
	path_hash=$(config_path_hash "$path" 2>/dev/null || true)
	path_mode=$(stat -c %a -- "$path" 2>/dev/null || true)
	[[ -n $path_hash ]] || return 1
	baseline_present=$(meta_value baseline-present 2>/dev/null || true)
	current_hash=$(file_hash)
	current_mode=$(file_mode)
	if [[ $path_hash == "$expected_hash" && $path_mode == "$expected_mode" ]]; then
		case $baseline_present in
		yes)
			baseline_hash=$(config_path_hash "$preview_baseline" 2>/dev/null || true)
			if [[ -n $baseline_hash && $current_hash == "$baseline_hash" &&
				$current_mode == "$expected_mode" ]]; then
				unlink -- "$path"
				return 0
			fi
			;;
		no)
			if [[ $current_hash == absent && $current_mode == absent ]]; then
				unlink -- "$path"
				return 0
			fi
			;;
		esac
	fi
	publish_config_if_hash "$path" "$expected_hash" "$expected_mode"
}

meta_value() {
	local key=$1
	awk -F '\t' -v key="$key" '$1 == key && NF == 2 { print $2; found = 1; exit } END { exit(found ? 0 : 1) }' "$preview_meta"
}

write_meta() {
	local token=$1 deadline=$2 boot_id=$3 capability=$4 value=$5 hash=$6 present=$7 mode=$8 pid=$9
	local start=${10} published=${11:-no} temp
	temp=$(mktemp --tmpdir="$state_dir" .preview.meta.XXXXXX)
	trap 'unlink -- "${temp:-}" 2>/dev/null || true' RETURN
	chmod 600 -- "$temp"
	printf '%s\t%s\n' \
		token "$token" deadline "$deadline" boot-id "$boot_id" capability "$capability" value "$value" \
		hash "$hash" baseline-present "$present" baseline-mode "$mode" \
		watchdog-pid "$pid" watchdog-start "$start" published "$published" >"$temp"
	mv -fT -- "$temp" "$preview_meta"
	trap - RETURN
}

write_preview_token() {
	local token=$1 temp
	temp=$(mktemp --tmpdir="$state_dir" .preview.current.XXXXXX)
	trap 'unlink -- "${temp:-}" 2>/dev/null || true' RETURN
	chmod 600 -- "$temp"
	printf '%s\n' "$token" >"$temp"
	mv -fT -- "$temp" "$preview_file"
	trap - RETURN
}

capture_baseline() {
	local temp
	temp=$(mktemp --tmpdir="$state_dir" .preview.baseline.XXXXXX)
	trap 'unlink -- "${temp:-}" 2>/dev/null || true' RETURN
	cp -- "$config_file" "$temp"
	chmod 600 -- "$temp"
	mv -fT -- "$temp" "$preview_baseline"
	trap - RETURN
}

process_start_time() {
	local pid=$1
	awk '{ line=$0; sub(/^.*\) /, "", line); split(line, field, " "); if (field[1] != "Z") print field[20] }' \
		"/proc/$pid/stat" 2>/dev/null
}

process_group_id() {
	local pid=$1
	awk '{ line=$0; sub(/^.*\) /, "", line); split(line, field, " "); if (field[1] != "Z") print field[3] }' \
		"/proc/$pid/stat" 2>/dev/null
}

terminate_watchdog_group() {
	local pid=$1 pgrp
	[[ $pid =~ ^[0-9]+$ && $pid -ge 2 && $pid -ne $$ ]] || return 0
	pgrp=$(process_group_id "$pid" || true)
	[[ $pgrp == "$pid" ]] || return 0
	kill -TERM -- "-$pid" 2>/dev/null || true
}

stop_watchdog() {
	[[ -f $preview_meta ]] || return 0
	local pid start boot_id current_boot current
	pid=$(meta_value watchdog-pid 2>/dev/null || true)
	start=$(meta_value watchdog-start 2>/dev/null || true)
	boot_id=$(meta_value boot-id 2>/dev/null || true)
	[[ $pid =~ ^[0-9]+$ && $pid -ge 2 && -n $start && $pid -ne $$ ]] || return 0
	current_boot=$(read_boot_id)
	[[ $current_boot == "$boot_id" ]] || return 0
	current=$(process_start_time "$pid" || true)
	[[ $current == "$start" ]] || return 0
	terminate_watchdog_group "$pid"
}

watchdog_alive() {
	[[ -f $preview_meta ]] || return 1
	local pid start boot_id current_boot current
	pid=$(meta_value watchdog-pid 2>/dev/null || true)
	start=$(meta_value watchdog-start 2>/dev/null || true)
	boot_id=$(meta_value boot-id 2>/dev/null || true)
	[[ $pid =~ ^[0-9]+$ && $pid -ge 2 && -n $start ]] || return 1
	current_boot=$(read_boot_id)
	[[ $current_boot == "$boot_id" ]] || return 1
	current=$(process_start_time "$pid" || true)
	[[ $current == "$start" ]]
}

clear_preview() {
	local token
	token=$(preview_token 2>/dev/null || true)
	stop_watchdog
	if [[ -n $token ]]; then
		cleanup_preview_exchange "$token" || true
	fi
	for path in "$preview_file" "$preview_meta" "$preview_baseline" "$preview_failed"; do
		if [[ -e $path || -L $path ]]; then
			unlink -- "$path"
		fi
	done
}

mark_failed() {
	local token=$1 detail=$2 temp
	temp=$(mktemp --tmpdir="$state_dir" .preview.failed.XXXXXX)
	trap 'unlink -- "${temp:-}" 2>/dev/null || true' RETURN
	chmod 600 -- "$temp"
	printf '%s\t%s\n' "$token" "$(clean_field "$detail")" >"$temp"
	mv -fT -- "$temp" "$preview_failed"
	trap - RETURN
}

preview_token() {
	[[ -f $preview_file ]] || return 1
	local token extra
	IFS=$'\t' read -r token extra <"$preview_file" || true
	valid_token "$token" && [[ -z ${extra:-} ]] || return 1
	printf '%s\n' "$token"
}

restore_baseline() {
	local expected_hash=$1 present mode temp
	present=$(meta_value baseline-present)
	mode=$(meta_value baseline-mode)
	prepare_config
	case $present in
	yes)
		[[ -f $preview_baseline && ! -L $preview_baseline && $mode =~ ^[0-7]{3,4}$ ]] || return 1
		temp=$(mktemp --tmpdir="$config_dir" .personalization.conf.restore.XXXXXX) || return 1
		trap 'unlink -- "${temp:-}" 2>/dev/null || true' RETURN
		cp -- "$preview_baseline" "$temp" || return 1
		chmod "$mode" -- "$temp" || return 1
		if ! publish_config_if_hash "$temp" "$expected_hash" "$mode"; then
			[[ $published_config_retained == false ]] || temp=
			return 1
		fi
		temp=
		trap - RETURN
		;;
	no)
		if [[ ! -e $config_file && ! -L $config_file ]]; then
			return 0
		fi
		remove_config "$expected_hash" 600
		;;
	*) return 1 ;;
	esac
}

restore_captured_baseline() {
	local present=$1 mode=$2 expected_hash=$3 temp
	prepare_config
	case $present in
	yes)
		[[ -f $preview_baseline && ! -L $preview_baseline && $mode =~ ^[0-7]{3,4}$ ]] || return 1
		temp=$(mktemp --tmpdir="$config_dir" .personalization.conf.restore.XXXXXX) || return 1
		trap 'unlink -- "${temp:-}" 2>/dev/null || true' RETURN
		cp -- "$preview_baseline" "$temp" || return 1
		chmod "$mode" -- "$temp" || return 1
		if ! publish_config_if_hash "$temp" "$expected_hash" "$mode"; then
			[[ $published_config_retained == false ]] || temp=
			return 1
		fi
		temp=
		trap - RETURN
		;;
	no)
		if [[ ! -e $config_file && ! -L $config_file ]]; then
			return 0
		fi
		remove_config "$expected_hash" 600
		;;
	*) return 1 ;;
	esac
}

preview_setup_cleanup() {
	local status=$1 current_hash='' current_mode='' token='' interrupted_status=2
	local recovery_complete=false
	trap - EXIT HUP INT TERM
	[[ $preview_setup_active == true ]] || exit "$status"
	set +e
	if [[ -n $preview_setup_pid ]]; then
		terminate_watchdog_group "$preview_setup_pid"
	fi
	token=$(preview_token 2>/dev/null || true)
	if [[ -n $token && -n $preview_setup_hash ]]; then
		if restore_interrupted_exchange "$token" "$preview_setup_hash" \
			"$preview_setup_mode" >/dev/null 2>&1; then
			recovery_complete=true
		else
			interrupted_status=$?
			if ((interrupted_status == 2)); then
				current_hash=$(file_hash 2>/dev/null)
				current_mode=$(file_mode 2>/dev/null)
				if [[ $current_hash != "$preview_setup_hash" ]]; then
					recovery_complete=true
				elif [[ $current_mode == "$preview_setup_mode" ]] &&
					restore_captured_baseline "$preview_setup_present" "$preview_setup_mode" \
						"$preview_setup_hash" >/dev/null 2>&1; then
					recovery_complete=true
				else
					mark_failed "$token" \
						'Interrupted toolkit preview could not restore the captured configuration'
				fi
			else
				mark_failed "$token" \
					'Interrupted toolkit preview could not restore the captured configuration'
			fi
		fi
	else
		recovery_complete=true
	fi
	if [[ $recovery_complete == true ]]; then
		if [[ -n $token ]]; then
			cleanup_preview_exchange "$token" >/dev/null 2>&1 || true
		fi
		for path in "$preview_file" "$preview_meta" "$preview_baseline" "$preview_failed"; do
			if [[ -e $path || -L $path ]]; then
				unlink -- "$path" 2>/dev/null
			fi
		done
	fi
	exit "$status"
}

expire_preview_locked() {
	local expected_token=${1:-} token deadline boot_id current_boot now expected_hash current_hash
	local expected_mode current_mode interrupted_status published baseline_present baseline_hash
	token=$(preview_token 2>/dev/null || true)
	if [[ -z $token ]]; then
		if [[ -e $preview_file || -L $preview_file || -e $preview_meta || -L $preview_meta ||
			-e $preview_baseline || -L $preview_baseline || -e $preview_failed || -L $preview_failed ]]; then
			clear_preview
		fi
		return 0
	fi
	[[ -z $expected_token || $token == "$expected_token" ]] || return 0
	[[ -f $preview_meta ]] || {
		mark_failed "$token" 'Preview metadata is missing'
		return 1
	}
	deadline=$(meta_value deadline 2>/dev/null || true)
	boot_id=$(meta_value boot-id 2>/dev/null || true)
	current_boot=$(read_boot_id)
	if [[ ! $deadline =~ ^[0-9]+$ || ! $boot_id =~ ^[0-9A-Fa-f-]{36}$ ]]; then
		mark_failed "$token" 'Preview timing metadata is invalid'
		return 1
	fi
	if [[ $current_boot == "$boot_id" ]]; then
		now=$(read_now)
	fi
	expected_hash=$(meta_value hash 2>/dev/null || true)
	expected_mode=$(meta_value baseline-mode 2>/dev/null || true)
	if restore_interrupted_exchange "$token" "$expected_hash" "$expected_mode"; then
		clear_preview
		return 0
	else
		interrupted_status=$?
		if ((interrupted_status != 2)); then
			mark_failed "$token" 'Interrupted toolkit preview could not restore the captured configuration'
			return 1
		fi
	fi
	current_hash=$(file_hash)
	current_mode=$(file_mode)
	if [[ -z $expected_hash || $current_hash != "$expected_hash" ||
		! $expected_mode =~ ^[0-7]{3,4}$ || $current_mode != "$expected_mode" ]]; then
		published=$(meta_value published 2>/dev/null || true)
		if [[ $published == no ]]; then
			baseline_present=$(meta_value baseline-present 2>/dev/null || true)
			case $baseline_present in
			yes)
				baseline_hash=$(config_path_hash "$preview_baseline" 2>/dev/null || true)
				if [[ -n $baseline_hash && $current_hash == "$baseline_hash" &&
					$current_mode == "$expected_mode" ]]; then
					clear_preview
					return 0
				fi
				;;
			no)
				if [[ $current_hash == absent && $current_mode == absent ]]; then
					clear_preview
					return 0
				fi
				;;
			esac
		fi
		mark_failed "$token" 'Font configuration changed outside Settings; automatic rollback was not applied'
		return 1
	fi
	if [[ $current_boot == "$boot_id" ]]; then
		((now >= deadline)) || return 0
	fi
	if ! restore_baseline "$expected_hash"; then
		mark_failed "$token" 'Automatic toolkit rollback could not restore the previous configuration'
		return 1
	fi
	clear_preview
}

acquire_lock() {
	prepare_state
	exec 9>"$lock_file"
	flock -w 5 -x 9 || die 'another toolkit settings operation is already running'
}

validate_selection() {
	local capability=$1 value=$2
	valid_capability "$capability" || die "unknown toolkit capability: $capability"
	valid_value_syntax "$value" || die "toolkit value is invalid: $value"
	if ! is_sentinel "$capability" "$value"; then
		case $value in
		follow-theme | follow-system)
			die "$capability is released with ${capability_default[$capability]}, not $value"
			;;
		esac
		value_available "$capability" "$value" ||
			die "$capability choice is not installed: $value"
	fi
}

# A theme preview snapshots the files theme-apply.sh derives and refuses to
# revert if they changed underneath. Mutating here during that window is
# exactly such a change, so it has to wait.
theme_transaction_armed() {
	local marker=$appearance_state_dir/integration-transaction state
	[[ -f $marker && ! -L $marker ]] || return 1
	IFS= read -r state <"$marker" 2>/dev/null || return 1
	case $state in
	ready | pending) return 0 ;;
	*) return 1 ;;
	esac
}

require_no_theme_transaction() {
	! theme_transaction_armed ||
		die 'a theme transaction is in progress; finish or revert it before changing toolkit settings'
}

# The icon theme is the one capability with no palette default, so releasing an
# override has nothing to fall back to. If the user had set gtk-icon-theme-name
# by hand before ever opening Settings, resetting would delete a value Settings
# never owned. Record it the first time an override is taken so theme-apply.sh
# can put it back.
capture_icon_baseline() {
	local source=$config_home/gtk-3.0/settings.ini value=''
	[[ ! -e $icon_baseline_file ]] || return 0
	[[ -f $source && ! -L $source ]] || return 0
	value=$(awk -F= '
		{
			key = $1
			gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
			if (key == "gtk-icon-theme-name") {
				sub(/^[^=]*=[[:space:]]*/, "")
				sub(/[[:space:]]+$/, "")
				print
				exit
			}
		}
	' "$source" 2>/dev/null || true)
	# An empty recording is still a recording: it says the key was absent before
	# the override, so releasing it removes the key again. The file's absence
	# means something different -- that no override was ever taken and the value
	# is none of our business.
	[[ $value =~ ^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$ ]] || value=''
	(umask 077 && printf '%s\n' "$value" >"$icon_baseline_file") || return 0
}

# Consumed once the applier has put it back; keeping it would let a stale value
# overwrite an icon theme the user set by hand later, while no override is
# active.
release_icon_baseline() {
	is_sentinel icon "${selected[icon]:-${capability_default[icon]}}" || return 0
	rm -f -- "$icon_baseline_file"
}

# Compares what the applier reports as live against the overrides in force.
#
# Sentinels are skipped: their value is the theme's to choose. An absent report
# is treated as a pass, so an applier too old to write one still works.
applied_matches_selection() {
	local report=$1 capability
	local -a fields=()
	[[ -f $report && ! -L $report ]] || return 0
	((${#selected[@]} > 0)) || return 0
	# Split with awk, not `IFS=$'\t' read`: tab is an IFS whitespace character,
	# so read collapses a run of them and an empty icon field would silently
	# shift every later value one column left.
	mapfile -t fields < <(awk -F'\t' '
		NR == 1 && NF == 5 && $1 == "toolkit-selection" {
			for (i = 2; i <= NF; i++) print $i
		}
	' "$report" 2>/dev/null)
	((${#fields[@]} == 4)) || return 0
	local -A live=(
		[cursor]=${fields[0]}
		[icon]=${fields[1]}
		[gtk]=${fields[2]}
		[qt]=${fields[3]}
	)
	for capability in "${capabilities[@]}"; do
		is_sentinel "$capability" "${selected[$capability]}" && continue
		[[ ${live[$capability]} == "${selected[$capability]}" ]] && continue
		printf 'dwm-settings-toolkit: %s override did not take effect: asked for %s, live value is %s\n' \
			"$capability" "${selected[$capability]}" "${live[$capability]:-none}" >&2
		return 1
	done
	return 0
}

# theme-apply.sh is a pure function of (themes.toml, personalization.conf), so
# converging is a re-run rather than restoring the files it derives.
#
# Its exit status alone does not prove convergence: a missing GTK theme makes
# it fall back to Adwaita and still exit 0, so a silently declined override
# would be reported to the user as applied. The report says what actually took
# effect and every override has to match it.
run_theme_apply() {
	local applier=${BASH_SOURCE[0]%/*}/theme-apply.sh
	[[ -x $applier ]] || applier=$(command -v theme-apply.sh 2>/dev/null || true)
	[[ -n $applier ]] || return 0
	local report=$state_dir/apply.report status=0
	rm -f -- "$report"
	if DWM_APPEARANCE_PERSONALIZATION_FILE=$config_file \
		DWM_APPEARANCE_TOOLKIT_REPORT=$report \
		timeout 30 "$applier" >/dev/null 2>&1; then
		applied_matches_selection "$report" || status=1
	else
		status=1
	fi
	rm -f -- "$report"
	return "$status"
}

# What is actually in force right now, read from the files theme-apply.sh
# derives rather than recomputed. A capability that follows the theme has no
# value of its own, so this is the only way for Settings to show what following
# the theme currently means.
ini_value() {
	local file=$1 key=$2
	[[ -f $file && ! -L $file ]] || return 0
	awk -F= -v key="$key" '
		{
			name = $1
			gsub(/^[[:space:]]+|[[:space:]]+$/, "", name)
			if (name == key) {
				sub(/^[^=]*=[[:space:]]*/, "")
				sub(/[[:space:]]+$/, "")
				print
				exit
			}
		}
	' "$file" 2>/dev/null || true
}

live_value() {
	local capability=$1 gtk3=$config_home/gtk-3.0/settings.ini env_file=$config_dir/theme-env.sh
	case $capability in
	cursor) ini_value "$gtk3" gtk-cursor-theme-name ;;
	icon) ini_value "$gtk3" gtk-icon-theme-name ;;
	gtk) ini_value "$gtk3" gtk-theme-name ;;
	qt)
		[[ -f $env_file && ! -L $env_file ]] || return 0
		sed -n 's/^export QT_QPA_PLATFORMTHEME=//p' "$env_file" 2>/dev/null | head -n 1
		;;
	esac
}

# Everything installed that a capability could be set to. Settings offers this
# list, so it is derived from the same roots value_available checks: an option
# that is offered but then refused is worse than one that is never offered.
emit_candidates() {
	local capability=$1 root name index
	case $capability in
	cursor)
		while IFS= read -r root; do
			[[ -d $root ]] || continue
			for name in "$root"/*/; do
				name=${name%/}
				name=${name##*/}
				[[ -d $root/$name/cursors ]] || continue
				printf '%s\n' "$name"
			done
		done < <(icon_roots)
		;;
	icon)
		while IFS= read -r root; do
			[[ -d $root ]] || continue
			for name in "$root"/*/; do
				name=${name%/}
				name=${name##*/}
				index=$root/$name/index.theme
				[[ -f $index ]] || continue
				grep -Eq '^[[:space:]]*(Scaled)?Directories[[:space:]]*=' "$index" || continue
				printf '%s\n' "$name"
			done
		done < <(icon_roots)
		;;
	gtk)
		printf '%s\n' Adwaita Adwaita-dark
		while IFS= read -r root; do
			[[ -d $root ]] || continue
			for name in "$root"/*/; do
				name=${name%/}
				name=${name##*/}
				[[ -d $root/$name/gtk-3.0 || -d $root/$name/gtk-4.0 ]] || continue
				printf '%s\n' "$name"
			done
		done < <(theme_roots)
		;;
	qt)
		printf '%s\n' gtk3
		command -v qt5ct >/dev/null 2>&1 && printf '%s\n' qt5ct
		command -v qt6ct >/dev/null 2>&1 && printf '%s\n' qt6ct
		;;
	esac
}

emit_status() {
	local token='' capability value deadline boot_id remaining=0 failed_detail=''
	local candidate_value
	local active_token active_hash state detail
	prepare_state
	prepare_config yes
	acquire_lock
	expire_preview_locked || true
	if preview_token >/dev/null 2>&1 && [[ ! -e $preview_failed ]] &&
		[[ ${DWM_SETTINGS_TOOLKIT_NO_WATCHDOG:-0} != 1 ]] && ! watchdog_alive; then
		active_token=$(preview_token)
		active_hash=$(meta_value hash 2>/dev/null || true)
		if restore_baseline "$active_hash"; then
			clear_preview
		else
			mark_failed "$active_token" \
				'Automatic toolkit rollback watchdog stopped and the previous configuration could not be restored'
		fi
	fi
	read_config || true

	printf '%s\n' "$action_header"
	if theme_transaction_armed; then
		printf 'provider\ttoolkit\trestricted\tuser-session\tA theme transaction is in progress\n'
	else
		printf 'provider\ttoolkit\tavailable\tuser-session\tCursor, icon, GTK and Qt overrides\n'
	fi

	# One record per capability: the value in force, and whether it is a live
	# override, the theme default, or a choice whose theme has since gone.
	for capability in "${capabilities[@]}"; do
		value=${selected[$capability]}
		if [[ $configured_state == invalid ]]; then
			state=partial
			detail=$configured_detail
		elif is_sentinel "$capability" "$value"; then
			state=available
			detail='Following the active theme'
		elif value_available "$capability" "$value"; then
			state=available
			detail='Overridden by the user'
		else
			state=unavailable
			detail="Selected $capability is no longer installed: $value"
		fi
		printf 'selection\t%s\t%s\t%s\t%s\t%s\n' "$capability" "$state" \
			"$(clean_field "$value")" "$(clean_field "$(live_value "$capability")")" \
			"$(clean_field "$detail")"
	done

	# One record per installed option, deduplicated, with the earliest root
	# winning the way the availability checks resolve it.
	for capability in "${capabilities[@]}"; do
		printf 'candidate\t%s\t%s\n' "$capability" \
			"$(clean_field "${capability_default[$capability]}")"
		while IFS= read -r candidate_value; do
			[[ -n $candidate_value ]] || continue
			printf 'candidate\t%s\t%s\n' "$capability" \
				"$(clean_field "$candidate_value")"
		done < <(emit_candidates "$capability" | LC_ALL=C sort -u)
	done

	if [[ -f $preview_failed ]]; then
		IFS=$'\t' read -r token failed_detail <"$preview_failed" || true
		printf 'preview\tfailed\t%s\t\t\t0\t%s\n' "$(clean_field "$token")" \
			"$(clean_field "$failed_detail")"
	elif token=$(preview_token 2>/dev/null); then
		capability=$(meta_value capability 2>/dev/null || true)
		value=$(meta_value value 2>/dev/null || true)
		deadline=$(meta_value deadline 2>/dev/null || true)
		boot_id=$(meta_value boot-id 2>/dev/null || true)
		if [[ $boot_id == "$(read_boot_id)" && $deadline =~ ^[0-9]+$ && $deadline -gt $(read_now) ]]; then
			remaining=$((deadline - $(read_now)))
		fi
		printf 'preview\tactive\t%s\t%s\t%s\t%s\tAutomatic rollback is armed\n' \
			"$(clean_field "$token")" "$(clean_field "$capability")" \
			"$(clean_field "$value")" "$remaining"
	else
		printf 'preview\tnone\t\t\t\t0\tNo toolkit preview is active\n'
	fi

	if theme_transaction_armed; then
		printf 'mutation\tblocked\tFinish the active theme change before changing these\n'
	elif [[ -e $preview_failed ]]; then
		printf 'mutation\tblocked\tResolve the interrupted toolkit preview first\n'
	elif mutation_ready 2>/dev/null; then
		printf 'mutation\tready\t\n'
	else
		printf 'mutation\tblocked\tThe toolkit settings helper cannot make changes here\n'
	fi

	# A parser that stops early otherwise cannot tell a truncated status from a
	# complete one, and would show a half-populated pane as if it were whole.
	printf 'complete\t1\n'
}

mutation_ready() {
	prepare_state
	prepare_config
	command -v flock >/dev/null 2>&1 || return 1
	command -v timeout >/dev/null 2>&1 || return 1
	command -v setsid >/dev/null 2>&1 || return 1
	command -v sleep >/dev/null 2>&1 || return 1
	exchange_supported || die "$exchange_failure_detail"
	read_now >/dev/null
	read_boot_id >/dev/null
}

start_preview() {
	local token=$1 seconds=$2 capability=$3 value=$4 present=no mode=600 baseline_hash=absent
	local deadline boot_id hash pid='' start=''
	valid_token "$token" || die 'preview token is invalid'
	valid_seconds "$seconds" || die 'preview duration must be between 5 and 120 seconds'
	validate_selection "$capability" "$value"
	require_no_theme_transaction
	acquire_lock
	expire_preview_locked || true
	[[ ! -e $preview_file && ! -e $preview_failed ]] || die 'another toolkit preview needs to be completed first'
	prepare_config
	if [[ -e $config_file ]]; then
		present=yes
		capture_baseline
		baseline_hash=$(config_path_hash "$preview_baseline")
		mode=$(stat -c %a -- "$config_file")
	fi
	preview_setup_active=true
	preview_setup_present=$present
	preview_setup_mode=$mode
	preview_setup_pid=''
	preview_setup_hash=''
	trap 'preview_setup_cleanup $?' EXIT
	trap 'exit 130' HUP INT TERM
	read_config || die 'toolkit configuration is malformed; repair or reset it first'
	selected[$capability]=$value
	hash=$(selection_hash)
	preview_setup_hash=$hash
	boot_id=$(read_boot_id)
	deadline=$(($(read_now) + 10#$seconds))
	write_meta "$token" "$deadline" "$boot_id" "$capability" "$value" "$hash" "$present" "$mode" '' ''
	write_preview_token "$token"
	if [[ ${DWM_SETTINGS_TOOLKIT_NO_WATCHDOG:-0} != 1 ]]; then
		setsid "$0" _watchdog "$token" "$deadline" </dev/null >/dev/null 2>&1 9>&- &
		pid=$!
		preview_setup_pid=$pid
		for _ in {1..20}; do
			start=$(process_start_time "$pid" || true)
			[[ -n $start ]] && break
			sleep 0.01
		done
		[[ -n $start ]] || die 'toolkit preview rollback watchdog could not start'
		write_meta "$token" "$deadline" "$boot_id" "$capability" "$value" "$hash" "$present" "$mode" "$pid" "$start"
	fi
	write_config "$baseline_hash" "$mode" "$(preview_exchange_path "$token")" ||
		die 'toolkit configuration changed outside Settings; preview was not applied'
	write_meta "$token" "$deadline" "$boot_id" "$capability" "$value" "$hash" "$present" "$mode" \
		"$pid" "$start" yes
	preview_setup_active=false
	trap - EXIT HUP INT TERM
	run_theme_apply ||
		printf 'dwm-settings-toolkit: preview saved but the live theme did not converge\n' >&2
	printf '%s\nresult\tpreview-started\n' "$action_header"
}

finish_preview() {
	local action=$1 requested=$2 token expected_hash expected_mode current_hash current_mode
	valid_token "$requested" || die 'preview token is invalid'
	acquire_lock
	token=$(preview_token 2>/dev/null || true)
	[[ $token == "$requested" ]] || die 'toolkit preview token does not match the active preview'
	expected_hash=$(meta_value hash 2>/dev/null || true)
	expected_mode=$(meta_value baseline-mode 2>/dev/null || true)
	current_hash=$(file_hash)
	current_mode=$(file_mode)
	case $action in
	keep)
		expire_preview_locked "$token" || true
		[[ $(preview_token 2>/dev/null || true) == "$token" ]] || die 'toolkit preview has expired'
		[[ ! -e $preview_failed ]] || die 'failed toolkit preview cannot be kept'
		[[ $current_hash == "$expected_hash" && $current_mode == "$expected_mode" ]] ||
			die 'toolkit configuration changed outside Settings; keep was refused'
		clear_preview
		;;
	revert)
		restore_baseline "$expected_hash" || {
			mark_failed "$token" 'Previous toolkit configuration could not be restored'
			die 'previous toolkit configuration could not be restored; the active file was preserved or retained for recovery'
		}
		clear_preview
		;;
	abandon)
		[[ -e $preview_failed ]] || die 'toolkit preview is not stale; use keep or revert'
		clear_preview
		;;
	*) die 'unsupported toolkit preview action' ;;
	esac
	# The config is the input; the files theme-apply.sh derives from it only
	# follow once it has run again. Re-read it first so the convergence check
	# compares against the selection this action just settled on.
	read_config || true
	run_theme_apply ||
		printf 'dwm-settings-toolkit: %s succeeded but the live theme did not converge\n' "$action" >&2
	release_icon_baseline
	printf '%s\nresult\t%s\n' "$action_header" "$action"
}

apply_selection() {
	local capability=$1 value=$2 expected_hash expected_mode
	validate_selection "$capability" "$value"
	require_no_theme_transaction
	acquire_lock
	expire_preview_locked || true
	[[ ! -e $preview_file && ! -e $preview_failed ]] ||
		die 'complete the active toolkit preview before applying another selection'
	read_config || die 'toolkit configuration is malformed; reset it before applying'
	selected[$capability]=$value
	[[ $capability != icon ]] || is_sentinel icon "$value" || capture_icon_baseline
	expected_hash=$(file_hash)
	expected_mode=$(file_mode)
	write_config "$expected_hash" "$expected_mode" ||
		die 'toolkit configuration changed outside Settings; selection was not applied'
	run_theme_apply || die 'the selection was saved but the live theme did not converge'
	release_icon_baseline
	printf '%s\nresult\tapply\t%s\t%s\n' "$action_header" \
		"$(clean_field "$capability")" "$(clean_field "$value")"
}

# Reset hands one capability back to the theme. The file only disappears once
# every capability follows again, so a partial reset stays persisted.
reset_selection() {
	local capability=$1 expected_hash expected_mode other all_default=true
	valid_capability "$capability" || die "unknown toolkit capability: $capability"
	require_no_theme_transaction
	acquire_lock
	expire_preview_locked || true
	[[ ! -e $preview_file && ! -e $preview_failed ]] ||
		die 'complete the active toolkit preview before resetting'
	read_config || true
	selected[$capability]=${capability_default[$capability]}
	for other in "${capabilities[@]}"; do
		is_sentinel "$other" "${selected[$other]}" || all_default=false
	done
	expected_hash=$(file_hash)
	expected_mode=$(file_mode)
	if [[ $all_default == true ]]; then
		remove_config "$expected_hash" "$expected_mode" ||
			die 'toolkit configuration changed outside Settings; reset was not applied'
	else
		write_config "$expected_hash" "$expected_mode" ||
			die 'toolkit configuration changed outside Settings; reset was not applied'
	fi
	run_theme_apply || die 'the reset was saved but the live theme did not converge'
	release_icon_baseline
	printf '%s\nresult\treset\t%s\t%s\n' "$action_header" \
		"$(clean_field "$capability")" "${capability_default[$capability]}"
}

watchdog() {
	local token=$1 deadline=$2 boot_id now next attempts=0
	valid_token "$token" || exit 1
	[[ $deadline =~ ^[0-9]+$ ]] || exit 1
	boot_id=$(read_boot_id)
	while :; do
		[[ $(read_boot_id) == "$boot_id" ]] || exit 0
		now=$(read_now)
		((now >= deadline)) && break
		sleep $((deadline - now))
		next=$(read_now)
		((next > now)) || exit 1
	done
	prepare_state
	exec 9>"$lock_file"
	until flock -w 5 -x 9; do
		((attempts += 1))
		((attempts < 24)) || exit 1
	done
	expire_preview_locked "$token" || true
}

command=${1:-}
case $command in
status)
	[[ $# -eq 1 ]] || {
		usage
		exit 2
	}
	emit_status
	;;
mutation-ready)
	[[ $# -eq 1 ]] || {
		usage
		exit 2
	}
	mutation_ready
	;;
preview)
	[[ $# -eq 5 ]] || {
		usage
		exit 2
	}
	start_preview "$2" "$3" "$4" "$5"
	;;
keep | revert | abandon)
	[[ $# -eq 2 ]] || {
		usage
		exit 2
	}
	finish_preview "$command" "$2"
	;;
apply)
	[[ $# -eq 3 ]] || {
		usage
		exit 2
	}
	apply_selection "$2" "$3"
	;;
reset)
	[[ $# -eq 2 ]] || {
		usage
		exit 2
	}
	reset_selection "$2"
	;;
_watchdog)
	[[ $# -eq 3 ]] || exit 2
	watchdog "$2" "$3"
	;;
*)
	usage
	exit 2
	;;
esac
