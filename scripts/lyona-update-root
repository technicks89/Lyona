#!/usr/bin/env bash
set -euo pipefail

install_prefix='@PREFIX@'
# The rest of the layout comes from /etc/lyona-release at run time (see
# read_install_layout below), so only @PREFIX@ is written into this file: the
# update check of a release before 2026.10.0-beta.6 fills in only @PREFIX@ in
# its expected copy, and reported every update as a mismatch (#280 VM).
install_manprefix=$install_prefix/share/man
# The Makefile's DATADIR default for this PREFIX (#325): /usr/share for /usr and
# /usr/local, else PREFIX/share.
case $install_prefix in
/usr | /usr/local) install_datadir=/usr/share ;;
*) install_datadir=$install_prefix/share ;;
esac
install_xsessionsdir=/usr/share/xsessions
install_stamp=/etc/lyona-release

die() {
	printf 'lyona-update-root: %s\n' "$*" >&2
	exit 1
}

# Exit 3, apart from die's 1: install-system had begun writing when it failed,
# so the live install may now mix two releases. lyona-update tells the caller
# to roll back to the backup this helper took first (#333).
die_part_way() {
	printf 'lyona-update-root: %s\n' "$*" >&2
	exit 3
}

# BEGIN dwm-trust.sh -- a verbatim copy of scripts/dwm-trust.sh's functions. A
# root helper sources nothing at run time (Sync Sprint 12 S12-14, D-21), and
# tests/test-shell-contracts.sh fails if this copy differs from the library.
# Every directory from PATH's parent up to / is a real directory, owned by root
# and not group- or other-writable. A stat that fails counts as untrusted.
trusted_parent_chain() {
	lyona_trust_parent=${1%/*}
	while :; do
		[ -d "$lyona_trust_parent" ] && [ ! -L "$lyona_trust_parent" ] || return 1
		[ "$(stat -c %u -- "$lyona_trust_parent" 2>/dev/null || printf 1)" = 0 ] || return 1
		find "$lyona_trust_parent" -maxdepth 0 -type d ! -perm /022 -print -quit 2>/dev/null |
			grep -q . || return 1
		[ "$lyona_trust_parent" = / ] && return 0
		lyona_trust_parent=${lyona_trust_parent%/*}
		[ -n "$lyona_trust_parent" ] || lyona_trust_parent=/
	done
}

# PATH is already canonical (no symlink anywhere in it), and names a root-owned
# executable that nobody else can write, in a trusted directory chain.
trusted_file() {
	lyona_trust_path=$(readlink -f -- "$1" 2>/dev/null) || return 1
	[ -n "$lyona_trust_path" ] && [ "$lyona_trust_path" = "$1" ] || return 1
	trusted_parent_chain "$lyona_trust_path" || return 1
	[ -f "$lyona_trust_path" ] && [ ! -L "$lyona_trust_path" ] && [ -x "$lyona_trust_path" ] || return 1
	[ "$(stat -c %u -- "$lyona_trust_path" 2>/dev/null || printf 1)" = 0 ] || return 1
	find "$lyona_trust_path" -maxdepth 0 -type f ! -perm /022 -print -quit 2>/dev/null | grep -q .
}
# END dwm-trust.sh

# A regular file (not a symlink) that the invoking user owns and no other
# unprivileged user could have written.
user_owned_file() {
	local path=$1 want_uid=$2 mode
	[[ $path == /* && $path != */../* && $path != *'/..' ]] || return 1
	[[ -f $path && ! -L $path ]] || return 1
	[[ $(stat -c %u -- "$path") == "$want_uid" ]] || return 1
	mode=$(stat -c %a -- "$path")
	((($((8#$mode)) & 8#022) == 0)) || return 1
	return 0
}

# The log lives in the invoking user's home, where they control every path
# component, so it is written as them, never as root (Sync Sprint 12 S12-03): a
# symlink there must not make root create or append to any other file.
# Control characters in the target are replaced so a crafted path cannot forge
# log lines.
log_outcome() {
	local verb=$1 version=$2 target=$3 outcome=$4
	[[ -n $log_file ]] || return 0
	target=${target//[$'\001'-$'\037'$'\177']/?}
	# shellcheck disable=SC2016 # the inner sh expands them, as the user
	printf '%s\t%s\t%s\t%s\t%s\n' \
		"$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$verb" "$version" "$target" "$outcome" |
		runuser -u "$invoking_user" -- sh -c \
			'umask 077 && mkdir -p -- "${1%/*}" && cat >>"$1"' sh "$log_file" 2>/dev/null || :
}

[[ $EUID == 0 ]] || die "this helper must run as root"
self=$(readlink -f "${BASH_SOURCE[0]}")
[[ $self == "$install_prefix/libexec/lyona/lyona-update-root" ]] ||
	die "helper is not running from its trusted installed path"
trusted_file "$self" || die "helper is not a trusted root-owned executable"

# The layout install-system recorded (stamp-system): where it put the man page,
# the shared data and the X session. These decide what root writes and what a
# restore accepts, so the stamp must be root's own file, and every value an
# absolute path of plain characters. It is read as data, never sourced. A
# stamp without the fields (before 2026.10.0-beta.6), or one written for
# another PREFIX, leaves the standard layout above.
read_install_layout() {
	local line key value prefix='' manprefix='' datadir='' xsessionsdir=''
	[[ -e $install_stamp ]] || return 0
	[[ -f $install_stamp && ! -L $install_stamp ]] || die "$install_stamp is not a regular file"
	if [[ $(stat -c '%u %h' -- "$install_stamp") != '0 1' ]] ||
		find "$install_stamp" -maxdepth 0 -perm /022 -print -quit | grep -q . ||
		(($(stat -c %s -- "$install_stamp") > 4096)); then
		die "$install_stamp is not a root-owned, root-only-writable record"
	fi
	while IFS= read -r line || [[ -n $line ]]; do
		key=${line%%=*}
		value=${line#*=}
		case $key in
		LYONA_PREFIX | LYONA_MANPREFIX | LYONA_DATADIR | LYONA_XSESSIONSDIR) ;;
		*) continue ;;
		esac
		[[ $value =~ ^/[A-Za-z0-9._/+-]*$ && $value != / && /$value/ != */../* && /$value/ != */./* ]] ||
			die "$install_stamp has an unusable $key: $value"
		case $key in
		LYONA_PREFIX) prefix=$value ;;
		LYONA_MANPREFIX) manprefix=$value ;;
		LYONA_DATADIR) datadir=$value ;;
		LYONA_XSESSIONSDIR) xsessionsdir=$value ;;
		esac
	done <"$install_stamp"
	[[ $prefix == "$install_prefix" ]] || return 0
	install_manprefix=${manprefix:-$install_manprefix}
	install_datadir=${datadir:-$install_datadir}
	install_xsessionsdir=${xsessionsdir:-$install_xsessionsdir}
}
read_install_layout

# rollback must work from a bare TTY with no polkit agent running, so this
# accepts sudo's invoking-user variable as well as pkexec's -- never a
# caller-supplied argument, and never anything read from a shell the
# invoking user could have shaped (both variables come from the setuid
# wrapper itself, not from the environment the invoker otherwise controls).
if [[ -n ${PKEXEC_UID:-} ]]; then
	[[ $PKEXEC_UID =~ ^[0-9]+$ ]] || die "PKEXEC_UID is malformed"
	invoking_uid=$PKEXEC_UID
elif [[ -n ${SUDO_UID:-} ]]; then
	[[ $SUDO_UID =~ ^[0-9]+$ ]] || die "SUDO_UID is malformed"
	invoking_uid=$SUDO_UID
else
	die "this helper must run through polkit or sudo"
fi
invoking_home=$(getent passwd "$invoking_uid" | cut -d: -f6)
[[ -n $invoking_home && $invoking_home == /* ]] ||
	die "could not resolve the invoking user's home directory"
invoking_user=$(getent passwd "$invoking_uid" | cut -d: -f1)
[[ -n $invoking_user ]] || die "could not resolve the invoking user's name"
state_home=$invoking_home/.local/state
log_file=$state_home/lyona/update.log

# make evaluates $(shell ...) as root, so it is a fixed path checked like cosign
# and setpriv, never whatever PATH yields (#336).
readonly make_path=/usr/bin/make
trusted_file "$make_path" || die "a trusted make ($make_path) is needed"

# System backups are made and kept by this helper, in a directory only root can
# read or write (Sync Sprint 12 S12-01). A rollback names a backup by its id; it
# never hands root an archive the invoking user could have written, so what a
# rollback restores is exactly what was installed when the backup was taken.
system_backups_root=/var/lib/lyona/backups
system_backups_keep=5

# The id lyona-update gives both halves of one backup (its own user-side
# directory and this helper's system-side one): a UTC timestamp and a pid.
valid_backup_id() {
	[[ $1 =~ ^[0-9]{8}T[0-9]{6}Z-[0-9]+$ ]]
}

# A real directory (not a symlink) that root owns and no one else can read,
# write or enter.
root_private_dir() {
	local path=$1
	[[ -d $path && ! -L $path ]] || return 1
	[[ $(stat -c %u -- "$path") == 0 ]] || return 1
	find "$path" -maxdepth 0 -type d ! -perm /077 -print -quit 2>/dev/null | grep -q .
}

prepare_system_backups_root() {
	if [[ ! -e $system_backups_root && ! -L $system_backups_root ]]; then
		(umask 077 && mkdir -p -- "$system_backups_root") || return 1
	fi
	root_private_dir "$system_backups_root"
}

# Print the words TREE's Makefile expands EXPR to, one per line.
tree_make_values() {
	local tree=$1 expr=$2
	"$make_path" -s -C "$tree" --no-print-directory \
		--eval="lyona-root-print: ; @printf '%s\\n' $expr" lyona-root-print
}

installed_version() {
	local version
	version=$(awk -F= '$1 == "LYONA_VERSION" { print $2; exit }' /etc/lyona-release 2>/dev/null || true)
	printf '%s\n' "${version:-unknown}"
}

# A release's order, as a string that sorts as versions do: YYYY.MM[.PATCH], then
# alpha < beta < rc < the release itself. As lyona-update's version_rank.
release_rank() {
	local v=$1 core=$1 suffix word num=0 srank=9 year month patch=0
	[[ $v =~ ^[0-9]+\.[0-9]+(\.[0-9]+)?(-(alpha|beta|rc)\.[0-9]+)?$ ]] || return 1
	if [[ $v == *-* ]]; then
		core=${v%%-*}
		suffix=${v#*-}
		word=${suffix%%.*}
		num=${suffix#*.}
		case $word in
		alpha) srank=1 ;;
		beta) srank=2 ;;
		rc) srank=3 ;;
		esac
	fi
	IFS=. read -r year month patch <<<"$core"
	printf '%04d%02d%03d%d%03d\n' "$((10#$year))" "$((10#$month))" "$((10#${patch:-0}))" "$srank" "$((10#$num))"
}

# dwm, the one program that includes the user's config.h, is built as lyona's
# own system user, lyona-build (#336, decision D-36), in a copy of the sources
# that user owns: an #include or #embed in config.h then reads only what that
# user can, where root's build could read any file and put it in a binary
# installed world-readable (#327, D-34: setpriv). Nothing else runs as
# lyona-build (no home, shell or password; install-system creates it through
# systemd-sysusers): the shared nobody could be written to by any process
# already running as nobody, whose code root would then install for every
# account, so a process running as the build user refuses the build. Only the
# sources, headers, built objects and the Makefile are copied, not the whole
# tree, so only dwm.o is compiled. Everything root runs (lyona-toml, during
# install-system) is built by root from the verified sources, which do not
# include config.h. dwm and dwm.o are read back with the build user's
# permissions, so a link planted in the build directory gives nothing that user
# could not read, then touched so install-system takes them as current.
readonly setpriv_path=/usr/bin/setpriv
readonly build_user=lyona-build
build_dwm_unprivileged() {
	local tree=$1 build file
	trusted_file "$setpriv_path" ||
		die "a trusted setpriv ($setpriv_path) is needed to build the update without root"
	getent passwd "$build_user" >/dev/null ||
		die "there is no $build_user user to build the update as; install-system creates it (systemd-sysusers /usr/lib/sysusers.d/lyona-update.conf)"
	if pgrep -u "$build_user" >/dev/null 2>&1; then
		die "a process is running as $build_user, which could alter the build; refusing to build the update until it is gone"
	fi
	build=$(mktemp -d) || die "could not create a build directory"
	if ! cp -a -- "$tree"/*.c "$tree"/*.h "$tree"/*.o "$tree/Makefile" "$tree/config.mk" "$build/" ||
		! chown -R "$build_user:$build_user" -- "$build"; then
		rm -rf -- "$build"
		die "could not prepare the unprivileged build"
	fi
	if ! env -i PATH=/usr/bin:/bin HOME=/nonexistent LANG=C.UTF-8 \
		"$setpriv_path" --reuid="$build_user" --regid="$build_user" --clear-groups --no-new-privs \
		"$make_path" -C "$build" dwm; then
		rm -rf -- "$build"
		die "failed to build dwm for the verified release"
	fi
	for file in dwm.o dwm; do
		if ! runuser -u "$build_user" -- cat -- "$build/$file" >"$tree/$file"; then
			rm -rf -- "$build"
			die "could not read the built $file back"
		fi
	done
	rm -rf -- "$build"
	chmod 0644 -- "$tree/dwm.o"
	chmod 0755 -- "$tree/dwm"
	touch -- "$tree/dwm.o"
	touch -- "$tree/dwm"
}

prune_system_backups() {
	local current_id=$1 id count=1
	while IFS= read -r id; do
		valid_backup_id "$id" || continue
		[[ $id == "$current_id" ]] && continue
		count=$((count + 1))
		if ((count > system_backups_keep)); then
			rm -rf -- "${system_backups_root:?}/$id"
		fi
	done < <(find "$system_backups_root" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort -r)
}

# Back up the managed system files that installing TREE is about to replace.
# The file list comes from TREE's Makefile (the lists install-system installs
# from); the contents come from the live system, read by root.
backup_system_files() {
	local tree=$1 id=$2 dir name path out
	local -a names helpers themes policies palettes
	valid_backup_id "$id" || die "malformed backup id: $id"
	prepare_system_backups_root ||
		die "$system_backups_root is not a private root-owned directory; refusing to back up into it"
	dir=$system_backups_root/$id
	[[ ! -e $dir && ! -L $dir ]] || die "a system backup with id $id already exists"

	# shellcheck disable=SC2016 # expanded by make, not the shell
	out=$(tree_make_values "$tree" 'dwm $(THUMB) $(INSTALL_COMMAND_NAMES)') ||
		die "could not read the installed command list from the new release"
	mapfile -t names < <(awk 'NF' <<<"$out")
	# shellcheck disable=SC2016
	out=$(tree_make_values "$tree" '$(notdir $(PRIVILEGED_HELPERS))') ||
		die "could not read the privileged helper list from the new release"
	mapfile -t helpers < <(awk 'NF' <<<"$out")
	# shellcheck disable=SC2016
	out=$(tree_make_values "$tree" '$(CAPITAINE_DARK_THEME) $(CAPITAINE_LIGHT_THEME)') ||
		die "could not read the cursor theme names from the new release"
	mapfile -t themes < <(awk 'NF' <<<"$out")
	# shellcheck disable=SC2016
	out=$(tree_make_values "$tree" '$(notdir $(POLKIT_ACTIONS))') ||
		die "could not read the polkit actions from the new release"
	mapfile -t policies < <(awk 'NF' <<<"$out")
	# The GTK themes, one per palette, as the new release's Makefile names them
	# (GTK_THEME_IDS, the release-tree contract, #337). A release before
	# 2026.10.0-beta.7 has no such variable: its palettes are read as its
	# Makefile then read them.
	# shellcheck disable=SC2016
	out=$(tree_make_values "$tree" '$(GTK_THEME_IDS)') || out=''
	mapfile -t palettes < <(awk 'NF' <<<"$out")
	if ((${#palettes[@]} == 0)); then
		mapfile -t palettes < <(awk '/^\[theme\./ { id = $0; sub(/^\[theme\./, "", id); sub(/\].*$/, "", id); print id }' \
			"$tree/config/themes.toml" 2>/dev/null)
	fi
	((${#names[@]} > 1)) || die "the new release reported no installed commands"

	mkdir -m 0700 -- "$dir" || die "could not create the system backup directory"

	{
		for name in "${names[@]}"; do
			printf '%s\n' "${install_prefix#/}/bin/$name"
		done
		for name in "${helpers[@]}"; do
			printf '%s\n' "${install_prefix#/}/libexec/lyona/$name"
		done
		for name in "${themes[@]}"; do
			printf '%s\n' "${install_datadir#/}/icons/$name"
		done
		# The shared code, session scripts and helper programs, and the shipped
		# defaults, whole: most of lyona's logic lives there, and a rollback that
		# left them restored new libraries under old commands (#324).
		printf '%s\n' "${install_prefix#/}/lib/lyona" "${install_prefix#/}/share/lyona"
		for name in "${policies[@]}"; do
			[[ $name =~ ^[A-Za-z0-9._-]+\.policy$ ]] && printf '%s\n' "usr/share/polkit-1/actions/$name"
		done
		for name in "${palettes[@]}"; do
			[[ $name =~ ^[A-Za-z0-9_-]+$ ]] && printf '%s\n' "${install_datadir#/}/themes/Lyona-$name"
		done
		# An install from before 2026.10.0-beta.6 has its shared data under
		# PREFIX/share, which this install removes (remove-legacy-shared-data):
		# kept here, so a rollback puts it back. Restore accepts these paths.
		if [[ $install_prefix/share != "$install_datadir" ]]; then
			for name in "${themes[@]}"; do
				printf '%s\n' "${install_prefix#/}/share/icons/$name"
			done
			printf '%s\n' "${install_prefix#/}/share/licenses/lyona"
		fi
		printf '%s\n' "${install_manprefix#/}/man1/dwm.1" \
			"${install_xsessionsdir#/}/dwm.desktop" \
			"${install_datadir#/}/licenses/lyona" \
			etc/lyona-release
	} | while IFS= read -r path; do
		[[ $path != */../* && $path != ../* && -n ${path##*/} ]] || continue
		if [[ -e /$path || -L /$path ]]; then
			printf '%s\n' "$path"
		fi
	done >"$dir/manifest"

	# --verbatim-files-from: a manifest line is a path, never a tar option (#336).
	if ! tar -C / --numeric-owner --verbatim-files-from -cpf "$dir/system-files.tar" -T "$dir/manifest"; then
		rm -rf -- "$dir"
		die "could not write the system backup"
	fi
	printf 'version=%s\n' "$(installed_version)" >"$dir/backup.txt"
	prune_system_backups "$id"
}

# Everything below this point that ends up executed -- a Makefile recipe, a
# script invoked by one -- must come from a tree this process itself extracted
# from its own root-owned copy of the tarball, hashed after copying, never from
# a file or directory the invoking user has had write access to since. A staging directory
# the unprivileged caller built and handed us is fine as a *data* source
# (a prebuilt "dwm" is inert until the user's own session later runs it,
# same as anything else in their PATH already), but it must never be the
# thing "make install-system" is run against, because config.mk and the
# Makefile execute arbitrary shell during evaluation (`$(shell ...)`), not
# only via the recipe someone thinks they are invoking.
extract_verified_tree() {
	local tarball=$1 dest=$2
	tar -xzf "$tarball" -C "$dest" --strip-components=1 ||
		die "failed to extract the verified release tarball"
}

# The release workflow's Sigstore identity (decision D-31), fixed here rather
# than taken from the caller or the environment: install-system checks it
# itself, as root, so a release it installs on the routine prompt is one the
# release workflow on main built and signed (GHSA-x538-46gg-v37h).
readonly release_signer=https://github.com/technicks89/Lyona/.github/workflows/build-iso.yml@refs/heads/main
readonly release_issuer=https://token.actions.githubusercontent.com
readonly cosign_path=/usr/bin/cosign

# verify_release_signature TARBALL BUNDLE: both root's own copies. cosign runs
# with a clean environment and a root-only cache for Sigstore's trust root,
# which it fetches over the network.
verify_release_signature() {
	local output
	trusted_file "$cosign_path" ||
		die "a trusted cosign ($cosign_path) is needed to verify the release; install it with: pacman -S cosign"
	if ! output=$(env -i PATH=/usr/bin:/bin HOME="$verified_home" TUF_ROOT="$verified_home/sigstore" \
		"$cosign_path" verify-blob-attestation --bundle "$2" \
		--type https://slsa.dev/provenance/v1 \
		--certificate-oidc-issuer "$release_issuer" \
		--certificate-identity "$release_signer" \
		"$1" 2>&1 >/dev/null); then
		printf '%s\n' "$output" | tail -n 3 >&2
		die "the release's signature does not verify; refusing to install it"
	fi
}

case ${1:-} in
# install-system installs only a release whose signature it verifies itself,
# on the routine polkit prompt. install-unverified is the same install checked
# by its digest alone (a release from before signing, or an offline file the
# user vouched for), on its own, explicit prompt (com.lyona.update.unverified).
install-system | install-unverified | install-downgrade)
	install_mode=$1
	case ${2:-} in
	release)
		if [[ $install_mode != install-unverified ]]; then
			[[ $# == 8 ]] ||
				die "install-system release requires a tarball, its checksum, the version, a config.h path (or -), a backup id, and the release's signature bundle"
			bundle_path=$8
		else
			[[ $# == 7 ]] ||
				die "install-unverified release requires a tarball, its checksum, the version, a config.h path (or -), and a backup id"
			bundle_path=
		fi
		tarball_path=$3
		expected_sha256=$4
		requested_version=$5
		config_h_path=$6
		backup_id=$7
		valid_backup_id "$backup_id" || die "malformed backup id: $backup_id"
		updates_root=$state_home/lyona/updates

		case $tarball_path in
		"$updates_root"/*) ;;
		*) die "tarball is not under the invoking user's managed updates area" ;;
		esac
		user_owned_file "$tarball_path" "$invoking_uid" ||
			die "tarball is not a safe, user-owned file"
		if [[ -n $bundle_path ]]; then
			case $bundle_path in
			"$updates_root"/*) ;;
			*) die "signature bundle is not under the invoking user's managed updates area" ;;
			esac
			user_owned_file "$bundle_path" "$invoking_uid" ||
				die "signature bundle is not a safe, user-owned file"
		fi
		[[ $expected_sha256 =~ ^[0-9a-fA-F]{64}$ ]] || die "malformed expected checksum"
		[[ $requested_version =~ ^[0-9][0-9A-Za-z.+_-]*$ ]] || die "malformed version"

		if [[ $config_h_path != - ]]; then
			user_owned_file "$config_h_path" "$invoking_uid" ||
				die "config.h is not a safe, user-owned file"
		fi
		command -v runuser >/dev/null 2>&1 || die "runuser is unavailable"

		verified_dir=$(mktemp -d) || die "could not create a scratch directory"
		verified_tarball=$(mktemp) || die "could not create a scratch file"
		verified_bundle=$(mktemp) || die "could not create a scratch file"
		verified_home=$(mktemp -d) || die "could not create a scratch directory"
		chmod 700 "$verified_dir" "$verified_home"
		chmod 600 "$verified_tarball" "$verified_bundle"
		trap 'rm -rf "$verified_dir" "$verified_tarball" "$verified_bundle" "$verified_home"' EXIT

		# Sync Sprint 12 S12-02: one root-owned copy is hashed, extracted and built,
		# so nothing can swap the file between the hash and the build. The copy is
		# read with the invoking user's own permissions, so a path, symlink or swap
		# can never make root read a file the user could not read themselves.
		runuser -u "$invoking_user" -- cat -- "$tarball_path" >"$verified_tarball" ||
			die "could not read the tarball as the invoking user"
		actual_sha256=$(sha256sum -- "$verified_tarball" | awk '{ print $1 }')
		# The expected digest comes from the invoking user's side, so a match only
		# proves the file is the one the caller meant. That it is genuine is the
		# signature, checked below on root's own copy, for install-system; for
		# install-unverified, the administrator's approval of the explicit prompt.
		[[ ${actual_sha256,,} == "${expected_sha256,,}" ]] ||
			die "tarball checksum does not match the expected release digest; refusing to install"
		if [[ $install_mode != install-unverified ]]; then
			runuser -u "$invoking_user" -- cat -- "$bundle_path" >"$verified_bundle" ||
				die "could not read the signature bundle as the invoking user"
			verify_release_signature "$verified_tarball" "$verified_bundle"
		fi

		extract_verified_tree "$verified_tarball" "$verified_dir"
		staged_version=$(awk '$1 == "VERSION" && $2 == "=" { print $3; exit }' "$verified_dir/config.mk")
		[[ -n $staged_version ]] || die "could not read VERSION from the verified release's config.mk"
		[[ $staged_version == "$requested_version" ]] ||
			die "the verified release is version $staged_version, not the requested $requested_version"

		# An older release goes through its own subcommand and polkit action,
		# never the routine update prompt: an old release may carry a root-helper
		# bug fixed since (#327, decided: a separate action).
		# Fail closed: a version that cannot be ranked, on either side, refuses
		# the install rather than skipping the age check (#336).
		installed=$(installed_version)
		if [[ $installed != unknown ]]; then
			installed_rank=$(release_rank "$installed") ||
				die "cannot compare $requested_version with the installed $installed, which /etc/lyona-release records in an unknown form; refusing to install"
			requested_rank=$(release_rank "$requested_version") ||
				die "cannot compare $requested_version with the installed $installed; refusing to install a release whose version is in an unknown form"
			if [[ $requested_rank < $installed_rank && $install_mode != install-downgrade ]]; then
				die "$requested_version is older than the installed $installed; a downgrade needs its own approval (install-downgrade)"
			fi
			if [[ ! $requested_rank < $installed_rank && $install_mode == install-downgrade ]]; then
				die "$requested_version is not older than the installed $installed; install-downgrade only installs an older release"
			fi
		elif [[ $install_mode == install-downgrade ]]; then
			die "the installed version is unknown, so this is no downgrade; use install-system"
		fi

		if [[ $config_h_path != - ]]; then
			runuser -u "$invoking_user" -- cat -- "$config_h_path" >"$verified_dir/config.h" ||
				die "could not read config.h as the invoking user"
		fi

		# The compiled binary is rebuilt here, rather than trusted from the
		# unprivileged caller's own prior build: a "dwm" copied in from the
		# staging directory would be installed system-wide, where every user
		# who selects it at login runs whatever the invoking user last put
		# there. The release source is the one verified above. The invoking
		# user's config.h, copied in just before, is not verified: it is C,
		# compiled into the dwm every user runs. That is decision D-18 (the
		# runtime TOML files are the way to customise); approving the update
		# approves that config.h too (Sync Sprint 12 S12-17).
		if ! "$make_path" -C "$verified_dir" clean; then
			die "failed to clean the verified build tree"
		fi
		# Everything but dwm, as root: the release's all-root target, which names
		# what never includes config.h (the release-tree contract, SPEC.md
		# section 6, #337). A release before 2026.10.0-beta.7 has no such target:
		# its programs and objects are named as its Makefile then named them.
		if "$make_path" -C "$verified_dir" -n all-root >/dev/null 2>&1; then
			root_targets=(all-root)
		else
			# shellcheck disable=SC2016 # expanded by make, not the shell
			root_targets_out=$(tree_make_values "$verified_dir" '$(THUMB) $(TOML_TOOL) $(XWATCH) $(filter-out dwm.o,$(OBJ))') ||
				die "could not read the build targets from the verified release"
			mapfile -t root_targets < <(awk 'NF' <<<"$root_targets_out")
		fi
		if ! "$make_path" -C "$verified_dir" "${root_targets[@]}"; then
			die "failed to build the verified release"
		fi
		build_dwm_unprivileged "$verified_dir"
		backup_system_files "$verified_dir" "$backup_id"

		# Into the locations this helper was installed for, so an update never
		# moves the shared data (the cursors, the GRUB theme) to where a bare
		# Makefile default puts them, and a later restore finds them.
		if ! "$make_path" -C "$verified_dir" install-system \
			PREFIX="$install_prefix" MANPREFIX="$install_manprefix" \
			DATADIR="$install_datadir" XSESSIONSDIR="$install_xsessionsdir" \
			USER_HOME="$invoking_home" \
			OWNER="$invoking_user" \
			XDG_STATE_HOME="$state_home"; then
			log_outcome "$install_mode" "$requested_version" "$verified_dir" failed
			die_part_way "install-system stopped part-way; the live install may now mix $requested_version with the release installed before. Its system files were backed up first as $backup_id: run lyona-update rollback to restore them"

		fi
		log_outcome "$install_mode" "$requested_version" "$tarball_path" succeeded
		;;
	*)
		die "usage: lyona-update-root install-system|install-downgrade release TARBALL SHA256 VERSION CONFIG_H|- BACKUP_ID BUNDLE, or install-unverified release TARBALL SHA256 VERSION CONFIG_H|- BACKUP_ID"
		;;
	esac
	;;
restore-system)
	[[ $# == 2 ]] || die "restore-system requires a backup id"
	backup_id=$2
	valid_backup_id "$backup_id" ||
		die "malformed backup id: $backup_id (a backup is named by its id, never by a path)"
	root_private_dir "$system_backups_root" ||
		die "$system_backups_root is missing or not a private root-owned directory; nothing to restore"
	backup_dir=$system_backups_root/$backup_id
	root_private_dir "$backup_dir" ||
		die "no system backup was kept for $backup_id (backups made before system backups moved to $system_backups_root cannot restore system files)"
	system_archive=$backup_dir/system-files.tar
	[[ -f $system_archive && ! -L $system_archive && $(stat -c %u -- "$system_archive") == 0 ]] ||
		die "the system backup archive for $backup_id is missing or not root-owned"

	# The archive is this helper's own, made from the live system in a directory
	# only root can reach, so its contents, owners and modes are trusted and are
	# restored as recorded. The member checks below are defence in depth: they
	# still refuse anything outside the managed install locations, any
	# setuid/setgid/sticky member, and any member that is not a file or a
	# directory (symlinks only inside the cursor themes, which ship them).
	# --numeric-owner avoids trusting archive-supplied user/group names.
	bin_dir_rel=${install_prefix#/}/bin
	libexec_dir_rel=${install_prefix#/}/libexec/lyona
	man_dir_rel=${install_manprefix#/}/man1
	xsessions_dir_rel=${install_xsessionsdir#/}
	icons_dir_rel=${install_datadir#/}/icons
	licenses_dir_rel=${install_datadir#/}/licenses/lyona
	# Updates before 2026.10.0-beta.6 installed the shared data under
	# PREFIX/share, the Makefile's old DATADIR default, so a backup taken then
	# may hold it there.
	legacy_icons_dir_rel=${install_prefix#/}/share/icons
	legacy_licenses_dir_rel=${install_prefix#/}/share/licenses/lyona
	lib_dir_rel=${install_prefix#/}/lib/lyona
	share_dir_rel=${install_prefix#/}/share/lyona
	polkit_dir_rel=usr/share/polkit-1/actions
	gtk_themes_rel=${install_datadir#/}/themes
	# Every member must also be one of the paths this backup recorded, or under
	# one (#324): the cursor themes it took, not anything under icons/.
	backup_manifest=$backup_dir/manifest
	[[ -f $backup_manifest && ! -L $backup_manifest && $(stat -c %u -- "$backup_manifest") == 0 ]] ||
		die "the system backup $backup_id has no root-owned manifest"
	in_manifest() {
		local member=${1%/} entry
		while IFS= read -r entry; do
			[[ -n $entry ]] || continue
			[[ $member == "$entry" || $member == "$entry"/* ]] && return 0
		done <"$backup_manifest"
		return 1
	}
	while IFS= read -r listing_line; do
		[[ -n $listing_line ]] || continue
		member_type=${listing_line:0:1}
		member_mode=${listing_line:1:9}
		member_path=$(awk '{ for (i = 6; i <= NF; i++) printf "%s%s", (i > 6 ? " " : ""), $i }' <<<"$listing_line")
		[[ $member_type != l ]] || member_path=${member_path%% -> *}
		[[ -n $member_path ]] || die "could not parse a backup archive listing line: $listing_line"

		case $member_type in
		- | d) ;;
		l)
			case $member_path in
			"$icons_dir_rel/"?* | "$legacy_icons_dir_rel/"?* | "$gtk_themes_rel/Lyona-"?*) ;;
			*) die "backup archive contains a symlink outside the cursor themes: $member_path" ;;
			esac
			;;
		*) die "backup archive contains a non-regular member (type '$member_type'): $member_path" ;;
		esac
		case $member_mode in
		*[sStT]*) die "backup archive contains a member with setuid, setgid, or sticky permissions: $member_path" ;;
		esac
		case $member_path in
		/* | *..*) die "backup archive contains an unsafe path: $member_path" ;;
		esac

		case $member_path in
		"$bin_dir_rel/"*/*) die "backup archive contains a nested path under a flat directory: $member_path" ;;
		"$bin_dir_rel/" | "$bin_dir_rel/"*) ;;
		"$libexec_dir_rel/"*/*) die "backup archive contains a nested path under a flat directory: $member_path" ;;
		"$libexec_dir_rel/" | "$libexec_dir_rel/"*) ;;
		"$man_dir_rel/"*/*) die "backup archive contains a nested path under a flat directory: $member_path" ;;
		"$man_dir_rel/" | "$man_dir_rel/"*) ;;
		"$xsessions_dir_rel/"*/*) die "backup archive contains a nested path under a flat directory: $member_path" ;;
		"$xsessions_dir_rel/" | "$xsessions_dir_rel/"*) ;;
		"$icons_dir_rel/" | "$icons_dir_rel/"*) ;;
		"$licenses_dir_rel/" | "$licenses_dir_rel/"*) ;;
		"$legacy_icons_dir_rel/" | "$legacy_icons_dir_rel/"*) ;;
		"$legacy_licenses_dir_rel/" | "$legacy_licenses_dir_rel/"*) ;;
		"$lib_dir_rel/" | "$lib_dir_rel/"*) ;;
		"$share_dir_rel/" | "$share_dir_rel/"*) ;;
		"$polkit_dir_rel/"*/*) die "backup archive contains a nested path under a flat directory: $member_path" ;;
		"$polkit_dir_rel/com.lyona."*.policy) ;;
		"$gtk_themes_rel/Lyona-"?*) ;;
		etc/lyona-release) ;;
		*) die "backup archive contains a path outside the managed install locations: $member_path" ;;
		esac
		in_manifest "$member_path" ||
			die "backup archive contains a path its manifest does not list: $member_path"
	done < <(tar --numeric-owner -tvf "$system_archive")

	# The shared code and defaults are put back whole: files the newer release
	# added there go, as they would not have existed in the version restored.
	set_aside=()
	for whole_dir in "$lib_dir_rel" "$share_dir_rel"; do
		grep -Fxq -- "$whole_dir" "$backup_manifest" || continue
		[[ -d /$whole_dir && ! -L /$whole_dir ]] || continue
		rm -rf -- "/${whole_dir:?}.lyona-restore-old"
		if ! mv -T -- "/$whole_dir" "/$whole_dir.lyona-restore-old"; then
			# Nothing restored yet: what was set aside goes back first.
			for moved in "${set_aside[@]}"; do
				mv -T -- "/$moved.lyona-restore-old" "/$moved" || :
			done
			die "could not set aside /$whole_dir before restoring it"
		fi
		set_aside+=("$whole_dir")
	done
	if ! tar -C / --numeric-owner -xpf "$system_archive"; then
		# What was there before goes back, not a half-restored tree.
		for whole_dir in "$lib_dir_rel" "$share_dir_rel"; do
			[[ -d /$whole_dir.lyona-restore-old ]] || continue
			rm -rf -- "/${whole_dir:?}"
			mv -T -- "/$whole_dir.lyona-restore-old" "/$whole_dir"
		done
		log_outcome restore-system unknown "$backup_id" failed
		die "restoring the system backup $backup_id failed"
	fi
	for whole_dir in "$lib_dir_rel" "$share_dir_rel"; do
		rm -rf -- "/${whole_dir:?}.lyona-restore-old"
	done
	log_outcome restore-system unknown "$backup_id" succeeded
	;;
*)
	die "usage: lyona-update-root install-system release ... | restore-system BACKUP_ID"
	;;
esac
