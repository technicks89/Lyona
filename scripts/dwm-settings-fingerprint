#!/usr/bin/env bash
set -euo pipefail

# Settings > Fingerprint (#483): the reader, the user's enrolled fingers, and
# where a finger is accepted instead of the password. Unprivileged; the
# Settings pane is its only caller.
#
#   dwm-settings-fingerprint status [--uses]
#   dwm-settings-fingerprint enroll FINGER      streams enroll-status lines
#   dwm-settings-fingerprint delete FINGER
#   dwm-settings-fingerprint set USE on|off|remove-external
#   dwm-settings-fingerprint acknowledge FINGER...
#
# status prints:
#   fingerprint-protocol  1
#   reader   available|none|unavailable  DETAIL      (DETAIL: the reader's name)
#   finger   NAME                                    (one per enrolled finger)
#   module   available|missing  PATH
#   use      USE  on|off|external|unavailable  DETAIL
#   complete status
# With --uses, only the module and use lines (#532): read from the PAM files
# alone, so opening Settings does not start fprintd and probe the reader.
#
# A finger enrolled outside Settings is reported (#535) as
#   finger-added  NAME
# after its finger line, until acknowledge accepts it. Settings keeps the
# fingers it enrolled and deleted in ${XDG_STATE_HOME}/lyona/fingerprint-fingers
# (one name a line, the user's own); the first status records those enrolled
# then, and reports none. A known finger fprintd no longer lists is dropped, so
# enrolling it again outside Settings is reported; only when fprintd answered,
# with fingers or with none (NoEnrolledPrints, told apart from a failed call by
# dbus-send), never when the call failed.
#
# The reader and the fingers come from fprintd over D-Bus. Enrolling and
# deleting need the device claimed for the whole operation, and fprintd ties a
# claim to one D-Bus connection, so they go through fprintd's own clients
# (fprintd-enroll, fprintd-delete), whose result lines carry fprintd's D-Bus
# status names unchanged; fprintd's polkit policy asks for the user's own
# password. FINGER is one of fprintd's ten finger names.
#
# enroll prints, as the reader reports them:
#   enroll-status  STATUS       (enroll-stage-passed, enroll-retry-scan, ...)
#   enroll-result  completed|failed  STATUS
#
# USE is lightdm (the login and the lock screen), polkit or sudo; set changes
# its PAM file through dwm-settings-fingerprint-root (polkit, administrator
# password) and lyona-fingerprint-pam, which documents exactly what changes.
# set exits 3 when the password dialog was dismissed (pkexec's 126), so the
# pane can say it was cancelled rather than failed (#529).

lyona_lib=${BASH_SOURCE[0]%/*}
[[ -f $lyona_lib/dwm-trust.sh ]] || lyona_lib=${lyona_lib%bin}lib/lyona
# shellcheck source=scripts/dwm-trust.sh
. "$lyona_lib/dwm-trust.sh"
# shellcheck source=scripts/dwm-xdg.sh
. "$lyona_lib/dwm-xdg.sh"
# Lenient: only the known-fingers file (#535) needs a state directory, and a
# status without HOME still answers.
# shellcheck disable=SC2034 # config_home, data_home and cache_home are not read
lyona_xdg_dirs lenient

self=dwm-settings-fingerprint
script_dir=${BASH_SOURCE[0]%/*}
fprint_service=net.reactivated.Fprint
fprint_manager=/net/reactivated/Fprint/Manager
readonly enroll_seconds=${DWM_FINGERPRINT_ENROLL_SECONDS:-120}
known_file=${state_home:+$state_home/lyona/fingerprint-fingers}

die() {
	printf '%s: %s\n' "$self" "$*" >&2
	exit 1
}

valid_finger() {
	case $1 in
	left-thumb | left-index-finger | left-middle-finger | left-ring-finger | left-little-finger) ;;
	right-thumb | right-index-finger | right-middle-finger | right-ring-finger | right-little-finger) ;;
	*) return 1 ;;
	esac
}

user_name() {
	local name
	name=$(id -un) || die "cannot tell who this user is"
	[[ $name =~ ^[A-Za-z0-9._][A-Za-z0-9._-]*$ ]] || die "unexpected user name"
	printf '%s\n' "$name"
}

# The PAM status tool: beside this script in a checkout, in PREFIX/libexec/lyona
# when installed. Its status only reads, so tests may name another
# (DWM_FINGERPRINT_PAM_TOOL); changes never use this, only the root helper.
pam_tool() {
	local candidate
	for candidate in ${DWM_FINGERPRINT_PAM_TOOL:+"$DWM_FINGERPRINT_PAM_TOOL"} "$script_dir/lyona-fingerprint-pam" "${script_dir%/bin}/libexec/lyona/lyona-fingerprint-pam"; do
		[[ -x $candidate ]] || continue
		printf '%s\n' "$candidate"
		return 0
	done
	return 1
}

fprint_call() { # METHOD-PATH INTERFACE METHOD [SIGNATURE ARGS...]
	timeout 10 busctl --system --json=short call "$fprint_service" "$@" 2>/dev/null
}

# Whether USER has no fingers enrolled: fprintd answers that with an error,
# which busctl does not name, so a failed list is asked again through dbus-send.
fprint_none_enrolled() { # DEVICE USER
	local reply
	command -v dbus-send >/dev/null 2>&1 || return 1
	# It exits 1 with the error, so its output is what tells.
	reply=$(timeout 10 dbus-send --system --print-reply --dest="$fprint_service" "$1" \
		net.reactivated.Fprint.Device.ListEnrolledFingers "string:$2" 2>&1) || :
	[[ $reply == *'net.reactivated.Fprint.Error.NoEnrolledPrints'* ]]
}

cmd_status() {
	local devices device name fingers user tool pam uses_only=${1:-}
	printf 'fingerprint-protocol\t1\n'
	if [[ $uses_only == --uses ]]; then
		:
	elif ! command -v busctl >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
		printf 'reader\tunavailable\tbusctl and jq are needed to read the reader\n'
	elif ! devices=$(fprint_call "$fprint_manager" net.reactivated.Fprint.Manager GetDevices); then
		printf 'reader\tunavailable\tfprintd is not installed or not running\n'
	elif ! device=$(jq -er '.data[0][0] // empty' <<<"$devices" 2>/dev/null) ||
		[[ ! $device =~ ^/net/reactivated/Fprint/Device/[0-9]+$ ]]; then
		printf 'reader\tnone\tNo fingerprint reader was found\n'
	else
		name=$(timeout 10 busctl --system --json=short get-property "$fprint_service" "$device" \
			net.reactivated.Fprint.Device name 2>/dev/null | jq -r '.data // empty' 2>/dev/null || true)
		name=$(printf '%s' "${name:-Fingerprint reader}" | tr -d '\t\n\r' | cut -c1-80)
		printf 'reader\tavailable\t%s\n' "$name"
		user=$(user_name)
		# None enrolled is an error from fprintd (NoEnrolledPrints): no lines.
		local enrolled=() known=() kept=() answered=0
		if fingers=$(fprint_call "$device" net.reactivated.Fprint.Device ListEnrolledFingers s "$user"); then
			answered=1
			while IFS= read -r name; do
				valid_finger "$name" || continue
				printf 'finger\t%s\n' "$name"
				enrolled+=("$name")
			done < <(jq -r '.data[0][]?' <<<"$fingers" 2>/dev/null)
		elif fprint_none_enrolled "$device" "$user"; then
			answered=1
		fi
		# Fingers enrolled outside Settings (#535); the first time, the
		# fingers there now are taken as known.
		mapfile -t known < <(known_fingers || :)
		if [[ -n $known_file && -f $known_file && ! -L $known_file ]]; then
			for name in "${enrolled[@]}"; do
				[[ " ${known[*]} " == *" $name "* ]] || printf 'finger-added\t%s\n' "$name"
			done
			# Known fingers fprintd no longer has are forgotten.
			if ((answered)); then
				for name in "${known[@]}"; do
					[[ " ${enrolled[*]} " != *" $name "* ]] || kept+=("$name")
				done
				((${#kept[@]} == ${#known[@]})) || known_write "${kept[@]}"
			fi
		elif ((answered)); then
			known_write "${enrolled[@]}"
		fi
	fi
	if tool=$(pam_tool) && pam=$("$tool" status 2>/dev/null); then
		printf '%s\n' "$pam" | awk -F '\t' '$1 == "module" || $1 == "use"'
	else
		printf 'module\tmissing\t/usr/lib/security/pam_fprintd.so\n'
		for name in lightdm polkit sudo; do
			printf 'use\t%s\tunavailable\tThe fingerprint PAM tool is not installed\n' "$name"
		done
	fi
	printf 'complete\tstatus\n'
}

# The fingers Settings knows of (#535): read, and replaced whole. Neither the
# file nor its directory is followed through a symlink; a file that cannot be
# written leaves the notice to say too much, never too little.
known_fingers() {
	[[ -n $known_file && -f $known_file && ! -L $known_file ]] || return 1
	local name
	while IFS= read -r name || [[ -n $name ]]; do
		valid_finger "$name" && printf '%s\n' "$name"
	done <"$known_file"
}
known_write() { # FINGER...
	local dir=${known_file%/*} tmp name
	[[ $known_file == /* && ! -L $dir && ! -L $known_file ]] || return 0
	(umask 077 && mkdir -p -- "$dir") 2>/dev/null || return 0
	tmp=$(mktemp "$dir/.fingerprint-fingers.XXXXXX" 2>/dev/null) || return 0
	for name in "$@"; do
		[[ -z $name ]] || printf '%s\n' "$name"
	done >"$tmp"
	chmod 600 -- "$tmp"
	mv -fT -- "$tmp" "$known_file" 2>/dev/null || rm -f -- "$tmp"
}
known_change() { # add|remove FINGER...
	local mode=$1 name kept=() current
	shift
	while IFS= read -r current; do
		[[ $mode == remove && " $* " == *" $current "* ]] || kept+=("$current")
	done < <(known_fingers || :)
	if [[ $mode == add ]]; then
		for name in "$@"; do
			[[ " ${kept[*]} " == *" $name "* ]] || kept+=("$name")
		done
	fi
	known_write "${kept[@]}"
}

cmd_enroll() {
	local finger=$1 line status last='' result=failed enroll_fd enroll_pid
	valid_finger "$finger" || die "unknown finger: $finger"
	command -v fprintd-enroll >/dev/null 2>&1 || die "fprintd-enroll is not installed"
	# timeout runs in place of the substitution's shell, so its PID is known;
	# stopped (Settings' Cancel, or Settings closing), this stops it, and timeout
	# passes the signal on to fprintd-enroll, which releases the reader at once.
	exec {enroll_fd}< <(LC_ALL=C exec timeout "$enroll_seconds" fprintd-enroll -f "$finger" 2>&1)
	enroll_pid=$!
	# shellcheck disable=SC2064 # the PID now, not later
	trap "kill -TERM $enroll_pid 2>/dev/null; exit 143" TERM INT HUP
	while IFS= read -r -u "$enroll_fd" line; do
		case $line in
		'Enroll result: '*)
			status=${line#Enroll result: }
			[[ $status =~ ^enroll-[a-z-]+$ ]] || continue
			last=$status
			printf 'enroll-status\t%s\n' "$status"
			;;
		esac
	done
	exec {enroll_fd}<&-
	wait "$enroll_pid" 2>/dev/null || :
	trap - TERM INT HUP
	[[ $last == enroll-completed ]] && result=completed
	[[ $result != completed ]] || known_change add "$finger"
	printf 'enroll-result\t%s\t%s\n' "$result" "${last:-enroll-failed}"
	[[ $result == completed ]]
}

cmd_delete() {
	local finger=$1 user
	valid_finger "$finger" || die "unknown finger: $finger"
	command -v fprintd-delete >/dev/null 2>&1 || die "fprintd-delete is not installed"
	user=$(user_name)
	LC_ALL=C timeout 30 fprintd-delete "$user" -f "$finger" >/dev/null 2>&1 ||
		die "the finger could not be deleted"
	known_change remove "$finger"
	printf 'fingerprint-result\tdelete\t%s\n' "$finger"
}

cmd_set() {
	local use=$1 value=$2 helper request
	case $use in lightdm | polkit | sudo) ;; *) die "unknown use: $use" ;; esac
	case $value in
	on) request=enable ;;
	off) request=disable ;;
	remove-external) request=remove-external ;;
	*) die "the value must be on, off or remove-external: $value" ;;
	esac
	helper=$(trusted_root_helper_path dwm-settings-fingerprint-root "${BASH_SOURCE[0]}" dwm-settings-fingerprint) ||
		die "the trusted fingerprint helper is unavailable"
	command -v pkexec >/dev/null 2>&1 || die "pkexec is unavailable"
	local status=0
	pkexec "$helper" "$request" "$use" >/dev/null || status=$?
	case $status in
	0) ;;
	126)
		printf 'dwm-settings-fingerprint: not changed: the password prompt was cancelled\n' >&2
		exit 3
		;;
	*) die "the change was not made" ;;
	esac
	printf 'fingerprint-result\tset\t%s\t%s\n' "$use" "$value"
}

case ${1:-} in
status)
	(($# == 1)) || [[ $# == 2 && $2 == --uses ]] || die "status takes only --uses"
	cmd_status "${2:-}"
	;;
enroll)
	(($# == 2)) || die "enroll takes a finger"
	cmd_enroll "$2"
	;;
delete)
	(($# == 2)) || die "delete takes a finger"
	cmd_delete "$2"
	;;
set)
	(($# == 3)) || die "set takes a use and on, off or remove-external"
	cmd_set "$2" "$3"
	;;
acknowledge)
	(($# >= 2)) || die "acknowledge takes one or more fingers"
	shift
	for finger in "$@"; do
		valid_finger "$finger" || die "unknown finger: $finger"
	done
	known_change add "$@"
	printf 'fingerprint-result\tacknowledge\t%s\n' "$*"
	;;
*)
	printf 'usage: %s status [--uses] | enroll FINGER | delete FINGER | set lightdm|polkit|sudo on|off|remove-external | acknowledge FINGER...\n' "$self" >&2
	exit 2
	;;
esac
