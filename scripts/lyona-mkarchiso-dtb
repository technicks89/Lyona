#!/usr/bin/env bash
set -euo pipefail

# Make the copy of mkarchiso that fuses the Snapdragon X device trees into the
# aarch64 medium's kernel (ARM6-02):
#
#   lyona-mkarchiso-dtb MKARCHISO FUNCTION_FILE OUTPUT
#
# Two edits to archiso 91's mkarchiso, each checked against the exact text it
# changes, so another archiso fails here and not in the image (as the builder
# does for releng's profile):
#   1. the gate that switches the device-tree step off when `stubble` is not in
#      the package list is removed (Arch Linux ARM does not package it);
#   2. _make_stubble_efi is replaced by the function in FUNCTION_FILE
#      (scripts/lyona-mkarchiso-fuse.sh), which uses systemd-stub.
# mkarchiso's call site and its `ukify` check stay as they are. The original is
# not modified; OUTPUT is executable.

die() {
	printf 'lyona-mkarchiso-dtb: %s\n' "$*" >&2
	exit 1
}

[[ $# == 3 ]] || die "usage: lyona-mkarchiso-dtb MKARCHISO FUNCTION_FILE OUTPUT"
source_file=$1
function_file=$2
output=$3
[[ -f $source_file && -r $source_file ]] || die "cannot read $source_file"
[[ -f $function_file && -r $function_file ]] || die "cannot read $function_file"
[[ $source_file != "$output" ]] || die "OUTPUT must not be MKARCHISO"

read -r -d '' program <<'AWK' || true
function fail(message) {
	print "lyona-mkarchiso-dtb: " message > "/dev/stderr"
	failed = 1
	exit 1
}
BEGIN {
	while ((getline line < function_file) > 0)
		replacement[++replacement_lines] = line
	close(function_file)
	for (i = 1; i <= replacement_lines; i++)
		if (replacement[i] == "_make_stubble_efi() {") {
			first = i
			break
		}
	for (i = replacement_lines; i >= 1; i--)
		if (replacement[i] == "}") {
			last = i
			break
		}
	if (!first || !last || last < first)
		fail("the function file has no _make_stubble_efi() { ... } block")
}
{ text[NR] = $0 }
END {
	if (failed)
		exit 1
	# The function, from its first line to the closing brace at column 0.
	for (i = 1; i <= NR; i++)
		if (text[i] == "_make_stubble_efi() {") {
			functions++
			function_start = i
		}
	if (functions != 1)
		fail("mkarchiso has " functions + 0 " _make_stubble_efi() definitions, expected 1; the archiso format changed")
	function_end = 0
	for (i = function_start + 1; i <= NR; i++)
		if (text[i] == "}") {
			function_end = i
			break
		}
	if (!function_end)
		fail("the end of _make_stubble_efi() was not found; the archiso format changed")

	# The gate: five exact-shaped lines inside the aarch64 block.
	for (i = 1; i + 4 <= NR; i++)
		if (text[i] == "        # shellcheck disable=SC2076" &&
		    text[i + 1] == "        if [[ ! \" ${pkg_list[*]} \" =~ ' stubble ' ]]; then" &&
		    text[i + 2] ~ /stubble/ &&
		    text[i + 3] == "            use_stubble=0" &&
		    text[i + 4] == "        fi") {
			gates++
			gate_start = i
		}
	if (gates != 1)
		fail("the stubble package gate was found " gates + 0 " times, expected 1; the archiso format changed")

	# What must stay: the switch, its ukify check, and the call.
	for (i = 1; i <= NR; i++) {
		if (text[i] == "        use_stubble=1") switches++
		if (text[i] == "        if ! command -v ukify &>/dev/null; then") ukify_checks++
		if (text[i] == "        _run_once _make_stubble_efi") calls++
	}
	if (switches != 1 || ukify_checks != 1 || calls != 1)
		fail("mkarchiso's use_stubble switch, ukify check or call is not as expected; the archiso format changed")

	for (i = 1; i <= NR; i++) {
		if (i == function_start) {
			for (j = first; j <= last; j++)
				print replacement[j]
			i = function_end
			continue
		}
		if (i >= gate_start && i <= gate_start + 4)
			continue
		print text[i]
	}
}
AWK

work=$(mktemp "${output}.XXXXXX")
trap 'rm -f -- "${work:-}"' EXIT
awk -v function_file="$function_file" "$program" "$source_file" >"$work" || die "could not edit $source_file"
# mkarchiso turns extglob on itself (line 6); a parse-only check needs it first.
bash -O extglob -n "$work" || die "the edited mkarchiso is not valid bash"
chmod 0755 "$work"
mv -fT -- "$work" "$output"
work=
