#!/usr/bin/env bash
set -euo pipefail

# A checkout keeps the shared shell code beside the scripts; an install keeps it
# in PREFIX/lib/lyona, beside PREFIX/bin (Sync Sprint 12 S12-13).
lyona_lib=${BASH_SOURCE[0]%/*}
[[ -f $lyona_lib/dwm-paths.sh ]] || lyona_lib=${lyona_lib%bin}lib/lyona
# shellcheck source=scripts/dwm-paths.sh
. "$lyona_lib/dwm-paths.sh"
export LC_ALL=C

self=lyona-update
script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
version_helper=${LYONA_UPDATE_VERSION_HELPER:-$script_dir/lyona-version}
root_helper_name=lyona-update-root
# An installed machine has no .git, so unlike lyona-release (which reads the
# remote from the local checkout via `gh`) this has to be a constant. Kept
# overridable only for the test suite, which stubs the GitHub API entirely.
github_repo=${LYONA_UPDATE_GITHUB_REPO:-technicks89/Lyona}
github_api_base=${LYONA_UPDATE_GITHUB_API:-https://api.github.com}
# Signed releases (decision D-31): the release workflow attests each release's
# files through Sigstore, as build-iso.yml run from main, and publishes the
# bundle as lyona-VERSION.sigstore.json. Releases before this one were not.
first_signed_version=2026.10.0-beta.2
signer_identity=https://github.com/$github_repo/.github/workflows/build-iso.yml@refs/heads/main
signer_issuer=https://token.actions.githubusercontent.com
cache_ttl=${LYONA_UPDATE_CACHE_TTL:-300}

warn() { printf '%s: %s\n' "$self" "$*" >&2; }
die() {
	warn "$*"
	exit 1
}

usage() {
	cat <<'EOF'
Usage: lyona-update check       [--channel stable|preview] [--json]
       lyona-update apply       [--version V]
                                [--file PATH [--bundle FILE] [--sha256 HASH]]
                                [--allow-downgrade] [--dry-run] [--yes]
       lyona-update rollback    [--backup ID] [--list] [--yes]
       lyona-update backups     [--json]
       lyona-update set-channel stable|preview

Updates lyona itself, from its GitHub releases. Packages are updated by
pacman, yay or Settings > System, not by this.

  check        Says whether a newer lyona is published on your channel.
  apply        Downloads, verifies and installs a release (the newest on
               your channel, or --version V), after backing up the running
               one. Asks first unless --yes; --dry-run only shows the plan.
               A release's signature is checked with cosign, which needs the
               network. --file installs a tarball you have; its signature is
               downloaded unless you give it (--bundle, the release's
               lyona-V.sigstore.json). --sha256 gives the tarball's line in
               the release's SHA256SUMS; with no --bundle, for a machine with
               no network, the signature is then not checked.
  rollback     Restores a backup (the newest, or --backup ID); --list shows
               them. Asks first unless --yes.
  backups      Lists the backups apply has made.
  set-channel  stable: releases only. preview: pre-releases too.
EOF
}

for required_command in awk curl jq mktemp sha256sum sort tar; do
	command -v "$required_command" >/dev/null 2>&1 ||
		die "required command not found: $required_command"
done

# shellcheck source=scripts/dwm-xdg.sh
. "$lyona_lib/dwm-xdg.sh"
# shellcheck source=scripts/dwm-trust.sh
. "$lyona_lib/dwm-trust.sh"
lyona_xdg_dirs

config_file=$config_home/lyona/update.conf
cache_file=$cache_home/lyona/update-index.json
updates_root=$state_home/lyona/updates
backups_root=$state_home/lyona/live-update-backups
status_file=$state_home/lyona/update.status
log_file=$state_home/lyona/update.log

# An apply restarts Quickshell (and rollback now does too, see cmd_rollback),
# destroying whatever in-memory state the UpdateModel held. This file is how
# it learns what happened across that restart: written at every phase
# transition, read back on Component.onCompleted. Best-effort throughout --
# a status write failing (disk full, an unwritable state dir) must never be
# what turns an otherwise-successful apply into a reported failure.
write_status_file() {
	local phase=$1 detail=$2 target=${3:-} outcome=${4:-pending} message=${5:-} dir tmp
	dir=$(dirname -- "$status_file") || return 0
	mkdir -p "$dir" 2>/dev/null || return 0
	tmp=$(mktemp "$dir/.update.status.XXXXXX" 2>/dev/null) || return 0
	if ! {
		printf 'lyona-update-status-protocol\t1\t0\n'
		printf 'phase\t%s\t%s\n' "$phase" "$detail"
		printf 'target\t%s\n' "$target"
		printf 'outcome\t%s\t%s\n' "$outcome" "$message"
		printf 'timestamp\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
		printf 'complete\tstatus\n'
	} >"$tmp" 2>/dev/null; then
		rm -f "$tmp"
		return 0
	fi
	chmod 600 "$tmp" 2>/dev/null || :
	mv -fT "$tmp" "$status_file" 2>/dev/null || :
}

# Tell the person who started an update how it ended, from the one place the
# terminal status is written, so the notification and the status file cannot
# disagree. By the time a successful apply reaches its final write, Quickshell
# has already been restarted (runtime_verify), so the notification reaches the
# new shell's server rather than the one being replaced. Best effort and
# bounded: a missing notification daemon must never fail or stall an update.
notify_outcome() {
	local detail=$1 target=$2 outcome=$3 message=$4 title body urgency=normal
	command -v notify-send >/dev/null 2>&1 || return 0
	# Declining the confirmation prompt is a choice, not a failure worth a
	# critical notification; the status still records that nothing was done.
	[[ ${status_quiet:-false} != true ]] || return 0
	case $outcome in
	succeeded)
		title="Lyona: $detail"
		case $detail in
		Rollback*) body="Restored backup $target." ;;
		*) body="Version $target is installed." ;;
		esac
		;;
	failed)
		title='Lyona: update failed'
		urgency=critical
		body="${message:-The update did not finish.} Details: $log_file"
		;;
	*) return 0 ;;
	esac
	local -a notify=(notify-send --app-name=Lyona --icon=system-software-update --urgency="$urgency" -- "$title" "$body")
	if command -v timeout >/dev/null 2>&1; then
		timeout 5 "${notify[@]}" >/dev/null 2>&1 || :
	else
		"${notify[@]}" >/dev/null 2>&1 || :
	fi
}

write_status() {
	write_status_file "$@"
	case ${4:-pending} in
	succeeded | failed) notify_outcome "$2" "${3:-}" "$4" "${5:-}" ;;
	esac
	return 0
}

# apply and rollback are the operations worth keeping a record of: they restart
# Quickshell, which takes the UpdateModel's in-memory copy of their output with
# it, and the build output is the first thing anyone debugging a failure needs.
# Each run starts a fresh log (so it stays bounded) and tees stdout and stderr
# into it, leaving the machine-readable stdout protocol exactly as it was.
# Best effort: no log is better than no update.
start_operation_log() {
	local operation=$1 dir
	dir=$(dirname -- "$log_file")
	mkdir -p "$dir" 2>/dev/null || return 0
	command -v tee >/dev/null 2>&1 || return 0
	(umask 077 && : >"$log_file") 2>/dev/null || return 0
	printf '%s %s started\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$operation" >>"$log_file" 2>/dev/null || return 0
	exec > >(tee -a "$log_file") 2> >(tee -a "$log_file" >&2)
}

# Set as an EXIT trap by cmd_apply/cmd_rollback once they have real work to
# report: bash's dynamic scoping means this top-level function still sees
# those functions' locals (status_phase/status_detail/status_target/
# status_written) even though it fires from die()'s exit, several call
# frames below where they were declared -- there is no need to thread them
# through explicitly.
report_status_failure() {
	# install_verify_exit_status: set by lyona-install-verify.sh's own trap
	# chaining when it is sourced mid-apply/rollback, since $? by the time this
	# runs as part of that chain is "rm -rf"'s (always 0), not the status that
	# actually triggered the trap. Falls back to $? directly when this fires
	# as the sole EXIT trap (a failure before the library is ever sourced).
	local exit_status=${install_verify_exit_status:-$?}
	[[ ${status_written:-false} == true ]] && return 0
	write_status "${status_phase:-idle}" "${status_detail:-}" "${status_target:-}" \
		failed "${status_detail:-} (exit $exit_status)"
}

# --- version comparison -----------------------------------------------

valid_version() {
	local v=$1
	[[ $v =~ ^[0-9]+\.[0-9]+(\.[0-9]+)?(-(alpha|beta|rc)\.[0-9]+)?$ ]]
}

# Encodes YYYY.MM[.PATCH][-alpha|beta|rc.N] into a 13-digit zero-padded
# string that sorts correctly with a plain string comparison: a release
# outranks every pre-release of the same core version, and rc > beta > alpha.
version_rank() {
	local v=$1 core=$1 suffix='' suffix_word='' suffix_num=0 srank=9 year month patch=0
	valid_version "$v" || return 1
	if [[ $v == *-* ]]; then
		core=${v%%-*}
		suffix=${v#*-}
		suffix_word=${suffix%%.*}
		suffix_num=${suffix#*.}
		case $suffix_word in
		alpha) srank=1 ;;
		beta) srank=2 ;;
		rc) srank=3 ;;
		esac
	fi
	IFS=. read -r year month patch <<<"$core"
	patch=${patch:-0}
	# 10# forces base-10: bash's printf %d otherwise reads a leading-zero
	# field like month "08" as invalid octal and silently substitutes 0.
	printf '%04d%02d%03d%d%03d\n' \
		"$((10#$year))" "$((10#$month))" "$((10#$patch))" "$srank" "$((10#$suffix_num))"
}

# --- configuration -------------------------------------------------------

channel=stable
check_on_login=true
auto_apply=false
keep_backups=5

seed_config() {
	[[ -e $config_file ]] && return 0
	# A pre-release install starts on the preview channel: the stable channel
	# only ever sees releases promoted out of pre-release, so a beta install
	# on it would never be offered an update (Sync Sprint 16 R16-02).
	local seeded=stable version
	if [[ -x $version_helper ]] && version=$("$version_helper" print 2>/dev/null) && [[ $version == *-* ]]; then
		seeded=preview
	fi
	printf 'channel=%s\ncheck_on_login=true\nauto_apply=false\nkeep_backups=5\n' "$seeded" |
		install -Dm600 /dev/stdin "$config_file"
}

read_config() {
	seed_config
	[[ -f $config_file && ! -L $config_file ]] || return 0
	local key value
	while IFS='=' read -r key value || [[ -n $key ]]; do
		# check_on_login is read for shape validation only -- this CLI never
		# schedules anything itself; UpdateModel.qml reads update.conf
		# directly for the login-time check (UPDATE-003).
		# shellcheck disable=SC2034
		case $key in
		channel) channel=$value ;;
		check_on_login) check_on_login=$value ;;
		auto_apply) auto_apply=$value ;;
		keep_backups) keep_backups=$value ;;
		esac
	done <"$config_file"
	# The key exists so the file shape is stable, but this boundary has no
	# unattended-apply implementation -- a stray "true" must be refused
	# loudly rather than silently doing nothing.
	[[ $auto_apply == false ]] || die "auto_apply=true is not supported yet; set it back to false in $config_file"
	[[ $keep_backups =~ ^[0-9]+$ ]] || die "keep_backups must be a non-negative integer in $config_file"
}

cmd_set_channel() {
	(($# == 1)) || die "set-channel requires exactly one value: stable or preview"
	case $1 in
	stable | preview) ;;
	*) die "channel must be stable or preview: $1" ;;
	esac
	read_config
	channel=$1
	local tmp
	tmp=$(mktemp "$(dirname "$config_file")/.update.conf.XXXXXX")
	{
		printf 'channel=%s\n' "$channel"
		printf 'check_on_login=%s\n' "$check_on_login"
		printf 'auto_apply=%s\n' "$auto_apply"
		printf 'keep_backups=%s\n' "$keep_backups"
	} >"$tmp"
	chmod 600 "$tmp"
	mv -fT "$tmp" "$config_file"
	printf 'complete\tset-channel\t%s\n' "$channel"
}

# --- installed version -----------------------------------------------

installed_status_json=
installed_version=
installed_state=
installed_commit=
installed_source=

read_installed() {
	[[ -x $version_helper ]] || die "lyona-version helper is unavailable: $version_helper"
	installed_status_json=$("$version_helper" status --json)
	installed_version=$("$version_helper" print)
	installed_state=$(jq -r '.state' <<<"$installed_status_json")
	if jq -e '.user.state == "available"' <<<"$installed_status_json" >/dev/null; then
		installed_commit=$(jq -r '.user.commit' <<<"$installed_status_json")
		installed_source=$(jq -r '.user.source' <<<"$installed_status_json")
	elif jq -e '.system.state == "available"' <<<"$installed_status_json" >/dev/null; then
		installed_commit=$(jq -r '.system.commit' <<<"$installed_status_json")
		installed_source=$(jq -r '.system.source' <<<"$installed_status_json")
	else
		installed_commit=unknown
		installed_source=unknown
	fi
}

# --- GitHub release lookup --------------------------------------------

fetch_url() {
	curl --fail --silent --show-error --location \
		--connect-timeout 5 --max-time 15 \
		-H 'Accept: application/vnd.github+json' \
		"$@"
}

# Prints one release object (never an array) for the requested channel, or
# fails if the channel has nothing published or the network is unreachable.
fetch_release() {
	local requested_channel=$1
	case $requested_channel in
	stable)
		fetch_url "$github_api_base/repos/$github_repo/releases/latest"
		;;
	preview)
		# Newest first, drafts already excluded for an unauthenticated
		# request -- the first entry is the newest preview or stable build.
		fetch_url "$github_api_base/repos/$github_repo/releases" | jq -c '.[0] // empty'
		;;
	*)
		die "unknown channel: $requested_channel (expected stable or preview)"
		;;
	esac
}

# Populates release_version / release_commit / release_published / release_asset_name /
# release_asset_url / release_asset_size / release_checksum / release_bundle_url
# (empty when the release has no signature). Returns 1 when the
# remote could not be reached or answered with an error, and 2 when it answered
# with nothing published for the channel (a 404, or an empty release list).
# Neither is an error (Sync Sprint 16 R16-02). Only a 404 means nothing is
# published: a rate limit's 403, or a server error, is a failed fetch.
release_version=
release_commit=unknown
release_published=unknown
release_asset_name=
release_asset_url=
release_asset_size=unknown
release_checksum=unknown
release_bundle_url=

# The cache stores every resolved field, not just the raw release listing --
# a cache hit must not still hit the network for the checksum and tag-commit
# lookups below, or the TTL would only ever save one of the three requests
# a panel indicator makes on every poll.
load_cache() {
	local requested_channel=$1 age mtime now cached
	[[ -f $cache_file && ! -L $cache_file ]] || return 1
	cached=$(cat "$cache_file" 2>/dev/null) || return 1
	[[ $(jq -r '.channel // empty' <<<"$cached") == "$requested_channel" ]] || return 1
	mtime=$(stat -c %Y -- "$cache_file" 2>/dev/null) || return 1
	now=$(date +%s)
	age=$((now - mtime))
	((age >= 0 && age < cache_ttl)) || return 1
	release_version=$(jq -r '.version // empty' <<<"$cached")
	[[ -n $release_version ]] || return 1
	release_commit=$(jq -r '.commit // "unknown"' <<<"$cached")
	release_published=$(jq -r '.publishedAt // "unknown"' <<<"$cached")
	release_asset_name=$(jq -r '.assetName // empty' <<<"$cached")
	release_asset_url=$(jq -r '.assetUrl // empty' <<<"$cached")
	release_asset_size=$(jq -r '.assetSize // "unknown"' <<<"$cached")
	release_checksum=$(jq -r '.checksum // "unknown"' <<<"$cached")
	release_bundle_url=$(jq -r '.bundleUrl // empty' <<<"$cached")
	return 0
}

save_cache() {
	local requested_channel=$1 tmp
	ensure_owned_directory "$(dirname "$cache_file")" "cache"
	tmp=$(mktemp "$(dirname "$cache_file")/.update-index.json.XXXXXX")
	jq -cn \
		--arg channel "$requested_channel" \
		--arg version "$release_version" \
		--arg commit "$release_commit" \
		--arg publishedAt "$release_published" \
		--arg assetName "$release_asset_name" \
		--arg assetUrl "$release_asset_url" \
		--arg assetSize "$release_asset_size" \
		--arg checksum "$release_checksum" \
		--arg bundleUrl "$release_bundle_url" \
		'{channel: $channel, version: $version, commit: $commit,
		  publishedAt: $publishedAt, assetName: $assetName, assetUrl: $assetUrl,
		  assetSize: $assetSize, checksum: $checksum, bundleUrl: $bundleUrl}' >"$tmp"
	mv -fT "$tmp" "$cache_file"
}

resolve_release() {
	local requested_channel=$1 release_json tag_json
	load_cache "$requested_channel" && return 0

	local fetched=0 err_file fetch_error
	err_file=$(mktemp) || return 1
	release_json=$(fetch_release "$requested_channel" 2>"$err_file") || fetched=$?
	fetch_error=$(<"$err_file")
	rm -f "$err_file"
	# curl --fail exits 22 for any HTTP error, and names the status.
	if ((fetched == 22)) && [[ $fetch_error == *'returned error: 404'* ]]; then
		return 2
	elif ((fetched != 0)); then
		return 1
	fi
	[[ -n $release_json && $release_json != null ]] || return 2

	release_version=$(jq -r '.tag_name // empty' <<<"$release_json")
	release_version=${release_version#v}
	[[ -n $release_version ]] || return 1
	release_published=$(jq -r '.published_at // "unknown"' <<<"$release_json")

	release_asset_name="lyona-$release_version.tar.gz"
	release_asset_url=$(jq -r --arg name "$release_asset_name" \
		'.assets[]? | select(.name == $name) | .browser_download_url' <<<"$release_json")
	release_asset_size=$(jq -r --arg name "$release_asset_name" \
		'.assets[]? | select(.name == $name) | .size' <<<"$release_json")
	[[ -n $release_asset_size ]] || release_asset_size=unknown
	release_bundle_url=$(jq -r --arg name "lyona-$release_version.sigstore.json" \
		'.assets[]? | select(.name == $name) | .browser_download_url' <<<"$release_json")

	local checksums_name checksums_url
	checksums_name="lyona-$release_version-SHA256SUMS"
	checksums_url=$(jq -r --arg name "$checksums_name" \
		'.assets[]? | select(.name == $name) | .browser_download_url' <<<"$release_json")
	if [[ -n $checksums_url ]]; then
		# The file name, exactly. A release lists its assets by the path they were
		# hashed at (an absolute build path, or ./name), with the "*" sha256sum adds
		# in binary mode. Never a pattern (Sync Sprint 12 S12-11): the name's "."
		# matched any character, and the match was not anchored at the start.
		release_checksum=$(fetch_url "$checksums_url" 2>/dev/null |
			awk -v want="$release_asset_name" '
				{ name = $2; sub(/^\*/, "", name); sub(/^.*\//, "", name) }
				name == want { print $1; exit }
			')
		[[ -n $release_checksum ]] || release_checksum=unknown
	fi

	# Best-effort only: the release commit comes from resolving the tag's
	# git ref, a second API call that a rate limit or a transient failure
	# must not turn into a hard "check" failure.
	tag_json=$(fetch_url "$github_api_base/repos/$github_repo/git/ref/tags/v$release_version" 2>/dev/null) || tag_json=
	if [[ -n $tag_json ]]; then
		release_commit=$(jq -r '.object.sha // "unknown"' <<<"$tag_json")
		release_commit=${release_commit:0:7}
		[[ -n $release_commit ]] || release_commit=unknown
	fi

	save_cache "$requested_channel" 2>/dev/null || :
	return 0
}

# --- check ---------------------------------------------------------------

cmd_check() {
	read_config
	local requested_channel=$channel json=false
	while (($# > 0)); do
		case $1 in
		--channel)
			(($# >= 2)) || die "--channel requires a value"
			requested_channel=$2
			shift 2
			;;
		--json)
			json=true
			shift
			;;
		*) die "unknown option: $1" ;;
		esac
	done
	case $requested_channel in
	stable | preview) ;;
	*) die "--channel must be stable or preview: $requested_channel" ;;
	esac

	read_installed

	local state message='' reached=false resolved=0
	if [[ $installed_state == unavailable ]]; then
		state=unavailable
		message='The installed-version record is present but cannot be trusted.'
	elif [[ $installed_state == defaults ]]; then
		state=unknown
		message='No install provenance record was found.'
	elif ! { resolve_release "$requested_channel" || { resolved=$? && false; }; }; then
		if ((resolved == 2)); then
			state=unknown
			message="Nothing has been published on the $requested_channel channel yet."
			if [[ $requested_channel == stable ]]; then
				message+=" lyona's releases so far are pre-releases; to be offered them, run: lyona-update set-channel preview"
			fi
		else
			state=offline
			message='The update server could not be reached.'
		fi
	else
		reached=true
		local installed_rank remote_rank
		installed_rank=$(version_rank "$installed_version" 2>/dev/null || printf 0)
		remote_rank=$(version_rank "$release_version" 2>/dev/null || printf 0)
		if [[ $installed_source == checkout && $remote_rank -le $installed_rank ]]; then
			state=ahead
			message='Running a development checkout newer than the published release.'
		elif [[ $remote_rank > $installed_rank ]]; then
			state=behind
			message="A newer $requested_channel release is available."
		elif [[ $remote_rank < $installed_rank ]]; then
			state=downgrade-offered
			message="The $requested_channel channel offers an older release than what is installed."
		else
			state=current
			message='The installed release matches the channel.'
		fi
	fi

	if [[ $json == true ]]; then
		jq -cn \
			--arg state "$state" \
			--arg message "$message" \
			--arg installedVersion "$installed_version" \
			--arg installedCommit "$installed_commit" \
			--arg channel "$requested_channel" \
			--arg reached "$reached" \
			--arg availableVersion "${release_version:-}" \
			--arg availableCommit "${release_commit:-unknown}" \
			--arg availablePublished "${release_published:-unknown}" \
			--arg assetName "${release_asset_name:-}" \
			--arg assetChecksum "${release_checksum:-unknown}" \
			--arg assetSize "${release_asset_size:-unknown}" \
			--arg devScripts "${LYONA_DEV_SCRIPTS:-}" \
			'{
				state: $state, message: $message, channel: $channel,
				devScripts: (if $devScripts == "" then null else $devScripts end),
				installed: {version: $installedVersion, commit: $installedCommit},
				available: (if $reached == "true" then {
					version: $availableVersion, commit: $availableCommit,
					publishedAt: $availablePublished,
					asset: {name: $assetName, checksum: $assetChecksum, size: $assetSize}
				} else null end)
			}'
		return 0
	fi

	printf 'lyona-update-protocol\t1\t0\n'
	printf 'state\t%s\t%s\n' "$state" "$message"
	printf 'installed\t%s\t%s\n' "$installed_version" "$installed_commit"
	if [[ $reached == true ]]; then
		printf 'available\t%s\t%s\t%s\n' "$release_version" "$release_commit" "$release_published"
		printf 'channel\t%s\n' "$requested_channel"
		printf 'asset\t%s\t%s\t%s\n' "$release_asset_name" "$release_checksum" "$release_asset_size"
	else
		printf 'channel\t%s\n' "$requested_channel"
	fi
	# The developer override (Sync Sprint 12 S12-13): the helpers this session
	# runs are a checkout's, whatever version is installed.
	if [[ -n ${LYONA_DEV_SCRIPTS:-} ]]; then
		printf 'override\tdev-scripts\t%s\n' "${LYONA_DEV_SCRIPTS//[$'\t\n']/ }"
	fi
	printf 'complete\tcheck\n'
}

# --- shared helpers for apply / rollback ------------------------------

trusted_root_helper() {
	trusted_root_helper_path "$root_helper_name" "$script_dir/lyona-update" lyona-update
}

# rollback is the path a user takes with no desktop running, so this must not
# require a polkit agent: it tries pkexec only when a graphical session looks
# reachable, and always has sudo as a fallback.
run_privileged() {
	local helper
	helper=$(trusted_root_helper) || die "trusted privileged update helper is unavailable"
	if [[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]] && command -v pkexec >/dev/null 2>&1; then
		local pkexec_status=0
		pkexec "$helper" "$@" || pkexec_status=$?
		case $pkexec_status in
		0) return 0 ;;
		126 | 127) warn "pkexec could not authorize or run this step; falling back to sudo" ;;
		*) return "$pkexec_status" ;;
		esac
	fi
	command -v sudo >/dev/null 2>&1 ||
		die "neither a polkit agent nor sudo is available to complete this step"
	sudo "$helper" "$@"
}

# --- apply -----------------------------------------------------------

sha256_of() {
	sha256sum -- "$1" | awk '{ print $1 }'
}

# The packages the release being installed needs, from its own package map, not
# the installed one: a release that adds a dependency otherwise installs helpers
# that fail at runtime (Sync Sprint 12 S12-11, decided with the maintainer: refuse
# and show the fix, no privileged package installation). The required groups
# block the update before anything changes; missing desktop packages only warn,
# since the install profile is not recorded and a user may have left some out.
# pacman -T resolves provides the way an install would.
# Arguments: STAGING_DIR.
check_release_packages() {
	local map=$1/scripts/dwm-packages.sh missing
	if [[ ! -f $map ]]; then
		warn "release has no scripts/dwm-packages.sh; package dependencies not checked"
		return 0
	fi
	command -v pacman >/dev/null 2>&1 || die "pacman not found; lyona runs on Arch Linux only"
	missing=$(missing_packages "$map" build x11 runtime-required) ||
		die "could not check which packages are installed (pacman -T failed)"
	if [[ -n $missing ]]; then
		warn "release $requested_version needs packages that are not installed: $missing"
		die "install them first, then update again: sudo pacman -S --needed $missing"
	fi
	missing=$(missing_packages "$map" desktop) ||
		die "could not check which packages are installed (pacman -T failed)"
	if [[ -n $missing ]]; then
		warn "desktop packages not installed (features that use them stay unavailable): $missing"
	fi
}

# Arguments: MAP GROUP.... Prints the named groups' packages that are not
# installed, on one line. pacman -T exits 0 when all are installed and 127 when
# it printed some that are not; anything else is a failed query, returned as
# such rather than read as "nothing missing".
missing_packages() {
	local -a packages=()
	local out status=0
	mapfile -t packages < <(release_packages "$@")
	((${#packages[@]} > 0)) || return 0
	out=$(pacman -T "${packages[@]}" 2>/dev/null) || status=$?
	case $status in
	0) ;;
	127) printf '%s\n' "$out" | awk 'NF' | paste -sd ' ' - ;;
	*) return 1 ;;
	esac
}

# Arguments: MAP GROUP..., the named groups of the release's package map, one
# package per line, each once.
release_packages() {
	local map=$1
	shift
	(
		# shellcheck source=scripts/dwm-packages.sh
		. "$map" && for group in "$@"; do dwm_packages arch "$group"; done
	) | awk 'NF && !seen[$0]++'
}

# VERSION was released signed: it is not older than the first signed release.
signature_required() {
	local rank first
	rank=$(version_rank "$1") || return 0
	first=$(version_rank "$first_signed_version")
	[[ ! $rank < $first ]]
}

# Downloads release VERSION's signature bundle into the updates area, as
# bundle_path, or fails saying why.
download_bundle() {
	local version=$1 bundle tmp
	[[ $version == "${release_version:-}" ]] || resolve_release "$channel" ||
		die "could not reach the update server for $version's signature; with no network, pass --sha256 HASH (the tarball's line in the release's SHA256SUMS)"
	[[ $version == "$release_version" ]] ||
		die "$version is not the newest release on the $channel channel; give its signature with --bundle FILE (lyona-$version.sigstore.json)"
	[[ -n $release_bundle_url ]] ||
		die "release $version has no signature (lyona-$version.sigstore.json); refusing to install it"
	bundle=$updates_root/lyona-$version.sigstore.json
	tmp=$(mktemp "$updates_root/.lyona-$version.sigstore.json.XXXXXX")
	if ! curl --fail --silent --show-error --location \
		--retry 3 --connect-timeout 10 --max-time 60 \
		"$release_bundle_url" --output "$tmp"; then
		rm -f "$tmp"
		die "failed to download $release_bundle_url"
	fi
	mv -fT "$tmp" "$bundle"
	bundle_path=$bundle
}

# TARBALL is release VERSION as the release workflow built and signed it: the
# bundle's Sigstore certificate names build-iso.yml run from main, and its
# build-provenance statement names TARBALL's digest. cosign fetches Sigstore's
# trust root, so this needs the network.
verify_signature() { # TARBALL VERSION BUNDLE
	local tarball=$1 version=$2 bundle=$3 output
	command -v cosign >/dev/null 2>&1 ||
		die "cosign is needed to check $version's signature; install it with: sudo pacman -S cosign"
	if ! output=$(cosign verify-blob-attestation --bundle "$bundle" \
		--type https://slsa.dev/provenance/v1 \
		--certificate-oidc-issuer "$signer_issuer" \
		--certificate-identity "$signer_identity" \
		"$tarball" 2>&1 >/dev/null); then
		printf '%s\n' "$output" | tail -n 3 >&2
		die "the signature of lyona-$version does not verify; refusing to install it"
	fi
}

cmd_apply() {
	local requested_version='' file_path='' allow_downgrade=false dry_run=false yes=false
	local given_checksum='' bundle_path=''
	while (($# > 0)); do
		case $1 in
		--version)
			(($# >= 2)) || die "--version requires a value"
			requested_version=$2
			shift 2
			;;
		--file)
			(($# >= 2)) || die "--file requires a value"
			file_path=$2
			shift 2
			;;
		--sha256)
			# The tarball's line in the release's SHA256SUMS, for an install with
			# no network: without it, --file looks the checksum up online.
			(($# >= 2)) || die "--sha256 requires a value"
			[[ $2 =~ ^[0-9a-fA-F]{64}$ ]] || die "--sha256 must be 64 hexadecimal digits"
			given_checksum=${2,,}
			shift 2
			;;
		--bundle)
			# The release's lyona-VERSION.sigstore.json, for --file.
			(($# >= 2)) || die "--bundle requires a value"
			bundle_path=$2
			shift 2
			;;
		--from-checkout)
			# Removed (Sync Sprint 12 S12-03, decision D-15): the privileged step
			# only installs verified releases. Install from a checkout with
			# `sudo make install-system` or scripts/dev-sync-install.sh.
			die "--from-checkout was removed; from a checkout, run sudo make install-system or scripts/dev-sync-install.sh"
			;;
		--allow-downgrade)
			allow_downgrade=true
			shift
			;;
		--dry-run)
			dry_run=true
			shift
			;;
		--yes)
			yes=true
			shift
			;;
		*) die "unknown option: $1" ;;
		esac
	done
	[[ -z $given_checksum || -n $file_path ]] ||
		die "--sha256 is for --file; a download is verified against the release's published SHA256SUMS"
	[[ -z $bundle_path || -n $file_path ]] ||
		die "--bundle is for --file; a download's signature is downloaded with it"
	if [[ -n $bundle_path ]]; then
		valid_absolute_path "$bundle_path" || die "--bundle must be an absolute path"
		[[ -f $bundle_path && ! -L $bundle_path ]] || die "signature bundle not found: $bundle_path"
	fi

	local status_phase=downloading status_detail='Preparing to apply' status_target='' status_written=false status_quiet=false
	trap report_status_failure EXIT
	# A dry run installs nothing, so it must not replace the last real log.
	[[ $dry_run == true ]] || start_operation_log apply

	read_config
	read_installed

	local staging_dir tarball checksum config_h_arg=- live_config_h=
	if [[ -n $file_path ]]; then
		valid_absolute_path "$file_path" || die "--file must be an absolute path"
		[[ -z $given_checksum ]] || checksum=$given_checksum
		[[ -f $file_path && ! -L $file_path ]] || die "tarball not found: $file_path"
		[[ -n $requested_version ]] || die "--file requires --version to confirm what it contains"
		valid_version "$requested_version" || die "not a valid version: $requested_version"
		status_target=$requested_version
		ensure_owned_directory "$updates_root" "updates"
		tarball=$updates_root/lyona-$requested_version.tar.gz
		if [[ $file_path != "$tarball" ]]; then
			local tmp_tarball
			tmp_tarball=$(mktemp "$updates_root/.lyona-$requested_version.tar.gz.XXXXXX")
			if ! cp -- "$file_path" "$tmp_tarball"; then
				rm -f "$tmp_tarball"
				die "failed to stage tarball: $file_path"
			fi
			mv -fT "$tmp_tarball" "$tarball"
		fi
	else
		[[ -n $requested_version ]] || {
			resolve_release "$channel" ||
				die "could not reach the update server; for an offline install pass --file PATH --version V --sha256 HASH (the tarball's line in the release's SHA256SUMS)"
			requested_version=$release_version
		}
		status_target=$requested_version
		valid_version "$requested_version" || die "not a valid version: $requested_version"
		[[ $requested_version == "${release_version:-}" ]] || resolve_release "$channel" ||
			die "could not look up release $requested_version"
		[[ $requested_version == "$release_version" ]] ||
			die "requested version $requested_version does not match the resolved release $release_version"
		checksum=$release_checksum
		[[ $checksum != unknown ]] || die "no published checksum for $requested_version; refusing to install unverified"

		ensure_owned_directory "$updates_root" "updates"
		tarball=$updates_root/lyona-$requested_version.tar.gz
		[[ -n $release_asset_url ]] || die "release $requested_version has no source archive asset"
		status_detail="Downloading lyona-$requested_version.tar.gz"
		write_status "$status_phase" "$status_detail" "$status_target" pending ''
		warn "$status_detail"
		local tmp_tarball
		tmp_tarball=$(mktemp "$updates_root/.lyona-$requested_version.tar.gz.XXXXXX")
		if ! curl --fail --silent --show-error --location \
			--retry 3 --connect-timeout 10 --max-time 300 \
			"$release_asset_url" --output "$tmp_tarball"; then
			rm -f "$tmp_tarball"
			die "failed to download $release_asset_url"
		fi
		mv -fT "$tmp_tarball" "$tarball"
	fi

	if [[ -n ${checksum:-} ]] && [[ $checksum != unknown ]]; then
		:
	elif [[ -n $file_path ]]; then
		resolve_release "$channel" && [[ $requested_version == "$release_version" ]] && checksum=$release_checksum
		checksum=${checksum:-unknown}
	fi
	status_phase=verifying status_detail='Verifying release checksum'
	write_status "$status_phase" "$status_detail" "$status_target" pending ''
	if [[ ${checksum:-unknown} != unknown ]]; then
		warn "verifying checksum"
		local actual_checksum
		actual_checksum=$(sha256_of "$tarball")
		[[ $actual_checksum == "$checksum" ]] ||
			die "checksum mismatch for $tarball: expected $checksum, got $actual_checksum"
	else
		warn "no checksum available for $tarball; proceeding without verification is not supported"
		die "refusing to install an unverified tarball"
	fi

	# The signature (decision D-31), once the file is known to be the one the
	# release lists.
	status_detail='Verifying release signature'
	write_status "$status_phase" "$status_detail" "$status_target" pending ''
	if ! signature_required "$requested_version"; then
		warn "$requested_version was released before releases were signed; verified by its checksum only"
	elif [[ -n $given_checksum && -z $bundle_path ]]; then
		warn "not checking the signature: --sha256 vouches for $file_path"
	else
		[[ -n $bundle_path ]] || download_bundle "$requested_version"
		warn "verifying signature"
		verify_signature "$tarball" "$requested_version" "$bundle_path"
	fi

	status_detail="Unpacking lyona-$requested_version.tar.gz"
	write_status "$status_phase" "$status_detail" "$status_target" pending ''
	staging_dir=$updates_root/$requested_version
	rm -rf "$staging_dir"
	mkdir -p "$staging_dir"
	if ! tar -xzf "$tarball" -C "$staging_dir" --strip-components=1; then
		rm -rf "$staging_dir"
		die "failed to unpack $tarball"
	fi
	# Compile-time options (Sync Sprint 12 S12-02, decision D-18): the user's own
	# $XDG_CONFIG_HOME/lyona/config.h first, then a checkout's config.h next to
	# this script. Resolved, because the privileged step refuses a symlink.
	local candidate
	for candidate in "$config_home/lyona/config.h" "${script_dir%/*}/config.h"; do
		[[ -f $candidate ]] || continue
		live_config_h=$(readlink -f -- "$candidate")
		break
	done
	if [[ -n $live_config_h ]]; then
		warn "building with compile-time options from $live_config_h"
		cp -- "$live_config_h" "$staging_dir/config.h"
		config_h_arg=$live_config_h
	fi

	local installed_rank requested_rank
	installed_rank=$(version_rank "$installed_version" 2>/dev/null || printf 0)
	requested_rank=$(version_rank "$requested_version" 2>/dev/null || die "not a valid version: $requested_version")
	if [[ $requested_rank < $installed_rank && $allow_downgrade != true ]]; then
		die "requested version $requested_version is older than the installed $installed_version; pass --allow-downgrade to proceed"
	fi

	status_detail="Checking the packages $requested_version needs"
	write_status "$status_phase" "$status_detail" "$status_target" pending ''
	check_release_packages "$staging_dir"

	status_phase=building status_detail="Building $requested_version"
	write_status "$status_phase" "$status_detail" "$status_target" pending ''
	warn "building $requested_version"
	if ! make -C "$staging_dir" clean >/dev/null; then
		die "failed to clean the staging tree"
	fi
	if ! make -C "$staging_dir" all; then
		[[ -z $live_config_h ]] ||
			warn "this build used $live_config_h; if $requested_version added compile-time options, merge them in from its config.def.h"
		die "build failed for $requested_version; the live install is untouched"
	fi

	if [[ $dry_run == true ]]; then
		status_written=true
		trap - EXIT
		# A dry run isn't a real, restart-surviving operation -- remove the
		# "building" status this same call just wrote rather than leaving a
		# stale pending record for a build that already finished.
		rm -f "$status_file"
		printf 'dry run: would back up the live install, then write:\n'
		printf '  %s/bin (system commands and dwm)\n' "${PREFIX:-/usr/local}"
		printf '  %s/libexec/lyona (privileged helpers)\n' "${PREFIX:-/usr/local}"
		printf '  %s/share/man/man1/dwm.1\n' "${PREFIX:-/usr/local}"
		printf '  /etc/lyona-release\n'
		printf '  %s\n' "$state_home/lyona/install.state"
		printf 'complete\tapply-dry-run\n'
		return 0
	fi

	if [[ $yes != true ]]; then
		local answer
		printf 'Install %s over the running system? [y/N] ' "$requested_version" >&2
		IFS= read -r answer || answer=
		case $answer in
		y | Y | yes | YES) ;;
		*)
			status_quiet=true
			die "not confirmed; the staged, built update in $staging_dir was left in place"
			;;
		esac
	fi

	# shellcheck source=scripts/lyona-install-verify.sh
	LYONA_INSTALL_REPO_DIR=$staging_dir . "$lyona_lib/lyona-install-verify.sh"
	prepare_expected_files

	status_phase=installing status_detail='Backing up the live installation'
	write_status "$status_phase" "$status_detail" "$status_target" pending ''
	warn "$status_detail"
	backup_live_install
	# The same id names the privileged helper's own copy of the system files,
	# which it takes, as root, just before installing (Sync Sprint 12 S12-01).
	local backup_id=${backup_dir##*/}

	status_detail="Installing $requested_version (authentication required)"
	write_status "$status_phase" "$status_detail" "$status_target" pending ''
	warn "$status_detail"
	if ! run_privileged install-system release "$tarball" "$checksum" "$requested_version" "$config_h_arg" "$backup_id"; then
		die "the privileged install step failed or was declined; the live install is untouched, and the staged, built update in $staging_dir was left in place"
	fi
	if ! make -C "$staging_dir" install-user \
		USER_HOME="$HOME" OWNER="$(id -un)" \
		XDG_CONFIG_HOME="$config_home" XDG_DATA_HOME="$data_home" XDG_STATE_HOME="$state_home"; then
		die "the user-level install step failed after the system files were already updated; run lyona-update rollback"
	fi

	status_phase=verifying-install status_detail='Verifying installed state'
	write_status "$status_phase" "$status_detail" "$status_target" pending ''
	warn "$status_detail"
	verify_install || die "the live installation does not match the staged update; run lyona-update rollback"

	status_phase=restarting status_detail='Restarting Quickshell'
	write_status "$status_phase" "$status_detail" "$status_target" pending ''
	warn "$status_detail"
	runtime_verify 1 || warn "runtime validation reported a problem; see above"

	prune_backups
	status_written=true
	write_status restarting 'Update complete' "$status_target" succeeded ''
	trap - EXIT
	printf 'complete\tapply\t%s\n' "$requested_version"
}

# --- backups / rollback ------------------------------------------------

list_backup_ids() {
	[[ -d $backups_root ]] || return 0
	find "$backups_root" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort -r
}

backup_version_of() {
	local id=$1 checkout_file
	checkout_file=$backups_root/$id/checkout.txt
	[[ -f $checkout_file ]] || {
		printf 'unknown\n'
		return 0
	}
	awk -F= '$1 == "version" { print $2; exit }' "$checkout_file" 2>/dev/null
}

prune_backups() {
	[[ $keep_backups -gt 0 ]] || return 0
	local id count=0
	while IFS= read -r id; do
		[[ -n $id ]] || continue
		count=$((count + 1))
		if ((count > keep_backups)); then
			rm -rf -- "${backups_root:?}/$id"
		fi
	done < <(list_backup_ids)
}

cmd_backups() {
	local json=false
	while (($# > 0)); do
		case $1 in
		--json)
			json=true
			shift
			;;
		*) die "unknown option: $1" ;;
		esac
	done
	if [[ $json == true ]]; then
		printf '['
		local id first=true version date
		while IFS= read -r id; do
			[[ -n $id ]] || continue
			version=$(backup_version_of "$id")
			date=${id%%-*}
			[[ $first == true ]] || printf ','
			first=false
			jq -cn --arg id "$id" --arg version "$version" --arg date "$date" \
				'{id: $id, version: $version, date: $date}'
		done < <(list_backup_ids)
		printf ']\n'
		return 0
	fi
	printf 'lyona-update-protocol\t1\t0\n'
	local id version
	while IFS= read -r id; do
		[[ -n $id ]] || continue
		version=$(backup_version_of "$id")
		printf 'backup\t%s\t%s\n' "$id" "$version"
	done < <(list_backup_ids)
	printf 'complete\tbackups\n'
}

verify_backup_checksums() {
	local backup_dir=$1 archive
	local sums_file=$backup_dir/SHA256SUMS
	[[ -f $sums_file && ! -L $sums_file ]] || die "backup has no checksum manifest: $backup_dir"
	for archive in "$backup_dir"/*.tar; do
		[[ -f $archive ]] || continue
		(cd "$backup_dir" && sha256sum --quiet --check <(grep -F "$(basename "$archive")" SHA256SUMS)) ||
			die "backup checksum verification failed: $archive"
	done
}

# Restores one user tree (~/.local/share/lyona or ~/.config/quickshell) from its
# backup archive, whole: the archive is unpacked beside the target and swapped in,
# so files a newer version added do not stay behind, as they did when it was
# unpacked over the current tree (Sync Sprint 12 S12-11). The current tree is kept
# until the new one is in place, and put back if the swap fails.
# Arguments: ARCHIVE NAME. True when the archive can be read and every entry is
# under the one top-level folder NAME (no absolute paths, no ".."). Checked for
# both user archives before the privileged system restore, so a bad one never
# leaves the system files restored and the user files not.
valid_user_archive() {
	local listing
	listing=$(tar -tf "$1" 2>/dev/null) || return 1
	[[ -n $listing ]] || return 1
	awk -v name="$2" '
		{ entry = $0; sub(/\/$/, "", entry) }
		entry != name && index(entry, name "/") != 1 { bad = 1 }
		entry ~ /(^|\/)\.\.(\/|$)/ { bad = 1 }
		END { exit bad }
	' <<<"$listing"
}

# Arguments: ARCHIVE TARGET.
restore_user_tree() {
	local archive=$1 target=$2 parent name staging previous
	parent=$(dirname "$target")
	name=$(basename "$target")
	mkdir -p "$parent" || return 1
	staging=$(mktemp -d "$parent/.$name.restore.XXXXXX") || return 1
	if ! tar -C "$staging" -xpf "$archive" ||
		[[ ! -d $staging/$name || -L $staging/$name ]] ||
		[[ $(find "$staging" -mindepth 1 -maxdepth 1 | wc -l) -ne 1 ]]; then
		rm -rf "$staging"
		warn "backup archive $archive does not hold exactly $name"
		return 1
	fi
	previous=
	if [[ -e $target || -L $target ]]; then
		previous=$staging/.previous
		mv -T "$target" "$previous" || {
			rm -rf "$staging"
			return 1
		}
	fi
	if ! mv -T "$staging/$name" "$target"; then
		if [[ -n $previous ]] && ! mv -T "$previous" "$target"; then
			# The original tree is only in staging now: keep it.
			warn "could not put $target back; the previous copy is kept in $previous"
			return 1
		fi
		rm -rf "$staging"
		return 1
	fi
	rm -rf "$staging"
}

cmd_rollback() {
	local backup_id='' list_only=false yes=false
	while (($# > 0)); do
		case $1 in
		--backup)
			(($# >= 2)) || die "--backup requires a value"
			backup_id=$2
			shift 2
			;;
		--list)
			list_only=true
			shift
			;;
		--yes)
			yes=true
			shift
			;;
		*) die "unknown option: $1" ;;
		esac
	done

	if [[ $list_only == true ]]; then
		cmd_backups
		return 0
	fi

	if [[ -z $backup_id ]]; then
		backup_id=$(list_backup_ids | head -n1)
		[[ -n $backup_id ]] || die "no backups are available"
	fi
	local backup_dir=$backups_root/$backup_id
	case $backup_id in
	*/* | '' | . | ..) die "invalid backup id: $backup_id" ;;
	esac
	[[ -d $backup_dir && ! -L $backup_dir ]] || die "backup not found: $backup_id"

	local status_phase=restarting status_detail="Verifying backup $backup_id" status_target=$backup_id status_written=false status_quiet=false
	trap report_status_failure EXIT
	start_operation_log rollback
	write_status "$status_phase" "$status_detail" "$status_target" pending ''

	verify_backup_checksums "$backup_dir"

	local checkout_file=$backup_dir/checkout.txt
	local backup_prefix backup_config_home backup_data_home
	backup_prefix=$(awk -F= '$1 == "prefix" { print $2; exit }' "$checkout_file" 2>/dev/null)
	backup_config_home=$(awk -F= '$1 == "config_home" { print $2; exit }' "$checkout_file" 2>/dev/null)
	backup_data_home=$(awk -F= '$1 == "xdg_data_home" { print $2; exit }' "$checkout_file" 2>/dev/null)
	local current_prefix=${PREFIX:-/usr/local}
	if [[ -n $backup_prefix && $backup_prefix != "$current_prefix" ]] ||
		[[ -n $backup_config_home && $backup_config_home != "$config_home" ]] ||
		[[ -n $backup_data_home && $backup_data_home != "$data_home" ]]; then
		die "backup $backup_id was taken against a different environment; refusing to restore into this one"
	fi

	if [[ $yes != true ]]; then
		local answer
		printf 'Restore backup %s over the running system? [y/N] ' "$backup_id" >&2
		IFS= read -r answer || answer=
		case $answer in
		y | Y | yes | YES) ;;
		*)
			status_quiet=true
			die "not confirmed"
			;;
		esac
	fi

	# Both user archives are checked before anything is restored (the swap checks
	# each again as it restores it).
	if [[ -f $backup_dir/lyona-data.tar ]]; then
		valid_user_archive "$backup_dir/lyona-data.tar" lyona ||
			die "backup $backup_id: lyona-data.tar is unreadable or holds more than lyona/; nothing was restored"
	fi
	if [[ -f $backup_dir/quickshell.tar ]]; then
		valid_user_archive "$backup_dir/quickshell.tar" quickshell ||
			die "backup $backup_id: quickshell.tar is unreadable or holds more than quickshell/; nothing was restored"
	fi

	status_detail="Restoring backup $backup_id"
	write_status "$status_phase" "$status_detail" "$status_target" pending ''
	warn "restoring system files (this step requires authentication)"
	# System files come from the privileged helper's own root-held copy, named by
	# id; this directory only holds the user-side trees.
	run_privileged restore-system "$backup_id" ||
		die "the privileged restore step failed or was declined"

	if [[ -f $backup_dir/lyona-data.tar ]]; then
		restore_user_tree "$backup_dir/lyona-data.tar" "$data_home/lyona" ||
			die "could not restore $data_home/lyona from backup $backup_id"
	fi
	if [[ -f $backup_dir/quickshell.tar ]]; then
		restore_user_tree "$backup_dir/quickshell.tar" "$config_home/quickshell" ||
			die "could not restore $config_home/quickshell from backup $backup_id"
	fi

	local restored_version
	restored_version=$(backup_version_of "$backup_id")
	status_target=${restored_version:-$backup_id}

	# Matches apply's own step 9: a rollback triggered live from the Settings
	# pane should take effect without a full logout whenever that's safe, and
	# the pane needs the same completion signal apply gives it. runtime_verify
	# itself defers to a session restart -- printing that requirement -- only
	# when the restored dwm binary actually differs from the running one, and
	# defers entirely (prints nothing actionable) when DISPLAY is unavailable,
	# which is exactly the bare-TTY case this command exists for; that case
	# gets its own explicit instruction below instead.
	status_phase=restarting status_detail='Restarting Quickshell'
	write_status "$status_phase" "$status_detail" "$status_target" pending ''
	# shellcheck source=scripts/lyona-install-verify.sh
	LYONA_INSTALL_REPO_DIR=$backup_dir . "$lyona_lib/lyona-install-verify.sh"
	if [[ -z ${DISPLAY:-} ]]; then
		printf 'Log in now to start using %s.\n' "${restored_version:-the restored version}"
	else
		runtime_verify 1 || warn "runtime validation reported a problem; see above"
	fi

	status_written=true
	write_status restarting 'Rollback complete' "$status_target" succeeded ''
	trap - EXIT
	printf 'complete\trollback\t%s\n' "${restored_version:-unknown}"
}

# --- dispatch --------------------------------------------------------

[[ $# -ge 1 ]] || {
	usage >&2
	exit 2
}
subcommand=$1
shift
case $subcommand in
check) cmd_check "$@" ;;
apply) cmd_apply "$@" ;;
rollback) cmd_rollback "$@" ;;
backups) cmd_backups "$@" ;;
set-channel) cmd_set_channel "$@" ;;
-h | --help)
	usage
	exit 0
	;;
*)
	usage >&2
	exit 2
	;;
esac
