#!/usr/bin/env bash
set -euo pipefail

# Fingerprint authentication in PAM (#483): adds and removes fprintd for one
# use at a time, and says which uses have it. Run as root only by
# dwm-settings-fingerprint-root (polkit); status is readable by anyone.
#
#   lyona-fingerprint-pam [--root DIR] status
#   lyona-fingerprint-pam [--root DIR] enable|disable|remove-external USE
#   lyona-fingerprint-pam [--root DIR] sync-enroll-rule
#
# USE is one of:
#   lightdm  /etc/pam.d/lightdm: the LightDM login and light-locker's lock
#            screen, which authenticates through the same service
#   polkit   /etc/pam.d/polkit-1, created over the system's
#            /usr/lib/pam.d/polkit-1 when that is the only one
#   sudo     /etc/pam.d/sudo
#
# enable adds two lines right after the "#%PAM-1.0" header (or at the top):
# a marker comment, then
#   -auth sufficient pam_fprintd.so timeout=10 max-tries=3
# "sufficient": a finger that fails or times out falls through to the
# password, which keeps working at every step. The leading "-" makes PAM skip
# the line if pam_fprintd is ever uninstalled. Nothing else in the file is
# touched. The original is kept (root-only, in /var/lib/lyona/fingerprint)
# with the checksum of what was written; disable puts the original back byte
# for byte when the file is still exactly what was written, and otherwise
# removes only the two lines (keeping a copy of the file first). For polkit,
# disable removes the /etc copy it created, which brings back the system's.
#
# A pam_fprintd line Lyona did not add is reported as "external" and left
# alone: enable and disable refuse it. remove-external removes such lines, after
# keeping a copy of the file, and only when asked.
#
# The stacks a use's file pulls in count too: every "include" and "substack"
# directive (any type, with or without a leading "-", the control word in any
# case, a line continued with a backslash as PAM joins it) and Debian's
# "@include", followed to any depth (at most 32 files), by name in /etc/pam.d
# and then /usr/lib/pam.d, or by absolute path. A pam_fprintd line in one of
# those, one that exists but cannot be read, or more files than the 32, makes
# the use "external", so it is never
# reported off while a finger works through it. A named stack that does not
# exist is skipped. remove-external edits only the use's own file; a line in a
# stack it pulls in is removed there, by hand.
#
# status prints:
#   fingerprint-pam-protocol  1
#   module   available|missing  PATH
#   use      USE  on|off|external|unavailable  DETAIL
#   complete status
#
# While any use is on, or set up outside Lyona, a polkit rule makes enrolling
# a finger ask for the administrator password (#535): fprintd's own policy
# asks for the user's password and remembers it for a while, so someone at an
# unlocked session could add a finger of their own, which then works wherever
# fingerprint is on. Every change here, and sync-enroll-rule (run by the
# install), writes the rule or removes it to match. enable writes it before it
# changes the PAM file, so a refused rule leaves fingerprint off. Every change
# and sync-enroll-rule hold one lock from their first look at the files until
# the rule matches, so two changes never decide the rule from each other's
# half-done state.
#
# DIR (for tests) is the root the paths are under; it is never given by the
# root helper, which uses /.

root=
if [[ ${1:-} == --root ]]; then
	[[ $# -ge 2 && $2 == /* ]] || {
		printf 'lyona-fingerprint-pam: --root needs an absolute directory\n' >&2
		exit 2
	}
	root=${2%/}
	shift 2
fi
umask 022
self=lyona-fingerprint-pam
readonly marker='# lyona-fingerprint: added by Lyona Settings > Fingerprint; turn it off there'
readonly fprint_line='-auth      sufficient  pam_fprintd.so timeout=10 max-tries=3'
module=$root/usr/lib/security/pam_fprintd.so
state_dir=$root/var/lib/lyona/fingerprint
enroll_rule=$root/etc/polkit-1/rules.d/50-lyona-fingerprint-enroll.rules

die() {
	printf '%s: %s\n' "$self" "$*" >&2
	exit 1
}

# The file a use edits, and where its original comes from when that file does
# not exist yet (polkit only).
target_of() {
	case $1 in
	lightdm) printf '%s\n' "$root/etc/pam.d/lightdm" ;;
	polkit) printf '%s\n' "$root/etc/pam.d/polkit-1" ;;
	sudo) printf '%s\n' "$root/etc/pam.d/sudo" ;;
	*) return 1 ;;
	esac
}
vendor_of() {
	case $1 in
	polkit) printf '%s\n' "$root/usr/lib/pam.d/polkit-1" ;;
	*) printf '\n' ;;
	esac
}
valid_use() { [[ $1 == lightdm || $1 == polkit || $1 == sudo ]]; }

# No symlink anywhere on the way to PATH, below the root.
no_symlinks() {
	local path=$1
	while [[ $path == "$root"/* ]]; do
		[[ ! -L $path ]] || return 1
		path=${path%/*}
	done
	[[ -z $root || ! -L $root ]]
}

# A regular file this user (root, when root) owns, reached without a symlink.
plain_owned_file() {
	no_symlinks "$1" && [[ -f $1 && ! -L $1 && $(stat -c %u -- "$1") == "$EUID" ]]
}

# The lines of FILE that turn fprintd on, apart from the two Lyona added.
external_lines() {
	awk -v marker="$marker" -v line="$fprint_line" '
		$0 == marker { m = NR; next }
		m > 0 && NR == m + 1 && $0 == line { next }
		/^[[:space:]]*#/ { next }
		/pam_fprintd\.so/ { print NR }
	' "$1"
}
has_lyona_lines() {
	awk -v marker="$marker" -v line="$fprint_line" '
		prev == marker && $0 == line { found = 1 }
		{ prev = $0 }
		END { exit !found }
	' "$1"
}

# Whether /etc/pam.d/polkit-1, without Lyona's two lines, is still the system's
# own file (#524): while it is on, a change polkit's package makes to its PAM
# file is shadowed, and pacman makes no .pacnew for it. The file may also be one
# that was there before Lyona, or edited since; status cannot tell (the state
# directory is root's), so the detail asks for a comparison, not a rebuild.
vendor_followed() {
	awk -v marker="$marker" -v line="$fprint_line" '
		$0 == marker { held = 1; next }
		held && $0 == line { held = 0; next }
		held { print marker; held = 0 }
		{ print }
	' "$1" | cmp -s - "$2"
}

# The file a PAM include, substack or @include NAME refers to.
pam_stack_path() {
	local name=$1 dir
	[[ -n $name && $name != *..* ]] || return 1
	if [[ $name == /* ]]; then
		printf '%s\n' "$root$name"
		return 0
	fi
	[[ $name != */* ]] || return 1
	for dir in "$root/etc/pam.d" "$root/usr/lib/pam.d"; do
		[[ -e $dir/$name ]] || continue
		printf '%s\n' "$dir/$name"
		return 0
	done
	return 1
}

# The first stack FILE pulls in, at any depth, that turns fprintd on: its
# path, or "?" and its path when it cannot be read. Nothing when none does.
included_fprintd() {
	local queue=("$1") seen=() file name path i=0
	while ((i < ${#queue[@]} && i < 32)); do
		file=${queue[i]}
		i=$((i + 1))
		while IFS= read -r name; do
			path=$(pam_stack_path "$name") || continue
			[[ " ${seen[*]} " != *" $path "* ]] || continue
			seen+=("$path")
			if [[ ! -f $path || ! -r $path ]]; then
				printf '?%s\n' "$path"
				return 0
			fi
			if [[ -n $(external_lines "$path") ]]; then
				printf '%s\n' "$path"
				return 0
			fi
			queue+=("$path")
		# As PAM reads it: a line ending in a backslash goes on in the next,
		# and the control word is in any case.
		done < <(awk '
			held == "" && /^[[:space:]]*#/ { next }
			/\\$/ { held = held substr($0, 1, length($0) - 1) " "; next }
			{ $0 = held $0; held = "" }
			$1 == "@include" { print $2; next }
			tolower($2) == "include" || tolower($2) == "substack" { print $3 }
		' "$file")
	done
	# Stacks left unread at the limit: not known to be without fprintd.
	if ((i < ${#queue[@]})); then
		printf '!%s\n' "$1"
	fi
}

# The state of a use: on, off, external or unavailable, and why.
use_state() {
	local use=$1 target vendor file included
	target=$(target_of "$use")
	vendor=$(vendor_of "$use")
	file=$target
	if [[ ! -e $target && -n $vendor && -e $vendor ]]; then
		file=$vendor
	fi
	if [[ ! -e $file ]]; then
		printf 'unavailable\t%s does not exist\n' "${target#"$root"}"
	elif ! no_symlinks "$file" || [[ ! -f $file || ! -r $file ]]; then
		printf 'unavailable\t%s is not a readable regular file\n' "${file#"$root"}"
	elif [[ -n $(external_lines "$file") ]]; then
		printf 'external\tfprintd was added to %s outside Lyona\n' "${file#"$root"}"
	elif included=$(included_fprintd "$file") && [[ $included == \!* ]]; then
		printf 'external\t%s pulls in more than 32 PAM files, so fprintd may be on through one not checked\n' \
			"${file#"$root"}"
	elif [[ $included == \?* ]]; then
		printf 'external\t%s, which %s pulls in, cannot be read, so fprintd may be on through it\n' \
			"${included#\?"$root"}" "${file#"$root"}"
	elif [[ -n $included ]]; then
		printf 'external\tfprintd was added to %s, which %s pulls in, outside Lyona\n' \
			"${included#"$root"}" "${file#"$root"}"
	elif has_lyona_lines "$file"; then
		if [[ $file == "$target" && -n $vendor && -f $vendor ]] && ! vendor_followed "$target" "$vendor"; then
			printf 'on\tA finger is accepted, or the password. /etc/pam.d/polkit-1 differs from polkit'"'"'s own /usr/lib/pam.d/polkit-1, which it shadows: compare them and carry over the changes you want (a copy Lyona made and nobody edited is made again from polkit'"'"'s file by turning this off and on)\n'
		else
			printf 'on\tA finger is accepted, or the password\n'
		fi
	else
		printf 'off\tThe password only\n'
	fi
}

# The enrolment rule (#535), present exactly while a use is on or external.
sync_enroll_rule() {
	local use state any=0
	for use in lightdm polkit sudo; do
		state=$(use_state "$use")
		case ${state%%$'\t'*} in on | external) any=1 ;; esac
	done
	if ((any == 0)); then
		[[ ! -e $enroll_rule && ! -L $enroll_rule ]] || {
			no_symlinks "$enroll_rule" && [[ ! -L $enroll_rule ]] || die "refusing a symlinked path: ${enroll_rule#"$root"}"
			rm -f -- "$enroll_rule"
		}
		return 0
	fi
	write_enroll_rule
}

write_enroll_rule() {
	local dir tmp
	dir=${enroll_rule%/*}
	no_symlinks "$dir" || die "refusing a symlinked path: ${dir#"$root"}"
	mkdir -p -- "$dir"
	[[ ! -L $enroll_rule ]] || die "refusing a symlinked path: ${enroll_rule#"$root"}"
	tmp=$(mktemp "$dir/.50-lyona-fingerprint-enroll.XXXXXX")
	cat >"$tmp" <<'RULE'
// Written by Lyona's lyona-fingerprint-pam while fingerprint is on for the
// login, administrator prompts or sudo (#535); removed when it is off for all.
// Enrolling a finger asks for the administrator password, not the user's own
// remembered one, so a finger cannot be added in a moment at an unlocked
// session and then work wherever fingerprint is on.
polkit.addRule(function(action, subject) {
    if (action.id == "net.reactivated.fprint.device.enroll") {
        return polkit.Result.AUTH_ADMIN;
    }
});
RULE
	chmod 644 -- "$tmp"
	mv -fT -- "$tmp" "$enroll_rule"
}

cmd_status() {
	local use state
	printf 'fingerprint-pam-protocol\t1\n'
	if [[ -f $module ]]; then
		printf 'module\tavailable\t%s\n' "${module#"$root"}"
	else
		printf 'module\tmissing\t%s\n' "${module#"$root"}"
	fi
	for use in lightdm polkit sudo; do
		state=$(use_state "$use")
		printf 'use\t%s\t%s\n' "$use" "$state"
	done
	printf 'complete\tstatus\n'
}

private_state_dir() {
	no_symlinks "$state_dir" || die "refusing a symlinked path: ${state_dir#"$root"}"
	mkdir -p -- "$state_dir"
	[[ -d $state_dir && ! -L $state_dir && $(stat -c %u -- "$state_dir") == "$EUID" ]] ||
		die "not a directory of this user's: ${state_dir#"$root"}"
	chmod 700 -- "$state_dir"
}

# Replaces TARGET with the contents of SOURCE, all at once, with REFERENCE's
# mode and owner (or 0644 and this user).
replace_file() { # TARGET SOURCE [REFERENCE]
	local target=$1 source=$2 reference=${3:-} tmp
	tmp=$(mktemp "${target%/*}/.${target##*/}.lyona.XXXXXX")
	if ! cat -- "$source" >"$tmp"; then
		rm -f -- "$tmp"
		die "cannot write ${target#"$root"}"
	fi
	if [[ -n $reference && -e $reference ]]; then
		chmod --reference="$reference" -- "$tmp"
		((EUID != 0)) || chown --reference="$reference" -- "$tmp"
	else
		chmod 644 -- "$tmp"
	fi
	mv -fT -- "$tmp" "$target"
}

checksum() { sha256sum -- "$1" | cut -d' ' -f1; }

# One change at a time, to any use, with the enrolment rule: held from the
# first look at the files and state until the rule matches (released when this
# exits), since the rule follows every use.
lock_changes() {
	private_state_dir
	exec 9>>"$state_dir/pam.lock"
	flock -w 30 9 || die "another fingerprint change is still running"
}

clear_state() { rm -f -- "$state_dir/$1".{orig,absent,written}; }

cmd_enable() {
	local use=$1 target vendor source work included
	lock_changes
	target=$(target_of "$use")
	vendor=$(vendor_of "$use")
	[[ -f $module ]] || die "pam_fprintd is not installed (${module#"$root"}); install fprintd first"
	source=$target
	[[ -e $target || -z $vendor ]] || source=$vendor
	[[ -e $source ]] || die "${target#"$root"} does not exist"
	plain_owned_file "$source" || die "refusing ${source#"$root"}: not a regular file of this user's"
	[[ -z $(external_lines "$source") ]] ||
		die "fprintd was added to ${source#"$root"} outside Lyona; remove it there, or with remove-external, first"
	included=$(included_fprintd "$source")
	[[ $included != \!* ]] ||
		die "${source#"$root"} pulls in more than 32 PAM files, so fprintd may be on through one not checked"
	[[ -z $included ]] ||
		die "fprintd may already be on through ${included#\?"$root"}, which ${source#"$root"} pulls in; remove it there first"
	if has_lyona_lines "$source"; then
		printf 'fingerprint-pam-result\tenable\t%s\talready\n' "$use"
		return 0
	fi
	no_symlinks "$target" || die "refusing a symlinked path: ${target#"$root"}"
	# The enrolment rule first: refused, fingerprint stays off.
	write_enroll_rule
	clear_state "$use"
	if [[ -e $target ]]; then
		cat -- "$target" >"$state_dir/$use.orig"
	else
		: >"$state_dir/$use.absent"
	fi
	work=$(mktemp)
	trap 'rm -f -- "$work"' RETURN
	awk -v marker="$marker" -v line="$fprint_line" '
		NR == 1 && $0 ~ /^#%PAM-1\.0[[:space:]]*$/ { print; print marker; print line; done = 1; next }
		NR == 1 { print marker; print line; done = 1 }
		{ print }
		END { if (!done) { print marker; print line } }
	' "$source" >"$work"
	# The checksum of the bytes written, before they are put in place.
	checksum "$work" >"$state_dir/$use.written"
	replace_file "$target" "$work" "$source"
	printf 'fingerprint-pam-result\tenable\t%s\ton\n' "$use"
}

cmd_disable() {
	local use=$1 target work stamp
	lock_changes
	target=$(target_of "$use")
	if [[ ! -e $target ]] || ! has_lyona_lines "$target"; then
		if [[ -e $target && -n $(external_lines "$target") ]]; then
			die "fprintd was added to ${target#"$root"} outside Lyona; remove it there, or with remove-external"
		fi
		clear_state "$use"
		printf 'fingerprint-pam-result\tdisable\t%s\talready\n' "$use"
		return 0
	fi
	plain_owned_file "$target" || die "refusing ${target#"$root"}: not a regular file of this user's"
	# Still exactly what was written: the original, byte for byte.
	if [[ -f $state_dir/$use.written && $(cat -- "$state_dir/$use.written") == "$(checksum "$target")" ]]; then
		if [[ -f $state_dir/$use.absent ]]; then
			rm -f -- "$target"
			clear_state "$use"
			printf 'fingerprint-pam-result\tdisable\t%s\trestored\n' "$use"
			return 0
		elif [[ -f $state_dir/$use.orig ]]; then
			replace_file "$target" "$state_dir/$use.orig" "$target"
			clear_state "$use"
			printf 'fingerprint-pam-result\tdisable\t%s\trestored\n' "$use"
			return 0
		fi
	fi
	# Edited since: only Lyona's two lines go, after a copy of the file.
	stamp=$(date +%Y%m%d%H%M%S)
	cat -- "$target" >"$state_dir/$use.before-disable.$stamp"
	work=$(mktemp)
	trap 'rm -f -- "$work"' RETURN
	awk -v marker="$marker" -v line="$fprint_line" '
		skip { skip = 0; if ($0 == line) { held = ""; next } }
		$0 == marker { skip = 1; held = $0; next }
		{ if (held != "") { print held; held = "" } print }
		END { if (held != "") print held }
	' "$target" >"$work"
	replace_file "$target" "$work" "$target"
	clear_state "$use"
	printf 'fingerprint-pam-result\tdisable\t%s\tremoved\n' "$use"
}

cmd_remove_external() {
	local use=$1 target work stamp lines
	lock_changes
	target=$(target_of "$use")
	[[ -e $target ]] || die "${target#"$root"} does not exist"
	plain_owned_file "$target" || die "refusing ${target#"$root"}: not a regular file of this user's"
	lines=$(external_lines "$target")
	if [[ -z $lines ]]; then
		printf 'fingerprint-pam-result\tremove-external\t%s\talready\n' "$use"
		return 0
	fi
	stamp=$(date +%Y%m%d%H%M%S)
	cat -- "$target" >"$state_dir/$use.external.$stamp"
	work=$(mktemp)
	trap 'rm -f -- "$work"' RETURN
	awk -v drop="$(printf '%s\n' "$lines" | tr '\n' ' ')" '
		BEGIN { n = split(drop, d, " "); for (i = 1; i <= n; i++) skip[d[i]] = 1 }
		!(NR in skip) { print }
	' "$target" >"$work"
	replace_file "$target" "$work" "$target"
	printf 'fingerprint-pam-result\tremove-external\t%s\tremoved\n' "$use"
}

case ${1:-} in
status)
	(($# == 1)) || die "status takes no arguments"
	cmd_status
	;;
enable | disable | remove-external)
	(($# == 2)) || die "$1 takes one use: lightdm, polkit or sudo"
	valid_use "$2" || die "unknown use: $2 (lightdm, polkit or sudo)"
	case $1 in
	enable) cmd_enable "$2" ;;
	disable) cmd_disable "$2" ;;
	remove-external) cmd_remove_external "$2" ;;
	esac
	sync_enroll_rule
	;;
sync-enroll-rule)
	(($# == 1)) || die "sync-enroll-rule takes no arguments"
	lock_changes
	sync_enroll_rule
	printf 'fingerprint-pam-result\tsync-enroll-rule\t%s\n' "$([[ -e $enroll_rule ]] && echo present || echo absent)"
	;;
*)
	printf 'usage: %s [--root DIR] status | enable|disable|remove-external lightdm|polkit|sudo | sync-enroll-rule\n' "$self" >&2
	exit 2
	;;
esac
