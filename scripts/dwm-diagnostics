#!/usr/bin/env bash
set -euo pipefail

# A checkout keeps the shared shell code beside the scripts; an install keeps it
# in PREFIX/lib/lyona, beside PREFIX/bin (Sync Sprint 12 S12-13).
lyona_lib=${BASH_SOURCE[0]%/*}
[[ -f $lyona_lib/dwm-xdg.sh ]] || lyona_lib=${lyona_lib%bin}lib/lyona
# shellcheck source=scripts/dwm-xdg.sh
. "$lyona_lib/dwm-xdg.sh"
# shellcheck source=scripts/dwm-packages.sh
. "$lyona_lib/dwm-packages.sh"

format=human
required_fail=0
optional_fail=0

usage() {
	printf 'usage: %s [--format human|health-tsv]\n' "$0" >&2
}

help() {
	cat <<EOF
usage: ${0##*/} [--format human|health-tsv]

Check this lyona install: the required commands and services dwm needs, and the
optional ones desktop features use. Run it when something does not start or a
feature is missing. Exits 1 when a required check fails.

  --format human        a readable report (the default)
  --format health-tsv   tab-separated lines for System Health
  -h, --help            show this help
EOF
}

sanitize_field() {
	local value=${1:-}

	value=${value//$'\t'/ }
	value=${value//$'\r'/ }
	value=${value//$'\n'/ | }
	printf '%s' "$value" | tr -d '\000-\010\013\014\016-\037' | cut -c 1-8192
}

emit_health() {
	local status=$1
	local id=$2
	local label=$3
	local detail=$4
	local repair_id=${5:-}
	local repair_label=${6:-}

	printf 'check\tdependencies\t%s\t%s\t%s\t%s\t%s\t%s\t%s\tuser\n' \
		"$(sanitize_field "$status")" \
		"$(sanitize_field "$id")" \
		"$(sanitize_field "$label")" \
		"$(sanitize_field "$detail")" \
		"$(sanitize_field "$detail")" \
		"$(sanitize_field "$repair_id")" \
		"$(sanitize_field "$repair_label")"
}

ok() {
	local id=$1
	local label=$2
	local detail=${3:-$2}

	if [[ $format == health-tsv ]]; then
		emit_health ok "$id" "$label" "$detail"
	else
		printf '  ok      %s\n' "$label"
	fi
}

required_missing() {
	local id=$1
	local label=$2
	local detail=${3:-$2}

	required_fail=$((required_fail + 1))
	if [[ $format == health-tsv ]]; then
		emit_health error "$id" "$label" "$detail" install-dependencies "Open dependency installer"
	else
		printf '  missing %s\n' "$label"
	fi
}

optional_missing() {
	local id=$1
	local label=$2
	local detail=${3:-$2}

	optional_fail=$((optional_fail + 1))
	if [[ $format == health-tsv ]]; then
		emit_health warn "$id" "$label" "$detail" install-dependencies "Open dependency installer"
	else
		printf '  degraded %s\n' "$label"
	fi
}

have_cmd() {
	command -v "$1" >/dev/null 2>&1
}

check_required_cmd() {
	if have_cmd "$1"; then
		ok "dependency-command-$1" "$1" "$1 is available"
	else
		required_missing "dependency-command-$1" "$1" "$1 is required but missing"
	fi
}

check_optional_cmd() {
	if have_cmd "$1"; then
		ok "desktop-command-$1" "$1" "$1 is available"
	else
		optional_missing "desktop-command-$1" "$1" "$1 is optional and missing"
	fi
}

check_pkg_config() {
	local id=${1//[^[:alnum:]]/-}
	if have_cmd pkg-config && pkg-config --exists "$1" 2>/dev/null; then
		ok "pkg-config-$id" "pkg-config:$1" "$1 development files are available"
	else
		required_missing "pkg-config-$id" "pkg-config:$1" "$1 development files are missing"
	fi
}

check_any_required_cmd() {
	local label=$1
	shift
	local cmd

	for cmd in "$@"; do
		if have_cmd "$cmd"; then
			ok "dependency-any-${label//[^[:alnum:]]/-}" "$label ($cmd)" "$cmd provides $label"
			return
		fi
	done

	required_missing "dependency-any-${label//[^[:alnum:]]/-}" "$label (${*})" "Install one of: ${*}"
}

check_any_optional_cmd() {
	local label=$1
	shift
	local cmd

	for cmd in "$@"; do
		if have_cmd "$cmd"; then
			ok "desktop-any-${label//[^[:alnum:]]/-}" "$label ($cmd)" "$cmd provides $label"
			return
		fi
	done

	optional_missing "desktop-any-${label//[^[:alnum:]]/-}" "$label (${*})" "Install one of: ${*}"
}

check_terminal() {
	local cmd

	if have_cmd dwm-terminal && cmd=$(dwm-terminal --print-command 2>/dev/null) && [[ -n $cmd ]]; then
		ok terminal "terminal ($cmd)" "dwm-terminal selected $cmd"
		return
	fi

	for cmd in alacritty kitty st warp-terminal xterm; do
		if have_cmd "$cmd"; then
			ok terminal "terminal ($cmd)" "$cmd is available"
			return
		fi
	done

	required_missing terminal "terminal (alacritty kitty st warp-terminal xterm)" "No supported terminal is available"
}

check_herdr() {
	local path="${HOME:-}/.local/bin/herdr"

	if have_cmd herdr; then
		ok herdr "Herdr workspace" "Herdr is available on PATH"
	elif [[ -n ${HOME:-} && -x $path ]]; then
		ok herdr "Herdr workspace" "$path is available"
	else
		optional_missing herdr "Herdr workspace" "Install with install-herdr; dwm-terminal will use the outer terminal directly"
	fi
}

# The login keyring's packages (Sync Sprint 15 S15-01). They are in the desktop
# group, so a missing one is a warning, as lyona-update gives (decision D-24).
# pacman -T exits 0 when a package is installed and 127 when it is not.
check_keyring() {
	local package status

	while IFS= read -r package; do
		[[ -n $package ]] || continue
		if ! have_cmd pacman; then
			optional_missing "dependency-package-$package" "$package" "Could not check $package: pacman not found"
			continue
		fi
		status=0
		pacman -T "$package" >/dev/null 2>&1 || status=$?
		case $status in
		0) ok "dependency-package-$package" "$package" "$package is installed" ;;
		127)
			optional_missing "dependency-package-$package" "$package" \
				"Install $package for secret storage and the keyring unlock at password login; then log out and back in"
			;;
		*) optional_missing "dependency-package-$package" "$package" "Could not check $package (pacman -T failed)" ;;
		esac
	done < <(dwm_packages arch keyring)
}

check_path_optional() {
	local id=$1
	local path=$2

	if [[ -e $path ]]; then
		ok "$id" "$path" "$path exists"
	else
		optional_missing "$id" "$path" "$path is missing"
	fi
}

main() {
	if [[ $format == human ]]; then
		printf 'lyona diagnostics\n'
		printf '\nRequired\n'
	fi

	check_required_cmd cc
	check_required_cmd make
	check_required_cmd pkg-config
	for module in x11 xft xinerama xrender imlib2 x11-xcb xcb xcb-res; do
		check_pkg_config "$module"
	done
	check_any_required_cmd "X11 server" Xorg Xlibre
	# The tiers check-deps.sh uses too, from the shared map (Sync Sprint 16 R16-45).
	while IFS= read -r cmd; do
		check_required_cmd "$cmd"
	done < <(dwm_command_tier required)
	check_terminal

	# Picom is part of the lyona desktop: required with it, optional without
	# (#244).
	if [[ $format == human ]]; then
		printf '\nCompositor\n'
	fi
	while IFS= read -r cmd; do
		if dwm_desktop_installed; then
			check_required_cmd "$cmd"
		else
			check_optional_cmd "$cmd"
		fi
	done < <(dwm_command_tier compositor)

	if [[ $format == human ]]; then
		printf '\nOptional desktop\n'
	fi
	while IFS= read -r cmd; do
		check_optional_cmd "$cmd"
	done < <(dwm_command_tier desktop)
	check_herdr
	check_any_optional_cmd "XDG autostart runner" dex dex-autostart
	check_any_optional_cmd "audio control" pactl wpctl amixer
	check_keyring
	check_path_optional xinitrc "$HOME/.xinitrc"
	lyona_xdg_dirs
	check_path_optional quickshell-config "$config_home/quickshell/shell.qml"

	# The developer override (Sync Sprint 12 S12-13): shown, so a forgotten one
	# does not go unnoticed.
	if [[ $format == human ]]; then
		printf '\nRuntime source\n'
		if [[ -n ${LYONA_DEV_SCRIPTS:-} ]]; then
			printf '  LYONA_DEV_SCRIPTS=%s (helpers from a development checkout)\n' \
				"${LYONA_DEV_SCRIPTS//[$'\t\r\n']/ }"
		else
			printf '  LYONA_DEV_SCRIPTS not set (installed helpers)\n'
		fi
	fi

	if [[ $format == human ]]; then
		printf '\nSummary\n'
		printf '  required_failures=%d\n' "$required_fail"
		printf '  optional_degraded=%d\n' "$optional_fail"
	else
		printf 'meta\tdependencies\tinfo\tdependency-summary\tDependency summary\t%d required failures, %d optional gaps\t\t\t\tuser\n' \
			"$required_fail" "$optional_fail"
	fi

	if ((required_fail > 0)); then
		if [[ $format == human ]]; then
			printf '\nRequired failures must be fixed before lyona is fully usable.\n' >&2
		fi
		return 1
	fi

	if ((optional_fail > 0)) && [[ $format == human ]]; then
		printf '\nOptional desktop features are degraded, but core dwm should remain usable.\n'
	fi
}

if (($# > 0)); then
	case ${1:-} in
	-h | --help)
		help
		exit 0
		;;
	--format)
		[[ $# -eq 2 ]] || {
			usage
			exit 2
		}
		format=$2
		;;
	--format=*)
		format=${1#*=}
		;;
	*)
		usage
		exit 2
		;;
	esac
fi

case $format in
human | health-tsv) ;;
*)
	usage
	exit 2
	;;
esac

main
