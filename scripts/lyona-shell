#!/bin/sh
set -eu

# Opens a part of the managed shell (Sync Sprint 16 R16-47). Keybinds call this
# rather than Quickshell's IPC: hotkeys.toml is seeded once and never updated,
# while this command is, so the IPC target, its functions and the config path
# can change without editing anyone's hotkeys.toml. Only the pairs below are
# passed on.

usage() {
	cat >&2 <<'EOF'
usage: lyona-shell TARGET ACTION

  launcher toggle              the app launcher
  overview toggle              the window overview
  controlcenter open|toggle    the Control Center
  controlcenter openKeybinds   the keybinds cheatsheet
  power toggle                 the power menu
  power confirm logout|reboot  the power menu, at that action's confirmation
  settings open|close|toggle|refresh|status
                               the Settings window
EOF
	exit 2
}

[ "$#" -ge 2 ] || usage
case "$1 $2 ${3:-}" in
'launcher toggle ' | 'overview toggle ' | 'controlcenter open ' | 'controlcenter toggle ' | \
	'controlcenter openKeybinds ' | 'power toggle ' | 'settings open ' | 'settings close ' | \
	'settings toggle ' | 'settings refresh ' | 'settings status ') [ "$#" -eq 2 ] || usage ;;
'power confirm logout' | 'power confirm reboot') [ "$#" -eq 3 ] || usage ;;
*) usage ;;
esac

# A checkout keeps the shared shell code beside the scripts; an install keeps it
# in PREFIX/lib/lyona (Sync Sprint 12 S12-13).
lyona_lib=${0%/*}
[ "$lyona_lib" != "$0" ] || lyona_lib=.
[ -f "$lyona_lib/dwm-xdg.sh" ] || lyona_lib=${lyona_lib%bin}lib/lyona
# shellcheck source=scripts/dwm-xdg.sh
. "$lyona_lib/dwm-xdg.sh"
lyona_xdg_dirs
# The managed shell lives only here; install-user replaces it wholesale.
config=$config_home/quickshell/shell.qml
if [ ! -f "$config" ]; then
	printf 'lyona-shell: managed Quickshell configuration not found: %s\n' "$config" >&2
	exit 1
fi

# Whether the managed instance answers at all: its tray, the first thing it
# serves (as dwm-quickshell-lifecycle.sh's quickshell_tray_ready).
shell_answers() {
	if command -v timeout >/dev/null 2>&1; then
		timeout 1 quickshell ipc --path "$config" call tray count >/dev/null 2>&1
	else
		quickshell ipc --path "$config" call tray count >/dev/null 2>&1
	fi
}

# The chord of the first binding whose FIELD contains VALUE, as the cheatsheet
# shows it (Super+Shift+R): from the user's hotkeys.toml, read by the one TOML
# reader (D-20), so a rebound key is named right in the one message that
# matters when the shell is down (#338). DEFAULT when the binding, the file or
# the reader is missing.
toml=$lyona_lib/lyona-toml
[ -x "$toml" ] || toml=$lyona_lib/../lyona-toml
hotkeys=$config_home/lyona/hotkeys.toml
if [ ! -f "$hotkeys" ]; then
	hotkeys=${lyona_lib%/lib/lyona}/share/lyona/config/hotkeys.toml
	[ -f "$hotkeys" ] || hotkeys=$lyona_lib/../config/hotkeys.toml
fi
chord_for() { # FIELD VALUE DEFAULT
	chord=$([ -x "$toml" ] && "$toml" dump "$hotkeys" 2>/dev/null | awk -F '\t' -v field="$1" -v value="$2" '
		$1 != "keys" { next }
		$3 == "mod" { mod[$2] = $4 }
		$3 == "key" { key[$2] = $4 }
		!hit && $3 == field && index($4, value) { hit = 1; idx = $2 }
		END {
			if (!hit) exit 1
			n = split(mod[idx], part, " ")
			out = ""
			for (i = 1; i <= n; i++) {
				p = tolower(part[i])
				out = out (i > 1 ? "+" : "") toupper(substr(p, 1, 1)) substr(p, 2)
			}
			k = key[idx]
			if (length(k) == 1) k = toupper(k)
			print out "+" k
		}') || chord=''
	printf '%s\n' "${chord:-$3}"
}

# Not exec: when no shell answers (it crashed, or was stopped), a key that
# opens part of it did nothing at all (#320). Now it brings the shell back,
# the way the Control Center and the restart key do, waits for it and asks
# again; only when that fails is the user told, by a path that does not need
# the shell, which is the notification server here: the first version of this
# used notify-send, which reached nothing (#338).
status=0
quickshell ipc --path "$config" call "$@" || status=$?
[ "$status" -ne 0 ] || exit 0
# A call the running shell refused is its own error, not a shell down.
if shell_answers; then
	exit "$status"
fi
controlcenter=$(command -v dwm-quickshell-controlcenter 2>/dev/null || true)
[ -n "$controlcenter" ] || controlcenter=${0%/*}/dwm-quickshell-controlcenter
if [ -x "$controlcenter" ]; then
	printf 'lyona-shell: the lyona shell is not running; starting it\n' >&2
	"$controlcenter" action restart-quickshell >/dev/null 2>&1 || :
	# Bounded by one deadline, probes and sleeps included: a start takes a
	# second or two; a shell that cannot start is reported below rather than
	# waited for.
	deadline=$(($(date +%s) + ${LYONA_SHELL_RESTART_WAIT:-8}))
	while :; do
		if shell_answers; then
			quickshell ipc --path "$config" call "$@"
			exit
		fi
		[ "$(date +%s)" -lt "$deadline" ] || break
		sleep 0.25
	done
fi
restart_chord=$(chord_for cmd restart-quickshell 'Super+Shift+R')
quit_chord=$(chord_for func quit 'Super+Ctrl+Shift+Q')
case $1 in
power) hint="The lyona shell could not be started. $restart_chord tries again; $quit_chord quits the session now." ;;
*) hint="The lyona shell could not be started. $restart_chord tries again." ;;
esac
printf 'lyona-shell: %s\n' "$hint" >&2
if command -v xmessage >/dev/null 2>&1; then
	xmessage -center -timeout 30 -buttons OK -default OK "$hint" >/dev/null 2>&1 &
fi
exit "$status"
