#!/bin/sh
# autorandr preswitch.d/postswitch.d hook: light-locker's leftover blanking
# windows (#416). After monitors go away and come back, light-locker can leave
# its full-screen black windows over them while it reports itself inactive, and
# the screens stay black. A few seconds after a layout change,
# dwm-settings-power recover-locker restarts light-locker if, and only if, that
# is what happened. It runs from both phases because autorandr skips postswitch
# when applying the layout fails, as it did when this was seen; the second run
# finds nothing to do.
#
# Installed as /etc/xdg/autorandr/preswitch.d/60-lyona-locker and
# postswitch.d/60-lyona-locker. Always exits 0: a failing hook must never get
# in the way of the layout.
set -u

# autorandr --batch runs hooks as each session's user. Never as root (#529):
# the helper and the light-locker or Picom it starts would come from root's
# environment and PATH.
[ "$(id -u)" -ne 0 ] || exit 0

helper=${LYONA_AUTORANDR_LOCKER_HELPER:-}
[ -n "$helper" ] || helper=$(command -v dwm-settings-power 2>/dev/null || :)
[ -n "$helper" ] && [ -x "$helper" ] || exit 0
settle=${LYONA_AUTORANDR_LOCKER_SETTLE:-5}
runtime=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
# One lock per display, named from DISPLAY with anything unsafe replaced.
display_key=$(printf '%s' "${DISPLAY:-none}" | tr -c 'A-Za-z0-9._-' '_')

# One recovery at a time on a display: when both phases' runs meet, the second
# skips, and a later one finds nothing left to do. The lock is not passed on:
# the light-locker the recovery starts would otherwise hold it for its whole
# life, and every later recovery would skip.
(
	sleep "$settle"
	if [ -d "$runtime" ] && command -v flock >/dev/null 2>&1; then
		exec 9>>"$runtime/lyona-locker-recover.$display_key.lock"
		flock -n 9 || exit 0
	fi
	"$helper" recover-locker 9>&-
) >/dev/null 2>&1 </dev/null &
exit 0
